---
import ColorModePicker from '../components/ColorModePicker.astro'
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { VERSION } from '../version.js'

interface Props {
  title: string
  panel?: string
  /** When true, removes main padding so the content can fill edge-to-edge.
   *  Used by plugin-view pages that embed a full-height iframe. */
  noPadding?: boolean
  embedded?: boolean
}

const { title, panel: pagePanel, noPadding = false, embedded = false } = Astro.props
const panel = pagePanel ?? (Astro.url.pathname.replace(/\/$/, '') === '/settings/sidebar' ? 'sidebar-settings' : undefined)
---

<html lang="en" data-theme="brand" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Fraunces:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {panel && <ClientRouter fallback="swap" />}
    <script is:inline>
      (function() {
        const read = key => { try { return localStorage.getItem(key); } catch { return null; } };
        const validTheme = value => ['brand', 'light', 'dark'].includes(value);
        const cached = read('filaman-theme-cache') || read('theme');
        document.documentElement.dataset.theme = validTheme(cached) ? cached : 'brand';
        // Nested pickers inherit old plugins' selected theme before their first paint.
        try {
          if (window.parent !== window) {
            const parentRoot = window.parent.document.documentElement;
            const inherit = () => {
              const theme = parentRoot.dataset.theme;
              if (validTheme(theme) && document.documentElement.dataset.theme !== theme) {
                document.documentElement.dataset.theme = theme;
              }
            };
            const observer = new MutationObserver(inherit);
            const observe = () => {
              observer.observe(parentRoot, { attributes: true, attributeFilter: ['data-theme'] });
              observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
              inherit();
            };
            observe();
            window.addEventListener('pagehide', () => observer.disconnect());
            window.addEventListener('pageshow', observe);
          }
        } catch { /* A cross-origin parent cannot supply its theme. */ }
        const l = read('lang') || 'en';
        document.documentElement.setAttribute('lang', l);
        
        // Sidebar state
        const s = read('sidebar-collapsed');
        const isCompact = window.innerWidth < 1280;
        if (s === 'true' || isCompact) {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      })();
    </script>
  </head>
  <body data-embedded={embedded ? "" : undefined}>
    <div id="fm-page" class="fm-page" style="visibility: hidden;">
      <aside class="fm-sidebar fm-surface">
        <button id="sidebar-toggle" class="fm-sidebar-toggle" aria-label="Toggle Sidebar" data-i18n-aria-label="nav.toggleSidebar" aria-controls="sidebar-content" aria-expanded="true">
          <svg class="sidebar-chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          <svg class="sidebar-menu-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16 M4 12h16 M4 18h16"/></svg>
        </button>

        <div id="sidebar-content" class="fm-sidebar-content">
          <!-- Logo -->
          <div class="fm-logo-container">
            <img src="/logo.png" alt="FilaMan" style="width: 42px; height: 42px; border-radius: 14px; flex-shrink: 0;" />
            <div class="fm-logo-text">
              <div style="font-weight: 700; letter-spacing: 0.6px;">FilaMan</div>
              <small style="color: var(--text-muted); font-size: 0.7rem;" data-i18n="app.subtitle">Filament Management</small>
            </div>
          </div>

          <!-- Navigation -->
          <nav id="sidebar-nav">
            <a href="/" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg?v=2#icon-dashboard"></use></svg></span>
              <span data-i18n="nav.dashboard">Dashboard</span>
            </a>
            <a href="/manufacturers" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg?v=2#icon-manufacturers"></use></svg></span>
              <span data-i18n="nav.manufacturers">Manufacturers</span>
            </a>
            <a href="/filaments" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg?v=2#icon-filaments"></use></svg></span>
              <span data-i18n="nav.filaments">Filaments</span>
            </a>
            <a href="/filaments/colors" class="fm-nav-item" id="sidebar-color-library" aria-label="Color Library" data-i18n-aria-label="colors.title">
              <span class="fm-nav-icon"><i class="fm-color-library-icon" aria-hidden="true"></i></span>
              <span data-i18n="colors.title">Color Library</span>
            </a>
            <a href="/spools" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg?v=2#icon-spools"></use></svg></span>
              <span data-i18n="nav.spools">Spools</span>
            </a>
            <a href="/printers" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg?v=2#icon-printers"></use></svg></span>
              <span data-i18n="nav.printers">Printers</span>
            </a>
            <a href="/print-jobs" class="fm-nav-item">
              <span class="fm-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg></span>
              <span data-i18n="nav.printJobs">Print Jobs</span>
            </a>
            <a href="/analytics" class="fm-nav-item">
              <span class="fm-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;"><line x1="6" y1="20" x2="6" y2="11"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="14"/></svg></span>
              <span data-i18n="nav.analytics">Analytics</span>
            </a>
            <a href="/display" class="fm-nav-item">
              <span class="fm-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;"><rect x="3" y="5" width="18" height="14" rx="2"/><line x1="7.5" y1="5" x2="7.5" y2="19"/><line x1="12" y1="5" x2="12" y2="19"/><line x1="16.5" y1="5" x2="16.5" y2="19"/></svg></span>
              <span data-i18n="nav.display">AMS View</span>
            </a>
            <a href="/locations" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg?v=2#icon-locations"></use></svg></span>
              <span data-i18n="nav.locations">Locations</span>
            </a>
            <a href="/spool-log" class="fm-nav-item">
              <span class="fm-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span>
              <span data-i18n="nav.spoolLog">Spool Log</span>
            </a>

            <div id="plugin-nav" class="sidebar-plugin-group" hidden>
              <hr class="fm-divider" data-sidebar-header />
              <button id="sidebar-plugin-heading" class="sidebar-plugin-heading" type="button" aria-expanded="false" aria-controls="sidebar-plugin-preview">
                <svg class="fm-nav-icon" width="18" height="18" aria-hidden="true"><use href="/icons.svg?v=2#icon-plugin" /></svg>
                <span data-i18n="nav.plugins">Plugins</span>
                <span id="sidebar-plugin-count" class="sidebar-plugin-count"></span>
                <svg class="sidebar-plugin-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <p id="sidebar-plugin-label" class="sidebar-plugin-label" data-i18n="nav.plugins">Plugins</p>
              <div id="sidebar-pinned-plugins" class="sidebar-pinned-plugins"></div>
              <div id="sidebar-plugin-preview" class="sidebar-plugin-preview" hidden>
                <a id="sidebar-plugin-settings-link" href="/settings/sidebar" class="fm-nav-item sidebar-plugin-settings-link"
                  aria-current={Astro.url.pathname.replace(/\/$/, '') === '/settings/sidebar' ? 'page' : undefined}>
                  <svg class="fm-nav-icon" aria-hidden="true"><use href="/icons.svg?v=2#icon-settings" /></svg>
                  <span data-i18n="settings.sidebarTitle">Sidebar settings</span>
                </a>
              </div>
            </div>

            <div id="admin-nav" class="sidebar-admin-group invisible">
              <hr class="fm-divider" style="margin-bottom: 8px;" data-sidebar-header />
              <div class="hide-collapsed" data-sidebar-header style="color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 0 12px; margin-bottom: 6px;" data-i18n="nav.admin">Admin</div>
              <a href="/admin" class="fm-nav-item">
                <span class="fm-nav-icon"><svg><use href="/icons.svg?v=2#icon-admin"></use></svg></span>
                <span data-i18n="nav.adminPanel">Admin Panel</span>
              </a>
            </div>
            <ColorModePicker id="sidebar-color-mode" />
          </nav>

          <!-- Sidebar Footer -->
          <div id="sidebar-footer" style="margin-top: auto; display: grid; gap: 12px;">
            <!-- User Profile Row -->
            <div id="sidebar-profile" class="sidebar-profile">
              <div class="hide-collapsed" style="flex: 1 1 0%; min-width: 0; padding-right: 8px;">
                <div id="user-name" style="font-weight: 600; color: var(--text); font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; width: 100%;">
                  <span style="color: var(--text-muted);" data-i18n="common.loading">Loading...</span>
                </div>
                <div id="user-role" class="invisible" style="color: var(--text-muted); font-size: 0.7rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; width: 100%;">User</div>
              </div>
              <div class="sidebar-profile-actions">
                <a
                  href="/settings"
                  data-sidebar-link
                  class="fm-btn fm-btn-outline"
                  style="padding: 6px; line-height: 0; border-radius: 8px; flex-shrink: 0;"
                  aria-label="User Settings"
                  data-i18n-aria-label="nav.settings"
                  data-i18n-title="nav.settings"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </a>
                <button
                  id="logout-btn"
                  class="fm-btn fm-btn-outline"
                  style="padding: 6px; line-height: 0; border-radius: 8px; flex-shrink: 0;"
                  aria-label="Logout"
                  data-i18n-aria-label="nav.logout"
                  data-i18n-title="nav.logout"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </button>
              </div>
            </div>

            <!-- Buy Me A Coffee -->
            <div style="text-align: center; margin-top: 4px;">
              <div style="font-size: 0.7rem; color: var(--text-muted); margin-bottom: 6px;" data-i18n="nav.supportProject">Unterstütze das Projekt</div>
              <a href="https://ko-fi.com/X8X51V6SLP" target="_blank" style="display: inline-block; transition: transform var(--transition);" onmouseenter="this.style.transform='scale(1.05)'" onmouseleave="this.style.transform='scale(1)'">
                <img src="/img/buymeacoffy.png" alt="Buy Me A Coffee" style="height: 44px; width: auto; display: block;" >
              </a>
            </div>

            <div id="sidebar-version-container" style="font-size: 0.7rem; color: var(--text-muted); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4px;">
              <div id="sidebar-version-label">{'v' + VERSION}</div>
              <a
                id="sidebar-version-update"
                href="/admin"
                class="invisible"
                style="display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; font-size: 0.65rem; font-weight: 600; color: var(--info-text, #93c5fd); background: var(--info-bg, rgba(59, 130, 246, 0.15)); border: 1px solid var(--info-border, rgba(59, 130, 246, 0.4)); border-radius: 9999px; text-decoration: none; transition: opacity var(--transition);"
              >
                <span class="fm-dot" style="background: #60a5fa; width: 6px; height: 6px;"></span>
                <span id="sidebar-version-update-text">Update</span>
              </a>
            </div>
            <div style="font-size: 0.7rem; color: var(--text-muted); text-align: center;">
              <a href="https://www.filaman.app" target="_blank" style="color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                Made with <img src="/coffeecup.svg" width="14" height="14" style="vertical-align: middle;"> and <img src="/heart.svg" width="14" height="14" style="vertical-align: middle;"> by Manuel Weiser
              </a>
              <br />
              <span style="font-size: 0.65rem;">MIT License</span>
            </div>
          </div>
        </div>
      </aside>
      <div id="sidebar-backdrop" class="fm-sidebar-backdrop"></div>

      <main class:list={['fm-main', { 'fm-main--flush': noPadding }]} data-panel={panel} tabindex={panel ? -1 : undefined}>
        <slot />
      </main>
      <div id="session-check-retry" class="fm-main" style="visibility: visible;" hidden>
        <p role="alert" data-i18n="common.networkError">Network error. Please try again.</p>
        <button type="button" class="fm-btn fm-btn-primary" data-i18n="common.retry">Retry</button>
      </div>
    </div>

    <div class="pc-print-prompt-stack">
      <div id="pc-print-prompt" class="pc-print-prompt hidden" role="status" aria-live="polite">
        <div class="pc-print-prompt-header">
          <strong class="pc-print-prompt-title"></strong>
          <span class="pc-print-prompt-age" hidden></span>
        </div>
        <img class="pc-print-prompt-preview" alt="" hidden />
        <p class="pc-print-prompt-message"></p>
        <p class="pc-print-prompt-error" role="alert" hidden></p>
        <div class="pc-print-prompt-actions">
          <button type="button" class="fm-btn fm-btn-primary pc-print-prompt-print" disabled>
            <svg aria-hidden="true"><use href="/icons.svg?v=2#icon-print"></use></svg><span></span>
          </button>
          <a class="fm-btn fm-btn-primary pc-print-prompt-download" download="label.pdf" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 21h14" /></svg><span></span>
          </a>
          <button type="button" class="fm-btn fm-btn-outline pc-print-prompt-edit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m16 3 5 5-12 12H4v-5zM14 5l5 5" /></svg><span></span>
          </button>
          <button type="button" class="fm-btn fm-btn-outline pc-print-prompt-close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg>
          </button>
        </div>
        <small class="pc-print-prompt-note"></small>
      </div>
      <div id="pc-print-prompt-waiting" role="status" hidden></div>
    </div>

    <!-- Global confirm / alert modal -->
    <dialog id="fm-confirm-overlay" class="fm-modal-overlay" aria-labelledby="fm-confirm-title" aria-describedby="fm-confirm-message">
      <div class="fm-modal">
        <h3 id="fm-confirm-title" class="fm-modal-title"></h3>
        <p id="fm-confirm-message" class="fm-modal-message"></p>
        <label id="fm-confirm-checkbox-row" class="fm-modal-checkbox" style="display:none">
          <input type="checkbox" id="fm-confirm-checkbox" />
          <span id="fm-confirm-checkbox-label"></span>
        </label>
        <div class="fm-modal-actions">
          <button id="fm-confirm-cancel" class="fm-btn fm-btn-outline"></button>
          <button id="fm-confirm-ok" class="fm-btn fm-btn-danger"></button>
        </div>
      </div>
    </dialog>


    <script>
      import { t, initI18n, syncLangFromUser, translatePage } from '../lib/i18n'
      import { abortAllRequests, getAbortSignal, isAbortError } from '../lib/abort'
      import { invalidateAllCaches } from '../lib/cache'
      import type { User } from '../lib/auth'
      import type { AppDialogs } from '../lib/form-dialog'
      import { clearLabelPresetBrowserStorage, ensureLabelPresetBrowserMigration } from '../lib/label-preset-storage'
      import { setupPcPrintPrompt } from '../lib/label-pc-print-prompt'
      import { setupSidebar } from '../lib/sidebar'
      import { pluginNavChangedEvent, type PluginNavChange } from '../lib/plugin-nav'
      import { loginUrlWithNext } from '../lib/login-redirect'
      import {
        isAutoOpenEnabled,
        getBoundReaderId,
        lastScanUrl,
        mayNavigate,
        rememberJump,
        takeRememberedJump,
      } from '../lib/tag-scanner'

      /* ── i18n init ───────────────────────────────────────────── */
      await initI18n()

      const sidebar = setupSidebar(highlightActiveNav)

      const inventoryBack = document.querySelector<HTMLAnchorElement>('[data-inventory-back]')
      if (inventoryBack && document.referrer && history.length > 1) {
        const previous = new URL(document.referrer)
        if (previous.origin === location.origin &&
            previous.pathname.replace(/\/$/, '') === inventoryBack.pathname) {
          inventoryBack.addEventListener('click', event => {
            if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
            event.preventDefault()
            void sidebar.navigate(() => history.back())
          })
        }
      }

      const layoutWindow = window as typeof window & Partial<AppDialogs> & {
        __t?: typeof t
        __translatePage?: typeof translatePage
        __syncLangFromUser?: typeof syncLangFromUser
      }

      // Expose t and translatePage globally for page scripts
      layoutWindow.__t = t
      layoutWindow.__translatePage = translatePage
      layoutWindow.__syncLangFromUser = syncLangFromUser

      /* ── Global confirm / alert modal ────────────────────────── */
      ;(function setupFmModal() {
        const overlay = document.getElementById('fm-confirm-overlay') as HTMLDialogElement
        const titleEl = document.getElementById('fm-confirm-title')!
        const messageEl = document.getElementById('fm-confirm-message')!
        const okBtn = document.getElementById('fm-confirm-ok')!
        const cancelBtn = document.getElementById('fm-confirm-cancel')!

        const checkboxRow = document.getElementById('fm-confirm-checkbox-row')!
        const checkboxInput = document.getElementById('fm-confirm-checkbox') as HTMLInputElement
        const checkboxLabel = document.getElementById('fm-confirm-checkbox-label')!

        type ModalCheckbox = { label: string; checked?: boolean }
        type CheckboxResult = { confirmed: boolean; checked: boolean }
        type ModalResult = boolean | CheckboxResult

        let resolveFn: ((v: ModalResult) => void) | null = null
        let checkboxMode = false
        let returnFocus: HTMLElement | null = null

        function openModal(title: string, message: string, okLabel: string, cancelLabel: string | null, isDanger: boolean): Promise<boolean>
        function openModal(title: string, message: string, okLabel: string, cancelLabel: string | null, isDanger: boolean, checkbox: ModalCheckbox | undefined): Promise<ModalResult>
        function openModal(title: string, message: string, okLabel: string, cancelLabel: string | null, isDanger: boolean, checkbox?: ModalCheckbox): Promise<ModalResult> {
          titleEl.textContent = title
          messageEl.textContent = message
          okBtn.textContent = okLabel
          okBtn.className = isDanger ? 'fm-btn fm-btn-danger' : 'fm-btn fm-btn-primary'

          if (cancelLabel) {
            cancelBtn.textContent = cancelLabel
            cancelBtn.style.display = ''
          } else {
            cancelBtn.style.display = 'none'
          }

          if (checkbox) {
            checkboxMode = true
            checkboxLabel.textContent = checkbox.label
            checkboxInput.checked = checkbox.checked ?? false
            checkboxRow.style.display = ''
          } else {
            checkboxMode = false
            checkboxRow.style.display = 'none'
          }

          returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
          overlay.showModal()
          overlay.classList.add('open')
          okBtn.focus()

          return new Promise<ModalResult>(resolve => {
            resolveFn = resolve
          })
        }

        function closeModal(result: boolean) {
          overlay.close()
          overlay.classList.remove('open')
          returnFocus?.focus()
          returnFocus = null
          if (resolveFn) {
            if (checkboxMode) {
              resolveFn(result ? { confirmed: true, checked: checkboxInput.checked } : { confirmed: false, checked: false })
            } else {
              resolveFn(result)
            }
            resolveFn = null
          }
        }

        okBtn.addEventListener('click', () => closeModal(true))
        cancelBtn.addEventListener('click', () => closeModal(false))
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeModal(false)
        })
        overlay.addEventListener('cancel', (e) => {
          e.preventDefault()
          closeModal(false)
        })
        overlay.addEventListener('close', () => {
          if (!overlay.open && resolveFn) closeModal(false)
        })
        document.addEventListener('astro:before-swap', event => {
          if (event.newDocument !== document && overlay.open) closeModal(false)
        })

        // fmConfirm(message, options?) – replacement for window.confirm()
        type ConfirmOptions = { title?: string; okLabel?: string; isDanger?: boolean }
        function fmConfirm(message: string, options: ConfirmOptions & { checkbox: ModalCheckbox }): Promise<CheckboxResult>
        function fmConfirm(message: string, options?: ConfirmOptions): Promise<boolean>
        function fmConfirm(message: string, options?: ConfirmOptions & { checkbox?: ModalCheckbox }): Promise<ModalResult> {
          const title = options?.title || t('common.confirmTitle') || t('common.delete')
          const okLabel = options?.okLabel || t('common.delete')
          const isDanger = options?.isDanger !== undefined ? options.isDanger : true
          return openModal(title, message, okLabel, t('common.cancel'), isDanger, options?.checkbox)
        }
        layoutWindow.__fmConfirm = fmConfirm

        // fmAlert(message) – replacement for window.alert()
        layoutWindow.__fmAlert = function(message: string): Promise<boolean> {
          return openModal(t('common.errorTitle') || 'Error', message, t('common.close'), null, false)
        }

        // fmSuccess(message) – success-style alert with green title
        layoutWindow.__fmSuccess = function(message: string): Promise<boolean> {
          return openModal(t('common.successTitle') || 'Success', message, t('common.close'), null, false)
        }
      })()


      /* ── Auth check ──────────────────────────────────────────── */
      const userName = document.getElementById('user-name')!
      const userRole = document.getElementById('user-role')!
      const logoutBtn = document.getElementById('logout-btn')!
      const adminNav = document.getElementById('admin-nav')!
      const authRetry = document.getElementById('session-check-retry')!
      const retryButton = authRetry.querySelector('button')!
      const embedded = document.body.hasAttribute('data-embedded')
      let authenticatedUserId: User['id'] | undefined
      let disposePrintPrompt: (() => void) | undefined
      let sidebarAccess: string | undefined

      function closePrintPrompt() {
        disposePrintPrompt?.()
        disposePrintPrompt = undefined
      }

      async function readPanelSession(signal: AbortSignal) {
        const response = await fetch('/api/v1/me', { credentials: 'include', signal })
        const user: User | undefined = response.ok ? await response.json() : undefined
        return { response, user }
      }

      const preparedSessions = new WeakMap<HTMLElement, Promise<Awaited<ReturnType<typeof readPanelSession>>>>()

      async function checkAuth(main: HTMLElement) {
        const signal = getAbortSignal()
        retryButton.disabled = true
        try {
          const prepared = preparedSessions.get(main)
          preparedSessions.delete(main)
          const { response, user } = await (prepared ?? readPanelSession(signal))
          if (signal.aborted) return

          if (response.status === 401 || response.status === 403) {
            closePrintPrompt()
            // Server explicitly rejected auth — clear cookies and redirect
            document.cookie = 'session_id=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;'
            document.cookie = 'csrf_token=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;'
            window.location.href = loginUrlWithNext(window.location)
            return
          }
          if (!user) throw new Error(`Session check returned ${response.status}`)
          if (authenticatedUserId !== undefined && authenticatedUserId !== user.id) {
            closePrintPrompt()
            window.location.reload()
            return
          }
          if (authenticatedUserId === undefined) void sidebar.loadAccount(user.id, response.headers.get('X-Filaman-Theme'))
          authenticatedUserId = user.id
          await ensureLabelPresetBrowserMigration(user.id).catch(error => {
            if (!signal.aborted) console.warn('Could not migrate label presets to the database', error)
          })
          if (signal.aborted) return

          // Sync language from user profile
          syncLangFromUser(user.language)
          if (!embedded) disposePrintPrompt ??= setupPcPrintPrompt()


          const name = user.display_name || user.email
          const roles = user.roles.join(', ')
          if (userName.textContent !== name) userName.textContent = name
          if (userRole.textContent !== roles) userRole.textContent = roles
          userRole.classList.remove('invisible')

          adminNav.classList.toggle('invisible', !user.is_superadmin && !user.permissions.some(p => p.startsWith('admin:')))
          const access = JSON.stringify([user.id, user.is_superadmin, [...user.permissions].sort()])
          if (sidebarAccess !== access) {
            const changed = sidebarAccess !== undefined
            sidebarAccess = access
            if (changed) window.dispatchEvent(new Event('filaman:permissions-changed'))
            lastPluginNav = undefined
            sidebar.setPlugins([])
          }
          sidebar.setAdmin(!adminNav.classList.contains('invisible'))
          void checkSystemVersion(user, signal)
          void loadPluginNav()

          // Auth succeeded — reveal page content
          document.getElementById('fm-page')!.style.visibility = 'visible'
          main.style.removeProperty('visibility')
          main.style.removeProperty('display')
          authRetry.hidden = true
          main.dataset.panelAuthorized = ''
          main.dispatchEvent(new Event('filaman:panel-authorized'))
          return true
        } catch (err) {
          if (signal.aborted) return
          console.warn('Could not check session', err)
          // A restored native modal can block clicks on Retry even when hidden.
          document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach(dialog => dialog.close())
          main.style.display = 'none'
          authRetry.hidden = false
          retryButton.disabled = false
          retryButton.focus({ preventScroll: true })
        }
      }

      let pluginNavRequest = 0
      let lastPluginNav: string | undefined
      let retryPluginNav: ReturnType<typeof setTimeout> | undefined

      async function authorizePanel(main: HTMLElement) {
        if (await checkAuth(main) && main.isConnected) main.focus({ preventScroll: true })
      }

      retryButton.addEventListener('click', () => {
        void authorizePanel(document.querySelector<HTMLElement>('main')!)
      })

      /* ── System version check ────────────────────────────────── */
      type VersionStatus = { update_available: boolean; latest_version: string | null }

      async function checkSystemVersion(user: User, signal: AbortSignal) {
        try {
          const cachedRaw = sessionStorage.getItem('fm_version_check')
          if (cachedRaw) {
            try {
              const cached: { ts: number; data: VersionStatus } | null = JSON.parse(cachedRaw)
              if (cached?.ts && Date.now() - cached.ts < 30 * 60 * 1000 && cached.data) {
                applyVersionStatus(cached.data, user)
                return
              }
            } catch { /* ignore corrupted cache */ }
          }

          const resp = await fetch('/api/v1/admin/system/version-check', { credentials: 'include', signal })
          if (!resp.ok) return
          const data: VersionStatus = await resp.json()
          if (signal.aborted) return
          sessionStorage.setItem('fm_version_check', JSON.stringify({ ts: Date.now(), data }))
          applyVersionStatus(data, user)
        } catch { /* Version check is non-critical */ }
      }

      function applyVersionStatus(data: VersionStatus, user: User) {
        const updateBadge = document.getElementById('sidebar-version-update') as HTMLAnchorElement | null
        const updateText = document.getElementById('sidebar-version-update-text')
        if (!updateBadge || !updateText) return
        updateBadge.classList.toggle('invisible', !data.update_available)
        if (!data.update_available) return

        const isAdmin = Boolean(user?.is_superadmin || (user?.permissions || []).some((p: string) => p.startsWith('admin:')))
        if (isAdmin) {
          updateBadge.href = '/admin'
          updateBadge.removeAttribute('target')
          updateBadge.removeAttribute('rel')
        } else {
          updateBadge.href = 'https://github.com/Fire-Devils/filaman-system/releases/latest'
          updateBadge.target = '_blank'
          updateBadge.rel = 'noopener noreferrer'
        }

        const label = t('nav.updateAvailable') || 'Update available'
        const updateLabel = data.latest_version ? `${label}: v${data.latest_version}` : label
        if (updateText.textContent !== updateLabel) updateText.textContent = updateLabel
        updateBadge.title = `${label}: v${data.latest_version || ''}`
      }

      /* ── Plugin navigation ───────────────────────────────────── */
      const pluginIconRevisions = new Map<string, string>()
      window.addEventListener('filaman:plugin-installed', event => {
        const { detail: pluginKey } = event as CustomEvent<string>
        // A ZIP replacement can change the SVG without changing the version.
        pluginIconRevisions.set(pluginKey, `${Date.now()}.${pluginNavRequest}`)
        void loadPluginNav()
      })

      async function loadPluginNav(retry = true) {
        clearTimeout(retryPluginNav)
        const request = ++pluginNavRequest
        const signal = getAbortSignal()
        try {
          const resp = await fetch('/api/v1/plugin-nav', { credentials: 'include', cache: 'no-store', signal })
          if (resp.status === 401 || resp.status === 403) retry = false
          if (!resp.ok) throw new Error('Plugin navigation unavailable')
          const plugins: { plugin_key: string; name: string; page_url: string; icon_url?: string | null }[] = await resp.json()
          if (signal.aborted || request !== pluginNavRequest) return
          for (const plugin of plugins) {
            const revision = pluginIconRevisions.get(plugin.plugin_key)
            if (plugin.icon_url && revision) {
              const separator = plugin.icon_url.includes('?') ? '.' : '?v='
              plugin.icon_url += separator + revision
            }
          }
          const snapshot = JSON.stringify(plugins)
          if (snapshot === lastPluginNav) return
          sidebar.setPlugins(plugins)
          lastPluginNav = snapshot
          highlightActiveNav()
        } catch (error) {
          if (request !== pluginNavRequest || isAbortError(error)) return
          if (retry) retryPluginNav = setTimeout(() => {
            if (!signal.aborted) void loadPluginNav(false)
          }, 600)
          else if (lastPluginNav === undefined) sidebar.setPluginsUnavailable()
        }
      }

      function refreshPluginNav(change?: PluginNavChange) {
        if (change?.pluginKey) pluginIconRevisions.set(change.pluginKey, change.revision)
        void loadPluginNav()
      }
      window.addEventListener(pluginNavChangedEvent, event => refreshPluginNav((event as CustomEvent<PluginNavChange>).detail))
      window.addEventListener('storage', event => {
        if (event.key !== pluginNavChangedEvent) return
        let change: PluginNavChange | undefined
        try { change = JSON.parse(event.newValue || 'null') } catch { /* Older tabs send only a nonce. */ }
        refreshPluginNav(change)
      })
      window.addEventListener('pageshow', event => {
        if (event.persisted) void loadPluginNav()
      })
      window.addEventListener('focus', () => void loadPluginNav())
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) void loadPluginNav()
      })

      logoutBtn.addEventListener('click', () => void sidebar.navigate(async () => {
        page.inert = true
        window.addEventListener('pageshow', () => { page.inert = false }, { once: true })
        closePrintPrompt()
        const csrfToken = document.cookie
          .split('; ')
          .find(row => row.startsWith('csrf_token='))
          ?.split('=')[1]

        try {
          await fetch('/auth/logout', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': decodeURIComponent(csrfToken || ''),
            },
            credentials: 'include',
          })
        } finally {
          clearLabelPresetBrowserStorage()
          localStorage.removeItem('lang')
          window.location.href = '/login'
        }
      }))

      /* ── Active nav highlighting ─────────────────────────────── */
      function highlightActiveNav() {
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/'
        // Plugin pages are told apart by their query, so the entry for the one
        // currently open is only found with it.
        const currentTarget = currentPath + window.location.search
        let bestNavMatch: HTMLAnchorElement | undefined
        let bestNavLen = 0
        for (const item of document.querySelectorAll<HTMLAnchorElement>('aside a.fm-nav-item, aside a[data-sidebar-link]')) {
          item.classList.remove('active')
          item.removeAttribute('aria-current')
          if (item.origin !== window.location.origin || item.closest('[hidden]')) continue
          const path = item.pathname.replace(/\/$/, '') || '/'
          const matches = item.search
            ? path + item.search === currentTarget
            : path === currentPath || (path !== '/' && currentPath.startsWith(path + '/'))
          const length = path.length + item.search.length
          if (matches && length > bestNavLen) {
            bestNavLen = length
            bestNavMatch = item
          }
        }
        bestNavMatch?.classList.add('active')
        bestNavMatch?.setAttribute('aria-current', 'page')
      }
      highlightActiveNav()

      /* ── Sidebar toggle ──────────────────────────────────────── */
      const page = document.getElementById('fm-page')!
      const sidebarToggle = document.getElementById('sidebar-toggle')!
      const html = document.documentElement

      const mobileSidebar = window.matchMedia('(max-width: 599px)')
      const compactSidebar = window.matchMedia('(max-width: 1279px)')
      const sidebarContent = document.getElementById('sidebar-content')!

      function setSidebarCollapsed(collapsed: boolean, persist = true) {
        if (collapsed) {
          page.classList.add('collapsed')
          html.classList.add('sidebar-collapsed')
        } else {
          page.classList.remove('collapsed')
          html.classList.remove('sidebar-collapsed')
        }
        sidebarToggle.setAttribute('aria-expanded', String(!collapsed))
        sidebarContent.inert = mobileSidebar.matches && collapsed
        document.querySelector<HTMLElement>('main')!.inert = mobileSidebar.matches && !collapsed
        authRetry.inert = mobileSidebar.matches && !collapsed
        // Only persist sidebar state on desktop
        if (persist && !mobileSidebar.matches) {
          localStorage.setItem('sidebar-collapsed', collapsed ? 'true' : 'false')
        }
      }
      setSidebarCollapsed(html.classList.contains('sidebar-collapsed'), false)

      const syncSidebarWidth = () => setSidebarCollapsed(compactSidebar.matches || localStorage.getItem('sidebar-collapsed') === 'true', false)
      mobileSidebar.addEventListener('change', syncSidebarWidth)
      compactSidebar.addEventListener('change', syncSidebarWidth)

      document.addEventListener('keydown', (event) => {
        if (!mobileSidebar.matches || html.classList.contains('sidebar-collapsed')) return
        if (event.key === 'Escape') {
          event.preventDefault()
          setSidebarCollapsed(true, false)
          sidebarToggle.focus()
        } else if (event.key === 'Tab') {
          const controls = [...document.querySelectorAll<HTMLElement>('.fm-sidebar button, .fm-sidebar a[href]')]
            .filter(element => !element.matches(':disabled') && element.getClientRects().length)
          const next = event.shiftKey ? controls.at(-1) : controls[0]
          if (document.activeElement === (event.shiftKey ? controls[0] : controls.at(-1))) {
            event.preventDefault()
            next?.focus()
          }
        }
      })

      // Update sidebar state
      sidebarToggle.addEventListener('click', () => {
        const isCollapsed = page.classList.contains('collapsed')
        setSidebarCollapsed(!isCollapsed)
      })

      // Close sidebar on mobile when clicking backdrop
      const sidebarBackdrop = document.getElementById('sidebar-backdrop')!
      sidebarBackdrop.addEventListener('click', () => {
        setSidebarCollapsed(true)
        sidebarToggle.focus()
      })

      /* ── Main panel navigation ───────────────────────────────── */
      if (page.querySelector('main[data-panel]')) {
        // Astro checks the opt-out on the link itself before fetching.
        document.addEventListener('click', event => {
          const link = event.target instanceof Element ? event.target.closest('a') : null
          if (!link || link.closest('.fm-sidebar')) return
          const target = new URL(link.href)
          const currentPanel = page.querySelector<HTMLElement>('main[data-panel]')?.dataset.panel
          const to = target.pathname.replace(/\/$/, '')
          const panelLink = target.origin === location.origin && (
            (currentPanel === 'settings' && to === '/settings/sidebar') ||
            (currentPanel === 'sidebar-settings' && to === '/settings') ||
            (currentPanel === 'admin' && to === '/admin/system') ||
            (currentPanel === 'plugin-management' && (
              to === '/admin' || to === '/plugin-view' || to.startsWith('/plugin-view/') ||
              to === '/admin/system/filamentdb-import' || to === '/admin/system/spoolman-import'
            ))
          )
          if (!panelLink) link.setAttribute('data-astro-reload', '')
        }, { capture: true })
        document.addEventListener('astro:before-preparation', event => {
          const load = event.loader
          event.loader = sidebar.guardPanelNavigation(event, async () => {
            await load()
            if (event.defaultPrevented || event.signal.aborted || event.newDocument === document) return
            const nextMain = event.newDocument.querySelector<HTMLElement>('main[data-panel]')
            if (!nextMain) return
            const departure = new AbortController()
            window.addEventListener('pagehide', () => departure.abort(), { once: true, signal: departure.signal })
            const session = readPanelSession(AbortSignal.any([event.signal, departure.signal]))
            preparedSessions.set(nextMain, session)
            await session.catch(() => {})
            if (departure.signal.aborted) {
              // A page restored from the browser cache keeps the panel it left with.
              if (event.navigationType === 'traverse') preparedSessions.delete(nextMain)
              else {
                event.to = event.from
                event.newDocument = document
              }
            }
            departure.abort()
          })
        })
        const { swapFunctions } = await import('astro:transitions/client')
        let restoreScroll: (() => void) | undefined
        document.addEventListener('astro:before-swap', event => {
          if (event.newDocument === document) {
            const { scrollX, scrollY } = window
            restoreScroll = () => window.scrollTo(scrollX, scrollY)
            void event.viewTransition.ready.catch(() => {})
            event.viewTransition.skipTransition()
            event.swap = () => document.querySelector('.astro-route-announcer')?.remove()
            return
          }
          const nextMain = event.newDocument.querySelector<HTMLElement>('main[data-panel]')
          const main = page.querySelector<HTMLElement>('main[data-panel]')
          if (!main || !nextMain) return

          // Keep the mounted sidebar out of full-page view transition snapshots.
          void event.viewTransition.ready.catch(() => {})
          event.viewTransition.skipTransition()
          event.swap = () => {
            abortAllRequests()
            authRetry.hidden = true
            swapFunctions.deselectScripts(event.newDocument)
            swapFunctions.swapHeadElements(event.newDocument)
            document.querySelector('.astro-route-announcer')?.remove()
            nextMain.style.visibility = 'hidden'
            main.replaceWith(nextMain)
          }
        })
        document.addEventListener('astro:after-swap', () => {
          if (restoreScroll) {
            highlightActiveNav()
            restoreScroll()
            restoreScroll = undefined
            return
          }
          const main = page.querySelector<HTMLElement>('main[data-panel]')
          if (!main) return
          setSidebarCollapsed(mobileSidebar.matches || html.classList.contains('sidebar-collapsed'), false)
          highlightActiveNav()
          translatePage(main)
          void authorizePanel(main)
        })
      }
      void checkAuth(document.querySelector<HTMLElement>('main')!)
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return
        const main = document.querySelector<HTMLElement>('main')!
        if (main.hasAttribute('data-panel-authorized')) void checkAuth(main)
        else void authorizePanel(main)
      })

      /* ── SSE live-update connection ──────────────────────────── */
      ;(function setupSSE() {
        let es: EventSource | null = null
        let reconnectDelay = 1000
        let reconnect: ReturnType<typeof setTimeout> | undefined

        function connect() {
          if (es) return
          es = new EventSource('/api/v1/events/stream')

          es.onmessage = (e) => {
            try {
              const data = JSON.parse(e.data)
              if (['resync', 'filaments_changed', 'manufacturers_changed', 'colors_changed', 'spools_changed', 'locations_changed', 'statuses_changed'].includes(data.event)) {
                invalidateAllCaches()
              }
              window.dispatchEvent(new CustomEvent('filaman:data-changed', { detail: data }))
            } catch {}
          }

          es.onopen = () => {
            reconnectDelay = 1000
          }

          es.onerror = () => {
            es?.close()
            es = null
            reconnect = setTimeout(connect, reconnectDelay)
            reconnectDelay = Math.min(reconnectDelay * 2, 30000)
          }
        }

        // Bei Navigation SSE-Connection schließen um HTTP/2-Blockierung zu vermeiden
        window.addEventListener('pagehide', () => {
          clearTimeout(reconnect)
          es?.close()
          es = null
        })
        window.addEventListener('pageshow', event => {
          if (event.persisted) connect()
        })

        connect()
      })()

      /* ── Follow a tag reader to the spool it scanned ──────────── */
      // Poll the persisted scan sequence so navigation survives disconnected clients.
      ;(function followTagScanner() {
        if (embedded) return
        const POLL_MS = 1200
        let lastSeenSeq: number | null = null
        let inFlight = false

        async function poll() {
          if (inFlight || !isAutoOpenEnabled()) return
          inFlight = true
          try {
            const response = await fetch(lastScanUrl(getBoundReaderId()), {
              credentials: 'include',
              cache: 'no-store',
            })
            if (!response.ok) return
            const scan = await response.json()
            const seq = Number(scan?.seq) || 0
            if (!seq) return

            // The first answer only sets the mark. Without that, opening a tab
            // would jump to whatever was scanned an hour ago.
            if (lastSeenSeq === null) {
              lastSeenSeq = seq
              return
            }
            if (seq <= lastSeenSeq) return
            lastSeenSeq = seq
            if (page.inert) return

            if (!scan.spool_id) {
              showScanNote(t('scanner.unknownTag', { uid: scan.uid || '?' }))
              return
            }
            // Jumping is for the pages where it continues what you were doing.
            // Anywhere else - a plugin page, the AMS view, a form - the scan is
            // an interruption, so it is offered instead of obeyed.
            if (!sidebar.isLeaving() && mayNavigate(document, window.location.pathname)) {
              void sidebar.navigate(() => {
                rememberJump({ uid: scan.uid || '', spoolId: scan.spool_id, at: Date.now() })
                window.location.href = `/spools/${scan.spool_id}`
              })
              return
            }
            showScanNote(
              scan.spool_label
                ? t('scanner.offerNamed', { id: scan.spool_id, name: scan.spool_label })
                : t('scanner.offer', { id: scan.spool_id }),
              `/spools/${scan.spool_id}`
            )
          } catch {
            // A poll that fails changes nothing; the next one tries again.
          } finally {
            inFlight = false
          }
        }

        // The quiet half of the feature. An unknown tag is not an error, it is
        // nothing to open, and naming the UID makes it obvious which spool
        // still needs linking. With a link it becomes the offer used wherever
        // the page must not be taken away.
        function showScanNote(text: string, href?: string, ms?: number) {
          document.getElementById('tag-scan-note')?.remove()
          const note = document.createElement('div')
          note.id = 'tag-scan-note'
          note.className = 'fm-alert-info'
          note.setAttribute('role', 'status')
          note.style.cssText =
            'position: fixed; right: 20px; bottom: 20px; z-index: 1000; max-width: 340px;' +
            'display: flex; align-items: center; gap: 12px;'
          const label = document.createElement('span')
          label.style.flex = '1'
          label.textContent = text
          note.appendChild(label)
          if (href) {
            const open = document.createElement('a')
            open.className = 'fm-btn fm-btn-primary'
            open.href = href
            open.textContent = t('scanner.open')
            note.appendChild(open)
          }
          document.body.appendChild(note)
          // An offer has to outlive the glance that notices it, so it waits
          // longest. A note that only reports something gets long enough to be
          // read and no longer, because lingering is just in the way.
          setTimeout(() => note.remove(), ms ?? (href ? 20000 : 6000))
        }

        // A hidden tab keeps polling on purpose. Somebody watching the screen
        // while working in another window is exactly the case this is for, and
        // a tab that stopped listening would simply never move. It costs almost
        // nothing: browsers throttle timers in a background tab to about once a
        // minute by themselves, so the interval below only applies up front.
        // A page that changed under you owes an explanation. This is the other
        // half of the jump above, running on the page it landed on.
        const landed = takeRememberedJump()
        if (landed) {
          // Longer than a plain note: this one answers "why am I suddenly
          // here", and that question is asked after the eye has wandered.
          showScanNote(
            landed.uid
              ? t('scanner.landed', { uid: landed.uid })
              : t('scanner.landedPlain'),
            undefined,
            10000
          )
        }

        setInterval(poll, POLL_MS)
        void poll()
      })()
    </script>
  </body>
</html>
