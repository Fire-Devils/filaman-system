---
const handles = [
  { name: 'nw', label: 'Resize top left', key: 'cropTopLeft' },
  { name: 'ne', label: 'Resize top right', key: 'cropTopRight' },
  { name: 'sw', label: 'Resize bottom left', key: 'cropBottomLeft' },
  { name: 'se', label: 'Resize bottom right', key: 'cropBottomRight' },
  { name: 'n', label: 'Resize top', key: 'cropTop' },
  { name: 's', label: 'Resize bottom', key: 'cropBottom' },
  { name: 'w', label: 'Resize left', key: 'cropLeft' },
  { name: 'e', label: 'Resize right', key: 'cropRight' },
]
---
<dialog id="freeform-image-crop-dialog" aria-labelledby="freeform-crop-title" aria-describedby="freeform-crop-help">
  <h2 id="freeform-crop-title" data-i18n="labelDesigner.cropImage">Crop image</h2>
  <p id="freeform-crop-help" data-i18n="labelDesigner.cropHelp">Drag the corners to crop, or drag inside to move the selection. Arrow keys move it; Shift moves faster. The original image stays unchanged.</p>
  <div class="crop-preview">
    <div data-crop-stage>
      <img alt="" draggable="false" />
      <div data-crop-selection tabindex="0" role="group" aria-label="Crop selection" data-i18n-aria-label="labelDesigner.cropSelection">
        {handles.map(handle => <button type="button" data-crop-handle={handle.name} aria-label={handle.label} data-i18n-aria-label={`labelDesigner.${handle.key}`} title={handle.label} data-i18n-title={`labelDesigner.${handle.key}`} />)}
      </div>
    </div>
  </div>
  <p class="crop-status" role="status" aria-live="polite"></p>
  <footer>
    <button type="button" data-crop-action="reset" data-i18n="labelDesigner.resetCrop">Reset crop</button>
    <div><button type="button" data-crop-action="cancel" data-i18n="common.cancel">Cancel</button><button type="button" class="crop-apply" data-crop-action="apply" data-i18n="common.apply" disabled>Apply</button></div>
  </footer>
</dialog>
<style>
  dialog { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 12px; color: var(--text); margin: auto; max-height: 90vh; overflow: auto; padding: 20px; width: min(640px, 90vw); }
  dialog::backdrop { background: #0009; }
  h2 { font-size: 1rem; margin: 0 0 8px; }
  p { color: var(--text-muted); font-size: 0.8rem; margin: 8px 0 12px; }
  .crop-preview { align-items: center; background: var(--bg); border-radius: 6px; display: flex; justify-content: center; min-height: 120px; overflow: hidden; padding: 10px; }
  [data-crop-stage] { line-height: 0; max-width: 100%; position: relative; touch-action: none; user-select: none; }
  img { display: block; max-height: min(48vh, 420px); max-width: 100%; object-fit: contain; }
  [data-crop-selection] { border: 1px solid white; box-shadow: 0 0 0 999px #0008; box-sizing: border-box; cursor: move; position: absolute; touch-action: none; }
  [data-crop-selection]:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  [data-crop-handle] { background: transparent; border: 0; height: 16px; padding: 0; position: absolute; touch-action: none; width: 16px; }
  [data-crop-handle]::after { border: 0 solid white; content: ''; filter: drop-shadow(0 0 1px black); height: 9px; left: 3px; position: absolute; top: 3px; width: 9px; }
  [data-crop-handle='nw'] { cursor: nwse-resize; left: -8px; top: -8px; }
  [data-crop-handle='nw']::after { border-left-width: 3px; border-top-width: 3px; }
  [data-crop-handle='ne'] { cursor: nesw-resize; right: -8px; top: -8px; }
  [data-crop-handle='ne']::after { border-right-width: 3px; border-top-width: 3px; }
  [data-crop-handle='sw'] { bottom: -8px; cursor: nesw-resize; left: -8px; }
  [data-crop-handle='sw']::after { border-bottom-width: 3px; border-left-width: 3px; }
  [data-crop-handle='se'] { bottom: -8px; cursor: nwse-resize; right: -8px; }
  [data-crop-handle='se']::after { border-bottom-width: 3px; border-right-width: 3px; }
  [data-crop-handle='n'], [data-crop-handle='s'] { cursor: ns-resize; left: calc(50% - 8px); }
  [data-crop-handle='n'] { top: -8px; }
  [data-crop-handle='s'] { bottom: -8px; }
  [data-crop-handle='n']::after, [data-crop-handle='s']::after { border-top-width: 3px; height: 0; top: 6px; }
  [data-crop-handle='w'], [data-crop-handle='e'] { cursor: ew-resize; top: calc(50% - 8px); }
  [data-crop-handle='w'] { left: -8px; }
  [data-crop-handle='e'] { right: -8px; }
  [data-crop-handle='w']::after, [data-crop-handle='e']::after { border-left-width: 3px; left: 6px; width: 0; }
  footer, footer > div { align-items: center; display: flex; gap: 8px; justify-content: space-between; }
  footer { margin-top: 16px; }
  footer button { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 0.8rem; padding: 8px 12px; }
  footer .crop-apply { background: var(--accent); color: var(--accent-contrast, #071a12); }
  button:disabled { cursor: default; opacity: 0.45; }
  .crop-status:empty { display: none; }
</style>
