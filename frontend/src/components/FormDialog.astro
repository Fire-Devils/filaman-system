---
interface Props {
  id: string
  titleId: string
  titleKey: string
  title: string
  wide?: boolean
  /** Manual section for this dialog (key from lib/handbook.ts) */
  handbook?: string
  /** Pure notice dialogs (no manual section wanted): no help button in the header */
  noHelp?: boolean
}
const { id, titleId, titleKey, title, wide = false, handbook, noHelp = false } = Astro.props
---
<dialog id={id} class:list={['fm-form-dialog', { 'fm-form-dialog-wide': wide }]} aria-labelledby={titleId} data-handbook={handbook} data-help-skip={noHelp ? '' : undefined}>
  <header class="fm-section-header fm-form-dialog-header">
    <h2 id={titleId} data-i18n={titleKey}>{title}</h2>
    <div class="fm-header-actions"><slot name="actions" /></div>
  </header>
  <div class="fm-section-body"><slot /></div>
</dialog>
