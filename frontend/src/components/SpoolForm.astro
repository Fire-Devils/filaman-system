---
import { buildSpoolDetailSections, renderSpoolFieldInput } from '../lib/spool-detail'
import en from '../i18n/en.json'
import '../styles/spool-form.css'
const sections = buildSpoolDetailSections({ low_weight_threshold_g: 100 })
const label = (key: string) => en.spools[key.replace('spools.', '') as keyof typeof en.spools]
---
<div id="spool-create-page" class="fm-detail-content">
  <div class="fm-list-toolbar"><h1 data-i18n="spools.newSpool">New Spool</h1></div>
  <form id="spool-form" class="fm-settings-stack" novalidate>
    <section class="fm-card filament-spec-card spool-profile-card">
      <h2 class="filament-spec-title spool-section-heading">
        <span data-i18n="spools.filament">Filament</span>
        <a href="/filaments/new?create_spool=1" class="fm-btn fm-btn-outline" data-i18n="filaments.addFilament">Add Filament</a>
      </h2>
      <div class="fm-section-body">
        <input type="hidden" id="filament_id" name="filament_id" />
        <p id="filament-dropdown-text" class="filament-spec-value" data-i18n="spools.selectFilament">Select filament...</p>
        <div class="fm-list-controls">
          <a href="/filaments?select_for_spool=1" class="fm-btn fm-btn-outline" data-i18n="spools.selectFilament">Select filament</a>
          <button type="button" id="btn-import-from-tag" class="fm-btn fm-btn-outline" data-i18n="spools.importFromTag">Import from Tag</button>
        </div>
      </div>
    </section>
    <fieldset id="spool-create-details" disabled hidden style="border: 0; padding: 0; margin: 0; min-width: 0;">
      <div class="filament-spec-grid">
        {sections.map(section => <section class:list={['fm-card', 'filament-spec-card', { 'spool-profile-card': section.key === 'spool' }]}>
          <h2 class="filament-spec-title spool-section-heading"><span data-i18n={section.titleKey}>{label(section.titleKey)}</span></h2>
          <div class="filament-spec-rows">
            {section.key === 'spool' && <label class="filament-spec-row" for="spool_quantity"><span class="filament-spec-label" data-i18n="spools.quantity">Quantity</span><input type="number" id="spool_quantity" name="spool_quantity" value="1" min="1" step="1" class="fm-input spool-edit-input" /></label>}
            {section.rows.filter(row => row.key !== 'filament_id').map(row => row.key === 'spool_core_weight_g' ?
              <div class="filament-spec-row spool-core-row">
                <span class="filament-spec-label" data-i18n={row.labelKey}>{label(row.labelKey)}</span>
                <div class="spool-core-edit">
                  <label><input type="checkbox" id="uses_spool_core" /> <span data-i18n="spools.usesSpoolCore">Uses spool core / adapter</span></label>
                  <div id="spool_core_weight_container" style="display: none;">
                    <span class="spool-input-unit"><input id={row.key} name={row.key} type="number" step="1" min="0" class="fm-input spool-edit-input" placeholder="Global default" data-i18n-placeholder="spools.spoolCoreWeightPlaceholder" aria-describedby="spool-core-weight-help" aria-label={label(row.labelKey)} data-i18n-aria-label={row.labelKey} /><span>g</span></span>
                  </div>
                  <small id="spool-core-weight-help" class="fm-field-hint" data-i18n="spools.spoolCoreWeightHint">Leave blank to use the global default.</small>
                </div>
              </div> :
              <label class="filament-spec-row" for={row.key}>
                <span class="filament-spec-label" data-i18n={row.labelKey}>{label(row.labelKey)}</span>
                <Fragment set:html={renderSpoolFieldInput(row, row.key === 'low_weight_threshold_g' ? 100 : '', label, row.key)} />
              </label>)}
            {section.key === 'identity' && <label class="filament-spec-row" for="location_id"><span class="filament-spec-label" data-i18n="spools.location">Location</span><select id="location_id" name="location_id" class="fm-select spool-edit-input"><option value="" data-i18n="spools.noLocation">No location</option></select></label>}
          </div>
        </section>)}
        <section id="system-fields-container" class="fm-card filament-spec-card" style="display: none;">
          <h2 class="filament-spec-title" data-i18n="common.systemFields">System Fields</h2>
          <div id="system-fields-grid" class="spool-system-fields-editor"></div>
        </section>
        <section class="fm-card filament-spec-card spool-extra-fields-card">
          <h2 class="filament-spec-title spool-section-heading"><span data-i18n="spools.specificExtraFields">Spool-specific extra fields</span><button type="button" id="btn-add-field" class="fm-btn fm-btn-outline">+ <span data-i18n="common.add">Add</span></button></h2>
          <div class="fm-section-body">
            <p class="fm-field-hint"><span data-i18n="spools.specificExtraFieldsHelp">These typed fields apply only to this spool.</span> <a href="/admin/extra-fields" style="color: var(--accent);" data-i18n="spools.manageSystemExtraFields">Manage System Extra Fields</a></p>
            <div id="custom-fields-container" class="fm-settings-stack"></div>
          </div>
        </section>
      </div>
    </fieldset>
    <div id="error-message" class="fm-alert-error hidden" role="alert"></div>
  </form>
</div>
