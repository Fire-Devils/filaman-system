---
interface Props { titleKey: string; title: string; id?: string; class?: string }
const { titleKey, title, id, class: className } = Astro.props
---
<section class:list={['fm-card', 'fm-section', className]}>
  <header class="fm-section-header">
    <h2 id={id} data-i18n={titleKey}>{title}</h2>
    <slot name="actions" />
  </header>
  <div class="fm-section-body"><slot /></div>
</section>
