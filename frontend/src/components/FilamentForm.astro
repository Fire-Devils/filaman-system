---
import InlineColorEditor from './InlineColorEditor.astro'

interface Props {
  mode: 'create' | 'edit'
  cancelHref: string
}

const { mode, cancelHref } = Astro.props
---

    <form id="filament-form" class="filament-editor-form">
      <header id="filament-editor-hero" class="filament-hero filament-editor-hero">
        <div class="filament-hero-layout">
          <div class="filament-editor-heading">
            <h1 id="filament-editor-title" data-i18n={mode === 'create' ? 'filaments.newFilament' : 'filaments.editFilament'}>
              {mode === 'create' ? 'Create New Filament' : 'Edit Filament'}
            </h1>
            <div class="filament-editor-manufacturer">
              <div class="filament-manufacturer-field" data-dirty-key="manufacturer_id">
                <label for="manufacturer_id" class="filament-sr-only" data-i18n="filaments.manufacturer">Manufacturer *</label>
                <select id="manufacturer_id" name="manufacturer_id" required class="filament-manufacturer-select" aria-label="Manufacturer" data-i18n-aria-label="filaments.manufacturer">
                  <option value="" data-i18n="filaments.selectManufacturer">Select manufacturer...</option>
                </select>
                <div class="filament-search-scope-control">
                  <span id="fil-search-scope-hint"></span>
                  <label>
                    <span data-i18n="filamentdbLookup.searchAction">search</span>
                    <input id="fil-search-all-manufacturers" type="checkbox" aria-label="Search all manufacturers" data-i18n-aria-label="filamentdbLookup.searchAllManufacturers" />
                  </label>
                </div>
              </div>
              <div id="fil-fdb-section" style="display: none;">
                <div id="fil-lookup-heading" class="filament-lookup-heading"></div>
                <div id="fil-lookup-container"></div>
                <div id="fil-lookup-toast" class="fdb-toast" style="display: none;"></div>
              </div>
            </div>
            <div class="filament-hero-meta">
              <span id="filament-editor-type" class="filament-pill">—</span>
            </div>
            <button id="filament-color-launcher" class="filament-color-editor-button" type="button" aria-label="Edit colors" data-i18n-aria-label="filaments.editColors">
              <span id="filament-editor-color-swatch" class="filament-color-dot"></span>
              <code id="filament-editor-color-name" class="filament-color-name" data-i18n="filaments.chooseColors">Choose colors</code>
              <span class="filament-color-edit-icon" aria-hidden="true">✎</span>
            </button>
          </div>
          <div class="filament-hero-actions">
            <button
              type="submit"
              id="submit-btn"
              class="fm-btn fm-btn-primary"
              data-i18n={mode === 'create' ? 'filaments.createFilament' : 'filaments.saveFilament'}
            >
              {mode === 'create' ? 'Create Filament' : 'Save Filament'}
            </button>
            <a id="filament-form-cancel" href={cancelHref} class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</a>
          </div>
        </div>
      </header>
      <p class="filament-required-legend"><span class="filament-required" aria-hidden="true">*</span> <span data-i18n="filaments.requiredFieldsLegend">Required</span></p>
      <div class="filament-form-sections">
        <section class="fm-card filament-spec-card filament-form-primary-section" data-filament-section="material">
          <h2 class="filament-spec-title" data-i18n="filaments.materialDetails">Material</h2>
          <div class="filament-form-section-body">
            <div class="filament-required-field" data-dirty-key="material_type">
              <label for="type" class="fm-label"><span data-i18n="filaments.type">Base Material</span> <span class="filament-required" aria-hidden="true">*</span></label>
              <select id="type" name="type" required class="fm-select"><option value="" data-i18n="filaments.selectType">Select base material...</option></select>
              <div id="custom-type-wrapper" class="filament-required-field hidden" style="margin-top: 8px;">
                <label for="custom_type" class="fm-label"><span data-i18n="filaments.customTypeLabel">Custom Base Material</span> <span class="filament-required" aria-hidden="true">*</span></label>
                <input type="text" id="custom_type" name="custom_type" placeholder="e.g. HIPS" data-i18n-placeholder="filaments.customTypePlaceholder" class="fm-input" maxlength="50" style="text-transform: uppercase;" />
              </div>
            </div>
            <div class="filament-required-field" data-dirty-key="diameter_mm">
              <label for="diameter_mm" class="fm-label"><span data-i18n="filaments.diameter">Diameter</span> <span class="filament-required" aria-hidden="true">*</span></label>
              <div class="filament-unit-input"><input type="number" id="diameter_mm" name="diameter_mm" step="0.01" value="1.75" required class="fm-input" /><span>mm</span></div>
            </div>
            <div data-dirty-key="material_subgroup">
              <label for="material_subgroup" class="fm-label" data-i18n="filaments.materialSubgroup">Material Variant / Additive</label>
              <input type="text" id="material_subgroup" name="material_subgroup" placeholder="e.g. CF, GF, Wood-filled" data-i18n-placeholder="filaments.materialSubgroupPlaceholder" class="fm-input" />
            </div>
            <div data-dirty-key="finish_type">
              <label for="finish_type" class="fm-label" data-i18n="filaments.finishType">Finish / Appearance</label>
              <select id="finish_type" name="finish_type" class="fm-select">
                <option value="">-</option>
                <option value="solid" data-i18n="filaments.finishSolid">Solid</option>
                <option value="matte" data-i18n="filaments.finishMatte">Matte</option>
                <option value="silk" data-i18n="filaments.finishSilk">Silk</option>
                <option value="translucent" data-i18n="filaments.finishTranslucent">Translucent</option>
                <option value="neon" data-i18n="filaments.finishNeon">Neon</option>
                <option value="glow" data-i18n="filaments.finishGlow">Glow in the Dark</option>
              </select>
            </div>
            <div class="filament-form-wide filament-required-field" data-dirty-key="designation">
              <label for="designation" class="fm-label"><span data-i18n="filaments.designation">Manufacturer Product / Series Name</span> <span class="filament-required" aria-hidden="true">*</span></label>
              <input type="text" id="designation" name="designation" required placeholder="e.g. Basic, Hyper, Tough+, PolyTerra" data-i18n-placeholder="filaments.designationPlaceholder" class="fm-input" />
            </div>
            <div data-dirty-key="density_g_cm3">
              <label for="density_g_cm3" class="fm-label" data-i18n="filaments.densityLabel">Density</label>
              <div class="filament-unit-input"><input type="number" id="density_g_cm3" name="density_g_cm3" step="0.01" placeholder="e.g. 1.24" data-i18n-placeholder="filaments.densityPlaceholder" class="fm-input" /><span>g/cm³</span></div>
            </div>
            <label class="filament-form-check" data-dirty-key="is_discontinued"><input type="checkbox" id="is_discontinued" name="is_discontinued" class="fm-checkbox" /><span data-i18n="filaments.discontinued">Discontinued</span></label>
          </div>
        </section>

        <section class="fm-card filament-spec-card" data-filament-section="spool">
          <h2 class="filament-spec-title" data-i18n="filaments.spoolDetails">Spool</h2>
          <div class="filament-form-section-body">
            <div data-dirty-key="raw_material_weight_g"><label for="raw_material_weight_g" class="fm-label" data-i18n="filaments.rawMaterialWeightLabel">Net Filament Weight</label><div class="filament-unit-input"><input type="number" id="raw_material_weight_g" name="raw_material_weight_g" step="1" placeholder="e.g. 1000" data-i18n-placeholder="filaments.rawMaterialPlaceholder" class="fm-input" /><span>g</span></div></div>
            <div data-dirty-key="default_spool_weight_g"><label for="default_spool_weight_g" class="fm-label" data-i18n="filaments.defaultSpoolWeightLabel">Empty Spool Weight</label><div class="filament-unit-input"><input type="number" id="default_spool_weight_g" name="default_spool_weight_g" step="1" placeholder="e.g. 250" data-i18n-placeholder="filaments.defaultSpoolWeightPlaceholder" class="fm-input" /><span>g</span></div></div>
            <div data-dirty-key="spool_material"><label for="spool_material" class="fm-label" data-i18n="spools.spoolMaterial">Spool Material</label><select id="spool_material" name="spool_material" class="fm-select"><option value="">-</option><option value="Plastic" data-i18n="spools.spoolMaterialPlastic">Plastic</option><option value="Cardboard" data-i18n="spools.spoolMaterialCardboard">Cardboard</option><option value="Metal" data-i18n="spools.spoolMaterialMetal">Metal</option><option value="Other" data-i18n="spools.spoolMaterialOther">Other</option></select></div>
            <div data-dirty-key="spool_outer_diameter_mm"><label for="spool_outer_diameter_mm" class="fm-label" data-i18n="spools.spoolOuterDiameterLabel">Spool Outer Diameter</label><div class="filament-unit-input"><input type="number" id="spool_outer_diameter_mm" name="spool_outer_diameter_mm" step="0.1" class="fm-input" /><span>mm</span></div></div>
            <div data-dirty-key="spool_width_mm"><label for="spool_width_mm" class="fm-label" data-i18n="spools.spoolWidthLabel">Spool Width</label><div class="filament-unit-input"><input type="number" id="spool_width_mm" name="spool_width_mm" step="0.1" class="fm-input" /><span>mm</span></div></div>
            <div data-dirty-key="price"><label for="price" class="fm-label" data-i18n="filaments.price">Purchase Price</label><input type="number" id="price" name="price" step="0.01" placeholder="e.g. 24.99" data-i18n-placeholder="filaments.pricePlaceholder" class="fm-input" /></div>
            <div data-dirty-key="price_currency"><label for="price_currency" class="fm-label" data-i18n="filaments.priceCurrency">Price currency</label><input id="price_currency" name="price_currency" maxlength="3" placeholder="USD" class="fm-input" style="text-transform: uppercase;" /></div>
          </div>
        </section>

        <section class="fm-card filament-spec-card" data-filament-section="temperatures">
          <h2 class="filament-spec-title" data-i18n="filaments.temperatures">Temperatures</h2>
          <div class="filament-form-section-body">
            <div data-dirty-key="extruder_temp_range_c"><label class="fm-label" data-i18n="filaments.extruderTemperatureLabel">Extruder Temperature</label><div class="filament-unit-input"><div class="filament-range-inputs"><input type="number" id="extruder_temp_value" step="1" placeholder="Value" data-i18n-placeholder="filaments.temperatureValue" aria-label="Extruder temperature value" class="fm-input" /><input type="number" id="extruder_temp_to" step="1" placeholder="To (optional)" data-i18n-placeholder="filaments.temperatureTo" aria-label="Extruder temperature upper value" class="fm-input" /></div><span>°C</span></div></div>
            <div data-dirty-key="bed_temp_range_c"><label class="fm-label" data-i18n="filaments.bedTemperatureLabel">Bed Temperature</label><div class="filament-unit-input"><div class="filament-range-inputs"><input type="number" id="bed_temp_value" step="1" placeholder="Value" data-i18n-placeholder="filaments.temperatureValue" aria-label="Bed temperature value" class="fm-input" /><input type="number" id="bed_temp_to" step="1" placeholder="To (optional)" data-i18n-placeholder="filaments.temperatureTo" aria-label="Bed temperature upper value" class="fm-input" /></div><span>°C</span></div></div>
            <div data-dirty-key="chamber_temp_c"><label for="chamber_temp_c" class="fm-label" data-i18n="filaments.chamberTemperatureLabel">Chamber temperature</label><div class="filament-unit-input"><input type="number" id="chamber_temp_c" name="chamber_temp_c" step="1" class="fm-input" /><span>°C</span></div></div>
            <div data-dirty-key="softening_temp_c"><label for="softening_temp_c" class="fm-label" data-i18n="filaments.softeningTemperatureLabel">Softening temperature</label><div class="filament-unit-input"><input type="number" id="softening_temp_c" name="softening_temp_c" step="1" class="fm-input" /><span>°C</span></div></div>
          </div>
        </section>

        <section class="fm-card filament-spec-card" data-filament-section="drying">
          <h2 class="filament-spec-title" data-i18n="filaments.dryingInfo">Drying</h2>
          <div class="filament-form-section-body">
            <div data-dirty-key="drying_temp_c"><label for="drying_temp_c" class="fm-label" data-i18n="filaments.dryingTemperatureLabel">Drying temperature</label><div class="filament-unit-input"><input type="number" id="drying_temp_c" name="drying_temp_c" step="1" class="fm-input" /><span>°C</span></div></div>
            <div data-dirty-key="drying_time_hours"><label for="drying_time_hours" class="fm-label" data-i18n="filaments.dryingTimeLabel">Drying time</label><div class="filament-unit-input"><input type="number" id="drying_time_hours" name="drying_time_hours" step="0.1" class="fm-input" /><span>h</span></div></div>
          </div>
        </section>

        <section class="fm-card filament-spec-card" data-filament-section="printBehavior">
          <h2 class="filament-spec-title" data-i18n="filaments.printBehavior">Print behavior</h2>
          <div class="filament-form-section-body">
            <div data-dirty-key="cooling_fan_range_percent"><label class="fm-label" data-i18n="filaments.coolingFanLabel">Cooling fan</label><div class="filament-unit-input"><div class="filament-range-inputs"><input type="number" id="cooling_fan_value" min="0" max="100" step="1" placeholder="Value" data-i18n-placeholder="filaments.temperatureValue" aria-label="Cooling fan value" class="fm-input" /><input type="number" id="cooling_fan_to" min="0" max="100" step="1" placeholder="To (optional)" data-i18n-placeholder="filaments.temperatureTo" aria-label="Cooling fan upper value" class="fm-input" /></div><span>%</span></div></div>
            <div data-dirty-key="max_volumetric_speed_mm3_s"><label for="max_volumetric_speed_mm3_s" class="fm-label" data-i18n="filaments.maxVolumetricSpeedLabel">Max volumetric speed</label><div class="filament-unit-input"><input type="number" id="max_volumetric_speed_mm3_s" name="max_volumetric_speed_mm3_s" step="0.1" class="fm-input" /><span>mm³/s</span></div></div>
            <div data-dirty-key="flow_ratio"><label for="flow_ratio" class="fm-label" data-i18n="filaments.flowRatio">Flow ratio</label><input type="number" id="flow_ratio" name="flow_ratio" step="0.001" class="fm-input" /></div>
            <div data-dirty-key="pressure_advance_k"><label for="pressure_advance_k" class="fm-label" data-i18n="filaments.pressureAdvance">Pressure advance (K)</label><input type="number" id="pressure_advance_k" name="pressure_advance_k" step="0.001" class="fm-input" /></div>
          </div>
        </section>

        <section class="fm-card filament-spec-card" data-filament-section="compatibilitySources">
          <h2 class="filament-spec-title" data-i18n="filaments.compatibilitySources">Compatibility &amp; sources</h2>
          <div class="filament-form-section-body">
            <div data-dirty-key="ams_compatibility"><label for="ams_compatibility" class="fm-label" data-i18n="filaments.amsCompatibility">AMS compatibility</label><input id="ams_compatibility" name="ams_compatibility" placeholder="AMS, AMS 2 Pro" class="fm-input" /></div>
            <div data-dirty-key="build_plate_compatibility"><label for="build_plate_compatibility" class="fm-label" data-i18n="filaments.buildPlateCompatibility">Build plate compatibility</label><input id="build_plate_compatibility" name="build_plate_compatibility" placeholder="Textured PEI, Smooth PEI" class="fm-input" /></div>
            <div data-dirty-key="manufacturer_sku"><label for="manufacturer_sku" class="fm-label" data-i18n="filaments.manufacturerSku">Manufacturer SKU</label><input id="manufacturer_sku" name="manufacturer_sku" class="fm-input" /></div>
            <div data-dirty-key="shop_url"><label for="shop_url" class="fm-label" data-i18n="filaments.shopUrl">Product / Purchase URL</label><input type="url" id="shop_url" name="shop_url" placeholder="e.g. https://shop.example.com/filament" data-i18n-placeholder="filaments.shopUrlPlaceholder" class="fm-input" /></div>
            <div data-dirty-key="datasheet_url"><label for="datasheet_url" class="fm-label" data-i18n="filaments.datasheetUrl">Datasheet URL</label><input type="url" id="datasheet_url" name="datasheet_url" class="fm-input" /></div>
            <div data-dirty-key="image_url"><label for="image_url" class="fm-label" data-i18n="filaments.imageUrl">Image URL</label><input type="url" id="image_url" name="image_url" class="fm-input" /></div>
          </div>
        </section>
      </div>

      <dialog id="filament-color-dialog" class="fm-modal-overlay filament-color-dialog-overlay" aria-labelledby="filament-color-dialog-title">
        <div class="fm-card filament-color-dialog">
          <div class="filament-color-dialog-header">
            <h2 id="filament-color-dialog-title" data-i18n="filaments.colorSelection">Color Selection</h2>
            <span id="filament-color-dialog-preview" class="filament-color-dialog-preview" hidden></span>
            <button id="filament-color-dialog-close" type="button" class="filament-color-dialog-close" aria-label="Close" data-i18n-aria-label="common.close">&times;</button>
          </div>
          <div class="filament-color-dialog-body">
            <div class="filament-color-meta-row">
              <div class="filament-color-meta-field" data-dirty-key="manufacturer_color_name">
                <label for="manufacturer_color_name" class="fm-label"><span data-i18n="filaments.manufacturerColorName">Manufacturer’s Color Name</span><span class="filament-optional" data-i18n="filaments.optional">optional</span></label>
                <input type="text" id="manufacturer_color_name" name="manufacturer_color_name" placeholder="e.g. Bambu Green, Jade White" data-i18n-placeholder="filaments.manufacturerColorNamePlaceholder" class="fm-input" />
              </div>
              <div class="filament-color-mode-group">
                <div class="filament-required-field filament-color-meta-field" data-dirty-key="color_mode">
                  <label class="fm-label"><span data-i18n="filaments.colorMode">Color Configuration</span> <span class="filament-required" aria-hidden="true">*</span></label>
                  <div class="filament-color-mode-options">
                    <label><input type="radio" name="color_mode" value="single" checked required /><span data-i18n="filaments.colorModeSingle">Single Color</span></label>
                    <label><input type="radio" name="color_mode" value="multi" /><span data-i18n="filaments.colorModeMulti">Multi Color</span></label>
                  </div>
                </div>
                <div id="multi-color-options" class="filament-required-field filament-color-meta-field" data-dirty-key="multi_color_style" hidden>
                  <label for="multi_color_style" class="fm-label"><span data-i18n="filaments.multiColorStyle">Multi-Color Pattern</span> <span class="filament-required" aria-hidden="true">*</span></label>
                  <select id="multi_color_style" name="multi_color_style" class="fm-select" required disabled><option value="striped" data-i18n="filaments.styleStriped">Striped</option><option value="gradient" data-i18n="filaments.styleGradient">Gradient</option></select>
                </div>
              </div>
            </div>
            <div class="filament-color-picker filament-required-field" data-dirty-key="colors">
              <div id="existing-color-picker" class="filament-existing-color-picker">
                <div class="filament-color-picker-heading">
                  <h3><span id="color-selection-title" data-i18n="filaments.selectExistingFilamentColor">Select Existing Filament Color</span></h3>
                  <span id="color-hint" class="filament-optional" data-i18n="filaments.clickSelectionOrder" hidden>Click in selection order</span>
                </div>
                <div class="filament-color-search-row">
                  <input type="search" id="color-search" class="fm-input fm-header-filter-search" placeholder="Search color names..." data-i18n-placeholder="filaments.searchColorNames" aria-label="Search color names" data-i18n-aria-label="filaments.searchColorNames" />
                  <button type="button" id="color-filter-clear" class="fm-btn fm-btn-outline filament-color-toolbar-button" data-i18n="filaments.clearFilters">Clear Filters</button>
                </div>
                <div id="selected-colors"></div>
                <div class="filament-color-panel">
                  <div class="filament-color-action-row">
                    <div class="filament-color-sort-buttons" aria-label="Sort colors" data-i18n-aria-label="filaments.sortColors">
                      <button type="button" id="color-sort-name" class="filament-color-sort-button" data-direction="none"><span data-i18n="filaments.sortName">Name</span><span class="filament-color-sort-arrow" aria-hidden="true"></span></button>
                      <button type="button" id="color-sort-hex" class="filament-color-sort-button" data-direction="none"><span data-i18n="filaments.sortHex">Hex</span><span class="filament-color-sort-arrow" aria-hidden="true"></span></button>
                    </div>
                    <button type="button" id="color-filter-button" class="fm-btn fm-btn-outline filament-color-toolbar-button fm-header-filter-trigger" data-filter-sidecar aria-label="Visual Color Filter" data-i18n-aria-label="filaments.visualColorFilter"><span data-i18n="filaments.visualColorFilter">Visual Color Filter</span></button>
                    <label class="fm-header-filter-grid-toggle"><input id="color-list-toggle" type="checkbox" role="switch" aria-label="Color list" data-i18n-aria-label="filters.colorList" /><span class="fm-header-filter-grid-toggle-track" aria-hidden="true"></span><span data-i18n="filters.colorList">Color list</span></label>
                  </div>
                  <div id="color-grid" class="fm-color-grid"><p data-i18n="common.loading">Loading...</p></div>
                </div>
              </div>
              <InlineColorEditor />
            </div>
          </div>
          <div class="filament-color-dialog-actions">
            <button id="filament-color-dialog-done" type="button" class="fm-btn fm-btn-primary" data-i18n="common.close">Close</button>
          </div>
        </div>
      </dialog>

      <!-- System Fields -->
      <div id="system-fields-container" class="fm-card filament-extra-fields-card" data-dirty-key="custom_fields" style="display: none;">
        <h3 class="fm-label" style="font-size: 1rem; margin-bottom: 12px;" data-i18n="common.systemFields">System Fields</h3>
        <div id="system-fields-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <!-- Dynamic system fields go here -->
        </div>
      </div>

      <!-- Custom Fields -->
      <div id="filament-custom-fields-card" class="fm-card filament-extra-fields-card" data-dirty-key="custom_fields">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <label class="fm-label" style="margin: 0;" data-i18n="filaments.specificExtraFields">Filament-specific extra fields</label>
          <button type="button" id="btn-add-field" class="fm-btn fm-btn-outline" style="font-size: 0.8rem; padding: 4px 10px;">
            + <span data-i18n="common.add">Add</span>
          </button>
        </div>
        <p style="margin: -4px 0 12px; color: var(--text-muted); font-size: 0.82rem;">
          <span data-i18n="filaments.specificExtraFieldsHelp">These typed fields apply only to this filament.</span>
          <a href="/admin/extra-fields" style="color: var(--accent);" data-i18n="filaments.manageSystemExtraFields">Create/Manage cross-filament System Extra Fields here</a>
        </p>
        <div id="custom-fields-container" style="display: grid; gap: 8px;">
          <!-- Dynamic fields go here -->
        </div>
      </div>

      <div id="error-message" class="fm-alert-error hidden"></div>

    </form>

<style>
  .filament-editor-form { display: grid; gap: 12px; }
  .filament-editor-hero { margin-bottom: 0; overflow: visible; }
  .filament-editor-hero::before { border-radius: inherit; }
  .filament-editor-heading { min-width: 0; }
  .filament-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .filament-editor-manufacturer {
    position: relative;
    display: grid;
    grid-template-columns: minmax(12rem, 22rem) minmax(16rem, 1fr);
    gap: 12px;
    align-items: stretch;
    width: min(55rem, calc(100vw - 10rem));
    max-width: 100%;
    margin: 5px 0 10px;
  }
  .filament-manufacturer-field { min-width: 0; }
  .filament-search-scope-control {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 6px;
    align-items: center;
    margin: 4px 2px 0;
    color: var(--text-muted);
    font-size: .68rem;
  }
