---
import type { HTMLAttributes } from 'astro/types'
import InlineColorEditor from './InlineColorEditor.astro'
import { filamentSections } from '../lib/filament-fields'
import { t } from '../lib/i18n'

interface Props {
  mode: 'create' | 'edit'
}

const { mode } = Astro.props
type InputAttributes = HTMLAttributes<'input'>
---

    <form id="filament-form" class="filament-editor-form">
      <header id="filament-editor-hero" class="filament-hero filament-editor-hero">
        <div class="filament-hero-layout">
          <div class="filament-editor-heading">
            <h1 id="filament-editor-title" data-i18n={mode === 'create' ? 'filaments.newFilament' : 'filaments.editFilament'}>
              {mode === 'create' ? 'Create New Filament' : 'Edit Filament'}
            </h1>
            <div class="filament-editor-manufacturer">
              <div class="filament-manufacturer-field" data-dirty-key="manufacturer_id">
                <label for="manufacturer_id" class="filament-sr-only" data-i18n="filaments.manufacturer">Manufacturer *</label>
                <select id="manufacturer_id" name="manufacturer_id" required class="filament-manufacturer-select" aria-label="Manufacturer" data-i18n-aria-label="filaments.manufacturer">
                  <option value="" data-i18n="filaments.selectManufacturer">Select manufacturer...</option>
                </select>
                <div class="filament-search-scope-control">
                  <span id="fil-search-scope-hint"></span>
                  <label>
                    <span data-i18n="filamentdbLookup.searchAction">search</span>
                    <input id="fil-search-all-manufacturers" type="checkbox" aria-label="Search all manufacturers" data-i18n-aria-label="filamentdbLookup.searchAllManufacturers" />
                  </label>
                </div>
              </div>
              <div id="fil-fdb-section" style="display: none;">
                <div id="fil-lookup-heading" class="filament-lookup-heading"></div>
                <div id="fil-lookup-container"></div>
                <div id="fil-lookup-toast" class="fdb-toast" style="display: none;"></div>
              </div>
            </div>
            <div class="filament-hero-meta">
              <span id="filament-editor-type" class="filament-pill">—</span>
            </div>
            <button id="filament-color-launcher" class="filament-color-editor-button" type="button" aria-label="Edit colors" data-i18n-aria-label="filaments.editColors">
              <span id="filament-editor-color-swatch" class="filament-color-dot"></span>
              <code id="filament-editor-color-name" class="filament-color-name" data-i18n="filaments.chooseColors">Choose colors</code>
              <span class="filament-color-edit-icon" aria-hidden="true">✎</span>
            </button>
          </div>
        </div>
      </header>
      <p class="filament-required-legend"><span class="filament-required" aria-hidden="true">*</span> <span data-i18n="filaments.requiredFieldsLegend">Required</span></p>
      <div class="filament-form-sections">
        {filamentSections.map(section => (
          <section class:list={['fm-card', 'filament-spec-card', { 'filament-form-primary-section': section.key === 'material' }]} data-filament-section={section.key}>
            <h2 class="filament-spec-title" data-i18n={section.titleKey}>{t(section.titleKey)}</h2>
            <div class="filament-form-section-body">
              {section.key === 'spool' && <div id="filament-spool-profile" class="filament-spool-profile" hidden data-dirty-key="filamentdb_spool_profile_id filamentdb_spool_image_file">
                <div class="spool-profile-heading"><span class="fm-label" data-i18n="filamentdbLookup.spoolType">Spool type</span><button type="button" class="fm-btn spool-profile-choose" aria-expanded="false" aria-controls="filament-spool-profile-lookup" data-i18n="filamentdbLookup.chooseSpoolType">Choose spool type</button></div>
                <div class="spool-profile-summary"><span role="status" aria-live="polite"></span><span class="spool-profile-preview"></span><button type="button" class="fm-btn spool-profile-clear" hidden data-i18n="filamentdbLookup.matchSpoolType">Match entered values</button></div>
                <div id="filament-spool-profile-lookup" class="spool-profile-lookup" hidden></div>
              </div>}

              {section.fields.map(field => {
                const id = field.id ?? field.key
                const Tag = field.kind === 'checkbox' ? 'label' : 'div'
                const attributes: InputAttributes = {
                  id, name: id,
                  type: field.kind === 'number' || field.kind === 'url' ? field.kind : 'text',
                  class: 'fm-input', required: field.required, step: field.step,
                  min: field.min, max: field.max, maxlength: field.maxLength,
                  value: field.defaultValue,
                  placeholder: field.placeholderKey ? t(field.placeholderKey) : field.placeholder,
                  'data-i18n-placeholder': field.placeholderKey,
                  style: field.key === 'price_currency' ? 'text-transform: uppercase;' : undefined,
                }
                return (
                  <Tag class:list={{ 'filament-required-field': field.required, 'filament-form-wide': field.key === 'designation', 'filament-form-check': field.kind === 'checkbox', 'filament-form-number': field.kind === 'number' || field.kind === 'range' }} data-dirty-key={field.key}>
                    {field.kind === 'checkbox' ? (
                      <><input id={id} name={id} type="checkbox" class="fm-checkbox" /><span data-i18n={field.labelKey}>{t(field.labelKey)}</span></>
                    ) : (
                      <>
                        <label for={field.kind === 'range' ? field.rangePrefix + '_value' : id} class="fm-label">
                          <span data-i18n={field.labelKey}>{t(field.labelKey)}</span>
                          {field.required && <span class="filament-required" aria-hidden="true">*</span>}
                        </label>
                        {field.kind === 'material' ? (
                          <>
                            <select id={id} name={id} required={field.required} class="fm-select"><option value="" data-i18n="filaments.selectType">{t('filaments.selectType')}</option></select>
                            <div id="custom-type-wrapper" class="filament-required-field hidden" style="margin-top: 8px;">
                              <label for="custom_type" class="fm-label"><span data-i18n="filaments.customTypeLabel">{t('filaments.customTypeLabel')}</span> <span class="filament-required" aria-hidden="true">*</span></label>
                              <input type="text" id="custom_type" name="custom_type" placeholder={t('filaments.customTypePlaceholder')} data-i18n-placeholder="filaments.customTypePlaceholder" class="fm-input" maxlength="50" style="text-transform: uppercase;" />
                            </div>
                          </>
                        ) : field.kind === 'select' ? (
                          <select id={id} name={id} class="fm-select">
                            <option value="">-</option>
                            {field.options?.map(([value, labelKey]) => <option value={value} data-i18n={labelKey}>{t(labelKey)}</option>)}
                          </select>
                        ) : field.kind === 'range' ? (
                          <div class="filament-unit-input">
                            <div class="filament-range-inputs">
                              <input id={field.rangePrefix + '_value'} type="number" step="any" min={field.min} max={field.max} placeholder={t('filaments.temperatureValue')} data-i18n-placeholder="filaments.temperatureValue" aria-label={field.rangeLabel + ' value'} class="fm-input" />
                              <input id={field.rangePrefix + '_to'} type="number" step="any" min={field.min} max={field.max} placeholder={t('filaments.temperatureTo')} data-i18n-placeholder="filaments.temperatureTo" aria-label={field.rangeLabel + ' upper value'} class="fm-input" />
                            </div>
                            <span>{field.unit}</span>
                          </div>
                        ) : field.unit ? (
                          <div class="filament-unit-input"><input {...attributes} /><span>{field.unit}</span></div>
                        ) : <input {...attributes} />}
                      </>
                    )}
                  </Tag>
                )
              })}
            </div>
          </section>
        ))}
      </div>

      <dialog id="filament-color-dialog" class="fm-modal-overlay filament-color-dialog-overlay" aria-labelledby="filament-color-dialog-title">
        <div class="fm-card filament-color-dialog">
          <div class="filament-color-dialog-header">
            <h2 id="filament-color-dialog-title" data-i18n="filaments.colorSelection">Color Selection</h2>
            <span id="filament-color-dialog-preview" class="filament-color-dialog-preview" hidden></span>
            <button id="filament-color-dialog-close" type="button" class="filament-color-dialog-close" aria-label="Close" data-i18n-aria-label="common.close">&times;</button>
          </div>
          <div class="filament-color-dialog-body">
            <div class="filament-color-meta-row">
              <div class="filament-color-meta-field" data-dirty-key="manufacturer_color_name">
                <label for="manufacturer_color_name" class="fm-label"><span data-i18n="filaments.manufacturerColorName">Manufacturer’s Color Name</span><span class="filament-optional" data-i18n="filaments.optional">optional</span></label>
                <input type="text" id="manufacturer_color_name" name="manufacturer_color_name" placeholder="e.g. Bambu Green, Jade White" data-i18n-placeholder="filaments.manufacturerColorNamePlaceholder" class="fm-input" />
              </div>
              <div class="filament-color-mode-group">
                <div class="filament-required-field filament-color-meta-field" data-dirty-key="color_mode">
                  <label class="fm-label"><span data-i18n="filaments.colorMode">Color Configuration</span> <span class="filament-required" aria-hidden="true">*</span></label>
                  <div class="filament-color-mode-options">
                    <label><input type="radio" name="color_mode" value="single" checked required /><span data-i18n="filaments.colorModeSingle">Single Color</span></label>
                    <label><input type="radio" name="color_mode" value="multi" /><span data-i18n="filaments.colorModeMulti">Multi Color</span></label>
                  </div>
                </div>
                <div id="multi-color-options" class="filament-required-field filament-color-meta-field" data-dirty-key="multi_color_style" hidden>
                  <label for="multi_color_style" class="fm-label"><span data-i18n="filaments.multiColorStyle">Multi-Color Pattern</span> <span class="filament-required" aria-hidden="true">*</span></label>
                  <select id="multi_color_style" name="multi_color_style" class="fm-select" required disabled><option value="striped" data-i18n="filaments.styleStriped">Striped</option><option value="gradient" data-i18n="filaments.styleGradient">Gradient</option></select>
                </div>
              </div>
            </div>
            <div class="filament-color-picker filament-required-field" data-dirty-key="colors">
              <div id="existing-color-picker" class="filament-existing-color-picker">
                <div class="filament-color-picker-heading">
                  <h3><span id="color-selection-title" data-i18n="filaments.selectExistingFilamentColor">Select Existing Filament Color</span></h3>
                  <span id="color-hint" class="filament-optional" data-i18n="filaments.clickSelectionOrder" hidden>Click in selection order</span>
                </div>
                <div class="filament-color-search-row">
                  <input type="search" id="color-search" class="fm-input fm-header-filter-search" placeholder="Search color names..." data-i18n-placeholder="filaments.searchColorNames" aria-label="Search color names" data-i18n-aria-label="filaments.searchColorNames" />
                  <button type="button" id="color-filter-clear" class="fm-btn fm-btn-outline filament-color-toolbar-button" data-i18n="filaments.clearFilters">Clear Filters</button>
                </div>
                <div class="filament-color-panel">
                  <div class="filament-color-action-row">
                    <div class="filament-color-sort-buttons" aria-label="Sort colors" data-i18n-aria-label="filaments.sortColors">
                      <button type="button" id="color-sort-name" class="filament-color-sort-button" data-direction="none"><span data-i18n="filaments.sortName">Name</span><span class="filament-color-sort-arrow" aria-hidden="true"></span></button>
                      <button type="button" id="color-sort-hex" class="filament-color-sort-button" data-direction="none"><span data-i18n="filaments.sortHex">Hex</span><span class="filament-color-sort-arrow" aria-hidden="true"></span></button>
                    </div>
                    <button type="button" id="color-filter-button" class="fm-btn fm-btn-outline filament-color-toolbar-button fm-header-filter-trigger" data-filter-sidecar aria-label="Visual Color Filter" data-i18n-aria-label="filaments.visualColorFilter"><span data-i18n="filaments.visualColorFilter">Visual Color Filter</span></button>
                    <label class="fm-header-filter-grid-toggle"><input id="color-list-toggle" type="checkbox" role="switch" aria-label="Color list" data-i18n-aria-label="filters.colorList" /><span class="fm-header-filter-grid-toggle-track" aria-hidden="true"></span><span data-i18n="filters.colorList">Color list</span></label>
                  </div>
                  <div id="color-grid" class="fm-color-grid"><p data-i18n="common.loading">Loading...</p></div>
                </div>
              </div>
              <InlineColorEditor />
            </div>
          </div>
          <div class="filament-color-dialog-actions">
            <button id="filament-color-dialog-done" type="button" class="fm-btn fm-btn-primary" data-i18n="common.close">Close</button>
          </div>
        </div>
      </dialog>

      <!-- System Fields -->
      <div id="system-fields-container" class="fm-card filament-extra-fields-card" data-dirty-key="system_fields" style="display: none;">
        <h3 class="fm-label" style="font-size: 1rem; margin-bottom: 12px;" data-i18n="common.systemFields">System Fields</h3>
        <div id="system-fields-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <!-- Dynamic system fields go here -->
        </div>
      </div>

      <!-- Custom Fields -->
      <div id="filament-custom-fields-card" class="fm-card filament-extra-fields-card" data-dirty-key="entity_fields">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <label class="fm-label" style="margin: 0;" data-i18n="filaments.specificExtraFields">Filament-specific extra fields</label>
          <button type="button" id="btn-add-field" class="fm-btn fm-btn-outline" style="font-size: 0.8rem; padding: 4px 10px;">
            + <span data-i18n="common.add">Add</span>
          </button>
        </div>
        <p style="margin: -4px 0 12px; color: var(--text-muted); font-size: 0.82rem;">
          <span data-i18n="filaments.specificExtraFieldsHelp">These typed fields apply only to this filament.</span>
          <a href="/admin/extra-fields" style="color: var(--accent);" data-i18n="filaments.manageSystemExtraFields">Create/Manage cross-filament System Extra Fields here</a>
        </p>
        <div id="custom-fields-container" style="display: grid; gap: 8px;">
          <!-- Dynamic fields go here -->
        </div>
      </div>

      <div id="error-message" class="fm-alert-error hidden"></div>

    </form>

<style>
  .filament-editor-form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .filament-editor-hero { margin-bottom: 0; overflow: visible; }
  .filament-editor-hero::before { border-radius: inherit; }
  .filament-editor-heading { min-width: 0; }
  .filament-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .filament-editor-manufacturer {
    position: relative;
    display: grid;
    grid-template-columns: minmax(12rem, 22rem) minmax(16rem, 1fr);
    gap: 12px;
    align-items: stretch;
    width: min(55rem, calc(100vw - 10rem));
    max-width: 100%;
    margin: 5px 0 10px;
  }
  .filament-manufacturer-field { min-width: 0; }
  .filament-search-scope-control {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 6px;
    align-items: center;
    margin: 4px 2px 0;
    color: var(--text-muted);
    font-size: .68rem;
  }
  .filament-search-scope-control label { display: inline-flex; gap: 4px; align-items: center; font: inherit; color: inherit; cursor: pointer; }
  .filament-search-scope-control input { width: .8rem; height: .8rem; margin: 0; accent-color: var(--accent); }
  .filament-manufacturer-select {
    width: 100%;
    min-height: 32px;
    padding: 4px 34px 4px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--input-bg);
    color: var(--text-muted);
    font: 600 .82rem/1.2 var(--font-sans);
    cursor: pointer;
  }
  .filament-manufacturer-select:hover,
  .filament-manufacturer-select:focus { border-color: var(--accent); outline: none; color: var(--text); }
  #fil-fdb-section {
    position: absolute;
    top: 0;
    left: calc(22rem + 12px);
    z-index: 2;
    width: calc(100% - 22rem - 12px);
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }

  .filament-color-editor-button {
    display: inline-grid;
    grid-template-columns: auto minmax(0, auto) auto;
    gap: 9px;
    align-items: center;
    max-width: min(460px, 70vw);
    margin-top: 10px;
    padding: 5px 8px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 74%, transparent);
    color: var(--text);
    cursor: pointer;
    text-align: left;
  }

  .filament-color-editor-button:hover,
  .filament-color-editor-button:focus-visible { border-color: var(--accent); outline: none; }
  .filament-color-editor-button.is-dirty {
    border-color: color-mix(in srgb, var(--accent) 65%, transparent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .filament-color-editor-button .filament-color-dot {
    width: min(180px, 28vw);
    background-image: conic-gradient(#d1d5db 25%, #fff 0 50%, #d1d5db 0 75%, #fff 0);
    background-size: 8px 8px;
    background-clip: padding-box;
  }
  .filament-color-editor-button .filament-color-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .filament-color-edit-icon {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--accent);
    font-size: .85rem;
  }

  .filament-form-sections {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
  }
  .filament-form-section-body { display: grid; gap: 0; padding: 4px 16px; }
  .filament-form-section-body > [data-dirty-key] {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(7rem, 13rem);
    gap: 12px;
    align-items: center;
    min-height: 40px;
    padding: 3px 0;
    border-bottom: 1px solid var(--border);
  }
  .filament-form-section-body > .filament-spool-profile { display: block; }
  .filament-form-section-body > [data-dirty-key]:last-child { border-bottom: 0; }
  .filament-form-section-body .fm-label { margin: 0; font-size: .8rem; }
  .filament-required { color: var(--error-text); }
  .filament-required-legend { margin: 0 0 6px; color: var(--text-muted); font-size: .72rem; }
  .filament-required-field:has(> :is(input, select, textarea):required:valid) > .fm-label .filament-required,
  .filament-required-field:has(> .filament-unit-input :required:valid) > .fm-label .filament-required,
  .filament-required-field:has(> .filament-color-mode-options :required:valid) > .fm-label .filament-required { display: none; }
  #custom-type-wrapper { grid-column: 1 / -1; }
  #custom-type-wrapper {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(7rem, 13rem);
    gap: 12px;
    align-items: center;
  }
  #custom-type-wrapper.hidden { display: none; }
  :global(#filament-form .filament-form-section-body .fm-input),
  :global(#filament-form .filament-form-section-body .fm-select) {
    height: 30px;
    min-height: 30px;
    padding: 3px 7px;
    font-size: .78rem;
  }
  :global(#filament-form .filament-form-section-body .fm-input::placeholder) {
    color: var(--text-muted);
    opacity: .56;
    font-weight: 400;
  }
  :global(#filament-form input[type="number"]) { appearance: textfield; -moz-appearance: textfield; }
  :global(#filament-form input[type="number"]::-webkit-inner-spin-button),
  :global(#filament-form input[type="number"]::-webkit-outer-spin-button) { margin: 0; appearance: none; }

  .filament-form-check { grid-template-columns: minmax(0, 1fr) auto !important; cursor: pointer; }
  .filament-form-check input { grid-column: 2; grid-row: 1; }
  .filament-form-check span { grid-column: 1; grid-row: 1; font-size: .8rem; }
  .filament-range-inputs { display: grid; grid-template-columns: repeat(2, minmax(5.5ch, 1fr)); gap: 6px; min-width: 0; }
  .filament-unit-input { display: flex; align-items: stretch; gap: 6px; min-width: 0; }
  .filament-unit-input > :first-child { flex: 1 1 auto; min-width: 0; }
  .filament-unit-input > input[type="number"] { min-width: 5.5ch; }
  .filament-unit-input > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    padding: 0 5px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--text-muted);
    font-size: .75rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .filament-form-section-body > .filament-form-number {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
  }
  .filament-form-number > .fm-label { flex: 1 1 8rem; }
  .filament-form-number > .filament-unit-input { flex: 0 0 auto; margin-left: auto; }
  .filament-form-number input[type="number"] { flex: 0 0 auto; width: calc(8ch + 16px); text-align: right; }
  .filament-form-number > input[type="number"] { margin-left: auto; }
  .filament-range-inputs input[type="number"] { width: calc(6ch + 16px); }

  .filament-color-dialog-overlay { padding: 16px; }
  .filament-color-dialog-overlay .filament-color-dialog {
    width: min(600px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }
  .filament-color-dialog-header,
  .filament-color-dialog-actions {
    position: sticky;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 14px 18px;
    background: var(--bg-elevated);
  }
  .filament-color-dialog-header { top: 0; border-bottom: 1px solid var(--border); }
  .filament-color-dialog-header h2 { margin: 0; font-size: 1.05rem; }
  .filament-color-dialog-preview {
    width: min(180px, 32vw);
    height: 28px;
    margin-left: 4px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text) 22%, transparent);
    border-radius: 999px;
  }
  .filament-color-dialog-close {
    margin-left: auto;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    font-size: 1.3rem;
  }
  .filament-color-dialog-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding: 16px 18px;
  }
  .filament-color-meta-row {
    display: grid;
    grid-template-columns: minmax(205px, .8fr) minmax(325px, 1.2fr);
    gap: 14px;
    min-width: 560px;
    overflow-x: auto;
  }
  .filament-color-meta-row > [data-dirty-key],
