---
import ColorEditorFields from './ColorEditorFields.astro'
---

<details id="new-color-disclosure" class="fm-inline-color-disclosure">
  <summary data-i18n="filaments.addColorToLibrary">Add new color to library</summary>
  <div id="new-color-form" class="fm-inline-color-form">
    <ColorEditorFields idPrefix="new-color" defaultHex="#FF0000" disabled />

    <div class="fm-inline-color-actions">
      <button
        type="button"
        id="btn-save-new-color"
        class="fm-btn fm-btn-primary"
        style="font-size: 0.8rem; padding: 8px 14px;"
        data-i18n="filaments.saveColor"
      >
        Save Color
      </button>
    </div>
  </div>
</details>
