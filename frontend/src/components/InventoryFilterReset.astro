---
interface Props { scope: 'all' | 'columns' }
const { scope } = Astro.props
const all = scope === 'all'
const label = all ? 'Clear all filters' : 'Clear column filters'
const labelKey = all ? 'common.clearAllFilters' : 'common.clearColumnFilters'
---

<button
  id={all ? 'filter-clear' : 'filter-clear-columns'}
  type="button"
  class="fm-btn fm-btn-outline fm-filter-reset"
  data-filter-reset
  aria-label={label}
  title={label}
  data-i18n-aria-label={labelKey}
  data-i18n-title={labelKey}
  hidden
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 4h18l-7 8v2M10 18v-6L3 4m13 12 5 5m0-5-5 5" />
  </svg>
  {all && <span data-i18n={labelKey}>{label}</span>}
</button>
