---
interface Props {
  backHref?: string
  backLabel: string
  backLabelId?: string
  backI18n?: string
  standardLabel?: string
  standardI18n?: string
  designerLabel?: string
  designerI18n?: string
  sheetsLabel?: string
  sheetsI18n?: string
}

const {
  backHref,
  backLabel,
  backLabelId,
  backI18n,
  standardLabel = 'Standard Label',
  standardI18n,
  designerLabel = 'Label Designer',
  designerI18n,
  sheetsLabel = 'Label Sheets',
  sheetsI18n = 'labelPrint.labelSheets',
} = Astro.props
---

<aside class="print-sidebar" style="--designer-sidebar-width: 360px">
  <div class="print-sidebar-scroll">
    <a id="btn-back" href={backHref} class="sidebar-header back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      <span id={backLabelId} data-i18n={backI18n}>{backLabel}</span>
    </a>

    <div class="tab-nav" role="tablist" aria-label="Label workspace" data-i18n-aria-label="labelPrint.workspaceTabs">
      <button type="button" role="tab" aria-selected="true" aria-controls="tab-panel-print" tabindex="0" class="tab-btn active" id="tab-btn-print" data-tab="print" data-workspace-mode="standard" data-i18n={standardI18n}>{standardLabel}</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-designer-v2" tabindex="-1" class="tab-btn" id="tab-btn-designer" data-tab="designer" data-workspace-mode="designer" data-i18n={designerI18n}>{designerLabel}</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-sheets" tabindex="-1" class="tab-btn" id="tab-btn-sheets" data-tab="print" data-workspace-mode="sheets" data-i18n={sheetsI18n}>{sheetsLabel}</button>
    </div>

    <slot />
  </div>

  <slot name="footer" />
</aside>
