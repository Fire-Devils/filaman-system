---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="FilaMan - Manufacturers">
  <style>
    .sortable { cursor: pointer; user-select: none; }
    .sortable:hover { background: var(--bg-hover); }
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 16px;
      align-items: center;
    }
    .filter-bar .fm-input-search {
      flex: 1;
      min-width: 200px;
      max-width: 400px;
    }
  </style>
  <style is:global>
    .pagination-container { display: flex; justify-content: space-between; align-items: center; }
    .pagination-pages { display: flex; gap: 4px; align-items: center; font-size: 0.8rem; }
    .pagination-pages a { color: var(--accent); cursor: pointer; padding: 2px 6px; text-decoration: none; border-radius: 3px; }
    .pagination-pages a:hover { text-decoration: underline; background: color-mix(in srgb, var(--accent) 10%, transparent); }
    .pagination-pages .page-current { font-weight: 700; color: var(--accent); padding: 2px 8px; background: color-mix(in srgb, var(--accent) 15%, transparent); border-radius: 3px; }
    .pagination-pages .page-ellipsis { color: var(--text-muted); padding: 0 2px; }
  </style>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="font-size: 1.8rem; font-weight: 700;" data-i18n="manufacturers.title">Manufacturers</h1>
    <button id="btn-new" class="fm-btn fm-btn-primary" data-i18n="manufacturers.addManufacturer">
      Add Manufacturer
    </button>
  </div>

  <div class="filter-bar">
    <div class="fm-filter-search-wrap">
      <input
        type="text"
        id="filter-search"
        class="fm-input fm-input-search"
        data-i18n-placeholder="manufacturers.searchPlaceholder"
        placeholder="Search manufacturers..."
      />
      <button id="filter-search-clear" class="fm-filter-search-clear" type="button" aria-label="Clear search" title="Clear search" data-i18n-aria-label="common.clearSearch" data-i18n-title="common.clearSearch">&times;</button>
    </div>
    <button id="filter-clear-columns" class="fm-btn fm-btn-outline" type="button" data-i18n="common.clearColumnFilters">Clear column filters</button>
    <button id="filter-clear" class="fm-btn fm-btn-outline" type="button" data-i18n="common.clearAllFilters">Clear all filters</button>
  </div>

  <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
    <div class="pagination-container" id="pagination-top" style="flex: 1;"></div>
    <div class="col-picker-wrap">
      <button id="btn-columns" class="fm-btn fm-btn-outline" style="padding: 5px 10px; font-size: 0.8rem; display: flex; align-items: center; gap: 5px; white-space: nowrap;">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
        <span data-i18n="common.columns">Spalten</span>
      </button>
      <div id="columns-dropdown" class="col-picker-dropdown"></div>
    </div>
  </div>

  <div class="fm-card" style="padding: 0;">
    <table class="fm-table">
      <thead>
        <tr>
          <th data-i18n="manufacturers.name" data-sort="name" class="sortable col-name">Name</th>
          <th data-i18n="manufacturers.logo" class="col-logo" style="min-width: 114px;">Logo</th>
          <th data-i18n="manufacturers.url" data-sort="url" class="sortable col-url">URL</th>
          <th data-i18n="manufacturers.filaments" data-sort="filament_count" class="sortable col-filaments">Filaments</th>
          <th data-i18n="manufacturers.spools" data-sort="spool_count" class="sortable col-spools">Spools</th>
          <th data-i18n="manufacturers.materials" data-sort="materials" class="sortable col-materials">Materials</th>
          <th data-i18n="manufacturers.colTotalPrice" data-sort="total_price_available" class="sortable col-total_price">Total Value</th>
          <th data-i18n="manufacturers.colArchived" data-sort="archived_spool_count" class="sortable col-archived">Archived</th>
          <th data-i18n="manufacturers.colSpoolWeight" data-sort="empty_spool_weight_g" class="sortable col-spool_weight">Spool Weight</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="manufacturers-table">
        <tr>
          <td colspan="10" style="text-align: center; color: var(--text-muted); padding: 24px;" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="pagination-container" id="pagination" style="margin-top: 16px;"></div>

  <!-- Info Modal -->
  <div id="info-modal-container" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 50;">
    <div class="fm-card" style="width: 100%; max-width: 480px; margin: 16px;">
      <h3 id="info-modal-title" style="font-size: 1.1rem; font-weight: 600; margin-bottom: 16px;">Manufacturer Details</h3>
      <div id="info-modal-content" style="display: grid; gap: 12px;">
        <!-- Filled via JS -->
      </div>
      <div style="margin-top: 24px;">
        <button type="button" id="info-modal-close" class="fm-btn fm-btn-outline" style="width: 100%;" data-i18n="common.close">
          Close
        </button>
      </div>
    </div>
  </div>

  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { cachedFetchAllPages, invalidateCachePrefix, CACHE_KEYS } from '../../lib/cache'
    import { formatPrice, getCurrency, initCurrency } from '../../lib/format'
    import { initColumnPicker, type ColumnGroup } from '../../lib/column-picker'
    import { initColumnReorder } from '../../lib/column-reorder'
    import { initColumnResize } from '../../lib/column-resize'
    import {
      bindTableFilterControls,
      initHeaderColumnFilters,
      isColumnFilterActive,
      matchesColumnFilter,
      multiColumnFilter,
      syncHeaderSortButtons,
      type ColumnFilterValue,
      type HeaderFilterController,
      type HeaderFilterOption,
    } from '../../lib/table-column-filters'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { checkFilamentDbActive } from '../../lib/filamentdb-lookup'
    import { createManufacturerDialog } from '../../lib/manufacturer-dialog'
    await initI18n()
    await initCurrency()

    const filamentDbActive = await checkFilamentDbActive()
    const manufacturerDialog = createManufacturerDialog({
      filamentDbActive,
      onSaved: () => loadManufacturers(),
    })

    let manufacturers: any[] = []
    let sortKey: string | null = 'name'
    let sortDirection: 'asc' | 'desc' | null = 'asc'

    // Restore sort state from localStorage
    try {
      const savedSort = localStorage.getItem('filaman-sort-manufacturers')
      if (savedSort) {
        const { key, direction } = JSON.parse(savedSort)
        if (key && (direction === 'asc' || direction === 'desc')) {
          sortKey = key
          sortDirection = direction
        }
      }
    } catch { /* ignore invalid data */ }
    const allowedPageSizes = [25, 50, 100, 150, 200]
    let pageSize = (() => {
      try {
        const saved = parseInt(localStorage.getItem('filaman-pagesize-manufacturers') || '50', 10)
        return allowedPageSizes.includes(saved) ? saved : 50
      } catch { return 50 }
    })()
    let currentPage = 1
    let isInitialLoad = true
    let mfrHeaderFilters: HeaderFilterController | null = null

    let savedFilterState: { names?: string[], materials?: string[], columns?: Record<string, ColumnFilterValue> } | null = null
    try {
      const sf = localStorage.getItem('filaman-filters-manufacturers')
      if (sf) savedFilterState = JSON.parse(sf)
    } catch { /* ignore invalid data */ }
    let columnFilters: Record<string, ColumnFilterValue> = { ...(savedFilterState?.columns || {}) }
    if (!columnFilters.name) columnFilters.name = multiColumnFilter(savedFilterState?.names || [])
    if (!columnFilters.materials) columnFilters.materials = multiColumnFilter(savedFilterState?.materials || [])
    Object.keys(columnFilters).forEach((key) => {
      if (!isColumnFilterActive(columnFilters[key])) delete columnFilters[key]
    })

    // Restore page from localStorage
    try {
      const savedPage = localStorage.getItem('filaman-page-manufacturers')
      if (savedPage) currentPage = Math.max(1, parseInt(savedPage, 10) || 1)
    } catch {}

    function setupSortableHeaders() {
      const thead = document.querySelector('.fm-table thead')
      if (!thead) return
      thead.addEventListener('click', (e) => {
        const th = (e.target as HTMLElement).closest('th[data-sort]') as HTMLElement | null
        if (!th) return
        const key = th.dataset.sort!
        if (sortKey === key) {
          if (sortDirection === 'asc') sortDirection = 'desc'
          else if (sortDirection === 'desc') { sortKey = null; sortDirection = null }
          else sortDirection = 'asc'
        } else {
          sortKey = key
          sortDirection = 'asc'
        }
        updateSortIndicators()
        renderManufacturers()
        // Save sort state to localStorage
        if (sortKey && sortDirection) {
          localStorage.setItem('filaman-sort-manufacturers', JSON.stringify({ key: sortKey, direction: sortDirection }))
        } else {
          localStorage.removeItem('filaman-sort-manufacturers')
        }
      })
    }

    function updateSortIndicators() {
      document.querySelectorAll('th[data-sort]').forEach(th => {
        const key = (th as HTMLElement).dataset.sort!
        th.classList.remove('sort-asc', 'sort-desc')
        if (sortKey === key && sortDirection) {
          th.classList.add(sortDirection === 'asc' ? 'sort-asc' : 'sort-desc')
        }
      })
      const table = document.querySelector('.fm-table') as HTMLTableElement | null
      if (table) syncHeaderSortButtons(table, sortKey, sortDirection)
    }

    function getSortValue(item: any, key: string): any {
      if (key === 'materials') return item.material_types?.length ?? 0
      return item[key]
    }

    function sortManufacturers(items: any[]): any[] {
      if (!sortKey || !sortDirection) return items
      const sortBy = sortKey
      return [...items].sort((a, b) => {
        const aVal = getSortValue(a, sortBy) ?? ''
        const bVal = getSortValue(b, sortBy) ?? ''
        let cmp = 0
        if (typeof aVal === 'string') cmp = aVal.localeCompare(bVal)
        else cmp = aVal - bVal
        return sortDirection === 'asc' ? cmp : -cmp
      })
    }

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function getFilterValues() {
      const search = (document.getElementById('filter-search') as HTMLInputElement).value.toLowerCase().trim()
      return { search }
    }

    function filterManufacturers(items: any[]): any[] {
      const { search } = getFilterValues()
      const activeFilters = Object.entries(columnFilters).filter(([, value]) => isColumnFilterActive(value))

      return items.filter(mf => {
        if (!activeFilters.every(([key, filter]) => matchesColumnFilter(getManufacturerFilterValue(mf, key), filter))) return false

        // Text search across name, url, materials
        if (search) {
          const name = (mf.name || '').toLowerCase()
          const url = (mf.url || '').toLowerCase()
          const materials = (mf.materials || []).join(' ').toLowerCase()
          const haystack = `${name} ${url} ${materials}`
          if (!haystack.includes(search)) return false
        }

        return true
      })
    }

    function getManufacturerFilterValue(manufacturer: any, key: string): unknown {
      if (key === 'name') return manufacturer.name
      if (key === 'url') return manufacturer.url
      if (key === 'filaments') return manufacturer.filament_count
      if (key === 'spools') return manufacturer.spool_count
      if (key === 'materials') return manufacturer.materials || []
      if (key === 'total_price') return manufacturer.total_price_available
      if (key === 'archived') return manufacturer.archived_spool_count
      if (key === 'spool_weight') return manufacturer.empty_spool_weight_g
      return null
    }

    function updateHeaderFilterOptions(items: any[]) {
      const nameOptions: HeaderFilterOption[] = [...new Set(items.map((mf: any) => mf.name || '').filter(Boolean))]
        .sort((a, b) => a.localeCompare(b))
        .map((name) => ({ value: name, label: name }))
      const materials = new Set<string>()
      items.forEach(mf => {
        if (mf.materials) {
          mf.materials.forEach((m: string) => materials.add(m))
        }
      })
      const materialOptions: HeaderFilterOption[] = [...materials].sort().map((mat) => ({ value: mat, label: mat }))
      mfrHeaderFilters?.setOptions('name', nameOptions)
      mfrHeaderFilters?.setOptions('materials', materialOptions)
    }

    async function loadManufacturers() {
      try {
        const data = await cachedFetchAllPages(CACHE_KEYS.MANUFACTURERS, '/api/v1/manufacturers')
        manufacturers = data.items
        updateHeaderFilterOptions(manufacturers)
        if (isInitialLoad) {
          isInitialLoad = false
        } else {
          currentPage = 1
        }
        renderManufacturers()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load manufacturers:', error)
        document.getElementById('manufacturers-table')!.innerHTML = `
          <tr>
            <td colspan="10" style="text-align: center; color: var(--error-text); padding: 24px;">${t('manufacturers.failedLoad')}</td>
          </tr>
        `
      }
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div')
      div.textContent = str
      return div.innerHTML
    }

    function getPageNumbers(page: number, totalPages: number): (number | string)[] {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1)
      const pages = new Set([1, totalPages])
      for (let i = Math.max(2, page - 1); i <= Math.min(totalPages - 1, page + 1); i++) pages.add(i)
      const sorted = [...pages].sort((a, b) => a - b)
      const result: (number | string)[] = []
      sorted.forEach((p, i) => {
        if (i > 0 && p - sorted[i - 1] > 1) result.push('\u2026')
        result.push(p)
      })
      return result
    }

    function buildPaginationHtml(total: number, page: number): string {
      const totalPages = Math.ceil(total / pageSize)
      if (totalPages <= 1) {
        const pageSizeItems = allowedPageSizes.map(s => s === pageSize ? `<span class="page-current">${s}</span>` : `<a class="page-link page-size-link" data-size="${s}">${s}</a>`).join('')
        return `
          <div style="font-size: 0.8rem; color: var(--text-muted);">${t('manufacturers.manufacturerCount', { count: total })}</div>
          <div></div>
          <div class="pagination-pages">
            <span style="color: var(--text-muted);">${t('common.perPage')}:</span>
            ${pageSizeItems}
          </div>
        `
      }
      const pageNumbers = getPageNumbers(page, totalPages)
      const pageItems = pageNumbers.map(p => {
        if (p === '\u2026') return `<span class="page-ellipsis">\u2026</span>`
        if (p === page) return `<span class="page-current">${p}</span>`
        return `<a class="page-link" data-page="${p}">${p}</a>`
      }).join('')
      const pageSizeItems = allowedPageSizes.map(s => s === pageSize ? `<span class="page-current">${s}</span>` : `<a class="page-link page-size-link" data-size="${s}">${s}</a>`).join('')
      return `
        <div style="font-size: 0.8rem; color: var(--text-muted);">
          ${t('common.showing')} ${((page - 1) * pageSize) + 1}-${Math.min(page * pageSize, total)} ${t('common.of')} ${total}
        </div>
        <div class="pagination-pages">
          <span style="color: var(--text-muted);">${t('common.page')}:</span>
          ${page > 1 ? `<a class="page-link page-prev">\u2039</a>` : ''}
          ${pageItems}
          ${page < totalPages ? `<a class="page-link page-next">\u203A</a>` : ''}
        </div>
        <div class="pagination-pages">
          <span style="color: var(--text-muted);">${t('common.perPage')}:</span>
          ${pageSizeItems}
        </div>
      `
    }

    function renderPagination(total: number, page: number) {
      const totalPages = Math.ceil(total / pageSize)
      const html = buildPaginationHtml(total, page)
      document.getElementById('pagination-top')!.innerHTML = html
      document.getElementById('pagination')!.innerHTML = html

      document.querySelectorAll('.pagination-container').forEach(container => {
        container.querySelectorAll('.page-link[data-page]').forEach(link => {
          link.addEventListener('click', () => {
            currentPage = parseInt((link as HTMLElement).dataset.page!, 10)
            localStorage.setItem('filaman-page-manufacturers', String(currentPage))
            renderManufacturers()
          })
        })
        container.querySelector('.page-prev')?.addEventListener('click', () => {
          if (page > 1) {
            currentPage = page - 1
            localStorage.setItem('filaman-page-manufacturers', String(currentPage))
            renderManufacturers()
          }
        })
        container.querySelector('.page-next')?.addEventListener('click', () => {
          if (page < totalPages) {
            currentPage = page + 1
            localStorage.setItem('filaman-page-manufacturers', String(currentPage))
            renderManufacturers()
          }
        })
        container.querySelectorAll('.page-size-link').forEach(link => {
          link.addEventListener('click', () => {
            const newSize = parseInt((link as HTMLElement).dataset.size!, 10)
            if (allowedPageSizes.includes(newSize)) {
              pageSize = newSize
              localStorage.setItem('filaman-pagesize-manufacturers', String(newSize))
              currentPage = 1
              localStorage.setItem('filaman-page-manufacturers', '1')
              renderManufacturers()
            }
          })
        })
      })
    }
    function renderManufacturers() {
      const tbody = document.getElementById('manufacturers-table')!
      const filtered = filterManufacturers(manufacturers)
      const sorted = sortManufacturers(filtered)
      localStorage.setItem('filaman-filters-manufacturers', JSON.stringify({ columns: columnFilters }))

      // Validate current page
      const totalPages = Math.max(1, Math.ceil(sorted.length / pageSize))
      if (currentPage > totalPages) currentPage = totalPages

      if (sorted.length === 0) {
        const { search } = getFilterValues()
        const hasFilters = search || Object.values(columnFilters).some(isColumnFilterActive)
        tbody.innerHTML = `
          <tr>
            <td colspan="10" style="text-align: center; color: var(--text-muted); padding: 24px;">
              ${hasFilters ? t('manufacturers.noResults') : t('manufacturers.noManufacturers')}
            </td>
          </tr>
        `
        document.getElementById('pagination-top')!.innerHTML = ''
        document.getElementById('pagination')!.innerHTML = ''
        return
      }

      // Paginate
      const start = (currentPage - 1) * pageSize
      const paged = sorted.slice(start, start + pageSize)
      // Note: escapeHtml() is used for all user-supplied data; URLs use escapeHtml for both href and text
      tbody.innerHTML = paged.map(mf => `
        <tr style="cursor: pointer;" class="manufacturer-row" data-mf='${escapeHtml(JSON.stringify(mf))}'>
          <td class="col-name" style="font-weight: 500;">${escapeHtml(mf.name)}</td>
          <td class="col-logo" style="padding: 12px; text-align: center;">${mf.logo_url ? `<span style="color: var(--text-muted);" hidden>-</span><img src="${escapeHtml(mf.logo_url)}" alt="" style="height: 24px; width: auto; max-width: 72px; object-fit: contain; background: color-mix(in srgb, white 30%, var(--bg-soft) 70%); border: 1px solid color-mix(in srgb, white 22%, var(--border) 78%); border-radius: 8px; padding: 4px 8px; vertical-align: middle;" onerror="this.style.display='none'; this.previousElementSibling?.removeAttribute('hidden')" />` : '<span style="color: var(--text-muted);">-</span>'}</td>
          <td class="col-url">${mf.url ? `<a href="${escapeHtml(mf.url)}" target="_blank" rel="noopener" class="stop-prop" style="color: var(--accent); text-decoration: none;">${escapeHtml(mf.url)}</a>` : '<span style="color: var(--text-muted);">-</span>'}</td>
          <td class="col-filaments"><a href="/filaments?manufacturer_id=${mf.id}" class="stop-prop" style="color: var(--accent); text-decoration: none; font-weight: 500;">${mf.filament_count || 0}</a></td>
          <td class="col-spools"><a href="/spools?manufacturer_id=${mf.id}" class="stop-prop" style="color: var(--accent); text-decoration: none; font-weight: 500;">${mf.spool_count || 0}</a></td>
          <td class="col-materials">${mf.materials && mf.materials.length > 0 ? mf.materials.map((m: string) => escapeHtml(m)).join(', ') : '<span style="color: var(--text-muted);">-</span>'}</td>
          <td class="col-total_price" style="font-family: monospace;">${mf.total_price_available != null ? formatPrice(mf.total_price_available, getCurrency()) : '-'}</td>
          <td class="col-archived" style="color: var(--text-muted);">${mf.archived_spool_count ?? '-'}</td>
          <td class="col-spool_weight" style="font-family: monospace;">${mf.empty_spool_weight_g != null ? mf.empty_spool_weight_g + 'g' : '-'}</td>
          <td style="text-align: right; white-space: nowrap;">
            <button data-mf='${escapeHtml(JSON.stringify(mf))}' class="btn-edit fm-btn fm-btn-outline stop-prop" style="padding: 5px 12px; font-size: 0.8rem;">${t('common.edit')}</button>
            <button data-id="${mf.id}" class="btn-delete fm-btn fm-btn-danger stop-prop" style="padding: 5px 12px; font-size: 0.8rem; margin-left: 6px;">${t('common.delete')}</button>
          </td>
        </tr>
      `).join('')

      mfrReorder.applyOrder()

      document.querySelectorAll('.manufacturer-row').forEach(row => {
        row.addEventListener('click', () => {
          const mf = JSON.parse((row as HTMLElement).dataset.mf!)
          openInfoModal(mf)
        })
      })

      document.querySelectorAll('.stop-prop').forEach(el => {
        el.addEventListener('click', (e) => e.stopPropagation())
      })

      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const mf = JSON.parse(target.dataset.mf!)
          manufacturerDialog.open(mf)
        })
      })

      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const id = parseInt(target.dataset.id!)

          if (!(await (window as any).__fmConfirm(t('manufacturers.confirmDelete')))) return

          try {
            // First attempt to delete normally
            let response = await fetch(`/api/v1/manufacturers/${id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              signal: getAbortSignal(),
            })

            // If conflict (409), prompt for cascade delete
            if (response.status === 409) {
              const confirmCascade = await (window as any).__fmConfirm(
                t('manufacturers.confirmCascadeDelete'),
                { 
                  title: t('common.confirmTitle'), 
                  okLabel: t('manufacturers.forceDelete'), 
                  isDanger: true 
                }
              )

              if (!confirmCascade) return

              // Attempt to delete with force flag
              response = await fetch(`/api/v1/manufacturers/${id}?force=true`, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': getCsrfToken() },
                credentials: 'include',
                signal: getAbortSignal(),
              })
            }

            if (!response.ok) {
              const data = await response.json().catch(() => ({}))
              await (window as any).__fmAlert(data.detail?.message || data.message || t('manufacturers.failedDelete'))
              return
            }

            // Invalidate cache after successful delete
            invalidateCachePrefix(CACHE_KEYS.MANUFACTURERS)
            loadManufacturers()
          } catch {
            await (window as any).__fmAlert(t('manufacturers.failedDelete'))
          }
        })
      })
      renderPagination(sorted.length, currentPage)
    }

    function openInfoModal(mf: any) {
      const container = document.getElementById('info-modal-container')!
      const content = document.getElementById('info-modal-content')!
      const title = document.getElementById('info-modal-title')!

      title.textContent = ''
      if (mf.logo_url) {
        const img = document.createElement('img')
        img.src = mf.logo_url
        img.alt = ''
        img.style.cssText = 'width: 64px; height: 64px; object-fit: contain; vertical-align: middle; margin-right: 12px; background: #fff; border: 1px solid rgba(0,0,0,0.12); border-radius: 6px; padding: 4px;'
        img.onerror = () => { img.style.display = 'none' }
        title.appendChild(img)
      }
      title.appendChild(document.createTextNode(mf.name))

      content.innerHTML = `
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="fm-card" style="padding: 12px; background: var(--bg-soft);">
            <div style="font-size: 0.75rem; color: var(--text-muted);">${t('manufacturers.filaments')}</div>
            <div style="font-size: 1.2rem; font-weight: 600;">${mf.filament_count || 0}</div>
          </div>
          <div class="fm-card" style="padding: 12px; background: var(--bg-soft);">
            <div style="font-size: 0.75rem; color: var(--text-muted);">${t('manufacturers.availableSpools')}</div>
            <div style="font-size: 1.2rem; font-weight: 600;">${mf.spool_count || 0}</div>
          </div>
          <div class="fm-card" style="padding: 12px; background: var(--bg-soft);">
            <div style="font-size: 0.75rem; color: var(--text-muted);">${t('manufacturers.archivedSpools')}</div>
            <div style="font-size: 1.2rem; font-weight: 600;">${mf.archived_spool_count || 0}</div>
          </div>
          <div class="fm-card" style="padding: 12px; background: var(--bg-soft);">
             <div style="font-size: 0.75rem; color: var(--text-muted);">${t('manufacturers.materials')}</div>
             <div style="font-size: 0.9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${(mf.materials || []).join(', ')}">
               ${(mf.materials || []).join(', ') || '-'}
             </div>
          </div>
        </div>

        <div style="display: grid; gap: 12px; margin-top: 8px;">
          <div class="fm-card" style="border-left: 4px solid var(--accent); padding: 12px;">
            <div style="font-size: 0.75rem; color: var(--text-muted);">${t('manufacturers.totalValueAvailable')}</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent);">${formatPrice(mf.total_price_available, getCurrency())}</div>
          </div>
          <div class="fm-card" style="border-left: 4px solid var(--text-muted); padding: 12px;">
            <div style="font-size: 0.75rem; color: var(--text-muted);">${t('manufacturers.totalSpentAllTime')}</div>
            <div style="font-size: 1.4rem; font-weight: 700;">${formatPrice(mf.total_price_all, getCurrency())}</div>
          </div>
        </div>
      `

      container.style.display = 'flex'
    }

    function closeInfoModal() {
      document.getElementById('info-modal-container')!.style.display = 'none'
    }

    document.getElementById('btn-new')?.addEventListener('click', () => manufacturerDialog.open())
    document.getElementById('info-modal-close')?.addEventListener('click', closeInfoModal)

    document.getElementById('info-modal-container')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeInfoModal()
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeInfoModal()
    })

    function setupHeaderFilters() {
      const table = document.querySelector('.fm-table') as HTMLTableElement | null
      if (!table) return
      mfrHeaderFilters = initHeaderColumnFilters(table, [
        {
          key: 'name',
          label: t('manufacturers.name'),
          columnSelector: 'th.col-name',
          type: 'multi',
          options: [],
          initialValue: columnFilters.name,
          onApply: (value) => applyColumnFilter('name', value),
        },
        {
          key: 'url',
          label: t('manufacturers.url'),
          columnSelector: 'th.col-url',
          type: 'text',
          initialValue: columnFilters.url,
          onApply: (value) => applyColumnFilter('url', value),
        },
        {
          key: 'filaments',
          label: t('manufacturers.filaments'),
          columnSelector: 'th.col-filaments',
          type: 'number',
          initialValue: columnFilters.filaments,
          onApply: (value) => applyColumnFilter('filaments', value),
        },
        {
          key: 'spools',
          label: t('manufacturers.spools'),
          columnSelector: 'th.col-spools',
          type: 'number',
          initialValue: columnFilters.spools,
          onApply: (value) => applyColumnFilter('spools', value),
        },
        {
          key: 'materials',
          label: t('manufacturers.materials'),
          columnSelector: 'th.col-materials',
          type: 'multi',
          options: [],
          initialValue: columnFilters.materials,
          onApply: (value) => applyColumnFilter('materials', value),
        },
        {
          key: 'total_price',
          label: t('manufacturers.colTotalPrice'),
          columnSelector: 'th.col-total_price',
          type: 'number',
          initialValue: columnFilters.total_price,
          onApply: (value) => applyColumnFilter('total_price', value),
        },
        {
          key: 'archived',
          label: t('manufacturers.colArchived'),
          columnSelector: 'th.col-archived',
          type: 'number',
          initialValue: columnFilters.archived,
          onApply: (value) => applyColumnFilter('archived', value),
        },
        {
          key: 'spool_weight',
          label: t('manufacturers.colSpoolWeight'),
          columnSelector: 'th.col-spool_weight',
          type: 'number',
          initialValue: columnFilters.spool_weight,
          onApply: (value) => applyColumnFilter('spool_weight', value),
        },
      ])
      syncHeaderSortButtons(table, sortKey, sortDirection)
    }

    function applyColumnFilter(key: string, value: ColumnFilterValue) {
      if (isColumnFilterActive(value)) columnFilters[key] = value
      else delete columnFilters[key]
      currentPage = 1
      localStorage.setItem('filaman-page-manufacturers', '1')
      renderManufacturers()
    }

    bindTableFilterControls({
      onApply: () => {
        currentPage = 1
        localStorage.setItem('filaman-page-manufacturers', '1')
        renderManufacturers()
      },
      onClearColumns: () => {
        columnFilters = {}
        mfrHeaderFilters?.resetAll()
        currentPage = 1
        localStorage.setItem('filaman-page-manufacturers', '1')
        renderManufacturers()
      },
      onClearAll: () => {
        columnFilters = {}
        mfrHeaderFilters?.resetAll()
        currentPage = 1
        localStorage.setItem('filaman-page-manufacturers', '1')
        renderManufacturers()
      },
    })

    // ── Column Visibility ──────────────────────────────────────────────
    const mfrColumnGroups: ColumnGroup[] = [
      {
        heading: t('common.columnsStandard'),
        columns: [
          { key: 'logo', label: t('manufacturers.logo') },
          { key: 'url', label: t('manufacturers.url') },
          { key: 'filaments', label: t('manufacturers.filaments') },
          { key: 'spools', label: t('manufacturers.spools') },
          { key: 'materials', label: t('manufacturers.materials') },
        ],
      },
      {
        heading: t('common.columnsExtended'),
        columns: [
          { key: 'total_price', label: t('manufacturers.colTotalPrice') },
          { key: 'archived', label: t('manufacturers.colArchived') },
          { key: 'spool_weight', label: t('manufacturers.colSpoolWeight') },
        ],
      },
    ]
    initColumnPicker({
      storageKey: 'filaman-columns-manufacturers',
      defaultVisible: ['logo', 'url', 'filaments', 'spools', 'materials'],
      groups: mfrColumnGroups,
      btnId: 'btn-columns',
      dropdownId: 'columns-dropdown',
      orderStorageKey: 'filaman-column-order-manufacturers',
      widthsStorageKey: 'filaman-column-widths-manufacturers',
      resetLabel: t('common.columnsReset'),
      onReset: () => mfrReorder.resetOrder(),
      onResetWidths: () => mfrResize.resetWidths(),
    })

    const mfrReorder = initColumnReorder({
      tableSelector: '.fm-table',
      storageKey: 'filaman-column-order-manufacturers',
    })
    const mfrResize = initColumnResize({
      tableSelector: '.fm-table',
      storageKey: 'filaman-column-widths-manufacturers',
    })
    // ── End Column Visibility ──────────────────────────────────────────

    setupHeaderFilters()

    setupSortableHeaders()
    if (sortKey && sortDirection) updateSortIndicators()
    loadManufacturers()

    // Live-Update via SSE: Hersteller automatisch neu laden
    let _mfrReloadTimer: ReturnType<typeof setTimeout> | null = null
    window.addEventListener('filaman:data-changed', (e: Event) => {
      const { event } = (e as CustomEvent).detail ?? {}
      if (event === 'manufacturers_changed') {
        if (_mfrReloadTimer) clearTimeout(_mfrReloadTimer)
        _mfrReloadTimer = setTimeout(() => loadManufacturers(), 300)
      }
    })
  </script>
</Layout>
