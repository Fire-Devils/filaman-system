---
import FormDialog from '../../components/FormDialog.astro'
import Layout from '../../layouts/Layout.astro'
---

<Layout title="FilaMan - Printers">
  <div class="fm-list-toolbar">
    <h1 style="font-weight: 700; margin: 0; font-family: var(--font-serif);" data-i18n="printers.title">Printers</h1>
    <div class="fm-list-controls">
      <button
        id="btn-check-all"
        class="fm-btn fm-btn-outline"
        data-i18n="printers.checkAll"
      >
        Check All Printers
      </button>
      <button
        id="btn-new"
        class="fm-btn fm-btn-primary"
        data-i18n="printers.addPrinter"
      >
        Add Printer
      </button>
    </div>
  </div>
  
  <div class="fm-card" style="padding: 0;">
    <table class="fm-table fm-admin-table">
      <thead>
        <tr>
          <th data-i18n="printers.name">Name</th>
          <th data-i18n="printers.driver">Driver</th>
          <th data-i18n="common.status">Status</th>
          <th data-i18n="common.online">Online</th>
          <th data-i18n="printers.slotsHeader">Slots</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="printers-table">
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <FormDialog id="modal-container" titleId="modal-title" titleKey="printers.addPrinter" title="Add Printer" >
    <Fragment slot="actions">
      <button type="submit" form="modal-form" id="modal-submit" disabled class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
      <button type="button" id="modal-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
    <form id="modal-form" class="fm-compact-form">
        <input type="hidden" id="printer-id" />
        <div>
          <label for="printer-name" class="fm-label" data-i18n="printers.name">
            Name *
          </label>
          <input
            type="text"
            id="printer-name"
            required
            class="fm-input"
          />
        </div>
        <div>
          <label for="printer-driver" class="fm-label" data-i18n="printers.driver">
            Driver *
          </label>
          <select
            id="printer-driver"
            required
            class="fm-select"
          >
          </select>
        </div>
        <div id="config-fields" style="display: flex; flex-direction: column; gap: 12px;"></div>
        <div id="modal-error" class="fm-alert-error hidden" role="alert"></div>
    </form>
  </FormDialog>

  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { buildDriverConfigPayload, isStructuredProp, type SchemaProperty, type FieldValue } from '../../lib/driver-config-form'
    import { escapeHtml } from '../../lib/extra-fields'
    import { tableAction } from '../../lib/table-actions'
    import { bindFormDialog } from '../../lib/form-dialog'
    import { bindFormState } from '../../lib/form-state'
    await initI18n()

    const modalForm = document.getElementById('modal-form') as HTMLFormElement
    const formState = bindFormState(modalForm, document.getElementById('modal-submit') as HTMLButtonElement)
    const formDialog = bindFormDialog(document.getElementById('modal-container') as HTMLDialogElement, { canClose: () => !formState.busy })

    interface SlotSummary { external_spool?: boolean; ams_type?: string; ams_units?: { ams_id: number; tray_count: number }[] }
    interface PrinterRecord { id: number; name: string; driver_key: string; is_active: boolean; driver_config?: Record<string, unknown> | null; custom_fields?: (Record<string, unknown> & { slot_summary?: SlotSummary | null }) | null }
    interface DriverSchema { properties?: Record<string, SchemaProperty>; required?: string[] }
    interface DriverPlugin { driver_key?: string | null; name: string; is_active: boolean; config_schema?: DriverSchema | null }
    interface DriverHealth extends SlotSummary { running?: boolean; connected?: boolean; ams_count?: number; slot_count?: number }
    const dialogs = window as unknown as {
      __fmConfirm: (message: string, options: { checkbox: { label: string } }) => Promise<{ confirmed: boolean; checked: boolean }>
      __fmAlert: (message: string) => Promise<boolean>
      __fmSuccess: (message: string) => Promise<boolean>
    }
    let printers: PrinterRecord[] = []
    let allPlugins: DriverPlugin[] = []
    /**
     * The config the modal was opened with, and the schema it was rendered from.
     * Both are needed on save: structured properties have no input element, so
     * their stored value has to be carried through explicitly.
     */
    let editingConfigSchema: Record<string, SchemaProperty> | null = null
    let editingConfigValues: Record<string, unknown> = {}

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }
    
    async function loadPrinters() {
      try {
        const response = await fetch('/api/v1/printers', { credentials: 'include', signal: getAbortSignal() })
        
        if (!response.ok) throw new Error('Failed to fetch printers')
        
        printers = await response.json().then(d => d.items)
        renderPrinters()
        fetchHealthForAll()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load printers:', error)
        document.getElementById('printers-table')!.innerHTML = `
          <tr>
            <td colspan="6" style="text-align: center; color: var(--error-text);">${t('printers.failedLoad')}</td>
          </tr>
        `
      }
    }

    function renderSlotTags(summary: SlotSummary | null | undefined): string {
      if (!summary) return '\u2014'
      const tags: string[] = []
      const tagStyle = 'display:inline-block;padding:2px 8px;font-size:0.7rem;border-radius:999px;background:var(--bg-soft);color:var(--text-muted);margin-right:4px;white-space:nowrap;'
      if (summary.external_spool) {
        tags.push(`<span style="${tagStyle}">Ext: 1 Slot</span>`)
      }
      if (summary.ams_units && summary.ams_units.length > 0) {
        for (const unit of summary.ams_units) {
          const label = summary.ams_type === 'AMS Lite' ? 'AMS Lite' : `AMS ${unit.ams_id + 1}`
          tags.push(`<span style="${tagStyle}">${label}: ${unit.tray_count} Slots</span>`)
        }
      }
      return tags.length > 0 ? tags.join('') : '\u2014'
    }
    
    async function fetchHealthForAll() {
      await Promise.all(printers.map(async p => {
        const badge = document.getElementById(`online-badge-${p.id}`)
        const slotsEl = document.getElementById(`slots-info-${p.id}`)
        if (!badge) return
        try {
          const resp = await fetch(`/api/v1/printers/${p.id}/driver/health`, { credentials: 'include', signal: getAbortSignal() })
          if (!resp.ok) {
            badge.textContent = t('common.offline')
            badge.style.color = 'var(--text-muted)'
            return
          }
          const health: DriverHealth = await resp.json()
          if (health.running && health.connected) {
            badge.textContent = t('common.online')
            badge.style.color = '#22c55e'
          } else {
            badge.textContent = t('common.offline')
            badge.style.color = 'var(--error-text)'
          }
          // Slot info from driver — render as tag cards
          if (slotsEl && health.running && health.connected) {
            const slotSummary = {
              ams_count: health.ams_count,
              ams_type: health.ams_type || 'AMS',
              slot_count: health.slot_count,
              external_spool: health.external_spool,
              ams_units: health.ams_units || [],
            }
            const html = renderSlotTags(slotSummary)
            if (html !== '\u2014') {
              slotsEl.innerHTML = html
            }
          }
        } catch {
          badge.textContent = t('common.offline')
          badge.style.color = 'var(--text-muted)'
        }
      }))
    }

    function renderPrinters() {
      const tbody = document.getElementById('printers-table')!
      
      if (printers.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align: center; color: var(--text-muted);">
              ${t('printers.noPrinters')}
            </td>
          </tr>
        `
        return
      }
      
      tbody.innerHTML = printers.map(p => `
        <tr style="cursor: pointer;" onclick="window.location='/printers/${p.id}'">
          <td style="padding: 12px; font-weight: 500;">${escapeHtml(p.name)}</td>
          <td style="padding: 12px;">
            <span style="padding: 2px 8px; font-size: 0.75rem; border-radius: 999px; background: var(--bg-soft); color: var(--text-muted);">${escapeHtml(p.driver_key)}</span>
          </td>
          <td style="padding: 12px;">
            <span style="padding: 2px 8px; font-size: 0.75rem; border-radius: 999px; background: var(--bg-soft); color: ${p.is_active ? 'var(--accent-2)' : 'var(--error-text)'};">
              ${p.is_active ? t('common.active') : t('common.inactive')}
            </span>
          </td>
          <td style="padding: 12px;">
            <span id="online-badge-${p.id}" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 999px; background: var(--bg-soft); color: var(--text-muted);">—</span>
          </td>
          <td style="padding: 12px;">
            <span id="slots-info-${p.id}" style="font-size: 0.8rem;">${renderSlotTags(p.custom_fields?.slot_summary)}</span>
          </td>
          <td style="padding: 12px; text-align: right;" onclick="event.stopPropagation()">
            <div class="fm-row-actions">${tableAction('edit', { id: p.id })}${tableAction('delete', { id: p.id })}</div>
          </td>
        </tr>
      `).join('')
      
      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const id = parseInt(target.dataset.id!)
          try {
            const resp = await fetch(`/api/v1/printers/${id}`, { credentials: 'include', signal: getAbortSignal() })
            if (resp.ok) {
              const printer: PrinterRecord = await resp.json()
              openModal(id, printer.name, printer.driver_key, printer.driver_config || undefined)
            }
          } catch {}
        })
      })
      
      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const id = parseInt(target.dataset.id!)
          
          const result = await dialogs.__fmConfirm(t('printers.confirmDelete'), {
            checkbox: { label: t('printers.confirmDeleteParams') },
          })
          if (!result || !result.confirmed) return
          const qs = result.checked ? '?delete_params=true' : ''
          
          try {
            const response = await fetch(`/api/v1/printers/${id}${qs}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              signal: getAbortSignal(),
            })
            
            if (!response.ok) {
              const data = await response.json()
              await dialogs.__fmAlert(data.message || t('printers.failedDelete'))
              return
            }
            
            loadPrinters()
          } catch {
            await dialogs.__fmAlert(t('printers.failedDelete'))
          }
        })
      })
    }
    
    function openModal(id: number | null = null, name: string = '', driver: string = '', config?: Record<string, unknown>) {
      const title = document.getElementById('modal-title')!
      const idInput = document.getElementById('printer-id') as HTMLInputElement
      const nameInput = document.getElementById('printer-name') as HTMLInputElement
      const driverInput = document.getElementById('printer-driver') as HTMLSelectElement
      const error = document.getElementById('modal-error')!
      
      title.textContent = id ? t('printers.editPrinter') : t('printers.addPrinter')
      idInput.value = id ? String(id) : ''
      nameInput.value = name
      driverInput.value = driver
      error.classList.add('hidden')
      
      renderConfigFields(driver, config)
      
      formState.reset()
      formDialog.open()
      nameInput.focus()
    }
    
    
    document.getElementById('btn-new')?.addEventListener('click', () => openModal())
    
    document.getElementById('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const id = (document.getElementById('printer-id') as HTMLInputElement).value
      const name = (document.getElementById('printer-name') as HTMLInputElement).value
      const driver_key = (document.getElementById('printer-driver') as HTMLSelectElement).value
      const error = document.getElementById('modal-error') as HTMLDivElement
      const submitBtn = document.getElementById('modal-submit') as HTMLButtonElement
      
      const configContainer = document.getElementById('config-fields')!
      const configInputs = configContainer.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
      let driver_config: Record<string, unknown> | undefined = undefined
      // No schema means no driver config to send — leave the field out entirely
      // rather than submitting an empty object that would clear what is stored.
      if (editingConfigSchema && Object.keys(editingConfigSchema).length > 0) {
        const edited: Record<string, FieldValue> = {}
        configInputs.forEach(el => {
          const key = el.name
          if (el instanceof HTMLInputElement && el.type === 'checkbox') {
            edited[key] = el.checked
          } else if (el.type === 'number') {
            edited[key] = el.value ? Number(el.value) : null
          } else {
            edited[key] = el.value || null
          }
        })
        // Structured properties have no input; their stored value is carried
        // over here, because the backend replaces driver_config wholesale.
        driver_config = buildDriverConfigPayload(
          editingConfigSchema,
          editingConfigValues,
          edited
        )
      }
      const data: { name: string; driver_key: string; driver_config?: Record<string, unknown> } = { name, driver_key }
      if (driver_config) data.driver_config = driver_config
      
      error.classList.add('hidden')
      if (formState.busy || !modalForm.reportValidity()) return
      formState.setBusy(true)
      submitBtn.textContent = t('common.saving')
      
      try {
        const url = id ? `/api/v1/printers/${id}` : '/api/v1/printers'
        const method = id ? 'PATCH' : 'POST'
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          signal: getAbortSignal(),
          body: JSON.stringify(data),
        })
        
        if (!response.ok) {
          const errorData = await response.json()
          throw new Error(errorData.message || t('printers.failedSave'))
        }
        
        formState.setBusy(false)
        formDialog.close()
        loadPrinters()
      } catch (err) {
        if (isAbortError(err)) return
        error.textContent = err instanceof Error ? err.message : t('printers.failedSave')
        error.classList.remove('hidden')
      } finally {
        formState.setBusy(false)
        submitBtn.textContent = t('common.save')
      }
    })
    
    async function loadDrivers() {
      const select = document.getElementById('printer-driver') as HTMLSelectElement
      try {
        const response = await fetch('/api/v1/admin/system/plugins', { credentials: 'include', signal: getAbortSignal() })
        if (!response.ok) return
        allPlugins = await response.json()
        const drivers = allPlugins.filter(p => p.driver_key && p.is_active)
        select.innerHTML = '<option value="">' + t('printers.selectDriver') + '</option>'
          + drivers.map(d => `<option value="${d.driver_key}">${d.name}</option>`).join('')
      } catch {
        console.error('Failed to load drivers')
      }
    }

    function renderConfigFields(driverKey: string, existingConfig?: Record<string, unknown>) {
      const container = document.getElementById('config-fields')!
      container.innerHTML = ''
      editingConfigSchema = null
      editingConfigValues = existingConfig || {}
      if (!driverKey) return

      const schema = allPlugins.find(p => p.driver_key === driverKey)?.config_schema
      const properties = schema?.properties
      if (!properties) return
      editingConfigSchema = properties
      const required = schema?.required || []
      
      for (const [key, prop] of Object.entries(properties)) {
        const div = document.createElement('div')
        
        const label = document.createElement('label')
        label.className = 'fm-label'
        label.setAttribute('for', `config-${key}`)
        label.textContent = (prop.title || key) + (required.includes(key) ? ' *' : '')
        div.appendChild(label)
        
        const currentValue = existingConfig ? existingConfig[key] : undefined

        if (isStructuredProp(prop, currentValue ?? prop.default)) {
          // Read-only: no input element, so the save loop cannot clobber it.
          const pre = document.createElement('pre')
          pre.className = 'fm-input'
          pre.style.cssText = 'margin: 0; font-size: 0.8rem; white-space: pre-wrap; word-break: break-word; overflow-x: auto;'
          pre.textContent = JSON.stringify(currentValue ?? prop.default ?? null, null, 2)
          div.appendChild(pre)

          const note = document.createElement('div')
          note.style.cssText = 'font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;'
          note.textContent = t('printers.configReadOnly')
          div.appendChild(note)

          if (prop.description) {
            const hint = document.createElement('div')
            hint.style.cssText = 'font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;'
            hint.textContent = prop.description
            div.appendChild(hint)
          }

          container.appendChild(div)
          continue
        }

        // Bestimme den vorausgewählten Wert
        let selectedValue = ''
        if (currentValue !== undefined && currentValue !== null) {
          selectedValue = String(currentValue)
        } else if (prop.default !== undefined) {
          selectedValue = String(prop.default)
        }

        if (prop.type === 'boolean') {
          const input = document.createElement('input')
          input.id = `config-${key}`
          input.name = key
          input.className = 'fm-checkbox'
          input.type = 'checkbox'
          input.checked = currentValue === true || (currentValue === undefined && prop.default === true)
          div.appendChild(input)
        } else if (prop.enum && Array.isArray(prop.enum)) {
          // Enum → <select> Dropdown
          const select = document.createElement('select')
          select.id = `config-${key}`
          select.name = key
          select.className = 'fm-input'
          if (required.includes(key)) select.required = true
          
          const enumNames = prop.enumNames || prop.enum
          prop.enum.forEach((val, i) => {
            const opt = document.createElement('option')
            opt.value = String(val)
            opt.textContent = String(enumNames[i] ?? val)
            if (String(val) === selectedValue) opt.selected = true
            select.appendChild(opt)
          })
          div.appendChild(select)
        } else {
          const input = document.createElement('input')
          input.id = `config-${key}`
          input.name = key
          input.className = 'fm-input'
          
          if (prop.type === 'integer' || prop.type === 'number') {
            input.type = 'number'
            if (prop.minimum !== undefined) input.min = String(prop.minimum)
            if (prop.maximum !== undefined) input.max = String(prop.maximum)
          } else {
            input.type = 'text'
          }
          
          if (required.includes(key)) input.required = true
          input.value = selectedValue
          div.appendChild(input)
        }
        
        if (prop.description) {
          const hint = document.createElement('div')
          hint.style.cssText = 'font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;'
          hint.textContent = prop.description
          div.appendChild(hint)
        }
        
        container.appendChild(div)
      }
    }

    await loadDrivers()
    document.getElementById('printer-driver')?.addEventListener('change', (e) => {
      renderConfigFields((e.target as HTMLSelectElement).value)
    })

    document.getElementById('btn-check-all')?.addEventListener('click', async () => {
      const btn = document.getElementById('btn-check-all') as HTMLButtonElement
      btn.disabled = true
      btn.textContent = '...'
      // Reset all online badges to '—' before reconnecting
      printers.forEach(p => {
        const badge = document.getElementById(`online-badge-${p.id}`)
        if (badge) {
          badge.textContent = '—'
          badge.style.color = 'var(--text-muted)'
        }
      })
      try {
        await fetch('/api/v1/printers/reconnect-all', { method: 'POST', credentials: 'include', signal: getAbortSignal() })
        await dialogs.__fmSuccess(t('printers.reconnectDone'))
      } catch {}
      await fetchHealthForAll()
      btn.disabled = false
      btn.textContent = t('printers.checkAll')
    })

    loadPrinters()
  </script>
</Layout>
