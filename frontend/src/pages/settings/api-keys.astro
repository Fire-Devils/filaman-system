---
import Layout from '../../layouts/Layout.astro'
import FormSection from '../../components/FormSection.astro'
---

<Layout title="FilaMan - API Keys">
  <div class="fm-settings-page fm-settings-profile">
  <header class="fm-list-toolbar">
    <div>
      <a href="/settings" class="fm-admin-back">&larr; <span data-i18n="apiKeys.backToSettings">Back to Settings</span></a>
      <h1 data-i18n="apiKeys.title">API Keys</h1>
    </div>
  </header>
  
  <div class="fm-settings-stack">
    <FormSection titleKey="apiKeys.createNew" title="Create New API Key">
      <p class="fm-field-hint" data-i18n="apiKeys.description">Create API keys for external integrations like Bambuddy</p>
      <form id="create-key-form" class="fm-compact-form">
        <div>
          <label for="key_name" class="fm-label" data-i18n="apiKeys.keyName">Key Name</label>
          <input
            type="text"
            id="key_name"
            name="key_name"
            required
            class="fm-input"
            placeholder="e.g. Bambuddy Integration"
            data-i18n-placeholder="apiKeys.keyNamePlaceholder"
          />
        </div>
        
        <div id="create-error" class="fm-alert-error hidden"></div>
        
        <button
          type="submit"
          id="create-btn"
          class="fm-btn fm-btn-primary"
          style="justify-self: start;"
          data-i18n="apiKeys.createBtn"
        >
          Erstellen
        </button>
      </form>

      <div id="new-token-container" class="hidden" style="padding-top: 16px; border-top: 1px solid var(--border);">
        <div class="fm-alert-warning" style="margin-bottom: 16px;" data-i18n="apiKeys.tokenWarning">
          Dieser Token wird nur einmal angezeigt. Kopiere ihn jetzt!
        </div>
        <div style="display: flex; gap: 8px;">
          <input
            type="text"
            id="new-token-input"
            readonly
            class="fm-input"
            style="font-family: monospace;"
          />
          <button
            type="button"
            id="copy-token-btn"
            class="fm-btn fm-btn-secondary"
            data-i18n="apiKeys.copyBtn"
          >
            Copy
          </button>
        </div>
        <div id="copy-token-error" class="fm-alert-error hidden" role="alert" style="margin-top: 12px;"></div>

        <div style="margin-top: 16px;">
          <div style="font-weight: 600; margin-bottom: 4px;" data-i18n="apiKeys.qrTitle">Für die FilaMan-App scannen</div>
          <p class="fm-field-hint" style="margin: 0 0 12px;" data-i18n="apiKeys.qrHint">
            In der App: Anmeldung → Token → QR-Symbol im Token-Feld.
          </p>
          <!-- Fester weißer Grund: der QR-Code hat feste Farben und würde
               sonst im dunklen Theme schlecht erkannt werden. -->
          <div
            id="new-token-qr"
            style="display: inline-block; background: #ffffff; padding: 12px; border-radius: 8px; line-height: 0;"
          ></div>
          <div id="new-token-qr-error" class="fm-alert-error hidden" style="margin-top: 12px;"></div>
        </div>
      </div>
    </FormSection>
    
    <FormSection titleKey="apiKeys.existingKeys" title="Existing API Keys">
      
      <div id="keys-loading" class="fm-field-hint" data-i18n="common.loading">Loading...</div>
      <div id="keys-error" class="fm-alert-error hidden"></div>
      
      <div id="keys-table-container" class="fm-table-scroll hidden">
        <table class="fm-table fm-admin-table">
          <thead>
            <tr>
              <th data-i18n="apiKeys.tableName">Name</th>
              <th data-i18n="apiKeys.tableCreated">Created at</th>
              <th data-i18n="apiKeys.tableLastUsed">Last used</th>
              <th style="text-align: right;" data-i18n="apiKeys.tableActions">Actions</th>
            </tr>
          </thead>
          <tbody id="keys-tbody">
            <!-- Rows will be inserted here -->
          </tbody>
        </table>
        <div id="no-keys-msg" class="hidden" style="padding: 24px 8px; color: var(--text-muted); text-align: center;" data-i18n="apiKeys.noKeys">
          No API keys found.
        </div>
      </div>
    </FormSection>
  </div>
  </div>
  
  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { ensureQrCodeLoaded, getQrCodeConstructor } from '../../lib/qr-code'
    import { copyText } from '../../lib/clipboard'
    import { tableAction } from '../../lib/table-actions'
    await initI18n()

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }
    
    function formatDate(isoString: string | null): string {
      if (!isoString) return '-'
      return new Date(isoString).toLocaleString()
    }

    const createForm = document.getElementById('create-key-form') as HTMLFormElement
    const createError = document.getElementById('create-error') as HTMLDivElement
    const createBtn = document.getElementById('create-btn') as HTMLButtonElement
    const newTokenContainer = document.getElementById('new-token-container') as HTMLDivElement
    const newTokenInput = document.getElementById('new-token-input') as HTMLInputElement
    const copyTokenBtn = document.getElementById('copy-token-btn') as HTMLButtonElement
    const newTokenQr = document.getElementById('new-token-qr') as HTMLDivElement
    const newTokenQrError = document.getElementById('new-token-qr-error') as HTMLDivElement
    
    const keysLoading = document.getElementById('keys-loading') as HTMLDivElement
    const keysError = document.getElementById('keys-error') as HTMLDivElement
    const keysTableContainer = document.getElementById('keys-table-container') as HTMLDivElement
    const keysTbody = document.getElementById('keys-tbody') as HTMLTableSectionElement
    const noKeysMsg = document.getElementById('no-keys-msg') as HTMLDivElement

    // Zeichnet den frisch erstellten Token als QR-Code, damit die FilaMan-App
    // ihn scannen kann statt ihn abzutippen. Der Token wird nur einmal
    // angezeigt, der QR-Code lebt also genauso lange wie das Panel.
    async function renderTokenQr(token: string) {
      newTokenQr.innerHTML = ''
      newTokenQrError.classList.add('hidden')

      try {
        await ensureQrCodeLoaded()
        const QrCode = getQrCodeConstructor()
        new QrCode(newTokenQr, {
          text: token,
          width: 180,
          height: 180,
          colorDark: '#000000',
          colorLight: '#ffffff',
          correctLevel: QrCode.CorrectLevel.M,
        })
      } catch (error) {
        console.error('Failed to render token QR code:', error)
        newTokenQr.innerHTML = ''
        newTokenQrError.textContent = t('apiKeys.qrError')
        newTokenQrError.classList.remove('hidden')
      }
    }

    async function loadApiKeys() {
      keysLoading.classList.remove('hidden')
      keysError.classList.add('hidden')
      keysTableContainer.classList.add('hidden')
      
      try {
        const response = await fetch('/api/v1/me/api-keys', { credentials: 'include', signal: getAbortSignal() })
        if (!response.ok) throw new Error('Failed to load API keys')
        
        const keys = await response.json()
        renderKeys(keys)
        
        keysLoading.classList.add('hidden')
        keysTableContainer.classList.remove('hidden')
      } catch (error: any) {
        if (isAbortError(error)) return
        console.error('Failed to load API keys:', error)
        keysLoading.classList.add('hidden')
        keysError.textContent = error.message || t('apiKeys.loadError')
        keysError.classList.remove('hidden')
      }
    }

    function renderKeys(keys: any[]) {
      keysTbody.innerHTML = ''
      
      if (keys.length === 0) {
        noKeysMsg.classList.remove('hidden')
        return
      }
      
      noKeysMsg.classList.add('hidden')
      
      keys.forEach(key => {
        const tr = document.createElement('tr')
        
        const tdName = document.createElement('td')
        tdName.textContent = key.name
        
        const tdCreated = document.createElement('td')
        tdCreated.style.color = 'var(--text-muted)'
        tdCreated.textContent = formatDate(key.created_at)
        
        const tdLastUsed = document.createElement('td')
        tdLastUsed.style.color = 'var(--text-muted)'
        tdLastUsed.textContent = formatDate(key.last_used_at)
        
        const tdActions = document.createElement('td')
        tdActions.style.textAlign = 'right'
        
        tdActions.innerHTML = tableAction('delete', { id: key.id })
        const deleteBtn = tdActions.querySelector('button')!
        deleteBtn.onclick = () => deleteApiKey(key.id, key.name)
        
        
        tr.appendChild(tdName)
        tr.appendChild(tdCreated)
        tr.appendChild(tdLastUsed)
        tr.appendChild(tdActions)
        
        keysTbody.appendChild(tr)
      })
    }

    async function deleteApiKey(id: number, name: string) {
      if (!confirm(t('apiKeys.deleteConfirm')?.replace('{name}', name) || `Are you sure you want to delete API key "${name}"?`)) {
        return
      }
      
      try {
        const response = await fetch(`/api/v1/me/api-keys/${id}`, {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          signal: getAbortSignal(),
        })
        
        if (!response.ok) {
          throw new Error('Failed to delete API key')
        }
        
        // Reload the list
        loadApiKeys()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to delete API key:', error)
        alert(t('apiKeys.deleteError') || 'Failed to delete API key')
      }
    }

    createForm.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const formData = new FormData(createForm)
      const name = formData.get('key_name') as string
      
      createError.classList.add('hidden')
      newTokenContainer.classList.add('hidden')
      newTokenQr.innerHTML = ''
      newTokenQrError.classList.add('hidden')
      createBtn.disabled = true
      createBtn.textContent = t('common.saving') || 'Saving...'
      
      try {
        const response = await fetch('/api/v1/me/api-keys', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          signal: getAbortSignal(),
          body: JSON.stringify({ name }),
        })
        
        if (!response.ok) {
          const errorData = await response.json().catch(() => null)
          const msg = errorData?.message || errorData?.detail || t('apiKeys.createFailed') || 'Failed to create API key'
          throw new Error(typeof msg === 'string' ? msg : 'Failed to create API key')
        }
        
        const data = await response.json()
        
        // Show the new token
        newTokenInput.value = data.token
        newTokenContainer.classList.remove('hidden')
        document.getElementById('copy-token-error')!.classList.add('hidden')
        void renderTokenQr(data.token)
        
        // Reset form
        createForm.reset()
        
        // Reload the list
        loadApiKeys()
      } catch (error: any) {
        if (isAbortError(error)) return
        createError.textContent = error.message
        createError.classList.remove('hidden')
      } finally {
        createBtn.disabled = false
        createBtn.textContent = t('apiKeys.createBtn') || 'Erstellen'
      }
    })

    copyTokenBtn.addEventListener('click', async () => {
      // navigator.clipboard does not exist at all over plain HTTP, which is how
      // most installations are reached, so the raw API threw before it could
      // report anything. copyText() falls back to a hidden textarea, and a
      // failure now says so instead of only reaching the console.
      const copyError = document.getElementById('copy-token-error')!
      if (await copyText(newTokenInput.value)) {
        copyError.classList.add('hidden')
        const originalText = copyTokenBtn.textContent
        copyTokenBtn.textContent = t('common.copied') || 'Copied!'
        setTimeout(() => {
          copyTokenBtn.textContent = originalText
        }, 2000)
      } else {
        copyError.textContent = t('apiKeys.copyFailed')
        copyError.classList.remove('hidden')
        newTokenInput.select()
      }
    })

    // Initial load
    loadApiKeys()
  </script>
</Layout>
