---
import Layout from '../../../layouts/Layout.astro'

export function getStaticPaths() {
  return [{ params: { id: 'detail' } }]
}
---

<Layout title="FilaMan - Edit Spool">
  <p style="color: var(--text-muted);" data-i18n="common.loading">Loading...</p>
  <script>
    const parts = window.location.pathname.split('/').filter(Boolean)
    const id = parts.at(-1) === 'edit' ? parts.at(-2) : null
    window.location.replace(id && id !== 'detail' ? `/spools/${id}?edit=1` : '/spools')
  </script>
</Layout>
