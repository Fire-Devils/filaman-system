---
import Layout from '../../../layouts/Layout.astro'

export function getStaticPaths() {
  return [
    {params: {id: 'detail'}},
  ];
}

const { id } = Astro.params
---

<Layout title="FilaMan - Spool">
  <div class="detail-page-toolbar">
    <a href="/spools" class="detail-back-link">&larr; <span data-i18n="spools.backToSpools">Back to Spools</span></a>
    <div id="spool-page-actions"></div>
  </div>

  
  <div id="spool-content">
    <p style="color: var(--text-muted);" data-i18n="common.loading">Loading...</p>
  </div>
  
  <div id="actions-section" class="detail-quick-actions hidden">
    <h2 style="font-weight: 600; margin-bottom: 16px;" data-i18n="spools.quickActions">Quick Actions</h2>
    <div class="detail-quick-action-buttons">
      <button id="btn-measurement" class="fm-btn fm-btn-primary" style="background: var(--accent);">
        <svg aria-hidden="true"><use href="/icons.svg?v=detail4#icon-record-weight"></use></svg><span data-i18n="spools.recordWeight">Record Weight</span>
      </button>
      <button id="btn-adjustment" class="fm-btn fm-btn-outline" style="border-color: var(--accent-2); color: var(--accent-2);">
        <svg aria-hidden="true"><use href="/icons.svg?v=detail4#icon-adjust"></use></svg><span data-i18n="spools.adjust">Adjust</span>
      </button>
      <button id="btn-status" class="fm-btn fm-btn-outline" style="border-color: var(--accent-3); color: var(--accent-3);">
        <svg aria-hidden="true"><use href="/icons.svg?v=detail4#icon-change-status"></use></svg><span data-i18n="spools.changeStatus">Change Status</span>
      </button>
      <button id="btn-move" class="fm-btn fm-btn-outline">
        <svg aria-hidden="true"><use href="/icons.svg?v=detail4#icon-move"></use></svg><span data-i18n="spools.move">Move</span>
      </button>
      <a href={`/spools/${id}/print`} id="btn-print-label" class="fm-btn fm-btn-outline" style="border-color: #10b981; color: #10b981; text-decoration: none; display: flex; align-items: center; justify-content: center;">
        <svg aria-hidden="true"><use href="/icons.svg?v=detail2#icon-print"></use></svg><span data-i18n="spools.printLabel">Print Label</span>
      </a>
    </div>
  </div>
  
  <div id="modal-container" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="fm-card" style="padding: 24px; width: 100%; max-width: 420px; margin: 16px;">
      <h3 id="modal-title" style="font-weight: 600; margin: 0 0 16px 0;"></h3>
      <form id="modal-form" style="display: grid; gap: 16px;">
        <div id="modal-fields"></div>
        <div id="modal-error" class="fm-alert-error hidden"></div>
        <div style="display: flex; gap: 12px;">
          <button type="submit" id="modal-submit" class="fm-btn fm-btn-primary" data-i18n="common.submit">
            Submit
          </button>
          <button type="button" id="modal-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- RFID Modal -->
  <div id="rfid-modal" class="fm-modal-overlay">
    <div class="fm-card" style="width: 100%; max-width: 28rem; margin: 0 1rem; padding: 24px;">
      <h3 style="font-size: 1.15rem; font-weight: 600; margin-bottom: 16px;" data-i18n="rfid.writeTag">Write RFID Tag</h3>
      <div id="rfid-content">
        <p style="margin-bottom: 16px;" id="rfid-text"></p>
        <div id="rfid-device-select-container" class="hidden">
          <label for="rfid-device-select" class="fm-label" data-i18n="rfid.selectDevice">Select Device</label>
          <select id="rfid-device-select" class="fm-select" style="margin-bottom: 16px;"></select>
        </div>
        <div id="rfid-warning" class="fm-alert fm-alert-warning hidden" style="margin-bottom: 16px;"></div>
        <div id="rfid-slot-choice" class="hidden" style="margin-bottom: 16px; display: flex; flex-direction: column; gap: 8px;"></div>
      </div>
      <div id="rfid-status" class="fm-alert hidden" style="margin-bottom: 16px;"></div>
      <div style="display: flex; gap: 12px;">
        <button id="rfid-confirm" class="fm-btn fm-btn-primary" data-i18n="common.confirm">Confirm</button>
        <button id="rfid-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="delete-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="fm-card" style="padding: 24px; width: 100%; max-width: 400px; margin: 16px;">
      <h3 id="delete-modal-title" style="font-weight: 600; margin: 0 0 16px 0;" data-i18n="spools.archiveSpool">Archivieren</h3>
      <div id="delete-modal-content" style="margin-bottom: 20px;">
        <p id="delete-modal-message" style="margin: 0 0 16px 0; color: var(--text-muted);" data-i18n="spools.confirmDelete">Möchten Sie diese Spule wirklich löschen?</p>
        <label class="fm-checkbox-group" style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer;">
          <input type="checkbox" id="delete-permanent-checkbox" style="width: 18px; height: 18px; margin-top: 2px; accent-color: var(--accent);">
          <span data-i18n="spools.permanentDeleteLabel">Endgültig löschen statt archivieren</span>
        </label>
        <p id="delete-permanent-warning" class="hidden" style="margin: 12px 0 0 0; padding: 12px; background: rgba(239, 68, 68, 0.1); border-radius: 8px; font-size: 0.85rem; color: var(--error-text);" data-i18n="spools.permanentDeleteWarning">
          Diese Spule wird dauerhaft aus der Datenbank gelöscht und fließt nicht mehr in Statistiken ein.
        </p>
      </div>
      <div style="display: flex; gap: 12px;">
        <button id="btn-delete-confirm" class="fm-btn fm-btn-danger" data-i18n="spools.archiveSpool">Archivieren</button>
        <button id="btn-delete-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </div>
    </div>
  </div>
  

  <div id="slicer-profile-section" class="hidden" style="margin-top: 32px;">
    <h2 style="font-weight: 600; margin-bottom: 16px;" data-i18n="printers.slicerProfile">Slicer Profile</h2>
    <div class="fm-card" style="padding: 24px;">
      <label class="fm-label" data-i18n="printers.bambuSlicerProfile">Bambu Slicer Profile</label>
      <div id="slicer-profile-picker"></div>
      <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 8px;" data-i18n="printers.slicerProfileSpoolHint">Synced to this spool in Bambuddy across all Bambu printers.</p>
      <div id="slicer-profile-coverage" class="hidden" style="margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px;"></div>
      <span id="slicer-profile-msg" class="hidden" style="font-size: 0.85rem;"></span>
    </div>
  </div>

  <div id="printer-params-section" class="hidden" style="margin-top: 32px;">
    <h2 style="font-weight: 600; margin-bottom: 16px;" data-i18n="printers.printerParameters">Printer Parameters</h2>
    <div class="fm-card" style="padding: 24px;">
      <div style="margin-bottom: 16px;">
        <label class="fm-label" data-i18n="printers.selectPrinter">Printer</label>
        <select id="printer-select" class="fm-select">
          <option value="">\u2014</option>
        </select>
      </div>
      <div id="printer-params-list">
        <p style="color: var(--text-muted); font-size: 0.85rem;" data-i18n="printers.selectPrinterHint">Select a printer to view parameters</p>
      </div>
      <div id="printer-params-actions" class="hidden" style="margin-top: 12px; display: flex; align-items: center; gap: 12px;">
        <button id="btn-save-params" class="fm-btn fm-btn-primary" style="font-size: 0.85rem;" data-i18n="common.save">Save</button>
        <span id="params-save-feedback" style="font-size: 0.85rem; opacity: 0; transition: opacity 0.3s;"></span>
      </div>
    </div>
  </div>
  <div id="events-section" class="hidden" style="margin-top: 32px;">
    <h2 style="font-weight: 600; margin-bottom: 16px;" data-i18n="spools.eventHistory">Event History</h2>
    <div class="fm-card" style="padding: 0;">
      <table class="fm-table">
        <thead>
          <tr style="background: var(--bg-soft);">
            <th data-i18n="spools.eventType">Type</th>
            <th data-i18n="spools.eventDate">Date</th>
            <th data-i18n="spools.eventWeight">Weight</th>
            <th data-i18n="common.note">Note</th>
          </tr>
        </thead>
        <tbody id="events-table">
          <tr>
            <td colspan="4" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <style is:global>
    @keyframes slot-pulse-white {
      0%, 100% { box-shadow: 0 0 0 2px rgba(255,255,255,0.3); }
      50% { box-shadow: 0 0 0 3px rgba(255,255,255,0.9); }
    }
    @keyframes slot-pulse-green {
      0%, 100% { box-shadow: 0 0 0 2px rgba(34,197,94,0.3); }
      50% { box-shadow: 0 0 0 3px rgba(34,197,94,0.9); }
    }
    .slot-dot.slot-sending {
      animation: slot-pulse-white 0.8s ease-in-out infinite;
      border: 2px solid rgba(255,255,255,0.8) !important;
    }
    .slot-dot.slot-success {
      animation: slot-pulse-green 0.6s ease-in-out infinite;
      border: 2px solid #22c55e !important;
    }
    .slot-dot.slot-error {
      box-shadow: 0 0 0 2px #ef4444;
      border: 2px solid #ef4444 !important;
    }
    .spool-edit-input { width: min(12rem, 100%); min-width: 5.5ch; padding: 5px 8px; text-align: right; }
    .spool-edit-input[type="number"] { appearance: textfield; -moz-appearance: textfield; }
    .spool-edit-input[type="number"]::-webkit-inner-spin-button,
    .spool-edit-input[type="number"]::-webkit-outer-spin-button { margin: 0; appearance: none; }
    select.spool-edit-input { padding-right: 2.2rem; text-align: left; }
    .spool-edit-field { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
    .spool-input-unit { display: inline-flex; align-items: stretch; gap: 6px; width: min(12rem, 100%); min-width: 6.5rem; }
    .spool-input-unit .spool-edit-input { flex: 1 1 auto; min-width: 5.5ch; }
    .spool-input-unit > span { display: inline-flex; align-items: center; flex: 0 0 auto; padding: 0 5px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-soft); color: var(--text-muted); font-size: .75rem; font-weight: 650; white-space: nowrap; }
    .spool-core-row { grid-template-columns: 1fr; align-items: start; gap: 6px; }
    .spool-core-edit { width: 100%; max-width: none; display: grid; grid-template-columns: minmax(0, 1fr) minmax(6.5rem, 11rem); align-items: center; gap: 8px 16px; text-align: left; }
    .spool-core-edit .spool-input-unit { width: 100%; }
    .spool-core-edit .spool-edit-input { width: 100%; }
    .spool-core-edit small { grid-column: 1 / -1; max-width: 44rem; }
    .spool-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .spool-extra-fields-card { grid-column: 1 / -1; }
    .spool-extra-fields-editor { padding-bottom: 16px; }
    .spool-system-fields-editor { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 12px 16px 0; }
    .spool-extra-fields-help { margin: 12px 16px; color: var(--text-muted); font-size: .8rem; }
    .spool-extra-fields-help a { color: var(--accent); }
    #spool-custom-fields-editor { padding-inline: 16px; }
    .spool-profile-card { overflow: visible; }
    .spool-profile-lookup { margin-inline: -16px; padding: 12px 16px; border-block: 1px solid var(--border); background: color-mix(in srgb, var(--bg-soft) 65%, transparent); }
    .spool-profile-lookup .fdb-lookup-dropdown { position: static; max-height: 18rem; border-top: 1px solid var(--border); border-radius: 0 0 var(--radius-sm) var(--radius-sm); box-shadow: none; }
    .spool-detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 28px 0 12px; }
    .spool-detail-heading h2 { margin: 0; font-size: 1.05rem; }
    .spool-detail-heading > a { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .spool-filament-panel .spool-detail-heading { margin: 0 0 12px; }
    @media (max-width: 640px) {
      .spool-system-fields-editor { grid-template-columns: 1fr; }
      .spool-edit-field { align-items: stretch; flex-direction: column; }
      .spool-core-edit { grid-template-columns: 1fr; }
      .spool-core-edit small { grid-column: auto; }
      .spool-edit-input { width: 100%; }
    }
  </style>

  <script>
    import { t, initI18n } from '../../../lib/i18n'
    import { escapeHtml as escapeExtraFieldHtml, renderFieldInput } from '../../../lib/extra-fields'
    import { createEntityExtraFieldsDialog } from '../../../lib/entity-extra-fields-dialog'
    import {
      buildEntityExtraFieldsForPrint,
      collectExtraFieldPayload,
      createEntityExtraFieldEditor,
      getExtraFieldValue,
      renderDetailExtraFieldRows,
      type EntityExtraFieldEditor,
    } from '../../../lib/entity-extra-fields'
    import { cachedFetchAllPages, fetchSequential, invalidateCachePrefix, CACHE_KEYS } from '../../../lib/cache'
    import { assignableLocations } from '../../../lib/driver-managed-locations'
    import { getAbortSignal, isAbortError } from '../../../lib/abort'
    import { buildFilamentDetailSections, buildFilamentHeaderName, buildFilamentHeroStyle, formatHeaderId, renderFilamentHeaderColors } from '../../../lib/filament-detail'
    import { buildSpoolDetailSections, buildSpoolUpdatePayload, formatSpoolDate, type SpoolDetailRow } from '../../../lib/spool-detail'
    import { formatPrice, formatRfidUid, getCurrency, initCurrency, initRfidDisplayFormat } from '../../../lib/format'
    import { createFilamentDbLookup, type LookupInstance, checkFilamentDbActive } from '../../../lib/filamentdb-lookup'
    import { initPerModelProfilePicker } from '../../../lib/cloud-profile-picker'
    import {
      isBuiltInLabelField,
      scopeLabelExtraField,
      type LabelExtraFieldValue,
    } from '../../../lib/label-extra-fields'
    import {
      buildSpoolLabelDataFromApi,
      buildSpoolPrintSearchParams,
      buildSpoolStandardModelFields,
    } from '../../../lib/spool-label-data'
    import { writeScopedLabelFields } from '../../../lib/label-print-session'
    await initI18n()
    await initCurrency()

    const id = window.location.pathname.split('/').filter(Boolean).pop()!
    if (id === 'detail') {
      window.location.href = '/spools'
    }

    let spool: any = null
    let statuses: any[] = []
    let locations: any[] = []
    // RFID state
    let activeDevices: any[] = []
    let currentRfidSpoolId: any = null
    let printersList: any[] = []
    let currentPrinterParams: any[] = []
    let fieldDefinitions: any[] = []
    let filamentPrinterParams: any[] = []
    let spoolSystemFieldMap: Record<string, any> = {}
    const initialEditSection = new URLSearchParams(window.location.search).get('section')
    const extraFieldsDialogRequested = initialEditSection === 'extra-fields'
    let editing = new URLSearchParams(window.location.search).get('edit') === '1' && !extraFieldsDialogRequested
    let extraFieldsDialog: ReturnType<typeof createEntityExtraFieldsDialog> | null = null
    let detailActionHandlersBound = false
    let spoolProfileLookup: LookupInstance | null = null

    // -- Bambu cloud profile picker (Option A) --
    let currentDriverKey = ''
    let currentPrinterId = 0
    let cloudPresets: any[] = []
    let cloudPresetsByCode: Record<string, any> = {}
    let filamentSystemFieldMap: Record<string, any> = {}
    // Pending slot assignment state (for animated ring feedback)
    let pendingSlotAssign: { slotIndex: string; printerId: number; expectedColor: string } | null = null
    let pendingSlotTimeout: ReturnType<typeof setTimeout> | null = null
    let pendingSlotPollTimer: ReturnType<typeof setTimeout> | null = null
    
    function getCsrfToken() {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }
    
    async function loadData() {
      try {
        // Sequential fetching mit Caching für bessere SQLite-Performance
        const [spoolRes, statusesRes, locationsData, sysFieldsRes, filamentSysFieldsRes] = await fetchSequential([
          () => fetch(`/api/v1/spools/${id}`, { credentials: 'include', signal: getAbortSignal() }),
          () => fetch('/api/v1/spools/statuses', { credentials: 'include', signal: getAbortSignal() }),
          () => cachedFetchAllPages(CACHE_KEYS.LOCATIONS, '/api/v1/locations').then(d => d.items).catch(() => []),
          () => fetch('/api/v1/system-extra-fields?target_type=spool', { credentials: 'include', signal: getAbortSignal() }),
          () => fetch('/api/v1/system-extra-fields?target_type=filament', { credentials: 'include', signal: getAbortSignal() }),
        ] as const)
        const locationsRes = locationsData

        filamentSystemFieldMap = {}
        if (sysFieldsRes.ok) {
          const defs = await sysFieldsRes.json()
          spoolSystemFieldMap = {}
          for (const def of defs) {
            spoolSystemFieldMap[def.key] = def
          }
        }
        if (filamentSysFieldsRes.ok) {
          const defs = await filamentSysFieldsRes.json()
          for (const def of defs) {
            filamentSystemFieldMap[def.key] = def
          }
        }
        
        if (!spoolRes.ok) {
          if (spoolRes.status === 404) {
            document.getElementById('spool-content')!.innerHTML = `<div style="color: var(--error-text);">${t('spools.notFound')}</div>`
            return
          }
          throw new Error('Failed to fetch spool')
        }
        
        spool = await spoolRes.json()
        
        if (statusesRes.ok) {
          statuses = await statusesRes.json()
        }
        
        locations = locationsRes
        
        // Load active devices for RFID functionality
        const devicesRes = await fetch('/api/v1/devices/active', { credentials: 'include', signal: getAbortSignal() })
        if (devicesRes.ok) {
          activeDevices = await devicesRes.json()
        }
        
        renderSpool()
        if (extraFieldsDialogRequested) {
          window.history.replaceState(null, '', `/spools/${id}`)
          openSpoolExtraFields()
        }
        loadPrintersForParams()
        initPerModelProfilePicker({
          entityType: 'spool',
          entityId: parseInt(id),
          filamentId: spool.filament_id,
          filamentLabel: spool.filament?.designation || `#${spool.filament_id}`,
          t,
          getCsrfToken,
          getAbortSignal,
          isAbortError,
        })
        loadEvents()
        setupActions()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load spool:', error)
        document.getElementById('spool-content')!.innerHTML = `<div style="color: var(--error-text);">${t('spools.failedLoadSingle')}</div>`
      }
    }
    
    function getStatusLabel(statusId: any) {
      const s = statuses.find(s => s.id === statusId)
      if (!s) return `#${statusId}`
      const i18nKey = `spools.status${s.key.charAt(0).toUpperCase() + s.key.slice(1)}`
      return t(i18nKey) || s.label
    }
    
    function getLocationName(locationId: any) {
      if (!locationId) return t('spools.noLocation')
      const l = locations.find(l => l.id === locationId)
      return l ? l.name : `#${locationId}`
    }

    function safeExternalUrl(value: unknown): string {
      if (typeof value !== 'string') return ''
      try {
        const url = new URL(value, window.location.origin)
        return url.protocol === 'http:' || url.protocol === 'https:' ? escapeExtraFieldHtml(url.href) : ''
      } catch {
        return ''
      }
    }

    function renderFilamentDetailRow(row: { labelKey: string; value: string; href?: string }): string {
      const href = safeExternalUrl(row.href)
      const value = escapeExtraFieldHtml(row.value)
      return `<div class="filament-spec-row"><span class="filament-spec-label">${t(row.labelKey)}</span><span class="filament-spec-value">${href ? `<a href="${href}" target="_blank" rel="noopener noreferrer">${value}</a>` : value}</span></div>`
    }

    function renderSpoolField(row: SpoolDetailRow): string {
      if (!editing || !row.field) {
        if (row.key === 'rfid') {
          const tags = [spool.rfid_uid, spool.rfid_uid_2]
          return `<span class="filament-spec-value">${tags.map((uid, index) => uid ? `<span style="display: block; white-space: nowrap;">${escapeExtraFieldHtml(formatRfidUid(uid))} <button type="button" class="remove-rfid-tag" data-slot="${index + 1}" aria-label="${t('rfid.removeTag')}" style="border: 0; background: transparent; color: var(--text-muted); cursor: pointer;">×</button></span>` : '').join('') || '—'}</span>`
        }
        return `<span class="filament-spec-value">${escapeExtraFieldHtml(row.value)}</span>`
      }
      const rawValue = spool[row.key]
      if (row.key === 'spool_core_weight_g') {
        const enabled = rawValue !== 0
        return `<span class="filament-spec-value spool-edit-field spool-core-edit">
          <span style="font-size: .75rem; font-weight: 500; white-space: nowrap;"><input id="uses_spool_core" type="checkbox" aria-label="${t('spools.usesSpoolCore')}" ${enabled ? 'checked' : ''}> ${t('spools.usesSpoolCore')}</span>
          <span class="spool-input-unit"><input class="fm-input spool-edit-input" name="${row.key}" type="number" step="1" min="0" placeholder="${escapeExtraFieldHtml(t('spools.spoolCoreWeightPlaceholder'))}" value="${enabled && rawValue != null ? escapeExtraFieldHtml(String(rawValue)) : ''}" ${enabled ? '' : 'disabled'}><span>g</span></span>
          <small style="display: block; color: var(--text-muted); font-size: .72rem; font-weight: 400; line-height: 1.35;">${escapeExtraFieldHtml(t('spools.spoolCoreWeightHint'))}</small>
        </span>`
      }
      if (row.field.type === 'select') {
        const materialLabels: Record<string, string> = { Plastic: 'spools.spoolMaterialPlastic', Cardboard: 'spools.spoolMaterialCardboard', Metal: 'spools.spoolMaterialMetal', Other: 'spools.spoolMaterialOther' }
        return `<select class="fm-select spool-edit-input" name="${row.key}">${row.field.options?.map((option) => `<option value="${option}" ${rawValue === option ? 'selected' : ''}>${option ? escapeExtraFieldHtml(materialLabels[option] ? t(materialLabels[option]) : option) : '—'}</option>`).join('')}</select>`
      }
      const value = row.field.type === 'date' && rawValue ? String(rawValue).split('T')[0] : rawValue ?? ''
      const input = `<input class="fm-input spool-edit-input" name="${row.key}" type="${row.field.type}" ${row.field.step ? `step="${row.field.step}"` : ''} value="${escapeExtraFieldHtml(String(value))}">`
      return row.field.unit ? `<span class="spool-input-unit">${input}<span>${escapeExtraFieldHtml(row.field.unit)}</span></span>` : input
    }

    function renderExtraFields(): string {
      const customFields = spool.custom_fields ?? {}
      const rows = renderDetailExtraFieldRows(customFields, spool.custom_field_definitions ?? {}, spoolSystemFieldMap, t('common.systemField'))
      if (!editing) {
        return `<section class="fm-card filament-spec-card spool-extra-fields-card"><h2 class="filament-spec-title spool-section-heading"><span>${t('common.extraFields')}</span><button id="btn-edit-extra-fields" type="button" class="fm-btn fm-btn-outline" style="font-size: .72rem; padding: 3px 8px;">${t('common.edit')}</button></h2><div class="filament-spec-rows">${rows || `<div style="padding: 8px 0; color: var(--text-muted); font-size: .82rem;">${t('spools.noSpecificExtraFields')}</div>`}</div></section>`
      }
      const systemFields = Object.values(spoolSystemFieldMap).map((field: any) => `<div><label class="fm-label">${escapeExtraFieldHtml(field.label)}</label>${renderFieldInput(field, getExtraFieldValue(customFields, field.key))}</div>`).join('')
      return `<section id="spool-extra-fields-editor" class="fm-card filament-spec-card spool-extra-fields-card spool-extra-fields-editor">
        <h2 class="filament-spec-title spool-section-heading"><span>${t('spools.specificExtraFields')}</span><button type="button" id="btn-add-field" class="fm-btn fm-btn-outline" style="font-size: .8rem; padding: 4px 10px;">+ ${t('common.add')}</button></h2>
        <div id="spool-system-fields-editor" class="spool-system-fields-editor">${systemFields}</div>
        <p class="spool-extra-fields-help">${t('spools.specificExtraFieldsHelp')} <a href="/admin/extra-fields">${t('spools.manageSystemExtraFields')}</a></p>
        <div id="spool-custom-fields-editor"></div>
      </section>`
    }

    function openSpoolExtraFields(trigger?: HTMLElement): void {
      extraFieldsDialog ??= createEntityExtraFieldsDialog({
        targetType: 'spool',
        systemFields: spoolSystemFieldMap,
        async onSave(payload) {
          const response = await fetch(`/api/v1/spools/${spool.id}`, {
            method: 'PATCH',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
            body: JSON.stringify({
              custom_fields: payload.customFields,
              custom_field_definitions: payload.customFieldDefinitions,
            }),
          })
          if (!response.ok) {
            const error = await response.json().catch(() => ({}))
            throw new Error(error.detail?.message || error.message || t('spools.failedUpdate'))
          }
          invalidateCachePrefix('spools')
          window.location.reload()
        },
      })
      extraFieldsDialog.open({
        customFields: spool.custom_fields,
        customFieldDefinitions: spool.custom_field_definitions,
      }, trigger)
    }

    function bindSpoolContentActions() {
      document.getElementById('btn-edit-spool')?.addEventListener('click', () => {
        editing = true
        renderSpool()
      })
      document.getElementById('btn-edit-extra-fields')?.addEventListener('click', event => {
        openSpoolExtraFields(event.currentTarget as HTMLElement)
      })
      document.getElementById('btn-cancel-edit')?.addEventListener('click', () => {
        editing = false
        renderSpool()
      })
      document.getElementById('btn-rfid')?.addEventListener('click', () => {
        if (activeDevices.length === 0) {
          ;(window as any).__fmAlert(t('rfid.noDeviceOnline'))
          return
        }
        window.openRfidModal?.()
      })
      document.querySelectorAll<HTMLButtonElement>('.remove-rfid-tag').forEach((button) => button.addEventListener('click', () => {
        const slot = Number(button.dataset.slot)
        const uid = slot === 1 ? spool.rfid_uid : spool.rfid_uid_2
        if (uid) (window as any).removeRfidTag(slot, uid)
      }))
    }

    async function setupInlineEditor() {
      const form = document.getElementById('spool-inline-form') as HTMLFormElement
      const customFieldsContainer = document.getElementById('spool-custom-fields-editor')!
      const spoolExtraFieldEditor: EntityExtraFieldEditor = createEntityExtraFieldEditor({
        container: customFieldsContainer,
        addButton: document.getElementById('btn-add-field')!,
        emptyText: t('spools.noSpecificExtraFields'),
      })
      spoolExtraFieldEditor.setSystemFieldKeys(Object.keys(spoolSystemFieldMap))
      spoolExtraFieldEditor.setData(spool.custom_fields, spool.custom_field_definitions)
      const usesCore = document.getElementById('uses_spool_core') as HTMLInputElement | null
      usesCore?.addEventListener('change', () => {
        const input = form.elements.namedItem('spool_core_weight_g') as HTMLInputElement
        input.disabled = !usesCore.checked
      })
      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        const submit = document.querySelector('[form="spool-inline-form"][type="submit"]') as HTMLButtonElement
        const error = document.getElementById('spool-edit-error')!
        error.classList.add('hidden')
        const extraFields = collectExtraFieldPayload(document.getElementById('spool-system-fields-editor')!, spoolExtraFieldEditor)
        if (!extraFields) return
        submit.disabled = true
        try {
          const payload = buildSpoolUpdatePayload(new FormData(form), usesCore?.checked ?? true)
          Object.assign(payload, {
            custom_fields: extraFields.customFields,
            custom_field_definitions: extraFields.customFieldDefinitions,
          })
          const response = await fetch(`/api/v1/spools/${spool.id}`, {
            method: 'PATCH',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
            body: JSON.stringify(payload),
          })
          if (!response.ok) {
            const data = await response.json().catch(() => ({}))
            throw new Error(data.detail?.message || data.message || t('spools.failedUpdate'))
          }
          invalidateCachePrefix('spools')
          window.location.reload()
        } catch (err) {
          error.textContent = err instanceof Error ? err.message : t('spools.failedUpdate')
          error.classList.remove('hidden')
          submit.disabled = false
        }
      })

      const lookupButton = document.getElementById('btn-spool-profile-lookup') as HTMLButtonElement | null
      if (!lookupButton || !(await checkFilamentDbActive())) {
        lookupButton?.remove()
        return
      }
      lookupButton.addEventListener('click', () => {
        const section = document.getElementById('spool-profile-lookup-section')!
        section.classList.toggle('hidden')
        if (section.classList.contains('hidden') || spoolProfileLookup) return
        spoolProfileLookup = createFilamentDbLookup({
          container: document.getElementById('spool-profile-lookup-container')!,
          endpoint: '/filamentdb/spool-profiles',
          placeholder: t('filamentdbLookup.searchSpoolProfile'),
          minChars: 0,
          pageSize: 100,
          renderItem: (item: any) => {
            const details = [item.empty_weight_g != null ? `${item.empty_weight_g}g` : '', item.spool_material || '', item.outer_diameter_mm != null ? `${item.outer_diameter_mm}mm` : ''].filter(Boolean).join(' · ')
            const image = item.image_file ? `<img class="fdb-lookup-item-image" src="/api/v1/filamentdb/spool-profile-image?image_file=${encodeURIComponent(item.image_file)}" alt="" loading="lazy" onerror="this.style.display='none'">` : '<span class="fdb-lookup-item-image-placeholder">📦</span>'
            return `<div class="fdb-lookup-item-with-image">${image}<div class="fdb-lookup-item-text"><div class="fdb-lookup-item-name">${escapeExtraFieldHtml(item.name || '?')}</div><div class="fdb-lookup-item-sub">${escapeExtraFieldHtml(details)}</div></div></div>`
          },
          onSelect: (item: any) => {
            for (const [name, value] of Object.entries({ empty_spool_weight_g: item.empty_weight_g, spool_material: item.spool_material, spool_outer_diameter_mm: item.outer_diameter_mm, spool_width_mm: item.width_mm })) {
              const input = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null
              if (input && value != null) input.value = String(value)
            }
            const toast = document.getElementById('spool-profile-lookup-toast')!
            toast.className = 'fdb-toast fdb-toast-success'
            toast.textContent = t('filamentdbLookup.spoolProfileLoaded')
            toast.style.display = ''
          },
        })
      })
    }
    
    function renderSpool() {
      spoolProfileLookup?.destroy()
      spoolProfileLookup = null
      const remaining = spool.remaining_weight_g == null ? '—' : `${Number(spool.remaining_weight_g).toFixed(0)} g`
      const rfid = [spool.rfid_uid, spool.rfid_uid_2].filter(Boolean).map(formatRfidUid).join(' · ')
      const spoolSections = buildSpoolDetailSections({
        ...spool,
        status: getStatusLabel(spool.status_id),
        remaining,
        location: getLocationName(spool.location_id),
        purchase_price: spool.purchase_price == null ? null : formatPrice(spool.purchase_price, getCurrency()),
        purchase_date: formatSpoolDate(spool.purchase_date),
        rfid,
      }, {
        coreDisabled: t('common.off'),
        coreGlobalDefault: t('spools.spoolCoreWeightPlaceholder'),
      })
      const spoolProfileLookupHtml = editing ? `<div id="spool-profile-lookup-section" class="spool-profile-lookup hidden"><div id="spool-profile-lookup-container"></div><div id="spool-profile-lookup-toast" class="fdb-toast" style="display: none;"></div></div>` : ''
      const spoolSectionsHtml = spoolSections.map((section) => `<section class="fm-card filament-spec-card${section.key === 'spool' ? ' spool-profile-card' : ''}">
        <h2 class="filament-spec-title spool-section-heading"><span>${t(section.titleKey)}</span>${editing && section.key === 'spool' ? `<button id="btn-spool-profile-lookup" type="button" class="fm-btn fm-btn-outline" style="font-size: .72rem; padding: 3px 8px;">${t('filamentdbLookup.loadFromDb')}</button>` : ''}</h2>
        <div class="filament-spec-rows">${section.rows.map((row) => `${editing && section.key === 'spool' && row.key === 'spool_material' ? spoolProfileLookupHtml : ''}<label class="filament-spec-row${editing && row.key === 'spool_core_weight_g' ? ' spool-core-row' : ''}"><span class="filament-spec-label">${t(row.labelKey)}</span>${renderSpoolField(row)}</label>`).join('')}</div>
      </section>`).join('')
      const finishLabels: Record<string, string> = { solid: 'filaments.finishSolid', translucent: 'filaments.finishTranslucent', neon: 'filaments.finishNeon', glow: 'filaments.finishGlow' }
      const filamentSections = buildFilamentDetailSections(spool.filament || {}, {
        price: spool.filament?.price == null ? undefined : formatPrice(spool.filament.price, spool.filament.price_currency || getCurrency()),
        finish: finishLabels[spool.filament?.finish_type] ? t(finishLabels[spool.filament.finish_type]) : spool.filament?.finish_type,
        discontinued: spool.filament?.is_discontinued == null ? undefined : t(spool.filament.is_discontinued ? 'common.yes' : 'common.no'),
        spoolTitleKey: 'filaments.packagingDefaults',
      })
      const filamentSectionsHtml = filamentSections.map((section) => `<section class="fm-card filament-spec-card"><h3 class="filament-spec-title">${t(section.titleKey)}</h3><div class="filament-spec-rows">${section.rows.map(renderFilamentDetailRow).join('')}</div></section>`).join('')
      const filamentExtraFieldRows = renderDetailExtraFieldRows(
        spool.filament?.custom_fields ?? {},
        spool.filament?.custom_field_definitions ?? {},
        filamentSystemFieldMap,
        t('common.systemField'),
      )
      const filamentExtraFieldsHtml = `<section class="fm-card filament-spec-card"><h3 class="filament-spec-title">${t('common.extraFields')}</h3><div class="filament-spec-rows">${filamentExtraFieldRows || `<div style="padding: 8px 0; color: var(--text-muted); font-size: .82rem;">${t('filaments.noSpecificExtraFields')}</div>`}</div></section>`
      const spoolContent = document.getElementById('spool-content')!
      const quickActions = document.getElementById('actions-section')!
      quickActions.remove()
      
      spoolContent.innerHTML = `
        <header class="filament-hero" style="${buildFilamentHeroStyle(spool.filament)}">
          <div class="filament-hero-layout">
          <div class="filament-hero-identity">
            <div class="filament-hero-title-row">
              <div class="filament-hero-title-copy">
                <h1><span class="detail-record-id">${escapeExtraFieldHtml(t('spools.spoolId', { id: formatHeaderId(spool.id) }))}<span class="detail-record-divider">·</span><a class="filament-hero-link" href="/filaments/${encodeURIComponent(String(spool.filament_id))}">${t('spools.filament')} #${escapeExtraFieldHtml(formatHeaderId(spool.filament_id))}</a></span><span class="detail-record-name">${escapeExtraFieldHtml(buildFilamentHeaderName(spool.filament || {}))}</span></h1>
              </div>
              ${safeExternalUrl(spool.filament?.manufacturer?.logo_url) ? `<span class="filament-hero-logo"><img src="${safeExternalUrl(spool.filament.manufacturer.logo_url)}" alt="" onerror="this.parentElement.style.display='none'" /></span>` : ''}
            </div>
            <div class="filament-hero-body">
              ${renderFilamentHeaderColors(spool.filament || {}, t('filaments.soldAs'))}
              <div class="detail-hero-stats">
                <div class="detail-hero-stat"><svg aria-hidden="true"><use href="/icons.svg?v=detail2#icon-status"></use></svg><div><span>${t('spools.status')}</span><strong>${escapeExtraFieldHtml(getStatusLabel(spool.status_id))}</strong></div></div>
                <div class="detail-hero-stat"><svg aria-hidden="true"><use href="/icons.svg?v=detail3#icon-balance"></use></svg><div><span>${t('spools.remaining')}</span><strong>${escapeExtraFieldHtml(remaining)}</strong></div></div>
                <div class="detail-hero-stat"><svg aria-hidden="true"><use href="/icons.svg?v=detail2#icon-location"></use></svg><div><span>${t('spools.location')}</span><strong>${escapeExtraFieldHtml(getLocationName(spool.location_id))}</strong></div></div>
              </div>
            </div>
          </div>
          <div>
            <div id="printer-slots-inline"></div>
            <div class="detail-page-actions" role="group" aria-label="${t('common.actions')}">
            <button id="btn-rfid" type="button" class="detail-icon-button" style="${(spool.rfid_uid || spool.rfid_uid_2) ? 'color: #10b981;' : 'color: var(--text);'}" aria-label="${t('rfid.writeTag')}" title="${t('rfid.writeTag')}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true"><path d="M13 5C2 14 2 34 13 43 M35 5c11 9 11 29 0 38 M17 11c-8 7-8 19 0 26 M31 11c8 7 8 19 0 26 M21 17c-4 4-4 10 0 14 M27 17c4 4 4 10 0 14"/><circle cx="24" cy="24" r="2.5" fill="currentColor" stroke="none"/></svg>
            </button>
            ${editing ? `<button type="submit" form="spool-inline-form" class="fm-btn fm-btn-primary">${t('common.save')}</button><button id="btn-cancel-edit" type="button" class="fm-btn fm-btn-outline">${t('common.cancel')}</button>` : `<button id="btn-edit-spool" type="button" class="detail-icon-button" aria-label="${t('common.edit')}" title="${t('common.edit')}"><svg aria-hidden="true"><use href="/icons.svg?v=detail2#icon-edit"></use></svg></button><button id="btn-duplicate-spool" type="button" class="detail-icon-button" aria-label="${t('common.duplicate')}" title="${t('common.duplicate')}"><svg aria-hidden="true"><use href="/icons.svg?v=detail2#icon-copy"></use></svg></button><button id="btn-delete" type="button" class="detail-icon-button detail-icon-danger" aria-label="${t('common.delete')}" title="${t('common.delete')}"><svg aria-hidden="true"><use href="/icons.svg?v=detail2#icon-trash"></use></svg></button>`}
            </div>
          </div>
        </header>

        <form id="spool-inline-form">
          <div class="filament-spec-grid">${spoolSectionsHtml}${renderExtraFields()}</div>
          <div id="spool-edit-error" class="fm-alert-error hidden" style="margin-top: 12px;"></div>
        </form>
        ${filamentSectionsHtml ? `<section class="spool-filament-panel"><div class="spool-detail-heading"><h2>${t('spools.filamentDetails')}</h2><a href="/filaments/${spool.filament_id}/edit" class="fm-btn fm-btn-outline"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>${t('spools.editFilament')}</a></div><div class="filament-spec-grid">${filamentSectionsHtml}${filamentExtraFieldsHtml}</div></section>` : ''}
      `
      const toolbar = document.querySelector('.detail-page-toolbar')!
      const pageActions = spoolContent.querySelector('.detail-page-actions')!
      pageActions.prepend(spoolContent.querySelector('#printer-slots-inline')!)
      toolbar.querySelector('.detail-page-actions, #spool-page-actions')!.replaceWith(pageActions)
      spoolContent.querySelector('.filament-hero-layout > div:last-child')?.remove()
      spoolContent.querySelector('.filament-hero')!.insertAdjacentElement('afterend', quickActions)

      bindSpoolContentActions()
      loadPrinterSlotOverview()
      if (editing) setupInlineEditor()
      
      const printParams = buildSpoolPrintSearchParams(spool)
      const printUrl = `/spools/${spool.id}/print?${printParams.toString()}`

      // Store extra fields for label printing (spool + filament).
      // Iterate ALL system-defined fields so they appear in the designer even when
      // the spool hasn't had a value set for a field yet.
      const efForPrint: LabelExtraFieldValue[] = []

      // ── Spool model fields (always included so they appear as label checkboxes) ──
      const spoolModelFields = buildSpoolStandardModelFields(buildSpoolLabelDataFromApi(spool))
      for (const { key, label, value } of spoolModelFields) {
        efForPrint.push({ key, label, value: value !== undefined && value !== null ? String(value) : '', source: 'spool' })
      }

      for (const field of buildEntityExtraFieldsForPrint(
        spool.custom_fields,
        spool.custom_field_definitions,
        spoolSystemFieldMap,
        true,
      )) {
        if (isBuiltInLabelField('spool', field.key, field.label)) continue
        efForPrint.push(scopeLabelExtraField(field, 'spool'))
      }
      for (const field of buildEntityExtraFieldsForPrint(
        spool.filament?.custom_fields,
        spool.filament?.custom_field_definitions,
        filamentSystemFieldMap,
        true,
      )) {
        if (isBuiltInLabelField('filament', field.key, field.label)) continue
        efForPrint.push(scopeLabelExtraField(field, 'filament'))
      }
      writeScopedLabelFields('filaman-label-extra-fields', spool.id, efForPrint)

      const printBtn = document.getElementById('btn-print-label') as HTMLAnchorElement
      if (printBtn) printBtn.href = printUrl
      
      document.getElementById('actions-section')!.classList.remove('hidden')
      
      // Delete Modal Logic
      const deleteModal = document.getElementById('delete-modal')
      const deleteCheckbox = document.getElementById('delete-permanent-checkbox') as HTMLInputElement
      const deleteWarning = document.getElementById('delete-permanent-warning')
      const deleteConfirmBtn = document.getElementById('btn-delete-confirm') as HTMLButtonElement
      
      document.getElementById('btn-duplicate-spool')?.addEventListener('click', () => {
        // Copy physical/product fields only. Do NOT carry identity, RFID, AMS
        // location, status, or remaining weight — those must be set by write-tag /
        // weigh / driver assign-configure when the new spool is actually placed.
        const dupData = { ...spool }
        for (const key of [
          'id',
          'rfid_uid',
          'external_id',
          'location_id',
          'location',
          'status_id',
          'status',
          'remaining_weight_g',
          'last_used_at',
          'stocked_in_at',
          'created_at',
          'updated_at',
          'printer_params',
          'events',
        ]) {
          delete dupData[key]
        }
        sessionStorage.setItem('filaman_duplicate_spool', JSON.stringify(dupData))
        window.location.href = '/spools/new'
      })
      
      document.getElementById('btn-delete')?.addEventListener('click', () => {
        deleteModal?.classList.remove('hidden')
        deleteCheckbox.checked = false
        deleteWarning?.classList.add('hidden')
        deleteConfirmBtn.textContent = t('spools.archiveSpool')
        ;(document.getElementById('delete-modal-title') as HTMLElement).textContent = t('spools.archiveSpool')
      })
      
      if (!detailActionHandlersBound) {
        detailActionHandlersBound = true
        deleteCheckbox?.addEventListener('change', () => {
        if (deleteCheckbox.checked) {
          deleteWarning?.classList.remove('hidden')
          deleteConfirmBtn.textContent = t('spools.deleteSpool')
          ;(document.getElementById('delete-modal-title') as HTMLElement).textContent = t('spools.deleteSpool')
        } else {
          deleteWarning?.classList.add('hidden')
          deleteConfirmBtn.textContent = t('spools.archiveSpool')
          ;(document.getElementById('delete-modal-title') as HTMLElement).textContent = t('spools.archiveSpool')
        }
        })
      
        document.getElementById('btn-delete-cancel')?.addEventListener('click', () => {
          deleteModal?.classList.add('hidden')
        })
      
        document.getElementById('btn-delete-confirm')?.addEventListener('click', async () => {
        const isPermanent = deleteCheckbox.checked
        const url = isPermanent 
          ? `/api/v1/spools/${id}/permanent` 
          : `/api/v1/spools/${id}`
        
        try {
          const response = await fetch(url, {
            method: 'DELETE',
            headers: { 'X-CSRF-Token': getCsrfToken() },
            credentials: 'include',
            signal: getAbortSignal(),
          })
          
          if (response.ok) {
            window.location.href = '/spools'
          } else {
            await (window as any).__fmAlert(t('spools.failedDelete'))
          }
        } catch {
          // user-initiated action — show error even on abort
          await (window as any).__fmAlert(t('spools.failedDelete'))
        }
        })
      }
    }
    
    async function loadEvents() {
      try {
        const response = await fetch(`/api/v1/spools/${id}/events?page_size=50`, {
          credentials: 'include',
          signal: getAbortSignal(),
        })
        
        if (!response.ok) throw new Error('Failed to fetch events')
        
        const data = await response.json()
        document.getElementById('events-section')?.classList.remove('hidden')
        renderEvents(data.items)
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load events:', error)
      }
    }
    
    function renderEvents(events: any) {
      const tbody = document.getElementById('events-table') as HTMLElement
      
      if (events.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="4" style="text-align: center; color: var(--text-muted);">${t('spools.noEvents')}</td>
          </tr>
        `
        return
      }
      
      tbody.innerHTML = events.map((e: any) => `
        <tr>
          <td style="padding: 12px;">
            <span class="fm-pill" style="${getEventTypeStyle(e.event_type)}">${e.event_type}</span>
          </td>
          <td style="padding: 12px; font-size: 0.85rem; color: var(--text-muted);">
            ${new Date(e.event_at).toLocaleString()}
          </td>
          <td style="padding: 12px; font-family: monospace; font-size: 0.85rem;">
            ${e.measured_weight_g !== null ? e.measured_weight_g.toFixed(0) + 'g' : ''}
            ${e.delta_weight_g !== null ? (e.delta_weight_g > 0 ? '+' : '') + e.delta_weight_g.toFixed(0) + 'g' : ''}
          </td>
          <td style="padding: 12px; font-size: 0.85rem; color: var(--text-muted);">${e.note || '-'}</td>
        </tr>
      `).join('')
    }
    
    function getEventTypeStyle(type: any) {
      const styles = {
        measurement: 'border-color: var(--accent-2); color: var(--accent-2);',
        adjustment: 'border-color: var(--accent); color: var(--accent);',
        consumption: 'border-color: var(--accent-3); color: var(--accent-3);',
        status_change: 'border-color: var(--accent-3); color: var(--accent-3);',
        move_location: 'border-color: var(--accent); color: var(--accent);',
      }
      return styles[type as keyof typeof styles] || ''
    }
    
    function setupActions() {
      document.getElementById('btn-measurement')?.addEventListener('click', () => showModal('measurement'))
      document.getElementById('btn-adjustment')?.addEventListener('click', () => showModal('adjustment'))
      document.getElementById('btn-status')?.addEventListener('click', () => showModal('status'))
      document.getElementById('btn-move')?.addEventListener('click', () => showModal('move'))

      // Print Label button
      document.getElementById('btn-print-label')?.addEventListener('click', () => {
        printLabel()
      })
    }

    async function printLabel() {
      if (!spool) return

      // Load qrcode.min.js dynamically if not already loaded
      if (typeof (window as any).QRCode === 'undefined') {
        await new Promise((resolve, reject) => {
          const script = document.createElement('script')
          script.src = '/vendor/qrcode.min.js'
          script.onload = resolve
          script.onerror = reject
