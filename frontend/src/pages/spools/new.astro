---
import Layout from '../../layouts/Layout.astro'
import SpoolForm from '../../components/SpoolForm.astro'

---

<Layout title="FilaMan - New Spool">
  <div class="detail-page-toolbar">
    <a href="/spools" class="detail-back-link">&larr; <span data-i18n="spools.backToSpools">Back to Spools</span></a>
    <div class="detail-page-actions">
      <button type="submit" form="spool-form" id="submit-btn" disabled class="fm-btn fm-btn-primary" data-i18n="spools.createSpool">Create Spool</button>
      <a href="/spools" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</a>
    </div>
  </div>
  <SpoolForm />

  <!-- Modal: Von Tag übernehmen -->
  <div id="import-tag-modal" class="fm-modal-overlay">
    <div class="fm-modal" style="max-width: 440px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h2 style="margin: 0; font-weight: 600; font-size: 1.1rem;" data-i18n="spools.importFromTagTitle">Von Tag übernehmen</h2>
        <button id="import-tag-close" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; padding: 4px 8px; color: var(--text-muted);">✕</button>
      </div>
      <div id="import-tag-content" style="min-height: 80px;"></div>
    </div>
  </div>

  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { isIntegrationExtraFieldPath, renderSystemFieldRow, type SystemExtraFieldDef } from '../../lib/extra-fields'
    import {
      collectExtraFieldPayload,
      createEntityExtraFieldEditor,
      getExtraFieldValue,
    } from '../../lib/entity-extra-fields'
    import { cachedFetchAllPages, fetchSequential, CACHE_KEYS, invalidateCachePrefix } from '../../lib/cache'
    import { assignableLocations } from '../../lib/driver-managed-locations'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { initCurrency, suggestSpoolPurchasePrice } from '../../lib/format'
    const params = new URLSearchParams(window.location.search)
    let duplicateFilamentId: unknown = null
    try {
      duplicateFilamentId = JSON.parse(sessionStorage.getItem('filaman_duplicate_spool') || 'null')?.filament_id
    } catch (error) {
      console.error('Failed to read duplicate spool filament:', error)
    }
    if (!params.get('filament_id') && params.get('from_tag') !== '1' && !duplicateFilamentId) {
      window.location.replace('/filaments?select_for_spool=1')
    } else {
    await initI18n()
    const appCurrency = await initCurrency()

    // Set default purchase_date to today
    const purchaseDateInput = document.getElementById('purchase_date') as HTMLInputElement
    if (purchaseDateInput) {
      purchaseDateInput.value = new Date().toISOString().split('T')[0]
    }

    const filamentId = params.get('filament_id')
    
    // Custom Fields
    const customFieldsContainer = document.getElementById('custom-fields-container') as HTMLDivElement
    const btnAddField = document.getElementById('btn-add-field') as HTMLButtonElement

    const entityExtraFields = createEntityExtraFieldEditor({
      container: customFieldsContainer,
      addButton: btnAddField,
      emptyText: t('spools.noSpecificExtraFields'),
    })

    let filaments: any[] = []
    let systemFields: SystemExtraFieldDef[] = []
    let submitting = false

    const filamentHiddenInput = document.getElementById('filament_id') as HTMLInputElement
    const filamentDropdownText = document.getElementById('filament-dropdown-text')!

    function setFilamentDropdownVisual(id: number) {
      const filament = filaments.find(item => item.id === id)
      if (!filament) return
      filamentHiddenInput.value = String(id)
      filamentDropdownText.textContent = `${filament.manufacturer?.name || ''} ${filament.designation} (${filament.material_type})`.trim()
      filamentDropdownText.removeAttribute('data-i18n')
      const details = document.getElementById('spool-create-details') as HTMLFieldSetElement
      details.hidden = false
      details.disabled = false
      submitBtn.disabled = submitting
    }

    function selectFilament(id: number) {
      setFilamentDropdownVisual(id)
      applyFilamentDefaults(id)
      applyDuplicateSpoolData()
      restoreSpoolDraft()
    }

    function applySelectedFilament(preselectedId?: string | null) {
      if (preselectedId) setFilamentDropdownVisual(Number(preselectedId))
    }

    function flattenObject(obj: Record<string, unknown>, prefix = '', res: Record<string, unknown> = {}) {
      for (const key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
          const val = obj[key]
          const newKey = prefix ? `${prefix}.${key}` : key
          if (typeof val === 'object' && val !== null && !Array.isArray(val)) {
            flattenObject(val as Record<string, unknown>, newKey, res)
          } else {
            res[newKey] = val
          }
        }
      }
      return res
    }

    function renderSystemFields(flat: Record<string, unknown> = {}, raw?: Record<string, unknown>) {
      const container = document.getElementById('system-fields-container') as HTMLDivElement | null
      const grid = document.getElementById('system-fields-grid') as HTMLDivElement | null
      if (!container || !grid) return
      if (!systemFields || systemFields.length === 0) {
        container.style.display = 'none'
        return
      }
      container.style.display = 'block'
      grid.innerHTML = systemFields.map(field => renderSystemFieldRow(field, raw ? getExtraFieldValue(raw, field.key) : null, flat)).join('')
    }

    function applyDuplicateSpoolData() {
      // ── Apply duplicate data from sessionStorage ──
      const dupRaw = sessionStorage.getItem('filaman_duplicate_spool')
      if (dupRaw) {
        try {
          const dup = JSON.parse(dupRaw)

          // Filament
          if (dup.filament_id) {
            setFilamentDropdownVisual(Number(dup.filament_id))
          }
          if (!filamentHiddenInput.value) return

          // Initial Total Weight
          if (dup.initial_total_weight_g != null) {
            (document.getElementById('initial_total_weight_g') as HTMLInputElement).value = String(dup.initial_total_weight_g)
          }

          // Empty Spool Weight
          if (dup.empty_spool_weight_g != null) {
            (document.getElementById('empty_spool_weight_g') as HTMLInputElement).value = String(dup.empty_spool_weight_g)
          }

          // Spool Core Weight
          {
            const dupCoreCheckbox = document.getElementById('uses_spool_core') as HTMLInputElement
            const dupCoreContainer = document.getElementById('spool_core_weight_container')!
            const dupCoreInput = document.getElementById('spool_core_weight_g') as HTMLInputElement
            if (dup.spool_core_weight_g === 0) {
              dupCoreCheckbox.checked = false
              dupCoreContainer.style.display = 'none'
              dupCoreInput.value = ''
            } else {
              dupCoreCheckbox.checked = true
              dupCoreContainer.style.display = 'block'
              dupCoreInput.value = dup.spool_core_weight_g != null ? String(dup.spool_core_weight_g) : ''
            }
          }

          // Spool Material
          if (dup.spool_material) {
            (document.getElementById('spool_material') as HTMLSelectElement).value = dup.spool_material
          }

          // Spool Outer Diameter
          if (dup.spool_outer_diameter_mm != null) {
            (document.getElementById('spool_outer_diameter_mm') as HTMLInputElement).value = String(dup.spool_outer_diameter_mm)
          }

          // Spool Width
          if (dup.spool_width_mm != null) {
            (document.getElementById('spool_width_mm') as HTMLInputElement).value = String(dup.spool_width_mm)
          }

          // Location is intentionally NOT copied from duplicate. AMS/slot
          // locations must be set only when the driver assigns after a scan+place.

          // Lot Number
          if (dup.lot_number) {
            (document.getElementById('lot_number') as HTMLInputElement).value = dup.lot_number
          }

          // External ID
          if (dup.external_id) {
            (document.getElementById('external_id') as HTMLInputElement).value = dup.external_id
          }

          // Purchase Price
          if (dup.purchase_price != null) {
            (document.getElementById('purchase_price') as HTMLInputElement).value = String(dup.purchase_price)
          }

          // Purchase Date
          if (dup.purchase_date) {
            (document.getElementById('purchase_date') as HTMLInputElement).value = dup.purchase_date
          }

          // Low Weight Threshold
          if (dup.low_weight_threshold_g != null) {
            (document.getElementById('low_weight_threshold_g') as HTMLInputElement).value = String(dup.low_weight_threshold_g)
          }

          // RFID UID (only when explicitly included, e.g. from empty spool template)
          if (dup.rfid_uid) {
            (document.getElementById('rfid_uid') as HTMLInputElement).value = dup.rfid_uid
          }
          if (dup.rfid_uid_2) {
            (document.getElementById('rfid_uid_2') as HTMLInputElement).value = dup.rfid_uid_2
          }

          // Custom Fields (non-system) + System Fields
          if (dup.custom_fields && typeof dup.custom_fields === 'object') {
            // Prefill system fields from duplicate
            const dupFlat = flattenObject(dup.custom_fields)
            renderSystemFields(dupFlat, dup.custom_fields)
          }
          entityExtraFields.setData(dup.custom_fields, dup.custom_field_definitions)
          sessionStorage.removeItem('filaman_duplicate_spool')
        } catch (e) {
          console.error('Failed to apply duplicate spool data:', e)
        }
      }
    }

    async function loadOptions() {
      try {
        // Sequential fetching mit Caching für bessere SQLite-Performance
        const [filamentsData, locationsData, systemFieldsRes] = await fetchSequential([
          () => cachedFetchAllPages(CACHE_KEYS.FILAMENTS, '/api/v1/filaments'),
          () => cachedFetchAllPages(CACHE_KEYS.LOCATIONS, '/api/v1/locations'),
          () => fetch('/api/v1/system-extra-fields?target_type=spool', { credentials: 'include', signal: getAbortSignal() }),
        ] as const)
        
        if (!systemFieldsRes.ok) throw new Error(t('common.systemFieldsUnavailable'))
        systemFields = (await systemFieldsRes.json()).filter((field: SystemExtraFieldDef) => !isIntegrationExtraFieldPath(field.key))
        entityExtraFields.setSystemFieldKeys(systemFields.map(field => field.key))
        renderSystemFields()
        
        if (filamentsData) {
          filaments = filamentsData.items
          applySelectedFilament(filamentId)
          if (filamentId) {
            applyFilamentDefaults(parseInt(filamentId))
          }
        }
        
        if (locationsData) {
          const select = document.getElementById('location_id') as HTMLSelectElement
          // AMS/slot locations are driver-managed — only set via scan+place assign.
          assignableLocations(locationsData.items as any[]).forEach((l: any) => {
            const option = document.createElement('option')
            option.value = l.id
            option.textContent = l.name
            select.appendChild(option)
          })
        }

        applyDuplicateSpoolData()
        restoreSpoolDraft()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load options:', error)
        errorMessage.textContent = t('common.systemFieldsUnavailable')
        errorMessage.classList.remove('hidden')
        submitBtn.disabled = true
      }
    }

    async function checkActiveDevicesForImport() {
      try {
        const res = await fetch('/api/v1/devices/active', { credentials: 'include' })
        const devices: any[] = await res.json()
        if (btnImportFromTag) {
          const hasDevice = devices && devices.length > 0
          btnImportFromTag.style.opacity = hasDevice ? '1' : '0.45'
          btnImportFromTag.title = hasDevice ? '' : t('spools.importFromTagNoDevices')
        }
      } catch { /* ignore */ }
    }

    function applyFilamentDefaults(selectedFilamentId: number) {
      const filament = filaments.find((f) => f.id === selectedFilamentId)
      if (!filament) return

      const initialWeightInput = document.getElementById('initial_total_weight_g') as HTMLInputElement
      const emptySpoolInput = document.getElementById('empty_spool_weight_g') as HTMLInputElement
      const matInput = document.getElementById('spool_material') as HTMLSelectElement
      const odInput = document.getElementById('spool_outer_diameter_mm') as HTMLInputElement
      const wInput = document.getElementById('spool_width_mm') as HTMLInputElement
      const priceInput = document.getElementById('purchase_price') as HTMLInputElement

      const rawWeight = filament.raw_material_weight_g
      // Fallback to manufacturer settings if filament defaults are null
      const spoolWeight = filament.default_spool_weight_g ?? filament.manufacturer?.empty_spool_weight_g

      if (rawWeight != null && spoolWeight != null) {
        initialWeightInput.value = String(rawWeight + spoolWeight)
      } else if (rawWeight != null) {
        initialWeightInput.value = String(rawWeight)
      } else {
        initialWeightInput.value = ''
      }

      if (spoolWeight != null) {
        emptySpoolInput.value = String(spoolWeight)
      } else {
        emptySpoolInput.value = ''
      }

      matInput.value = filament.spool_material || filament.manufacturer?.spool_material || ''
      odInput.value = filament.spool_outer_diameter_mm != null ? String(filament.spool_outer_diameter_mm) : (filament.manufacturer?.spool_outer_diameter_mm != null ? String(filament.manufacturer.spool_outer_diameter_mm) : '')
      wInput.value = filament.spool_width_mm != null ? String(filament.spool_width_mm) : (filament.manufacturer?.spool_width_mm != null ? String(filament.manufacturer.spool_width_mm) : '')
      
      priceInput.value = suggestSpoolPurchasePrice(filament.price, filament.price_currency, appCurrency)
    }

    
    function getCsrfToken() {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }
    
    const form = document.getElementById('spool-form') as HTMLFormElement
    const errorMessage = document.getElementById('error-message') as HTMLElement
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement

    document.querySelectorAll<HTMLAnchorElement>('.detail-page-toolbar a[href="/spools"]').forEach(link => {
      link.addEventListener('click', () => sessionStorage.removeItem('filaman_spool_create_draft'))
    })

    form.querySelectorAll<HTMLAnchorElement>('a[href="/filaments?select_for_spool=1"], a[href="/filaments/new?create_spool=1"]').forEach(link => {
      link.addEventListener('click', event => {
        if (submitting) { event.preventDefault(); return }
        const extraFields = collectExtraFieldPayload(document.getElementById('system-fields-grid')!, entityExtraFields)
        if (!extraFields) { event.preventDefault(); return }
        try {
          sessionStorage.setItem('filaman_spool_create_draft', JSON.stringify({
            fields: Object.fromEntries(new FormData(form)),
            usesSpoolCore: usesCoreCheckbox.checked,
            ...extraFields,
          }))
        } catch (error) {
          event.preventDefault()
          errorMessage.textContent = error instanceof Error ? error.message : t('common.errorTitle')
          errorMessage.classList.remove('hidden')
        }
      })
    })

    function restoreSpoolDraft() {
      if (!filamentHiddenInput.value) return
      const raw = sessionStorage.getItem('filaman_spool_create_draft')
      if (!raw) return
      try {
        const draft = JSON.parse(raw)
        for (const [name, value] of Object.entries(draft.fields)) {
          if (name === 'filament_id') continue
          const input = form.elements.namedItem(name)
          if (input instanceof HTMLInputElement || input instanceof HTMLSelectElement || input instanceof HTMLTextAreaElement) input.value = String(value)
        }
        usesCoreCheckbox.checked = draft.usesSpoolCore
        coreWeightContainer.style.display = usesCoreCheckbox.checked ? 'block' : 'none'
        renderSystemFields(flattenObject(draft.customFields || {}), draft.customFields)
        entityExtraFields.setData(draft.customFields, draft.customFieldDefinitions)
        if (draft.fields.filament_id !== filamentHiddenInput.value) applyFilamentDefaults(Number(filamentHiddenInput.value))
        sessionStorage.removeItem('filaman_spool_create_draft')
      } catch (error) {
        errorMessage.textContent = error instanceof Error ? error.message : t('common.errorTitle')
        errorMessage.classList.remove('hidden')
      }
    }

    // Wire checkbox toggle for core weight field
    const usesCoreCheckbox = document.getElementById('uses_spool_core') as HTMLInputElement
    const coreWeightContainer = document.getElementById('spool_core_weight_container')!
    usesCoreCheckbox.addEventListener('change', () => {
      coreWeightContainer.style.display = usesCoreCheckbox.checked ? 'block' : 'none'
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (submitting || submitBtn.disabled || !filaments.some(item => item.id === Number(filamentHiddenInput.value))) return
      
      const formData = new FormData(form)
      const selectedFilamentId = parseInt(formData.get('filament_id') as string)
      const data: Record<string, unknown> = {
        filament_id: selectedFilamentId,
        low_weight_threshold_g: parseInt(formData.get('low_weight_threshold_g') as string) || 100,
      }
      
      const initialWeight = formData.get('initial_total_weight_g')
      if (initialWeight) data.initial_total_weight_g = parseFloat(initialWeight as string)
      
      const emptyWeight = formData.get('empty_spool_weight_g')
      if (emptyWeight) data.empty_spool_weight_g = parseFloat(emptyWeight as string)

      const usesCoreChk = (document.getElementById('uses_spool_core') as HTMLInputElement).checked
      if (!usesCoreChk) {
        data.spool_core_weight_g = 0  // explicitly disabled for this spool
      } else {
        const coreWeight = formData.get('spool_core_weight_g')
        if (coreWeight) data.spool_core_weight_g = parseFloat(coreWeight as string)
        // else omit → null → backend uses global default
      }

      const purchasePrice = formData.get('purchase_price')
      if (purchasePrice) data.purchase_price = parseFloat(purchasePrice as string)

      const purchaseDate = formData.get('purchase_date')
      if (purchaseDate) data.purchase_date = purchaseDate

      const spoolOuterDiameter = formData.get('spool_outer_diameter_mm')
      if (spoolOuterDiameter) data.spool_outer_diameter_mm = parseFloat(spoolOuterDiameter as string)

      const spoolWidth = formData.get('spool_width_mm')
      if (spoolWidth) data.spool_width_mm = parseFloat(spoolWidth as string)

      const spoolMaterial = formData.get('spool_material')
      if (spoolMaterial) data.spool_material = spoolMaterial

      // Set remaining_weight_g: use filament raw_material_weight_g as default
      const selectedFilament = filaments.find((f) => f.id === selectedFilamentId)
      if (selectedFilament && selectedFilament.raw_material_weight_g != null) {
        data.remaining_weight_g = selectedFilament.raw_material_weight_g
      }
      
      const locationId = formData.get('location_id')
      if (locationId) data.location_id = parseInt(locationId as string)
      
      const lotNumber = formData.get('lot_number')
      if (lotNumber) data.lot_number = lotNumber
      
      const rfidUid = formData.get('rfid_uid')
      if (rfidUid) data.rfid_uid = rfidUid
      const rfidUid2 = formData.get('rfid_uid_2')
      if (rfidUid2) data.rfid_uid_2 = rfidUid2
      
      const externalId = formData.get('external_id')
      if (externalId) data.external_id = externalId

      const systemGrid = document.getElementById('system-fields-grid') as HTMLDivElement
      const extraFieldPayload = collectExtraFieldPayload(systemGrid, entityExtraFields)
      if (!extraFieldPayload) return
      data.custom_fields = extraFieldPayload.customFields
      data.custom_field_definitions = extraFieldPayload.customFieldDefinitions
      
      const quantity = Math.max(1, parseInt((document.getElementById('spool_quantity') as HTMLInputElement).value) || 1)
      data.quantity = quantity
      
      errorMessage.classList.add('hidden')
      submitting = true
      submitBtn.disabled = true
      submitBtn.textContent = t('common.creating')
      
      try {
        const response = await fetch('/api/v1/spools/bulk', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          signal: getAbortSignal(),
          body: JSON.stringify(data),
        })
        
        if (!response.ok) {
          const errorData = await response.json()
          let msg = t('spools.failedCreate')
          if (Array.isArray(errorData.detail)) {
            msg = errorData.detail.map((e: any) => e.msg || e.message || JSON.stringify(e)).join(', ')
          } else if (errorData.detail?.message) {
            msg = errorData.detail.message
          } else if (errorData.message) {
            msg = errorData.message
          }
          console.error('Spool bulk create error:', JSON.stringify(errorData, null, 2))
          throw new Error(msg)
        }
        
        const spools = await response.json()
        
        if (spools.length === 1) {
          window.location.href = `/spools/${spools[0].id}`
        } else {
          window.location.href = '/spools'
        }
      } catch (error) {
        if (isAbortError(error)) return
        errorMessage.textContent = (error instanceof Error ? error.message : null) || t('spools.failedCreate')
        errorMessage.classList.remove('hidden')
      } finally {
        submitting = false
        submitBtn.disabled = !filaments.some(item => item.id === Number(filamentHiddenInput.value))
        submitBtn.textContent = t('spools.createSpool')
      }
    })
    
    // ── Import from Tag ──
    const importTagModal = document.getElementById('import-tag-modal') as HTMLDivElement
    const importTagContent = document.getElementById('import-tag-content') as HTMLDivElement
    const btnImportFromTag = document.getElementById('btn-import-from-tag') as HTMLButtonElement
    const btnImportTagClose = document.getElementById('import-tag-close') as HTMLButtonElement

    let importPollInterval: ReturnType<typeof setInterval> | null = null
    let importSelectedDeviceId: number | null = null

    function openImportTagModal() {
      importTagModal.classList.add('open')
      loadDevicesForImport()
    }

    function closeImportTagModal() {
      importTagModal.classList.remove('open')
      if (importPollInterval) { clearInterval(importPollInterval); importPollInterval = null }
      importTagContent.innerHTML = ''
    }

    async function loadDevicesForImport() {
      importTagContent.innerHTML = ''
      const loadingP = document.createElement('p')
      loadingP.style.color = 'var(--text-muted)'
      loadingP.textContent = t('common.loading')
      importTagContent.appendChild(loadingP)
      try {
        const res = await fetch('/api/v1/devices/active', { credentials: 'include' })
        const devices: any[] = await res.json()
        importTagContent.innerHTML = ''
        if (!devices || devices.length === 0) {
          const errP = document.createElement('p')
          errP.className = 'fm-alert-error'
          errP.style.margin = '0'
          errP.textContent = t('spools.importFromTagNoDevices')
          importTagContent.appendChild(errP)
          return
        }
        if (devices.length === 1) {
          importSelectedDeviceId = devices[0].id
          startTagScan(devices[0].id)
        } else {
          showDeviceSelectionForImport(devices)
        }
      } catch {
        importTagContent.innerHTML = ''
        const errP = document.createElement('p')
        errP.className = 'fm-alert-error'
        errP.style.margin = '0'
        errP.textContent = t('common.errorLoadingData')
        importTagContent.appendChild(errP)
      }
    }

    function showDeviceSelectionForImport(devices: any[]) {
      importTagContent.innerHTML = ''
      const intro = document.createElement('p')
      intro.style.cssText = 'margin-bottom: 12px; color: var(--text-muted); font-size: 0.9rem;'
      intro.textContent = t('spools.importFromTagSelectDevice')
      importTagContent.appendChild(intro)
      const grid = document.createElement('div')
      grid.style.cssText = 'display: grid; gap: 8px;'
      devices.forEach((d: any) => {
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'fm-btn fm-btn-outline'
        btn.style.cssText = 'text-align: left; padding: 10px 14px;'
        const strong = document.createElement('strong')
        strong.textContent = d.name || ''
        btn.appendChild(strong)
        if (d.ip_address) {
          btn.appendChild(document.createElement('br'))
          const small = document.createElement('small')
          small.style.color = 'var(--text-muted)'
          small.textContent = d.ip_address
          btn.appendChild(small)
        }
        btn.addEventListener('click', () => { importSelectedDeviceId = d.id; startTagScan(d.id) })
        grid.appendChild(btn)
      })
      importTagContent.appendChild(grid)
    }

    async function startTagScan(deviceId: number) {
      importTagContent.innerHTML = ''
      const wrapper = document.createElement('div')
      wrapper.style.cssText = 'text-align: center; padding: 24px 0;'
      const spinner = document.createElement('div')
      spinner.className = 'fm-spinner'
      spinner.style.cssText = 'margin: 0 auto 16px; width: 36px; height: 36px; border-width: 3px;'
      const statusP = document.createElement('p')
      statusP.style.cssText = 'color: var(--text-muted); margin: 0 0 8px;'
      statusP.textContent = t('spools.importFromTagPlaceOnScale')
      const countdownP = document.createElement('p')
      countdownP.id = 'import-tag-countdown'
      countdownP.style.cssText = 'font-size: 0.8rem; color: var(--text-muted); margin: 0;'
      wrapper.append(spinner, statusP, countdownP)
      importTagContent.appendChild(wrapper)

      try {
        const triggerRes = await fetch(`/api/v1/devices/${deviceId}/request-tag-scan`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: '{}',
        })

        if (!triggerRes.ok) {
          let apiMsg: string | null = null
          try {
            const payload = await triggerRes.json()
            if (typeof payload?.detail?.message === 'string') apiMsg = payload.detail.message
            else if (typeof payload?.message === 'string') apiMsg = payload.message
          } catch {
            apiMsg = null
          }
          showImportError(apiMsg || t('spools.importFromTagTriggerFailed'))
          return
        }
      } catch {
        showImportError(t('spools.importFromTagTriggerFailed'))
        return
      }

      let attempts = 0
      const maxAttempts = 30
      importPollInterval = setInterval(async () => {
        attempts++
        const el = document.getElementById('import-tag-countdown')
        if (el) el.textContent = `${maxAttempts - attempts}s`
        if (attempts > maxAttempts) {
          clearInterval(importPollInterval!); importPollInterval = null
          showImportError(t('spools.importFromTagTimeout'))
          return
        }
        try {
          const res = await fetch(`/api/v1/devices/${deviceId}/tag-scan-result`, { credentials: 'include' })
          if (!res.ok) {
            clearInterval(importPollInterval!); importPollInterval = null
            showImportError(t('spools.importFromTagScanFailed'))
            return
          }
          const data = await res.json()
          if (data.status === 'success' && data.tag_data) {
            clearInterval(importPollInterval!); importPollInterval = null
            await applyTagDataToForm(data.tag_data)
          } else if (data.status === 'error') {
            clearInterval(importPollInterval!); importPollInterval = null
            showImportError(data.error_message || t('spools.importFromTagScanFailed'))
          }
        } catch { /* ignore poll errors */ }
      }, 1000)
    }

    function showImportError(msg: string) {
      importTagContent.innerHTML = ''
      const errDiv = document.createElement('div')
      errDiv.className = 'fm-alert-error'
      errDiv.style.marginBottom = '16px'
      errDiv.textContent = msg
      importTagContent.appendChild(errDiv)
      const devId = importSelectedDeviceId
      if (devId) {
        const retryBtn = document.createElement('button')
        retryBtn.type = 'button'
        retryBtn.className = 'fm-btn fm-btn-outline'
        retryBtn.textContent = t('common.retry')
        retryBtn.addEventListener('click', () => startTagScan(devId))
        importTagContent.appendChild(retryBtn)
      }
    }

    async function resolveFilamentFromTag(tagData: any): Promise<any | null> {
      const materialType = String(tagData?.type || '').trim()
      if (!materialType) return null

      const payload: Record<string, unknown> = {
        type: materialType,
      }

      const brand = String(tagData?.brand || '').trim()
      if (brand) payload.brand = brand

      const subtype = String(tagData?.subtype || '').trim()
      if (subtype) payload.subtype = subtype

      const colorHex = String(tagData?.color_hex || tagData?.color || '').trim()
      if (colorHex) payload.color_hex = colorHex

      if (tagData?.min_temp != null && String(tagData.min_temp).trim() !== '') {
        payload.min_temp = tagData.min_temp
      }
      if (tagData?.max_temp != null && String(tagData.max_temp).trim() !== '') {
        payload.max_temp = tagData.max_temp
      }
      if (tagData?.diameter != null && String(tagData.diameter).trim() !== '') {
        payload.diameter = tagData.diameter
      }

      const res = await fetch('/api/v1/filaments/resolve-from-tag', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
        credentials: 'include',
        body: JSON.stringify(payload),
      })

      if (!res.ok) {
        let message = 'Failed to resolve filament from tag data'
        try {
          const errPayload = await res.json()
          message = errPayload?.detail?.message || errPayload?.message || message
        } catch {
          // keep default message
        }
        throw new Error(message)
      }

      return await res.json()
    }

    async function refreshFilamentsForResolvedSelection(filamentId: number) {
      invalidateCachePrefix(CACHE_KEYS.FILAMENTS)
      const filamentsData = await cachedFetchAllPages(CACHE_KEYS.FILAMENTS, '/api/v1/filaments')
      filaments = filamentsData.items
      applySelectedFilament(String(filamentId))
    }

    async function applyTagDataToForm(tagData: any) {
      const brand = (tagData.brand || '').toLowerCase().trim()
      const type  = (tagData.type  || '').toLowerCase().trim()
      const colorHex = String(tagData?.color_hex || tagData?.color || '').trim()
      let matchedFilament: any = null

      if (type) {
        try {
          const resolved = await resolveFilamentFromTag(tagData)
          if (resolved?.filament_id) {
            await refreshFilamentsForResolvedSelection(resolved.filament_id)
            matchedFilament = filaments.find((f: any) => f.id === resolved.filament_id) || null
          }
        } catch (error) {
          console.error('Failed to resolve filament from tag:', error)
          showImportError(error instanceof Error ? error.message : t('spools.importFromTagResolveFailed'))
          return
        }
      }

      if (type) {
        if (!matchedFilament && colorHex) {
          const normHex = (colorHex.startsWith('#') ? colorHex : '#' + colorHex).toLowerCase()
          matchedFilament = filaments.find((f: any) =>
            brand && (f.manufacturer?.name || '').toLowerCase().includes(brand) &&
            (f.material_type || '').toLowerCase() === type &&
            f.colors?.some((fc: any) => (fc.color?.hex_code || '').toLowerCase().startsWith(normHex.slice(0, 7)))
          )
        }
        if (!matchedFilament) {
          matchedFilament = filaments.find((f: any) =>
            brand && (f.manufacturer?.name || '').toLowerCase().includes(brand) &&
            (f.material_type || '').toLowerCase() === type
          )
        }
        if (!matchedFilament) {
          matchedFilament = filaments.find((f: any) => (f.material_type || '').toLowerCase() === type)
        }
      }
      importTagContent.innerHTML = ''
      if (matchedFilament) {
        selectFilament(matchedFilament.id)
        const successDiv = document.createElement('div')
        successDiv.className = 'fm-alert-success'
        successDiv.style.marginBottom = '16px'
        successDiv.textContent = `✓ ${t('spools.importFromTagMatched')}: `
        const strong = document.createElement('strong')
        strong.textContent = matchedFilament.designation
        successDiv.appendChild(strong)
        importTagContent.appendChild(successDiv)
      } else {
        const warnDiv = document.createElement('div')
        warnDiv.className = 'fm-alert-warning'
        warnDiv.style.marginBottom = '16px'
        const displayTag = `${tagData.brand || ''} ${tagData.type || ''}`.trim()
        warnDiv.textContent = `${t('spools.importFromTagNoMatch')}: `
        const strong = document.createElement('strong')
        strong.textContent = displayTag
        warnDiv.appendChild(strong)
        const span = document.createElement('span')
        span.textContent = `. ${t('spools.importFromTagSelectManually')}.`
        warnDiv.appendChild(span)
        importTagContent.appendChild(warnDiv)
      }
      const doneBtn = document.createElement('button')
      doneBtn.type = 'button'
      doneBtn.className = matchedFilament ? 'fm-btn fm-btn-primary' : 'fm-btn fm-btn-outline'
      doneBtn.textContent = t('common.close')
      doneBtn.addEventListener('click', closeImportTagModal)
      importTagContent.appendChild(doneBtn)
    }

    btnImportFromTag?.addEventListener('click', openImportTagModal)
    btnImportTagClose?.addEventListener('click', closeImportTagModal)
    importTagModal?.addEventListener('click', (e) => { if (e.target === importTagModal) closeImportTagModal() })

    await loadOptions()
    checkActiveDevicesForImport()
    if (params.get('from_tag') === '1') openImportTagModal()
    }
  </script>
</Layout>
