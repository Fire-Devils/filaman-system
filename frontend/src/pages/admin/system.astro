---
import Layout from '../../layouts/Layout.astro'
import AdminHeader from '../../components/AdminHeader.astro'
import FormDialog from '../../components/FormDialog.astro'
---

<Layout title="FilaMan - Plugins">
  <style>
    .plugin-toolbar-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .plugin-table { width: 100%; }
    .plugin-table :global(td:first-child) { min-width: 180px; }
    .plugin-table :global(:is(th, td):not(:first-child)) { width: 1%; white-space: nowrap; }
    :global(.plugin-actions) { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
    :global(.plugin-actions > *) { flex-shrink: 0; }
    :global(.plugin-detail-row) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); align-items: start; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--border); }
    :global(.plugin-detail-value) { text-align: right; overflow-wrap: anywhere; }
    :global(.plugin-schema) { margin-top: 8px; background: var(--bg-soft); border-radius: var(--radius-sm); padding: 12px; font-size: .8rem; white-space: pre-wrap; overflow-wrap: anywhere; }
    .plugin-message { margin-bottom: 16px; }
    .plugin-drop-zone { display: block; border: 2px dashed var(--border); border-radius: var(--radius-sm); padding: 20px; text-align: center; cursor: pointer; }
    .plugin-drop-zone:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    :global(#install-modal [hidden]) { display: none; }
    :global(#install-modal .fm-form-dialog-header) { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
    :global(#install-modal .fm-header-actions) { display: contents; }
    .plugin-install-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--inline-gap); }
    .plugin-install-feedback { grid-column: 1 / -1; display: grid; gap: 8px; overflow-wrap: anywhere; }
    .plugin-install-feedback:not(:has(> :not([hidden]))) { display: none; }
    @media (min-width: 641px) {
      :global(#install-modal.catalog-dialog) { width: min(58rem, calc(100vw - 32px)); }
    }
    :global(#install-modal.catalog-dialog h2) { font-size: 1.08rem; }
    .catalog-intro, #catalog-status { margin: 0; }
    #catalog-status:empty { position: absolute; }
    #catalog-retry { justify-self: start; }
    #catalog-selection { margin: 0; color: var(--text); }
    #error-details { max-height: min(8rem, 30dvh); overflow: auto; white-space: pre-wrap; }
    .catalog-tools { display: grid; gap: 12px; }
    .catalog-tools :is(input, select) { width: 100%; margin-top: 6px; }
    @media (min-width: 641px) {
      .catalog-tools { grid-template-columns: minmax(0, 1fr) 12rem; }
    }
    .catalog-list {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
      gap: 12px; list-style: none; margin: 0; padding: 0;
    }
    .catalog-list:empty { display: none; }
    .catalog-list :global(.catalog-card) {
      display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 16px;
      border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-soft);
      overflow-wrap: anywhere;
    }
    .catalog-list :global(.catalog-card:has([aria-current="true"])) { border-color: var(--accent); }
    .catalog-list :global(.catalog-heading) { display: flex; align-items: flex-start; gap: 10px; }
    .catalog-list :global(.catalog-icon) {
      display: grid; place-items: center; flex: 0 0 36px; height: 36px;
      border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-elevated);
    }
    .catalog-list :global(.catalog-icon .fm-plugin-icon) { color: var(--accent); }
    .catalog-list :global(h3) { font-size: 1rem; line-height: 1.3; margin: 0; }
    .catalog-list :global(p) { margin: 0; }
    .catalog-list :global(.catalog-description) { color: var(--text-muted); font-size: .875rem; line-height: 1.5; }
    .catalog-list :global(.catalog-version) {
      margin-left: auto; padding: 3px 7px; border-radius: 999px; background: var(--bg-elevated);
      color: var(--text-muted); font-size: .75rem;
    }
    .catalog-list :global(.catalog-footer) { display: grid; gap: 8px; margin-top: auto; }
    .catalog-list :global(.catalog-actions) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
    .catalog-list :global(.catalog-actions .fm-btn) { padding: 6px 12px; font-size: .8rem; }
    .catalog-list :global(.catalog-installed) {
      display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px;
      border: 1px solid var(--success-border); border-radius: 999px;
      background: var(--success-bg); color: var(--success-text); font-size: .85rem; font-weight: 700;
    }
    .catalog-list :global(.catalog-installed svg) { flex-shrink: 0; }
    .catalog-list :global(.catalog-actions a), .catalog-submit { color: var(--accent); font-size: .85rem; }
    .toggle-spinner { display: none; width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: toggle-spin .6s linear infinite; margin-left: 8px; }
    .toggle-spinner.visible { display: inline-block; }
    @keyframes toggle-spin { to { transform: rotate(360deg); } }
  </style>
  <div class="fm-admin-page">
  <AdminHeader titleKey="admin.systemPlugins" title="Plugins">
    <div class="plugin-toolbar-actions">
      <button id="btn-check-updates" class="fm-btn fm-btn-outline" data-i18n="admin.pluginCheckUpdates">Check for Updates</button>
      <button id="btn-install" class="fm-btn fm-btn-outline" data-i18n="admin.pluginUploadZip">Upload ZIP</button>
      <button id="btn-browse-plugins" class="fm-btn fm-btn-primary" data-i18n="admin.pluginBrowse">Browse Plugins</button>
    </div>
  </AdminHeader>
  <div id="plugin-message" class="plugin-message hidden" role="status"></div>
  <!-- Plugin-Liste -->
  <div class="fm-card" style="padding: 0;">
    <table class="fm-table fm-admin-table plugin-table">
      <thead>
        <tr>
          <th data-i18n="common.name">Name</th>
          <th data-i18n="admin.pluginVersion">Version</th>
          <th data-i18n="admin.pluginType">Type</th>
          <th data-i18n="admin.pluginAuthor">Author</th>
          <th data-i18n="common.status">Status</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="plugins-table">
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <!-- Install Modal -->
  <FormDialog id="install-modal" titleId="install-title" titleKey="admin.installPlugin" title="Install Plugin" wide>
    <Fragment slot="actions">
      <div class="plugin-install-actions">
        <button type="submit" form="install-form" id="install-submit" aria-describedby="catalog-selection" class="fm-btn fm-btn-primary" disabled data-i18n="admin.installPlugin">Install Plugin</button>
        <button type="button" id="install-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </div>
      <div class="plugin-install-feedback">
        <p id="catalog-selection" class="fm-field-hint" role="status" hidden></p>
        <div id="validation-details" class="fm-alert-success" role="status" hidden></div>
        <div id="error-details" class="fm-alert-error" role="alert" tabindex="0" hidden></div>
        <p id="upload-progress" class="fm-field-hint" style="margin: 0" role="status" data-i18n="admin.pluginInstalling" hidden>Installing…</p>
      </div>
    </Fragment>
      <form id="install-form" class="fm-compact-form">
        <div id="catalog-browser" class="fm-compact-form" hidden>
          <p class="catalog-intro fm-field-hint" data-i18n="admin.pluginBrowseIntro">Discover printer drivers and integrations that extend FilaMan.</p>
          <search class="catalog-tools">
            <div>
              <label for="catalog-search" class="fm-label" data-i18n="admin.pluginSearch">Search plugins</label>
              <input id="catalog-search" class="fm-input" type="search" />
            </div>
            <div>
              <label for="catalog-filter" class="fm-label" data-i18n="common.status">Status</label>
              <select id="catalog-filter" class="fm-select">
                <option value="all" data-i18n="admin.pluginFilterAll">All plugins</option>
                <option value="installed" data-i18n="admin.pluginFilterInstalled">Installed</option>
                <option value="uninstalled" data-i18n="admin.pluginFilterUninstalled">Not installed</option>
                <option value="updates" data-i18n="admin.pluginFilterUpdates">Updates available</option>
              </select>
            </div>
          </search>
          <p id="catalog-status" class="fm-field-hint" role="status"></p>
          <button id="catalog-retry" type="button" class="fm-btn fm-btn-outline" data-i18n="common.retry" hidden>Retry</button>
          <ul id="catalog-list" class="catalog-list"></ul>
          <div><a class="catalog-submit" href="https://github.com/Fire-Devils/filaman-system/blob/main/plugin-catalog/README.md#submit-a-plugin" target="_blank" rel="noopener noreferrer" data-i18n="admin.pluginSubmit">Submit a plugin</a></div>
        </div>

        <div id="plugin-zip-upload">
          <label for="file-input" class="fm-label" data-i18n="admin.pluginZipFile">Plugin ZIP File</label>
          <div id="drop-zone" class="plugin-drop-zone" role="button" tabindex="0" aria-labelledby="plugin-file-hint">
            <p id="plugin-file-hint" class="fm-field-hint" data-i18n="admin.pluginDropHint">Drag & Drop ZIP file here or click to select</p>
            <p id="file-name" style="margin: 8px 0 0; font-weight: 600; color: var(--text); display: none;"></p>
            <input type="file" id="file-input" accept=".zip,application/zip" style="display: none;" />
          </div>
        </div>
        
      </form>
  </FormDialog>
  
  <FormDialog id="detail-modal" titleId="detail-title" titleKey="admin.pluginDetails" title="Plugin Details">
    <Fragment slot="actions"><button type="button" id="detail-close" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.close">Close</button></Fragment>
    <div id="detail-content" class="fm-compact-form"></div>
  </FormDialog>
  </div>

  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { navHrefFor } from '../../lib/plugin-nav'
    import { createPluginIcon } from '../../lib/plugin-icon'
    import { ApiError, api, request } from '../../lib/api'
    import { bindFormDialog } from '../../lib/form-dialog'
    import { escapeHtml } from '../../lib/extra-fields'
    import { tableAction } from '../../lib/table-actions'
    await initI18n()

    interface Plugin {
      plugin_key: string; name: string; version: string; plugin_type: string; is_active: boolean
      description?: string | null; author?: string | null; installed_by?: number | null; installed_at: string
      page_url?: string | null; driver_key?: string | null; homepage?: string | null; license?: string | null
      icon_url?: string | null
      config_schema?: Record<string, unknown> | null
    }
    interface RegistryPlugin {
      plugin_key: string; name: string; version: string; description: string; publisher: string
      repository_url: string; min_filaman_version: string; is_compatible: boolean; release_id: string
      update_available: boolean; is_installed: boolean; requires_newer_zip: boolean; installed_version?: string | null
      icon_url?: string | null
    }
    interface InstallResult { plugin: { plugin_key: string; name: string; version: string }; message: string }
    const fm = window as unknown as { __fmConfirm: (message: string, options?: { title?: string; okLabel?: string; isDanger?: boolean }) => Promise<boolean> }
    let plugins: Plugin[] = []
    let selectedFile: File | null = null
    let availablePlugins: RegistryPlugin[] = []
    let selectedRelease: RegistryPlugin | null = null
    let updateMap = new Map<string, RegistryPlugin>()
    let updateRequest = 0
    const pendingUpdates = new Set<string>()
    
    let installing = false
    const installModal = document.getElementById('install-modal') as HTMLDialogElement
    const installDialog = bindFormDialog(installModal, { canClose: () => !installing })
    const detailDialog = bindFormDialog(document.getElementById('detail-modal') as HTMLDialogElement)
    function showMessage(message: string, error = false) {
      const host = document.getElementById('plugin-message')!
      host.className = `plugin-message ${error ? 'fm-alert-error' : 'fm-alert-success'}`
      host.setAttribute('role', error ? 'alert' : 'status')
      host.textContent = message
    }

    // ----------------------------------------------------------------
    //  Plugin-Liste laden und rendern
    // ----------------------------------------------------------------
    
    async function loadPlugins() {
      try {
        plugins = await api.get<Plugin[]>('/admin/system/plugins')
        renderPlugins()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load plugins:', error)
        const tbody = document.getElementById('plugins-table')!
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--error-text);">${escapeHtml(t('admin.pluginFailedLoad'))}</td></tr>`
      }
    }
    
    function renderPlugins() {
      const tbody = document.getElementById('plugins-table')!
      
      if (plugins.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted);">${escapeHtml(t('admin.noPlugins'))}</td></tr>`
        return
      }
      
      const typeLabels: Record<string, string> = {
        driver: t('admin.pluginTypeDriver'),
        import: t('admin.pluginTypeImport'),
        integration: t('admin.pluginTypeIntegration'),
      }
      
      tbody.innerHTML = plugins.map(p => {
        const update = updateMap.get(p.plugin_key)
        const openLabel = escapeHtml(`${t('common.open')} ${p.name}`)
        const nameHtml = p.page_url
          ? `<a href="${escapeHtml(navHrefFor(p.page_url))}" style="color: var(--accent); text-decoration: none; font-weight: 600;">${escapeHtml(p.name)}</a>`
          : `<span style="font-weight: 600;">${escapeHtml(p.name)}</span>`
        
        return `
        <tr>
          <td>
            <div class="fm-plugin-name"><span data-plugin-icon="${escapeHtml(p.plugin_key)}"></span>${nameHtml}</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(p.description || '')}</div>
          </td>
          <td style="font-family: monospace; font-size: 0.85rem;">${escapeHtml(p.version)}</td>
          <td>
            <span style="display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: var(--bg-soft); color: var(--text-muted);">${escapeHtml(typeLabels[p.plugin_type] || p.plugin_type)}</span>
          </td>
          <td style="color: var(--text-muted);">${escapeHtml(p.author || '-')}</td>
          <td>
            <div style="display: flex; align-items: center;">
              <label class="fm-toggle" title="${escapeHtml(p.is_active ? t('admin.pluginDeactivate') : t('admin.pluginActivate'))}">
                <input type="checkbox" class="toggle-active" aria-label="${escapeHtml(p.name)}: ${escapeHtml(t('common.status'))}" data-key="${escapeHtml(p.plugin_key)}" ${p.is_active ? 'checked' : ''} />
                <span class="fm-toggle-slider"></span>
              </label>
              <span class="toggle-spinner" data-spinner-key="${escapeHtml(p.plugin_key)}"></span>
            </div>
          </td>
          <td>
            <div class="plugin-actions">
            ${update ? `<button data-key="${escapeHtml(p.plugin_key)}" class="btn-update fm-btn fm-btn-outline" style="font-size:.8rem;padding:4px 10px" ${pendingUpdates.has(p.plugin_key) ? 'disabled' : ''}>${escapeHtml(t('admin.pluginUpdateTo').replace('{version}', update.version))}</button>` : ''}
            <button data-key="${escapeHtml(p.plugin_key)}" class="btn-detail fm-row-action" aria-label="${escapeHtml(t('admin.pluginDetails'))}" title="${escapeHtml(t('admin.pluginDetails'))}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7v1"/></svg></button>
            ${p.page_url ? `<a href="${escapeHtml(navHrefFor(p.page_url))}" class="fm-row-action" aria-label="${openLabel}" title="${openLabel}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg></a>` : ''}
            ${p.installed_by != null ? tableAction('delete', { key: p.plugin_key, name: p.name }, { title: t('admin.uninstallPlugin') }) : ''}
            </div>
          </td>
        </tr>
      `}).join('')

      tbody.querySelectorAll<HTMLElement>('[data-plugin-icon]').forEach(host => {
        const plugin = plugins.find(p => p.plugin_key === host.dataset.pluginIcon)
        host.replaceWith(createPluginIcon(plugin?.icon_url))
      })
      
      // Detail-Buttons
      document.querySelectorAll('.btn-detail').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const key = (e.currentTarget as HTMLButtonElement).dataset.key!
          showPluginDetails(key)
        })
      })
      
      // Update-Buttons
      document.querySelectorAll('.btn-update').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const btnEl = e.currentTarget as HTMLButtonElement
          const key = btnEl.dataset.key!
          const info = updateMap.get(key)
          if (!info || pendingUpdates.has(key)) return

          pendingUpdates.add(key)
          btnEl.disabled = true
          try {
            const confirmed = await fm.__fmConfirm(releasePrompt(info), {
              title: t('admin.installPlugin'), okLabel: t('admin.pluginUpdateTo').replace('{version}', info.version),
            })
            if (!confirmed) return
            btnEl.textContent = t('admin.pluginUpdating')
            await installRelease(info)
            showMessage(`${t('common.successTitle')}: ${plugins.find(plugin => plugin.plugin_key === key)?.name || key} · ${info.version}`)
            invalidateUpdate(key)
            loadPlugins()
          } catch (err) {
            if (isAbortError(err)) return
            if (releaseIsStale(err)) {
              invalidateUpdate(key)
              renderPlugins()
              showMessage(t('admin.pluginCatalogChanged'), true)
              document.getElementById('btn-check-updates')?.focus()
              try {
                await refreshUpdateActions()
              } catch (refreshError) {
                if (!isAbortError(refreshError)) console.error('Plugin catalog refresh failed:', refreshError)
              }
              return
            }
            console.error('Plugin update failed:', err)
            showMessage(err instanceof Error ? err.message : t('admin.pluginInstallFailed'), true)
          } finally {
            pendingUpdates.delete(key)
            const action = document.querySelector<HTMLButtonElement>(`.btn-update[data-key="${key}"]`)
            const update = updateMap.get(key)
            if (action && update) {
              action.disabled = false
              action.textContent = t('admin.pluginUpdateTo').replace('{version}', update.version)
            }
          }
        })
      })

      // Uninstall-Buttons
      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const key = (e.currentTarget as HTMLButtonElement).dataset.key!
          const name = (e.currentTarget as HTMLButtonElement).dataset.name!
          
          const msg = t('admin.confirmUninstall').replace('{name}', name)
          if (!(await fm.__fmConfirm(msg))) return
          
          // Ask whether to also delete plugin data
          const deleteData = await fm.__fmConfirm(t('admin.confirmUninstallDeleteData'), { title: t('admin.uninstallPlugin'), okLabel: t('common.yes') || 'Yes', isDanger: false })
          const qs = deleteData ? '?delete_data=true' : ''
          
          try {
            await api.delete(`/admin/system/plugins/${key}${qs}`)
            invalidateUpdate(key)
            loadPlugins()
          } catch (err) {
            if (isAbortError(err)) return
            showMessage(err instanceof Error ? err.message : t('admin.pluginUninstallFailed'), true)
          }
        })
      })
      
      // Toggle active/inactive
      document.querySelectorAll('.toggle-active').forEach(input => {
        input.addEventListener('change', async (e) => {
          const checkbox = e.currentTarget as HTMLInputElement
          const key = checkbox.dataset.key!
          const newState = checkbox.checked
          const spinner = document.querySelector(`.toggle-spinner[data-spinner-key="${key}"]`) as HTMLElement

          // Bei Deaktivierung: pruefen ob Drucker betroffen sind
          if (!newState) {
            try {
              const infoResp = await fetch(`/api/v1/admin/system/plugins/${key}/affected-printers`, {
                credentials: 'include',
                signal: getAbortSignal(),
              })
              if (infoResp.ok) {
                const info = await infoResp.json()
                if (info.count > 0) {
                  const msg = t('admin.pluginDeactivateConfirm').replace('{count}', info.count)
                  const confirmed = await fm.__fmConfirm(msg, {
                    title: t('admin.pluginDeactivate'),
                    isDanger: true,
                  })
                  if (!confirmed) {
                    checkbox.checked = true
                    return
                  }
                }
              }
            } catch (err) {
              if (isAbortError(err)) return
              // Bei Fehler trotzdem fortfahren (Vorschau ist optional)
            }
          }

          // Spinner anzeigen + Toggle deaktivieren
          checkbox.disabled = true
          if (spinner) spinner.classList.add('visible')
          
          try {
            await api.patch(`/admin/system/plugins/${key}/active`, { is_active: newState })

            // Lokalen State aktualisieren
            const plugin = plugins.find(p => p.plugin_key === key)
            if (plugin) plugin.is_active = newState
            
            // Tooltip aktualisieren
            const label = checkbox.closest('.fm-toggle') as HTMLElement
            if (label) label.title = newState ? t('admin.pluginDeactivate') : t('admin.pluginActivate')
            
          } catch (err) {
            if (isAbortError(err)) return
            // Bei Fehler: Checkbox zuruecksetzen
            checkbox.checked = !newState
            showMessage(err instanceof Error ? err.message : t('admin.pluginToggleFailed'), true)
          } finally {
            checkbox.disabled = false
            if (spinner) spinner.classList.remove('visible')
          }
        })
      })
    }
    
    // ----------------------------------------------------------------
    //  Plugin-Details anzeigen
    // ----------------------------------------------------------------
    
    function showPluginDetails(key: string) {
      const plugin = plugins.find(p => p.plugin_key === key)
      if (!plugin) return
      
      const title = document.getElementById('detail-title')!
      const content = document.getElementById('detail-content')!
      
      title.textContent = plugin.name
      title.classList.add('fm-plugin-name')
      title.prepend(createPluginIcon(plugin.icon_url))
      
      const rows = [
        { label: 'Plugin Key', value: plugin.plugin_key },
        { label: t('admin.pluginVersion'), value: plugin.version },
        { label: t('admin.pluginType'), value: plugin.plugin_type },
        { label: t('admin.pluginAuthor'), value: plugin.author || '-' },
        ...(plugin.driver_key ? [{ label: t('admin.pluginDriver'), value: plugin.driver_key }] : []),
        { label: t('admin.pluginDescription'), value: plugin.description || '-' },
        { label: t('admin.pluginHomepage'), value: plugin.homepage || '-', link: true },
        { label: t('admin.pluginLicense'), value: plugin.license || '-' },
        { label: t('admin.pluginInstalledAt'), value: new Date(plugin.installed_at).toLocaleString() },
      ]
      
      content.innerHTML = rows.map(r => `
        <div class="plugin-detail-row">
          <span style="color:var(--text-muted)">${escapeHtml(r.label)}</span>
          <span class="plugin-detail-value">${r.link && /^https?:\/\//i.test(String(r.value)) ? `<a href="${escapeHtml(String(r.value))}" target="_blank" rel="noopener noreferrer">${escapeHtml(String(r.value))}</a>` : escapeHtml(String(r.value))}</span>
        </div>
      `).join('')
      
      // Config Schema anzeigen
      if (plugin.config_schema && Object.keys(plugin.config_schema).length > 0) {
        content.innerHTML += `
          <div style="margin-top: 8px;">
            <span style="font-weight: 600; font-size: 0.9rem;" data-i18n="admin.pluginConfigSchema">Configuration Schema</span>
            <pre class="plugin-schema">${escapeHtml(JSON.stringify(plugin.config_schema, null, 2))}</pre>
          </div>
        `
      }
      
      detailDialog.open()
    }
    
    // ----------------------------------------------------------------
    //  Install-Modal: Drag & Drop, Dateiauswahl, Upload
    // ----------------------------------------------------------------
    
    const dropZone = document.getElementById('drop-zone')!
    const fileInput = document.getElementById('file-input') as HTMLInputElement
    const fileName = document.getElementById('file-name')!
    const installSubmit = document.getElementById('install-submit') as HTMLButtonElement
    
    const catalogBrowser = document.getElementById('catalog-browser')!
    const catalogSearch = document.getElementById('catalog-search') as HTMLInputElement
    const catalogFilter = document.getElementById('catalog-filter') as HTMLSelectElement
    const catalogStatus = document.getElementById('catalog-status')!
    const catalogList = document.getElementById('catalog-list')!
    const catalogRetry = document.getElementById('catalog-retry')!
    const catalogSelection = document.getElementById('catalog-selection')!
    const installSuccess = document.getElementById('validation-details')!
    const installError = document.getElementById('error-details')!
    const installProgress = document.getElementById('upload-progress')!
    let catalogRequest = 0

    document.getElementById('btn-browse-plugins')?.addEventListener('click', () => openInstaller(true))
    document.getElementById('btn-install')?.addEventListener('click', () => openInstaller(false))

    function openInstaller(browse: boolean) {
      catalogRequest++
      availablePlugins = []
      catalogList.replaceChildren()
      selectedFile = null
      installModal.classList.toggle('catalog-dialog', browse)
      catalogBrowser.hidden = !browse
      selectRelease(null)
      document.getElementById('plugin-zip-upload')!.hidden = browse
      const title = document.getElementById('install-title')!
      title.dataset.i18n = browse ? 'admin.pluginBrowse' : 'admin.installPlugin'
      title.textContent = t(title.dataset.i18n)
      const close = document.getElementById('install-cancel')!
      close.dataset.i18n = browse ? 'common.close' : 'common.cancel'
      close.textContent = t(close.dataset.i18n)
      catalogSearch.value = ''
      catalogFilter.value = 'all'
      fileInput.value = ''
      fileName.style.display = 'none'
      fileName.textContent = ''
      installSubmit.disabled = true
      clearInstallResult()
      dropZone.style.borderColor = 'var(--border)'
      dropZone.style.background = 'transparent'
      installDialog.open()
      if (browse) {
        catalogSearch.focus()
        loadAvailablePlugins()
      }
    }
    
    // Klick auf Drop-Zone oeffnet Dateiauswahl
    dropZone.addEventListener('click', () => fileInput.click())
    dropZone.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); fileInput.click() }
    })
    
    // Drag & Drop
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault()
      dropZone.style.borderColor = 'var(--accent)'
      dropZone.style.background = 'var(--bg-soft)'
    })
    
    dropZone.addEventListener('dragleave', () => {
      dropZone.style.borderColor = 'var(--border)'
      dropZone.style.background = 'transparent'
    })
    
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault()
      dropZone.style.borderColor = 'var(--border)'
      dropZone.style.background = 'transparent'
      
      const files = e.dataTransfer?.files
      if (files && files.length > 0) {
        handleFileSelect(files[0])
      }
    })
    
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFileSelect(fileInput.files[0])
      }
    })
    
    function handleFileSelect(file: File) {
      // ZIP-Pruefung
      if (!file.name.endsWith('.zip')) {
        showValidationError(t('admin.pluginNotZip'))
        return
      }
      
      // Groessen-Pruefung (10 MB)
      if (file.size > 10 * 1024 * 1024) {
        showValidationError(t('admin.pluginTooLarge'))
        return
      }
      
      selectedFile = file
      fileName.textContent = file.name + ` (${(file.size / 1024).toFixed(1)} KB)`
      fileName.style.display = 'block'
      installSubmit.disabled = false
      
      clearInstallResult()
    }

    function clearInstallResult() {
      installSuccess.hidden = true
      installError.hidden = true
      installError.textContent = ''
    }

    function showValidationError(message: string) {
      installSuccess.hidden = true
      installError.hidden = false
      installError.textContent = message
      installSubmit.disabled = true
    }
    
    // Upload / Install
    document.getElementById('install-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      if (installing || (!selectedRelease && !selectedFile)) return
      const release = selectedRelease
      installing = true
      const form = document.getElementById('install-form') as HTMLFormElement
      const cancel = document.getElementById('install-cancel') as HTMLButtonElement
      form.inert = true
      form.setAttribute('aria-busy', 'true')
      cancel.disabled = true
      installSubmit.disabled = true
      clearInstallResult()
      installProgress.hidden = false
      let focusAfterInstall: HTMLElement | undefined
      
      try {
        let result: InstallResult
        if (release) {
          result = await installRelease(release)
        } else {
          const formData = new FormData()
          formData.append('file', selectedFile!)
          result = await request<InstallResult>('/admin/system/plugins/install', { method: 'POST', body: formData })
        }
        const message = result.message || `${result.plugin.name} v${result.plugin.version}`
        installSuccess.hidden = false
        installSuccess.textContent = message
        
        selectedFile = null
        invalidateUpdate(result.plugin.plugin_key)
        if (release) {
          selectRelease(null)
          loadAvailablePlugins()
        }
        showMessage(message)
        loadPlugins()
      } catch (err) {
        if (isAbortError(err)) return
        if (release && releaseIsStale(err)) {
          invalidateUpdate(release.plugin_key)
          renderPlugins()
          selectRelease(null)
          showValidationError(t('admin.pluginCatalogChanged'))
          loadAvailablePlugins()
          focusAfterInstall = catalogSearch
        } else {
          showValidationError(err instanceof Error ? err.message : t('admin.pluginInstallFailed'))
        }
      } finally {
        installing = false
        installProgress.hidden = true
        form.inert = false
        form.setAttribute('aria-busy', 'false')
        cancel.disabled = false
        installSubmit.disabled = !selectedFile && !selectedRelease
        if (installModal.open) (focusAfterInstall ?? (installSubmit.disabled ? cancel : installSubmit)).focus({ preventScroll: true })
      }
    })

    // ----------------------------------------------------------------
    //  Registry: Verfuegbare Plugins laden
    // ----------------------------------------------------------------

    function releasePrompt(p: RegistryPlugin) {
      return t('admin.pluginConfirmRelease')
        .replace('{name}', () => p.name)
        .replace('{version}', () => p.version)
        .replace('{publisher}', () => p.publisher)
    }

    function installRelease({ plugin_key, version, release_id }: RegistryPlugin) {
      return api.post<InstallResult>('/admin/system/plugins/install-from-registry', { plugin_key, version, release_id })
    }

    function releaseIsStale(error: unknown) {
      return error instanceof ApiError && ['catalog_release_unavailable', 'catalog_downgrade'].includes(error.code)
    }

    function invalidateUpdate(key: string) {
      updateRequest++
      updateMap.delete(key)
    }

    async function refreshUpdateActions(): Promise<number | null> {
      const currentRequest = ++updateRequest
      try {
        const releases = await api.get<RegistryPlugin[]>('/admin/system/plugins/available')
        if (currentRequest !== updateRequest) return null
        const updates = releases.filter(release => release.update_available)
        updateMap = new Map(updates.map(release => [release.plugin_key, release]))
        renderPlugins()
        return updates.length
      } catch (err) {
        if (currentRequest !== updateRequest) return null
        throw err
      }
    }

    function selectRelease(release: RegistryPlugin | null) {
      selectedRelease = release
      catalogSelection.hidden = !release
      catalogSelection.textContent = release ? releasePrompt(release) : ''
      installSubmit.hidden = !catalogBrowser.hidden && !release
      installSubmit.disabled = !release
      for (const button of catalogList.querySelectorAll<HTMLButtonElement>('button[data-release]')) {
        button.setAttribute('aria-current', String(button.dataset.release === release?.plugin_key))
      }
    }

    async function loadAvailablePlugins() {
      const currentRequest = ++catalogRequest
      catalogList.replaceChildren()
      availablePlugins = []
      catalogRetry.hidden = true
      catalogStatus.textContent = t('common.loading')
      try {
        const releases = await api.get<RegistryPlugin[]>('/admin/system/plugins/available')
        if (currentRequest !== catalogRequest) return
        availablePlugins = releases.sort((a, b) => a.name.localeCompare(b.name))
        renderCatalog()
      } catch (err) {
        if (currentRequest !== catalogRequest || isAbortError(err)) return
        catalogStatus.textContent = t('admin.pluginRegistryFailed')
        catalogRetry.hidden = false
      }
    }

    function renderCatalog() {
      const query = catalogSearch.value.trim().toLocaleLowerCase()
      const filter = catalogFilter.value
      const matches = availablePlugins.filter(p => {
        if (filter === 'installed' && !p.is_installed) return false
        if (filter === 'uninstalled' && p.is_installed) return false
        if (filter === 'updates' && !p.update_available) return false
        return [p.name, p.description, p.publisher].some(value => value.toLocaleLowerCase().includes(query))
      })
      if (selectedRelease && !matches.includes(selectedRelease)) {
        selectRelease(null)
        clearInstallResult()
      }
      catalogList.innerHTML = matches.map(p => {
        const requirement = t('admin.pluginRequiresFilaMan').replace('{version}', p.min_filaman_version)
        let blocked = ''
        if (p.requires_newer_zip) {
          blocked = t('admin.pluginRequiresNewerZip').replace('{version}', p.installed_version ?? '')
        } else if (!p.is_compatible) {
          blocked = requirement
        }
        const offersInstall = !p.is_installed || p.update_available
        const installedVersion = p.installed_version && p.installed_version !== p.version
          ? ` · v${p.installed_version}`
          : ''
        const action = p.update_available
          ? t('admin.pluginUpdateTo').replace('{version}', p.version)
          : t('admin.installPlugin')
        return `<li class="catalog-card">
          <div class="catalog-heading">
            <span class="catalog-icon"></span>
            <div><h3>${escapeHtml(p.name)}</h3><p class="fm-field-hint">${escapeHtml(p.publisher)}</p></div>
            <span class="catalog-version">v${escapeHtml(p.version)}</span>
          </div>
          <p class="catalog-description">${escapeHtml(p.description)}</p>
          <div class="catalog-footer">
            ${blocked || offersInstall ? `<p class="fm-field-hint">${escapeHtml(blocked || requirement)}</p>` : ''}
            <div class="catalog-actions">
              <a href="${escapeHtml(p.repository_url)}" target="_blank" rel="noopener noreferrer" aria-label="${escapeHtml(p.name)} · GitHub">GitHub</a>
              ${p.is_installed ? `<span class="catalog-installed"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>${escapeHtml(t('admin.pluginAlreadyInstalled') + installedVersion)}</span>` : ''}
              ${!blocked && offersInstall ? `<button type="button" class="fm-btn fm-btn-primary" data-release="${escapeHtml(p.plugin_key)}" aria-current="${p.plugin_key === selectedRelease?.plugin_key}">${escapeHtml(action)}</button>` : ''}
            </div>
          </div>
        </li>`
      }).join('')
      catalogList.querySelectorAll('.catalog-icon').forEach((host, index) => {
        host.append(createPluginIcon(matches[index].icon_url))
      })
      catalogStatus.textContent = matches.length ? '' : t(availablePlugins.length ? 'admin.pluginNoMatches' : 'admin.pluginNoAvailable')
    }

    catalogSearch.addEventListener('keydown', event => {
      if (event.key === 'Enter') event.preventDefault()
    })
    function applyCatalogFilters() {
      if (availablePlugins.length) renderCatalog()
    }
    catalogSearch.addEventListener('input', applyCatalogFilters)
    catalogFilter.addEventListener('change', applyCatalogFilters)
    catalogRetry.addEventListener('click', loadAvailablePlugins)
    catalogList.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-release]')
      const release = availablePlugins.find(p => p.plugin_key === button?.dataset.release)
      if (!release) return
      clearInstallResult()
      selectRelease(release)
      installSubmit.focus({ preventScroll: true })
    })

    // ----------------------------------------------------------------
    //  Auf Aktualisierungen pruefen
    // ----------------------------------------------------------------

    document.getElementById('btn-check-updates')?.addEventListener('click', async () => {
      const btn = document.getElementById('btn-check-updates') as HTMLButtonElement
      btn.disabled = true
      btn.textContent = t('admin.pluginCheckingUpdates')

      try {
        const count = await refreshUpdateActions()
        if (count === null) return

        if (count === 0) {
          showMessage(t('admin.pluginUpToDate'))
        } else {
          const msg = t('admin.pluginUpdatesAvailable').replace('{count}', String(count))
          showMessage(msg)
        }

      } catch (err) {
        if (isAbortError(err)) return
        console.error('Update check failed:', err)
        showMessage(err instanceof Error ? err.message : t('admin.pluginRegistryFailed'), true)
      } finally {
        btn.disabled = false
        btn.textContent = t('admin.pluginCheckUpdates')
      }
    })
    
    // ----------------------------------------------------------------
    //  Initialisierung
    // ----------------------------------------------------------------
    
    loadPlugins()
  </script>
</Layout>
