---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="FilaMan - Admin Devices">
  <style>
    .device-dialog {
      width: calc(100% - 2rem);
      max-width: 28rem;
      max-height: calc(100vh - 2rem);
      margin: auto;
      padding: 24px;
      color: var(--text);
      overflow-y: auto;
    }

    .device-dialog::backdrop {
      background: rgba(0, 0, 0, 0.55);
    }
  </style>

  <div style="margin-bottom: 24px;">
    <a href="/admin" style="color: var(--accent); text-decoration: none;">&larr; <span data-i18n="admin.backToAdmin">Back to Admin</span></a>
  </div>
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="font-size: 1.8rem; font-weight: 700; margin: 0; font-family: var(--font-serif);" data-i18n="admin.deviceTokens">Device Tokens</h1>
    <button
      id="btn-new"
      class="fm-btn fm-btn-primary"
      data-i18n="admin.createDevice"
    >
      Create Device
    </button>
  </div>
  
  <div class="fm-card" style="padding: 0;">
    <table class="fm-table">
      <thead style="background: var(--bg-soft);">
        <tr>
          <th data-i18n="common.name">Name</th>
          <th data-i18n="common.status">Status</th>
          <th data-i18n="admin.ipAddress">IP Address</th>
          <th data-i18n="admin.autoAssign">Auto-Assign</th>
          <th data-i18n="admin.lastUsed">Last Used</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="devices-table">
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <dialog id="modal-container" class="fm-card device-dialog" aria-labelledby="modal-title">
    <h3 id="modal-title" style="font-size: 1.15rem; font-weight: 600; margin-bottom: 16px;" data-i18n="admin.createDevice">Create Device</h3>
    <form id="modal-form" style="display: flex; flex-direction: column; gap: 16px;">
      <div>
        <label for="device-name" class="fm-label"><span data-i18n="common.name">Name</span> *</label>
        <input type="text" id="device-name" required class="fm-input" />
      </div>
      <div id="modal-error" class="fm-alert-error hidden" role="alert"></div>
      <div style="display: flex; gap: 12px;">
        <button type="submit" id="modal-submit" class="fm-btn fm-btn-primary" data-i18n="common.create">Create</button>
        <button type="button" id="modal-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </div>
    </form>
  </dialog>
  
  <dialog id="token-modal" class="fm-card device-dialog" aria-labelledby="token-modal-title">
    <h3 id="token-modal-title" style="font-size: 1.15rem; font-weight: 600; margin-bottom: 16px;" data-i18n="admin.tokenCreated">Device Token Created</h3>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;" data-i18n="admin.tokenWarning">Copy this token now. It will not be shown again.</p>
    <label for="token-display" class="fm-visually-hidden" data-i18n="admin.deviceCode">Device code</label>
    <input readonly class="fm-input" style="font-family: monospace; font-size: 0.85rem; margin-bottom: 16px;" id="token-display" />
    <div id="token-copy-error" class="fm-alert-error hidden" role="alert" style="margin-bottom: 16px;"></div>
    <button type="button" id="token-copy" class="fm-btn fm-btn-primary" style="width: 100%;" data-i18n="admin.copyToClipboard">Copy to Clipboard</button>
    <button type="button" id="token-close" class="fm-btn fm-btn-outline" style="width: 100%; margin-top: 8px;" data-i18n="common.close">Close</button>
  </dialog>
  
  <dialog id="edit-modal" class="fm-card device-dialog" aria-labelledby="edit-modal-title">
    <h3 id="edit-modal-title" style="font-size: 1.15rem; font-weight: 600; margin-bottom: 16px;" data-i18n="admin.editDevice">Edit Device</h3>
    <form id="edit-form" style="display: flex; flex-direction: column; gap: 16px;">
      <input type="hidden" id="edit-device-id" />
      <div>
        <label for="edit-device-name" class="fm-label"><span data-i18n="common.name">Name</span> *</label>
        <input type="text" id="edit-device-name" required class="fm-input" />
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <input type="checkbox" id="edit-auto-assign" style="width: 18px; height: 18px; cursor: pointer;" />
        <label for="edit-auto-assign" style="cursor: pointer; font-size: 0.9rem;" data-i18n="admin.autoAssignEnabled">Enable Auto-Assign</label>
      </div>
      <div id="edit-timeout-group">
        <label for="edit-auto-timeout" class="fm-label"><span data-i18n="admin.autoAssignTimeout">Timeout (seconds)</span></label>
        <input type="number" id="edit-auto-timeout" min="10" max="300" step="1" class="fm-input" />
      </div>
      <div id="edit-error" class="fm-alert-error hidden" role="alert"></div>
      <div style="display: flex; gap: 12px;">
        <button type="submit" id="edit-submit" class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
        <button type="button" id="edit-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </div>
    </form>
  </dialog>
  
  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { isAbortError } from '../../lib/abort'
    import { copyText } from '../../lib/clipboard'
    import { escapeHtml } from '../../lib/extra-fields'
    import { api, fetchAllPages } from '../../lib/api'
    await initI18n()

    interface DeviceRecord {
      id: number
      name: string
      is_active: boolean
      registration_pending: boolean
      ip_address: string | null
      auto_assign_enabled: boolean
      auto_assign_timeout: number
      last_used_at: string | null
      is_online: boolean
    }

    type DeviceAdminWindow = {
      __fmAlert: (message: string) => Promise<boolean>
      __fmConfirm: (message: string) => Promise<boolean>
    }

    const dialogWindow = window as unknown as DeviceAdminWindow
    const createModal = document.getElementById('modal-container') as HTMLDialogElement
    const tokenModal = document.getElementById('token-modal') as HTMLDialogElement
    const editModal = document.getElementById('edit-modal') as HTMLDialogElement
    const modals = [createModal, tokenModal, editModal]
    let devices: DeviceRecord[] = []
    let returnFocus: HTMLElement | null = null

    function openModal(modal: HTMLDialogElement, initialFocus: HTMLElement) {
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
      modal.showModal()
      initialFocus.focus()
    }

    function closeModal(modal: HTMLDialogElement) {
      modal.close()
    }

    modals.forEach(modal => {
      modal.addEventListener('close', () => {
        returnFocus?.focus()
        returnFocus = null
      })
    })

    tokenModal.addEventListener('cancel', event => {
      event.preventDefault()
    })
    
    async function loadDevices() {
      try {
        devices = (await fetchAllPages<DeviceRecord>('/api/v1/admin/devices')).items
        renderDevices()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load devices:', error)
        document.getElementById('devices-table')!.innerHTML = `
          <tr><td colspan="6" role="alert" style="text-align: center; color: var(--error-text);">
            ${t('admin.failedLoadDevices')}
          </td></tr>
        `
      }
    }
    
    function renderDevices() {
      const tbody = document.getElementById('devices-table')!
      
      if (devices.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted);">${t('admin.noDevices')}</td></tr>`
        return
      }
      
      tbody.innerHTML = devices.map(d => {
        // Determine status
        let statusLabel = t('common.active')
        let statusColor = 'var(--accent-2)' // Green
        
        if (!d.is_active) {
          if (d.registration_pending) {
            statusLabel = t('admin.pending')
            statusColor = 'orange'
          } else {
            statusLabel = t('admin.inactive')
            statusColor = 'var(--error-text)'
          }
        } else if (d.is_online) {
          statusLabel = t('common.online')
          statusColor = 'var(--accent-2)'
        } else {
          statusLabel = t('common.offline')
          statusColor = 'var(--text-muted)'
        }
        const deviceHost = d.ip_address?.includes(':') ? `[${d.ip_address}]` : d.ip_address
        
        return `
        <tr>
          <td>${escapeHtml(d.name)}</td>
          <td>
            <span style="padding: 2px 8px; font-size: 0.75rem; border-radius: 999px; background: var(--bg-soft); color: ${statusColor}; border: 1px solid ${statusColor}40;">
              ${statusLabel}
            </span>
          </td>
          <td style="font-family: monospace; font-size: 0.85rem;">
            ${deviceHost ? `<a href="http://${escapeHtml(deviceHost)}" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">${escapeHtml(d.ip_address!)}</a>` : '-'}
          </td>
          <td>
            <span style="padding: 2px 8px; font-size: 0.75rem; border-radius: 999px; background: var(--bg-soft); color: ${d.auto_assign_enabled ? 'var(--accent-2)' : 'var(--text-muted)'}; border: 1px solid ${d.auto_assign_enabled ? 'var(--accent-2)' : 'var(--text-muted)'}40;">
              ${d.auto_assign_enabled ? t('common.on') : t('common.off')}
            </span>
          </td>
          <td style="color: var(--text-muted); font-size: 0.85rem;">${d.last_used_at ? new Date(d.last_used_at).toLocaleString() : t('common.never')}</td>
          <td style="text-align: right; white-space: nowrap;">
            <button data-id="${d.id}" class="btn-edit" style="color: var(--accent); background: none; border: none; cursor: pointer; margin-right: 8px;">${t('common.edit')}</button>
            <button data-id="${d.id}" class="btn-delete" style="color: var(--error-text); background: none; border: none; cursor: pointer;">${t('common.delete')}</button>
          </td>
        </tr>
      `
      }).join('')
      
      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const button = e.currentTarget as HTMLButtonElement
          const id = parseInt(button.dataset.id!)
          
          if (!(await dialogWindow.__fmConfirm(t('admin.confirmDeleteDevice')))) return
          
          try {
            await api.delete(`/admin/devices/${id}`)
            loadDevices()
          } catch (err: unknown) {
            if (isAbortError(err)) return
            console.error('Delete device error:', err)
            await dialogWindow.__fmAlert(
              err instanceof Error ? err.message : t('admin.failedDeleteDevice'),
            )
          }
        })
      })
      
      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const button = e.currentTarget as HTMLButtonElement
          const id = parseInt(button.dataset.id!)
          const device = devices.find(d => d.id === id)
          if (!device) return
          
          ;(document.getElementById('edit-device-id') as HTMLInputElement).value = String(device.id)
          ;(document.getElementById('edit-device-name') as HTMLInputElement).value = device.name
          ;(document.getElementById('edit-auto-assign') as HTMLInputElement).checked = device.auto_assign_enabled || false
          ;(document.getElementById('edit-auto-timeout') as HTMLInputElement).value = String(device.auto_assign_timeout || 60)
          toggleTimeoutVisibility()
          openModal(
            editModal,
            document.getElementById('edit-device-name')!,
          )
        })
      })
    }
    
    function showToken(token: string) {
      const display = document.getElementById('token-display') as HTMLInputElement
      const copyButton = document.getElementById('token-copy') as HTMLButtonElement
      
      display.value = token
      copyButton.textContent = t('admin.copyToClipboard')
      document.getElementById('token-copy-error')!.classList.add('hidden')
      openModal(tokenModal, copyButton)
    }
    
    document.getElementById('token-copy')?.addEventListener('click', async () => {
      const display = document.getElementById('token-display') as HTMLInputElement
      const copyError = document.getElementById('token-copy-error')!
      if (await copyText(display.value)) {
        copyError.classList.add('hidden')
        ;(document.getElementById('token-copy') as HTMLButtonElement).textContent = t('admin.copied')
      } else {
        copyError.textContent = t('admin.copyFailed')
        copyError.classList.remove('hidden')
        display.select()
      }
    })
    
    document.getElementById('token-close')?.addEventListener('click', () => {
      closeModal(tokenModal)
    })
    
    function toggleTimeoutVisibility() {
      const checked = (document.getElementById('edit-auto-assign') as HTMLInputElement).checked
      const group = document.getElementById('edit-timeout-group')!
      group.style.display = checked ? 'block' : 'none'
    }
    
    document.getElementById('edit-auto-assign')?.addEventListener('change', toggleTimeoutVisibility)
    
    document.getElementById('edit-cancel')?.addEventListener('click', () => {
      closeModal(editModal)
    })
    
    document.getElementById('edit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const deviceId = (document.getElementById('edit-device-id') as HTMLInputElement).value
      const name = (document.getElementById('edit-device-name') as HTMLInputElement).value
      const autoAssign = (document.getElementById('edit-auto-assign') as HTMLInputElement).checked
      const timeout = parseInt((document.getElementById('edit-auto-timeout') as HTMLInputElement).value) || 60
      
      const error = document.getElementById('edit-error') as HTMLDivElement
      const submitBtn = document.getElementById('edit-submit') as HTMLButtonElement
      
      error.classList.add('hidden')
      submitBtn.disabled = true
      submitBtn.textContent = t('common.saving')
      
      try {
        await api.put(`/admin/devices/${deviceId}`, {
          name,
          auto_assign_enabled: autoAssign,
          auto_assign_timeout: timeout,
        })
        
        closeModal(editModal)
        loadDevices()
      } catch (err: unknown) {
        if (isAbortError(err)) return
        error.textContent = err instanceof Error ? err.message : t('admin.failedUpdateDevice')
        error.classList.remove('hidden')
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = t('common.save')
      }
    })
    
    document.getElementById('btn-new')?.addEventListener('click', () => {
      ;(document.getElementById('device-name') as HTMLInputElement).value = ''
      openModal(
        createModal,
        document.getElementById('device-name')!,
      )
    })
    
    document.getElementById('modal-cancel')?.addEventListener('click', () => {
      closeModal(createModal)
    })
    
    document.getElementById('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const name = (document.getElementById('device-name') as HTMLInputElement).value
      
      const error = document.getElementById('modal-error') as HTMLDivElement
      const submitBtn = document.getElementById('modal-submit') as HTMLButtonElement
      
      error.classList.add('hidden')
      submitBtn.disabled = true
      submitBtn.textContent = t('common.creating')
      
      try {
        const data = await api.post<{ device_code: string }>('/admin/devices', { name })
        closeModal(createModal)
        showToken(data.device_code)
        loadDevices()
      } catch (err: unknown) {
        if (isAbortError(err)) return
        error.textContent = err instanceof Error ? err.message : t('admin.failedCreateDevice')
        error.classList.remove('hidden')
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = t('common.create')
      }
    })
    
    loadDevices()
  </script>
</Layout>
