---
import Layout from '../../layouts/Layout.astro'
import FormSection from '../../components/FormSection.astro'
---
<Layout title="FilaMan - App Settings">
<div class="fm-settings-page">
  <header class="fm-list-toolbar">
    <div><a href="/admin" class="fm-admin-back">&larr; <span data-i18n="admin.backToAdmin">Back to Admin</span></a><h1 data-i18n="admin.appSettingsTitle">App Settings</h1></div>
    <button type="submit" form="app-settings-form" id="save-btn" disabled class="fm-btn fm-btn-primary" data-i18n="admin.appSettingsSave">Save</button>
  </header>
  <form id="app-settings-form" class="fm-settings-grid">
    <div id="form-message" class="hidden fm-settings-wide" role="status"></div>
    <FormSection titleKey="admin.loginDisabled" title="Disable Login" id="login-title">
      <div class="fm-settings-row">
        <p class="fm-field-hint" id="login-hint" data-i18n="admin.loginDisabledHint">When enabled, all endpoints are accessible without authentication</p>
        <label class="fm-toggle"><input type="checkbox" id="login-disabled" aria-labelledby="login-title" aria-describedby="login-hint" /><span class="fm-toggle-slider"></span></label>
      </div>
      <div id="login-warning" class="fm-alert-error hidden" data-i18n="admin.loginDisabledWarning">Warning: Disabling login removes all authentication. Only use in trusted environments!</div>
    </FormSection>
    <FormSection titleKey="admin.appSettingsCurrencyLabel" title="Display Currency" id="currency-title">
      <p class="fm-field-hint" data-i18n="admin.appSettingsCurrencyDescription">Select the currency for displaying prices throughout the application</p>
      <select id="currency" aria-labelledby="currency-title" class="fm-select">
          <option value="EUR">EUR — Euro</option>
          <option value="USD">USD — US Dollar</option>
          <option value="GBP">GBP — British Pound</option>
          <option value="CHF">CHF — Swiss Franc</option>
          <option value="CAD">CAD — Canadian Dollar</option>
          <option value="AUD">AUD — Australian Dollar</option>
          <option value="JPY">JPY — Japanese Yen</option>
          <option value="SEK">SEK — Swedish Krona</option>
          <option value="NOK">NOK — Norwegian Krone</option>
          <option value="DKK">DKK — Danish Krone</option>
          <option value="PLN">PLN — Polish Zloty</option>
          <option value="CZK">CZK — Czech Koruna</option>
          <option value="BRL">BRL — Brazilian Real</option>
        </select>
    </FormSection>
    <FormSection titleKey="admin.rfidSettingsTitle" title="RFID Settings">
      <div class="fm-settings-row">
        <label for="rfid-extended-data-enabled" data-i18n="admin.rfidExtendedDataEnabled">Write extended data</label>
        <label class="fm-toggle"><input type="checkbox" id="rfid-extended-data-enabled" /><span class="fm-toggle-slider"></span></label>
        <p class="fm-field-hint" data-i18n="admin.rfidExtendedDataEnabledHint">When enabled, additional filament data will be written to the RFID tag.</p>
      </div>
      <div id="rfid-protocol-section" class="fm-settings-row">
        <label for="rfid-protocol" data-i18n="admin.rfidProtocol">Protocol</label><select id="rfid-protocol" class="fm-select" style="max-width: 240px;">
          <option value="openspool" data-i18n="admin.rfidProtocolOpenspool">OpenSpool</option>
          <option value="filaman" data-i18n="admin.rfidProtocolFilaman">FilaMan</option>
        </select>
        <p class="fm-field-hint" data-i18n="admin.rfidProtocolHint">Select the protocol for the extended tag data.</p>
      </div>
      <div class="fm-settings-row">
        <label for="rfid-display-colons" data-i18n="admin.rfidDisplayColons">Show colons in RFID UIDs</label>
        <label class="fm-toggle"><input type="checkbox" id="rfid-display-colons" /><span class="fm-toggle-slider"></span></label>
        <p class="fm-field-hint" data-i18n="admin.rfidDisplayColonsHint">Display hexadecimal UIDs as XX:XX:XX. This does not change stored values or matching.</p>
      </div>
    </FormSection>
    <FormSection titleKey="admin.spoolWeightDefaultsTitle" title="Spool Weight Defaults">
      <p class="fm-field-hint" data-i18n="admin.spoolWeightDefaultsDesc">Global weight settings applied to all spools. Individual spools can override these on their Edit page.</p>
      <div class="fm-settings-row"><label for="default-spool-core-weight" data-i18n="spools.spoolCoreWeightLabel">Core / Adapter Weight</label>
        <div class="fm-settings-number"><input type="number" id="default-spool-core-weight" step="1" min="0" placeholder="0" class="fm-input" aria-describedby="default-core-hint" /><span>g</span></div>
      </div>
      <p class="fm-field-hint" id="default-core-hint">
          <span data-i18n="admin.defaultCoreWeightHint">Extra weight added on top of the empty spool weight when calculating remaining filament from a scale reading. Use this for cardboard inner tubes, spool holders, or scale adapters that are always present when weighing a spool.</span>
          <br><strong data-i18n="admin.defaultCoreWeightFormulaLabel">Formula:</strong> <span data-i18n="admin.defaultCoreWeightFormula">Remaining = Scale reading − Empty spool weight − Core/adapter weight.</span>
          <br><span data-i18n="admin.defaultCoreWeightDisableHint">Leave blank or set to 0 to disable.</span>
        </p>
    </FormSection>
    <FormSection titleKey="admin.slicerProfileFallbackTitle" title="Slicer Profile Fallback">
      <p class="fm-field-hint" data-i18n="admin.slicerProfileFallbackDesc">Determines which profile is sent to a Bambu printer's AMS slot when no specific slicer profile resolves for a filament (e.g. a third-party filament with no matching cloud profile for the connected printer model).</p>
      <div class="fm-settings-row"><label for="bambu-unmatched-fallback" data-i18n="admin.slicerFallbackLabel">Default for unmatched filament</label><select id="bambu-unmatched-fallback" class="fm-select" style="max-width: 320px;">
        <option value="generic" data-i18n="admin.slicerFallbackGeneric">Generic profile (Generic PLA, PETG, …)</option>
        <option value="bambu" data-i18n="admin.slicerFallbackBambu">Bambu profile (Bambu PLA Basic, PETG Basic, …)</option>
      </select></div>
      <p class="fm-field-hint"><span data-i18n="admin.slicerFallbackHintPre">Choose</span> <strong data-i18n="admin.slicerFallbackHintStrong">Bambu profile</strong> <span data-i18n="admin.slicerFallbackHintPost">if you prefer Bambu's own material profiles for third-party filament instead of the bland Generic ones. Falls back to Generic for materials without a Bambu-brand equivalent.</span></p>
    </FormSection>
    <FormSection titleKey="admin.mcpTitle" title="AI Assistants (MCP)" class="fm-settings-wide" id="mcp-title">
      <p class="fm-field-hint" data-i18n="admin.mcpDesc">Provides an MCP server at /mcp so AI assistants (Claude, Cursor, VS Code, Codex, Gemini …) can query FilaMan. Sign-in works only with an API key, and the key's permissions apply.</p>
      <div class="fm-settings-row">
        <label for="mcp-enabled" data-i18n="admin.mcpEnabled">Enable MCP server</label>
        <label class="fm-toggle"><input type="checkbox" id="mcp-enabled" /><span class="fm-toggle-slider"></span></label>
      </div>
      <div id="mcp-write-section" class="fm-settings-row">
        <label for="mcp-write-enabled" data-i18n="admin.mcpWriteEnabled">Allow write access</label>
        <label class="fm-toggle"><input type="checkbox" id="mcp-write-enabled" /><span class="fm-toggle-slider"></span></label>
        <p class="fm-field-hint" data-i18n="admin.mcpWriteHint">Off: the AI can only read. On: it can also create and change spools, filaments, manufacturers and locations and record weights, consumption, status and moves. Deleting is never possible via MCP.</p>
      </div>
      <div id="mcp-write-warning" class="fm-alert-error hidden" data-i18n="admin.mcpWriteWarning">AI assistants can make mistakes. Check changes in the spool history and use a separate API key with limited permissions for the AI.</div>
      <div id="mcp-setup" class="hidden" style="display: grid; gap: 12px; margin-top: 8px;">
        <div class="fm-alert-info">
          <strong data-i18n="admin.mcpSetupTitle">How to connect an AI assistant</strong>
          <ol style="margin: 8px 0 0 18px; padding: 0; font-weight: 400;">
            <li><span data-i18n="admin.mcpStep1">Create an API key under</span> <a href="/settings/api-keys" data-i18n="admin.mcpStep1Link">Settings → API Keys</a><span data-i18n="admin.mcpStep1Post">, ideally a separate one just for the AI.</span></li>
            <li data-i18n="admin.mcpStep2">Copy the template for your AI client below and replace &lt;API-KEY&gt; with your key.</li>
            <li data-i18n="admin.mcpStep3">Restart the AI client and ask, for example: "Which PLA spools have less than 20 % left?"</li>
          </ol>
        </div>
        <div class="fm-settings-row">
          <span class="fm-label" data-i18n="admin.mcpUrlLabel">Server address</span>
          <code id="mcp-url" style="word-break: break-all;"></code>
        </div>
        <p id="mcp-unsaved" class="fm-field-hint" data-i18n="admin.mcpUnsavedHint">Save the settings to activate the MCP server.</p>
        <div id="mcp-clients" style="display: grid; gap: 8px;"></div>
        <p class="fm-field-hint" data-i18n="admin.mcpOtherClients">Other clients (e.g. n8n, LM Studio, Open WebUI): transport "Streamable HTTP", the server address above and the header "Authorization: ApiKey &lt;API-KEY&gt;".</p>
        <p class="fm-field-hint" data-i18n="admin.mcpWebLimitation">Web connectors in claude.ai or ChatGPT need an OAuth sign-in and a public HTTPS address. This is not supported yet; use a desktop or command-line client instead.</p>
      </div>
    </FormSection>
  </form>
</div>
  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { bindFormState } from '../../lib/form-state'
    import { getAbortSignal } from '../../lib/abort'
    import { initCurrency } from '../../lib/format'
    import { copyText } from '../../lib/clipboard'

    interface McpClient { key: string; name: string; file?: string; snippet: string }

    function mcpClients(url: string): McpClient[] {
      const header = { Authorization: 'ApiKey <API-KEY>' }
      const json = (value: unknown): string => JSON.stringify(value, null, 2)
      const remoteArgs = ['-y', 'mcp-remote', url, '--header', 'Authorization:${FILAMAN_AUTH}']
      if (url.startsWith('http://')) remoteArgs.push('--allow-http')
      return [
        {
          key: 'claude-code',
          name: 'Claude Code',
          snippet: `claude mcp add --transport http filaman ${url} --header "Authorization: ApiKey <API-KEY>"`,
        },
        {
          key: 'claude-desktop',
          name: 'Claude Desktop',
          file: 'claude_desktop_config.json',
          snippet: json({ mcpServers: { filaman: { command: 'npx', args: remoteArgs, env: { FILAMAN_AUTH: 'ApiKey <API-KEY>' } } } }),
        },
        { key: 'cursor', name: 'Cursor', file: '~/.cursor/mcp.json', snippet: json({ mcpServers: { filaman: { url, headers: header } } }) },
        { key: 'vscode', name: 'VS Code (Copilot)', file: '.vscode/mcp.json', snippet: json({ servers: { filaman: { type: 'http', url, headers: header } } }) },
        {
          key: 'codex',
          name: 'OpenAI Codex CLI',
          file: '~/.codex/config.toml',
          snippet: `[mcp_servers.filaman]\nurl = "${url}"\nhttp_headers = { "Authorization" = "ApiKey <API-KEY>" }`,
        },
        { key: 'gemini', name: 'Gemini CLI', file: '~/.gemini/settings.json', snippet: json({ mcpServers: { filaman: { httpUrl: url, headers: header } } }) },
      ]
    }

    function renderMcpClients(host: HTMLElement, url: string): void {
      host.replaceChildren()
      for (const client of mcpClients(url)) {
        const details = document.createElement('details')
        details.className = 'fm-card'
        details.style.padding = '8px 12px'
        const summary = document.createElement('summary')
        summary.style.cursor = 'pointer'
        summary.style.fontWeight = '600'
        summary.textContent = client.name
        details.appendChild(summary)
        if (client.file) {
          const file = document.createElement('p')
          file.className = 'fm-field-hint'
          file.textContent = `${t('admin.mcpFileLabel')} ${client.file}`
          details.appendChild(file)
        }
        const pre = document.createElement('pre')
        pre.style.cssText = 'margin: 8px 0; padding: 10px; background: var(--bg-muted, rgba(127,127,127,0.12)); border-radius: var(--radius-sm); font-size: 0.8rem; white-space: pre-wrap; word-break: break-all;'
        pre.textContent = client.snippet
        details.appendChild(pre)
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'fm-btn'
        button.textContent = t('admin.mcpCopy')
        button.addEventListener('click', async () => {
          const ok = await copyText(client.snippet)
          button.textContent = ok ? t('admin.mcpCopied') : t('admin.mcpCopyFailed')
          setTimeout(() => { button.textContent = t('admin.mcpCopy') }, 2000)
        })
        details.appendChild(button)
        host.appendChild(details)
      }
    }

    async function init() {
      await initI18n()
      await initCurrency()

      function getCsrfToken(): string {
        const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
        return match ? decodeURIComponent(match[1]) : ''
      }

      const form = document.getElementById('app-settings-form') as HTMLFormElement
      const loginDisabledInput = document.getElementById('login-disabled') as HTMLInputElement
      const currencySelect = document.getElementById('currency') as HTMLSelectElement
      const warningDiv = document.getElementById('login-warning')!
      const formMessage = document.getElementById('form-message')!
      const saveBtn = document.getElementById('save-btn') as HTMLButtonElement
      const formState = bindFormState(form, saveBtn)
      const rfidExtendedDataInput = document.getElementById('rfid-extended-data-enabled') as HTMLInputElement
      const rfidProtocolSelect = document.getElementById('rfid-protocol') as HTMLSelectElement
      const rfidProtocolSection = document.getElementById('rfid-protocol-section')!
      const rfidDisplayColonsInput = document.getElementById('rfid-display-colons') as HTMLInputElement
      const defaultSpoolCoreWeightInput = document.getElementById('default-spool-core-weight') as HTMLInputElement
      const bambuUnmatchedFallbackSelect = document.getElementById('bambu-unmatched-fallback') as HTMLSelectElement
      const mcpEnabledInput = document.getElementById('mcp-enabled') as HTMLInputElement
      const mcpWriteInput = document.getElementById('mcp-write-enabled') as HTMLInputElement
      const mcpWriteSection = document.getElementById('mcp-write-section')!
      const mcpWriteWarning = document.getElementById('mcp-write-warning')!
      const mcpSetup = document.getElementById('mcp-setup')!
      const mcpUnsaved = document.getElementById('mcp-unsaved')!
      const mcpUrl = `${window.location.origin}/mcp`
      let mcpSavedEnabled = false
      document.getElementById('mcp-url')!.textContent = mcpUrl
      renderMcpClients(document.getElementById('mcp-clients')!, mcpUrl)

      function updateMcpVisibility() {
        const enabled = mcpEnabledInput.checked
        mcpWriteSection.style.opacity = enabled ? '1' : '0.4'
        mcpWriteInput.disabled = !enabled
        mcpWriteWarning.classList.toggle('hidden', !(enabled && mcpWriteInput.checked))
        mcpSetup.classList.toggle('hidden', !enabled)
        mcpUnsaved.classList.toggle('hidden', mcpSavedEnabled)
      }
      mcpEnabledInput.addEventListener('change', updateMcpVisibility)
      mcpWriteInput.addEventListener('change', updateMcpVisibility)

      function showMessage(text: string, isError: boolean) {
        formMessage.textContent = text
        formMessage.className = `fm-settings-wide ${isError ? 'fm-alert-error' : 'fm-alert-success'}`
        formMessage.classList.remove('hidden')
        setTimeout(() => formMessage.classList.add('hidden'), 5000)
      }

      // Toggle warning visibility
      loginDisabledInput.addEventListener('change', () => {
        warningDiv.classList.toggle('hidden', !loginDisabledInput.checked)
      })

      // Protokoll-Section nur sichtbar wenn Extended Data aktiv
      function updateRfidProtocolVisibility() {
        rfidProtocolSection.style.opacity = rfidExtendedDataInput.checked ? '1' : '0.4'
        rfidProtocolSelect.disabled = !rfidExtendedDataInput.checked
      }
      rfidExtendedDataInput.addEventListener('change', updateRfidProtocolVisibility)

      // Load settings
      try {
        const resp = await fetch('/api/v1/admin/app-settings/', { credentials: 'include', signal: getAbortSignal() })
        if (resp.ok) {
          const data = await resp.json()
          loginDisabledInput.checked = data.login_disabled
          currencySelect.value = data.currency || 'EUR'
          warningDiv.classList.toggle('hidden', !data.login_disabled)
          rfidExtendedDataInput.checked = data.rfid_extended_data_enabled ?? false
          rfidProtocolSelect.value = data.rfid_protocol || 'openspool'
          rfidDisplayColonsInput.checked = data.rfid_display_colons === true
          updateRfidProtocolVisibility()
          defaultSpoolCoreWeightInput.value = data.default_spool_core_weight_g != null ? String(data.default_spool_core_weight_g) : ''
          bambuUnmatchedFallbackSelect.value = data.bambu_unmatched_profile_fallback || 'generic'
          mcpEnabledInput.checked = data.mcp_enabled === true
          mcpWriteInput.checked = data.mcp_write_enabled === true
          mcpSavedEnabled = mcpEnabledInput.checked
          updateMcpVisibility()
          formState.reset()
        } else {
          showMessage(t('admin.appSettingsLoadFailed'), true)
        }
      } catch {
        showMessage(t('admin.appSettingsLoadFailed'), true)
      }

      // Save settings
      form.addEventListener('submit', async (e) => {
        e.preventDefault()

        if (formState.busy || saveBtn.disabled || !form.reportValidity()) return
        formState.setBusy(true)
        saveBtn.textContent = t('admin.appSettingsSaving')

        const rawCoreWeight = defaultSpoolCoreWeightInput.value.trim()
        const payload = {
          login_disabled: loginDisabledInput.checked,
          currency: currencySelect.value,
          rfid_extended_data_enabled: rfidExtendedDataInput.checked,
          rfid_protocol: rfidProtocolSelect.value,
          rfid_display_colons: rfidDisplayColonsInput.checked,
          default_spool_core_weight_g: rawCoreWeight !== '' ? parseFloat(rawCoreWeight) : null,
          bambu_unmatched_profile_fallback: bambuUnmatchedFallbackSelect.value,
          mcp_enabled: mcpEnabledInput.checked,
          mcp_write_enabled: mcpEnabledInput.checked && mcpWriteInput.checked,
        }

        try {
          const resp = await fetch('/api/v1/admin/app-settings/', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': getCsrfToken(),
            },
            credentials: 'include',
            body: JSON.stringify(payload),
            signal: getAbortSignal(),
          })

          if (resp.ok) {
            localStorage.setItem('currency', currencySelect.value)
            localStorage.setItem('rfid_display_colons', String(rfidDisplayColonsInput.checked))
            mcpSavedEnabled = mcpEnabledInput.checked
            updateMcpVisibility()
            formState.reset()
            showMessage(t('admin.appSettingsSaveSuccess'), false)
          } else {
            const err = await resp.json().catch(() => ({}))
            const msg =
              err.detail?.message ||
              err.message ||
              (typeof err.detail === 'string' ? err.detail : null) ||
              (Array.isArray(err.detail) ? err.detail[0]?.msg : null) ||
              t('admin.appSettingsSaveFailed')
            showMessage(msg, true)
          }
        } catch {
          showMessage(t('admin.appSettingsSaveFailed'), true)
        } finally {
          formState.setBusy(false)
          saveBtn.textContent = t('admin.appSettingsSave')
        }
      })
    }

    init()
  </script>
</Layout>
