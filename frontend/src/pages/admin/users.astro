---
import Layout from '../../layouts/Layout.astro'
import AdminHeader from '../../components/AdminHeader.astro'
import FormDialog from '../../components/FormDialog.astro'
---

<Layout title="FilaMan - Admin Users">
  <div class="fm-admin-page">
  <AdminHeader titleKey="admin.users" title="Users">
    <button id="btn-new" class="fm-btn fm-btn-primary" data-i18n="admin.addUser">Add User</button>
  </AdminHeader>
  <p id="users-message" class="hidden fm-admin-message" role="status"></p>
  <div class="fm-card" style="padding: 0;">
    <table class="fm-table fm-admin-table">
      <thead>
        <tr>
          <th data-i18n="admin.email">Email</th>
          <th data-i18n="admin.displayName">Display Name</th>
          <th data-i18n="common.status">Status</th>
          <th data-i18n="admin.roles">Roles</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="users-table">
        <tr>
          <td colspan="5" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  </div>
  <FormDialog id="modal-container" titleId="modal-title" titleKey="admin.addUser" title="Add User">
    <Fragment slot="actions">
      <button type="submit" form="modal-form" id="modal-submit" disabled class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
      <button type="button" id="modal-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
    <form id="modal-form" class="fm-compact-form">
        <input type="hidden" id="user-id" />
        <div>
          <label for="user-email" class="fm-label"><span data-i18n="admin.email">Email</span> *</label>
          <input type="email" id="user-email" required class="fm-input" />
        </div>
        <div>
          <label for="user-display-name" class="fm-label" data-i18n="admin.displayName">Display Name</label>
          <input type="text" id="user-display-name" class="fm-input" />
        </div>
        <div id="password-field">
          <label for="user-password" class="fm-label" data-i18n="admin.password">Password *</label>
          <input type="password" id="user-password" class="fm-input" autocomplete="new-password" />
        </div>
        <div>
          <label class="fm-label" data-i18n="admin.roles">Roles</label>
          <div id="roles-checkboxes" class="fm-check-list"></div>
        </div>
        <div>
          <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" id="user-superadmin" />
            <span style="font-size: 0.875rem; color: var(--text);" data-i18n="admin.superadmin">Superadmin</span>
          </label>
        </div>
        <div id="modal-error" class="fm-alert-error hidden" role="alert"></div>
    </form>
  </FormDialog>
  <FormDialog id="password-modal" titleId="password-modal-title" titleKey="admin.resetPw" title="Reset Password">
    <Fragment slot="actions">
      <button type="submit" form="reset-form" id="reset-submit" disabled class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
      <button type="button" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
    <form id="reset-form" class="fm-compact-form">
      <input type="hidden" id="reset-user-id" />
      <div><label for="reset-password" class="fm-label" data-i18n="admin.password">Password</label>
        <input id="reset-password" class="fm-input" type="password" autocomplete="new-password" required minlength="8" /></div>
      <p id="reset-error" class="fm-alert-error hidden" role="alert"></p>
    </form>
  </FormDialog>
  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { isAbortError } from '../../lib/abort'
    import { api } from '../../lib/api'
    import { escapeHtml } from '../../lib/extra-fields'
    import { tableAction } from '../../lib/table-actions'
    import { bindFormDialog } from '../../lib/form-dialog'
    import { bindFormState } from '../../lib/form-state'
    await initI18n()

    interface UserRecord { id: number; email: string; display_name: string | null; is_superadmin: boolean; is_active: boolean; roles?: string[] }
    interface RoleRecord { key: string; name: string }
    let users: UserRecord[] = []
    let roles: RoleRecord[] | null = null
    let rolesEditable = false
    let currentUser: UserRecord | null = null
    let openRequest = 0
    const form = document.getElementById('modal-form') as HTMLFormElement
    const save = document.getElementById('modal-submit') as HTMLButtonElement
    const formState = bindFormState(form, save)
    const formDialog = bindFormDialog(document.getElementById('modal-container') as HTMLDialogElement, {
      canClose: () => !formState.busy,
      onClose: () => { openRequest++; (document.getElementById('user-password') as HTMLInputElement).value = '' },
    })
    const resetForm = document.getElementById('reset-form') as HTMLFormElement
    const resetState = bindFormState(resetForm, document.getElementById('reset-submit') as HTMLButtonElement)
    const resetDialog = bindFormDialog(document.getElementById('password-modal') as HTMLDialogElement, {
      canClose: () => !resetState.busy,
      onClose: () => resetForm.reset(),
    })
    function message(text: string, failed = false) {
      const node = document.getElementById('users-message')!
      node.textContent = text
      node.className = `fm-admin-message ${failed ? 'fm-alert-error' : 'fm-alert-success'}`
      node.setAttribute('role', failed ? 'alert' : 'status')
    }
    async function loadData() {
      try {
        const [userData, roleData, me] = await Promise.all([
          api.get<{ items: UserRecord[] }>('/admin/users'),
          api.get<RoleRecord[]>('/admin/roles').catch(() => null),
          api.get<UserRecord>('/me').catch(() => null),
        ])
        users = userData.items
        roles = roleData
        currentUser = me
        renderUsers()
      } catch (error) {
        if (!isAbortError(error)) message(error instanceof Error ? error.message : t('admin.noUsers'), true)
      }
    }
    function renderUsers() {
      document.getElementById('users-table')!.innerHTML = users.length ? users.map(user => `
        <tr>
          <td>${escapeHtml(user.email)}</td>
          <td>${escapeHtml(user.display_name || '—')}</td>
          <td><span class="fm-pill" style="color:${user.is_active ? 'var(--accent)' : 'var(--text-muted)'}">${t(user.is_active ? 'common.active' : 'common.inactive')}</span>
            ${user.is_superadmin ? `<span class="fm-pill">${t('admin.superadmin')}</span>` : ''}</td>
          <td>${escapeHtml(user.roles?.map(key => roles?.find(role => role.key === key)?.name || key).join(', ') || '—')}</td>
          <td style="text-align:right"><span class="fm-row-actions">
            ${tableAction('edit', { id: user.id })}
            <button type="button" data-id="${user.id}" class="btn-reset fm-btn fm-btn-outline" style="padding:3px 8px;font-size:.75rem">${t('admin.resetPw')}</button>
            ${currentUser && currentUser.id !== user.id ? tableAction('delete', { id: user.id }) : ''}
          </span></td>
        </tr>`).join('') : `<tr><td colspan="5">${escapeHtml(t('admin.noUsers'))}</td></tr>`
      document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach(button => button.addEventListener('click', () => openModal(Number(button.dataset.id))))
      document.querySelectorAll<HTMLButtonElement>('.btn-reset').forEach(button => button.addEventListener('click', () => {
        resetForm.reset()
        ;(document.getElementById('reset-user-id') as HTMLInputElement).value = button.dataset.id!
        document.getElementById('reset-error')!.classList.add('hidden')
        resetState.reset()
        resetDialog.open()
      }))
      document.querySelectorAll<HTMLButtonElement>('.btn-delete').forEach(button => button.addEventListener('click', async () => {
        if (!(await (window as unknown as { __fmConfirm: (message: string) => Promise<boolean> }).__fmConfirm(t('admin.deleteUserConfirm')))) return
        try { await api.delete(`/admin/users/${button.dataset.id}`); await loadData() }
        catch (error) { if (!isAbortError(error)) message(error instanceof Error ? error.message : t('admin.failedDeleteUser'), true) }
      }))
    }
    function renderRoleCheckboxes(selected: string[] = []) {
      // Save only assignments offered by this editor, even if a background refresh reloads roles.
      rolesEditable = roles !== null
      document.getElementById('roles-checkboxes')!.innerHTML = roles ? roles.map(role => `
        <label><input type="checkbox" value="${escapeHtml(role.key)}" class="role-checkbox" ${selected.includes(role.key) ? 'checked' : ''} />${escapeHtml(role.name)}</label>
      `).join('') : `<p class="fm-field-hint">${escapeHtml(t('admin.rolesUnavailable'))}</p>`
    }
    async function openModal(id: number | null = null) {
      const request = ++openRequest
      try {
        const user = id ? await api.get<UserRecord>(`/admin/users/${id}`) : null
        if (request !== openRequest) return
        form.reset()
        ;(document.getElementById('user-id') as HTMLInputElement).value = user ? String(user.id) : ''
        ;(document.getElementById('user-email') as HTMLInputElement).value = user?.email || ''
        ;(document.getElementById('user-display-name') as HTMLInputElement).value = user?.display_name || ''
        ;(document.getElementById('user-superadmin') as HTMLInputElement).checked = user?.is_superadmin || false
        ;(document.getElementById('user-password') as HTMLInputElement).required = !user
        document.getElementById('password-field')!.classList.toggle('hidden', Boolean(user))
        document.getElementById('modal-title')!.textContent = t(user ? 'admin.editUser' : 'admin.addUser')
        document.getElementById('modal-error')!.classList.add('hidden')
        renderRoleCheckboxes(user?.roles)
        formState.reset()
        formDialog.open()
      } catch (error) {
        if (!isAbortError(error)) message(error instanceof Error ? error.message : t('admin.failedUpdateUser'), true)
      }
    }
    document.getElementById('btn-new')!.addEventListener('click', () => openModal())
    form.addEventListener('submit', async event => {
      event.preventDefault()
      if (formState.busy || save.disabled || !form.reportValidity()) return
      const idInput = document.getElementById('user-id') as HTMLInputElement
      const payload = {
        email: (document.getElementById('user-email') as HTMLInputElement).value,
        display_name: (document.getElementById('user-display-name') as HTMLInputElement).value || null,
        is_superadmin: (document.getElementById('user-superadmin') as HTMLInputElement).checked,
      }
      const selectedRoles = [...form.querySelectorAll<HTMLInputElement>('.role-checkbox:checked')].map(input => input.value)
      const error = document.getElementById('modal-error')!
      error.classList.add('hidden')
      formState.setBusy(true)
      let detailsSaved = false
      try {
        if (idInput.value) await api.patch(`/admin/users/${idInput.value}`, payload)
        else {
          const created = await api.post<UserRecord>('/admin/users', { ...payload, password: (document.getElementById('user-password') as HTMLInputElement).value })
          // Keep the created identity if assigning roles fails, so retry cannot create a duplicate.
          idInput.value = String(created.id)
          ;(document.getElementById('user-password') as HTMLInputElement).value = ''
          ;(document.getElementById('user-password') as HTMLInputElement).required = false
          document.getElementById('password-field')!.classList.add('hidden')
          document.getElementById('modal-title')!.textContent = t('admin.editUser')
        }
        detailsSaved = true
        if (rolesEditable) await api.put(`/admin/users/${idInput.value}/roles`, selectedRoles)
        formState.setBusy(false)
        formDialog.close()
        await loadData()
      } catch (err) {
        if (isAbortError(err)) return
        error.textContent = err instanceof Error ? err.message : t('admin.failedUpdateUser')
        error.classList.remove('hidden')
        // Details may already exist even when the separate roles request failed.
        if (detailsSaved) await loadData()
      } finally { formState.setBusy(false) }
    })
    resetForm.addEventListener('submit', async event => {
      event.preventDefault()
      if (resetState.busy || !resetForm.reportValidity()) return
      const error = document.getElementById('reset-error')!
      error.classList.add('hidden')
      resetState.setBusy(true)
      try {
        await api.post(`/admin/users/${(document.getElementById('reset-user-id') as HTMLInputElement).value}/reset-password`, { new_password: (document.getElementById('reset-password') as HTMLInputElement).value })
        resetState.setBusy(false)
        resetDialog.close()
        message(t('admin.resetPwSuccess'))
      } catch (err) {
        if (isAbortError(err)) return
        error.textContent = err instanceof Error ? err.message : t('admin.resetPwFailed')
        error.classList.remove('hidden')
      } finally { resetState.setBusy(false) }
    })
    loadData()
  </script>
</Layout>
