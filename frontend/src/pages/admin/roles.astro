---
import Layout from '../../layouts/Layout.astro'
import AdminHeader from '../../components/AdminHeader.astro'
import FormDialog from '../../components/FormDialog.astro'
import FormSection from '../../components/FormSection.astro'
---
<Layout title="FilaMan - Admin Roles">
  <style>
    #role-edit-form, .role-picker { max-width: 32rem; }
    #role-edit-form > div, .role-picker { grid-template-columns: 9rem minmax(0, 1fr); }
    @media (max-width: 640px) { #role-edit-form > div, .role-picker { grid-template-columns: minmax(0, 1fr); } }
    .role-summary { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 12px; color: var(--text-muted); font-size: .85rem; }
    .role-summary code { color: var(--text); }
    .role-permissions-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    :global(.role-permission-group) { min-width: 0; border: 0; border-top: 1px solid var(--border); padding: 8px 0 0; }
    :global(.role-permission-group legend) { padding-right: 8px; font-size: .8rem; font-weight: 600; text-transform: capitalize; }
    :global(.role-permission) { display: flex; align-items: flex-start; gap: 8px; padding: 5px 0; font-size: .8rem; overflow-wrap: anywhere; }
    :global(.role-permission input) { margin-top: 3px; flex-shrink: 0; accent-color: var(--accent); }
    :global(.role-permission small) { display: block; color: var(--text-muted); font-size: .75rem; }
    @container detail-page (max-width: 52rem) { .role-permissions-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @container detail-page (max-width: 34rem) { .role-permissions-grid { grid-template-columns: 1fr; } }
  </style>
  <div class="fm-admin-page">
    <AdminHeader titleKey="admin.rolesPerms" title="Roles & Permissions">
      <button id="btn-new-role" class="fm-btn fm-btn-primary" data-i18n="admin.createRole">Create Role</button>
    </AdminHeader>
    <div id="page-error" class="fm-alert-error hidden" role="alert"></div>
    <div class="fm-settings-stack">
      <FormSection titleKey="admin.rolesTitle" title="Roles">
        <Fragment slot="actions">
          <div class="fm-header-actions">
            <button id="edit-role" class="fm-btn fm-btn-outline" disabled data-i18n="admin.editRole">Edit Role</button>
            <div id="role-edit-actions" class="fm-header-actions hidden">
              <button id="role-save" type="submit" form="role-edit-form" class="fm-btn fm-btn-primary" disabled data-i18n="common.save">Save</button>
              <button id="role-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
            </div>
            <button id="role-delete" class="fm-row-action fm-row-action-danger hidden" data-i18n-aria-label="admin.deleteRole" data-i18n-title="admin.deleteRole" aria-label="Delete Role" title="Delete Role"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6"/></svg></button>
          </div>
        </Fragment>
        <div class="role-picker fm-settings-row"><label for="role-select" class="fm-label" data-i18n="admin.rolesTitle">Roles</label><select id="role-select" class="fm-select" disabled></select></div>
        <div id="role-summary" class="role-summary"></div>
        <form id="role-edit-form" class="fm-compact-form hidden">
          <div><label for="role-edit-name" class="fm-label" data-i18n="admin.roleName">Name</label><input id="role-edit-name" class="fm-input" required /></div>
          <div><label for="role-edit-description" class="fm-label" data-i18n="admin.roleDescription">Description</label><input id="role-edit-description" class="fm-input" /></div>
        </form>
        <div id="role-error" class="fm-alert-error hidden" role="alert"></div>
      </FormSection>
      <FormSection titleKey="admin.permissions" title="Permissions" id="permissions-header">
        <Fragment slot="actions">
          <div class="fm-header-actions">
            <button id="edit-permissions" class="fm-btn fm-btn-outline" disabled data-i18n="admin.editPermissions">Edit Permissions</button>
            <div id="permissions-edit-actions" class="fm-header-actions hidden">
              <button id="permissions-save" type="submit" form="permissions-form" class="fm-btn fm-btn-primary" disabled data-i18n="common.save">Save</button>
              <button id="permissions-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
            </div>
          </div>
        </Fragment>
        <form id="permissions-form"><div id="permissions-checkboxes" class="role-permissions-grid"></div></form>
        <div id="permissions-error" class="fm-alert-error hidden" role="alert"></div>
      </FormSection>
    </div>
    <FormDialog id="role-modal" titleId="role-modal-title" titleKey="admin.createRole" title="Create Role">
      <Fragment slot="actions">
        <button id="role-modal-submit" type="submit" form="role-modal-form" class="fm-btn fm-btn-primary" disabled data-i18n="common.save">Save</button>
        <button id="role-modal-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </Fragment>
      <form id="role-modal-form" class="fm-compact-form">
        <div><label for="role-key" class="fm-label"><span data-i18n="admin.roleKey">Key</span> *</label><input id="role-key" class="fm-input" required pattern="[a-z][a-z0-9_]{1,48}[a-z0-9]" placeholder="e.g. editor" data-i18n-placeholder="admin.roleKeyPlaceholder" /><p class="fm-field-hint" data-i18n="admin.roleKeyHint">Unique identifier (lowercase, no spaces)</p></div>
        <div><label for="role-name-input" class="fm-label"><span data-i18n="admin.roleName">Name</span> *</label><input id="role-name-input" class="fm-input" required /></div>
        <div><label for="role-description" class="fm-label" data-i18n="admin.roleDescription">Description</label><input id="role-description" class="fm-input" /></div>
        <div id="role-modal-error" class="fm-alert-error hidden" role="alert"></div>
      </form>
    </FormDialog>
  </div>
  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { api } from '../../lib/api'
    import { isAbortError } from '../../lib/abort'
    import { escapeHtml } from '../../lib/extra-fields'
    import { bindFormDialog } from '../../lib/form-dialog'
    import { bindFormState } from '../../lib/form-state'
    await initI18n()

    interface Role { id: number; key: string; name: string; description: string | null; is_system: boolean }
    interface Permission { key: string; description: string | null; category: string | null }
    interface RoleDetail extends Role { permissions: string[] }
    const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
    const roleSelect = byId<HTMLSelectElement>('role-select')
    const roleForm = byId<HTMLFormElement>('role-edit-form')
    const permissionForm = byId<HTMLFormElement>('permissions-form')
    const createForm = byId<HTMLFormElement>('role-modal-form')
    const roleState = bindFormState(roleForm, byId<HTMLButtonElement>('role-save'))
    const permissionState = bindFormState(permissionForm, byId<HTMLButtonElement>('permissions-save'))
    const createState = bindFormState(createForm, byId<HTMLButtonElement>('role-modal-submit'))
    const createDialog = bindFormDialog(byId<HTMLDialogElement>('role-modal'), { canClose: () => !createState.busy })
    const fm = window as unknown as { __fmConfirm: (message: string) => Promise<boolean> }
    let roles: Role[] = []
    let permissions: Permission[] = []
    let selectedRole: Role | undefined
    let selectedPermissions: string[] | null = null
    let editing: 'role' | 'permissions' | null = null
    let deleting = false
    let roleRequest = 0
    const busy = () => deleting || roleState.busy || permissionState.busy || createState.busy
    const hide = (id: string, hidden: boolean) => byId(id).classList.toggle('hidden', hidden)
    function showError(id: string, cause: unknown) {
      const host = byId(id)
      host.textContent = cause instanceof Error ? cause.message : String(cause)
      hide(id, false)
    }
    function updateControls() {
      const locked = busy() || editing !== null
      roleSelect.disabled = locked || roles.length === 0
      byId<HTMLButtonElement>('btn-new-role').disabled = locked
      byId<HTMLButtonElement>('edit-role').disabled = busy() || !selectedRole
      byId<HTMLButtonElement>('edit-permissions').disabled = busy() || selectedPermissions === null
      byId<HTMLButtonElement>('role-cancel').disabled = busy()
      byId<HTMLButtonElement>('permissions-cancel').disabled = busy()
      byId<HTMLButtonElement>('role-delete').disabled = busy()
      hide('edit-role', editing !== null)
      hide('edit-permissions', editing !== null)
      hide('role-edit-actions', editing !== 'role')
      hide('permissions-edit-actions', editing !== 'permissions')
      hide('role-delete', !selectedRole || selectedRole.is_system || editing !== null)
      hide('role-edit-form', editing !== 'role')
      hide('role-summary', editing === 'role')
    }
    function renderRole() {
      byId('role-summary').innerHTML = selectedRole
        ? `<code>${escapeHtml(selectedRole.key)}</code>${selectedRole.is_system ? `<span class="fm-pill" title="${escapeHtml(t('admin.systemRoleHint'))}">${escapeHtml(t('admin.systemRole'))}</span>` : ''}<span>${escapeHtml(selectedRole.description || '—')}</span>`
        : escapeHtml(t('admin.noRoles'))
      byId('permissions-header').textContent = selectedRole ? `${t('admin.permissionsForRole')}: ${selectedRole.name}` : t('admin.permissions')
      updateControls()
    }
    function renderPermissions() {
      const host = byId('permissions-checkboxes')
      if (selectedPermissions === null) {
        host.textContent = selectedRole ? t('common.loading') : ''
        return
      }
      const grouped = new Map<string, Permission[]>()
      for (const permission of permissions) {
        const category = permission.category || 'other'
        if (!grouped.has(category)) grouped.set(category, [])
        grouped.get(category)!.push(permission)
      }
      host.innerHTML = [...grouped].map(([category, entries]) => `<fieldset class="role-permission-group"><legend>${escapeHtml(category)}</legend>${entries.map(permission => `<label class="role-permission"><input type="checkbox" class="perm-checkbox" value="${escapeHtml(permission.key)}" ${selectedPermissions!.includes(permission.key) ? 'checked' : ''} ${editing === 'permissions' ? '' : 'disabled'} /><span><code>${escapeHtml(permission.key)}</code>${permission.description ? `<small>${escapeHtml(permission.description)}</small>` : ''}</span></label>`).join('')}</fieldset>`).join('')
      permissionState.reset()
    }
    async function selectRole(id: number | undefined) {
      selectedRole = roles.find(role => role.id === id)
      roleSelect.value = selectedRole ? String(selectedRole.id) : ''
      selectedPermissions = null
      editing = null
      hide('role-error', true)
      hide('permissions-error', true)
      renderRole()
      renderPermissions()
      const request = ++roleRequest
      if (!selectedRole) return
      try {
        const detail = await api.get<RoleDetail>(`/admin/roles/${id}`)
        // A slower previous selection must never replace the current role's permissions.
        if (request !== roleRequest) return
        selectedPermissions = detail.permissions || []
        renderPermissions()
      } catch (error) {
        if (request !== roleRequest || isAbortError(error)) return
        byId('permissions-checkboxes').textContent = ''
        showError('permissions-error', error)
      }
      updateControls()
    }
    async function loadData(preferredId = selectedRole?.id) {
      hide('page-error', true)
      try {
        ;[roles, permissions] = await Promise.all([api.get<Role[]>('/admin/roles'), api.get<Permission[]>('/admin/permissions')])
        roleSelect.innerHTML = roles.map(role => `<option value="${role.id}">${escapeHtml(role.name)}</option>`).join('')
        await selectRole(roles.find(role => role.id === preferredId)?.id ?? roles[0]?.id)
      } catch (error) {
        if (!isAbortError(error)) showError('page-error', error)
      }
    }
    roleSelect.addEventListener('change', () => {
      if (busy() || editing) { roleSelect.value = String(selectedRole?.id || ''); return }
      selectRole(Number(roleSelect.value))
    })
    byId('edit-role').addEventListener('click', () => {
      if (!selectedRole || busy()) return
      editing = 'role'
      byId<HTMLInputElement>('role-edit-name').value = selectedRole.name
      byId<HTMLInputElement>('role-edit-description').value = selectedRole.description || ''
      roleState.reset()
      updateControls()
      byId('role-edit-name').focus()
    })
    byId('role-cancel').addEventListener('click', () => {
      if (busy()) return
      editing = null
      hide('role-error', true)
      updateControls()
      byId('edit-role').focus()
    })
    roleForm.addEventListener('submit', async event => {
      event.preventDefault()
      if (!selectedRole || editing !== 'role' || busy() || !roleForm.reportValidity() || roleForm.dataset.dirty !== 'true') return
      roleState.setBusy(true)
      updateControls()
      hide('role-error', true)
      try {
        const payload = { name: byId<HTMLInputElement>('role-edit-name').value, description: byId<HTMLInputElement>('role-edit-description').value || null }
        const saved = await api.patch<Role>(`/admin/roles/${selectedRole.id}`, payload)
        Object.assign(selectedRole, saved)
        roleSelect.selectedOptions[0].textContent = selectedRole.name
        editing = null
        roleState.reset()
        renderRole()
        byId('edit-role').focus()
      } catch (error) {
        if (!isAbortError(error)) showError('role-error', error)
      } finally {
        roleState.setBusy(false)
        updateControls()
      }
    })
    byId('edit-permissions').addEventListener('click', () => {
      if (selectedPermissions === null || busy()) return
      editing = 'permissions'
      renderPermissions()
      updateControls()
      permissionForm.querySelector<HTMLInputElement>('input')?.focus()
    })
    byId('permissions-cancel').addEventListener('click', () => {
      if (busy()) return
      editing = null
      hide('permissions-error', true)
      renderPermissions()
      updateControls()
      byId('edit-permissions').focus()
    })
    permissionForm.addEventListener('submit', async event => {
      event.preventDefault()
      if (!selectedRole || editing !== 'permissions' || busy() || permissionForm.dataset.dirty !== 'true') return
      permissionState.setBusy(true)
      updateControls()
      hide('permissions-error', true)
      const selected = [...permissionForm.querySelectorAll<HTMLInputElement>('.perm-checkbox:checked')].map(input => input.value)
      try {
        const result = await api.put<{ permissions?: string[] }>(`/admin/roles/${selectedRole.id}/permissions`, selected)
        selectedPermissions = result.permissions || selected
        editing = null
        renderPermissions()
      } catch (error) {
        if (!isAbortError(error)) showError('permissions-error', error)
      } finally {
        permissionState.setBusy(false)
        updateControls()
      }
    })
    byId('role-delete').addEventListener('click', async () => {
      const role = selectedRole
      if (!role || role.is_system || busy() || editing) return
      if (!(await fm.__fmConfirm(t('admin.confirmDeleteRole')))) return
      deleting = true
      updateControls()
      try {
        await api.delete(`/admin/roles/${role.id}`)
        await loadData()
      } catch (error) {
        if (!isAbortError(error)) showError('role-error', error)
      } finally { deleting = false; updateControls() }
    })
    byId('btn-new-role').addEventListener('click', () => {
      if (busy() || editing) return
      createForm.reset()
      hide('role-modal-error', true)
      createState.reset()
      createDialog.open()
    })
    byId<HTMLInputElement>('role-key').addEventListener('input', event => {
      const input = event.currentTarget as HTMLInputElement
      const position = input.selectionStart
      input.value = input.value.toLowerCase().replace(/[^a-z0-9_]/g, '')
      input.setSelectionRange(position, position)
    })
    createForm.addEventListener('submit', async event => {
      event.preventDefault()
      if (busy() || !createForm.reportValidity() || createForm.dataset.dirty !== 'true') return
      createState.setBusy(true)
      updateControls()
      hide('role-modal-error', true)
      try {
        const role = await api.post<Role>('/admin/roles', { key: byId<HTMLInputElement>('role-key').value, name: byId<HTMLInputElement>('role-name-input').value, description: byId<HTMLInputElement>('role-description').value || null })
        createState.setBusy(false)
        createDialog.close()
        await loadData(role.id)
      } catch (error) {
        if (!isAbortError(error)) showError('role-modal-error', error)
      } finally { createState.setBusy(false); updateControls() }
    })
    loadData()
  </script>
</Layout>
