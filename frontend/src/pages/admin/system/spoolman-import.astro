---
import Layout from '../../../layouts/Layout.astro'
import AdminHeader from '../../../components/AdminHeader.astro'
import FormSection from '../../../components/FormSection.astro'
import '../../../styles/spoolman-import.css'
---

<Layout title="FilaMan - Spoolman Import">
  <div class="fm-admin-page">
  <a href="/admin/system" class="fm-admin-back">&larr; <span data-i18n="admin.backToSystem">Back to System</span></a>
  <AdminHeader titleKey="spoolman.title" title="Spoolman Import" back={false} />
  <p class="fm-admin-message" style="color: var(--text-muted);" data-i18n="spoolman.subtitle">Import filaments, spools, manufacturers, and locations from a Spoolman instance.</p>

  <div class="fm-admin-stack">
  <div id="step-connection">
    <FormSection titleKey="spoolman.stepConnection" title="Connection">
      <Fragment slot="actions"><span style="color: var(--text-muted); font-size: 0.85rem;" aria-hidden="true">1</span></Fragment>
    <div class="fm-settings-row">
      <label class="fm-label" for="spoolman-url" data-i18n="spoolman.spoolmanUrl">Spoolman URL</label>
      <div class="fm-list-controls">
        <input type="url" id="spoolman-url" class="fm-input" placeholder="http://192.168.1.100:7912" style="flex: 1 1 16rem; min-width: 0;" />
        <button id="btn-test" class="fm-btn fm-btn-primary" data-i18n="spoolman.testConnection">Test Connection</button>
      </div>
    </div>
    <div id="connection-result" style="margin-top: 12px; display: none;"></div>
    </FormSection>
  </div>

  <div id="step-preview" style="opacity: 0.5; pointer-events: none;">
    <FormSection titleKey="spoolman.stepPreview" title="Preview">
      <Fragment slot="actions"><span style="color: var(--text-muted); font-size: 0.85rem;" aria-hidden="true">2</span></Fragment>
    <p class="fm-field-hint" data-i18n="spoolman.previewDesc">Review the data that will be imported from Spoolman.</p>
    <button style="justify-self: start;" id="btn-preview" class="fm-btn fm-btn-outline" data-i18n="spoolman.loadPreview">Load Preview</button>
    <div id="preview-result" style="display: none;"></div>
    </FormSection>
  </div>

  <div id="step-import" style="opacity: 0.5; pointer-events: none;">
    <FormSection titleKey="spoolman.stepImport" title="Import">
      <Fragment slot="actions"><span style="color: var(--text-muted); font-size: 0.85rem;" aria-hidden="true">3</span></Fragment>
    <div id="import-controls">
      <p class="fm-field-hint" data-i18n="spoolman.importDesc">Start the import. Existing data will not be overwritten.</p>
      <div class="fm-settings-row" style="margin: 14px 0;">
        <label class="fm-label" for="extra-field-mode" data-i18n="spoolman.extraFieldMode">Spoolman extra fields</label>
        <div class="fm-compact-form">
        <select id="extra-field-mode" class="fm-select" style="width:100%;">
          <option value="system" selected data-i18n="spoolman.extraFieldModeSystem">Create or reuse System Extra Fields</option>
          <option value="local" data-i18n="spoolman.extraFieldModeLocal">Create filament- or spool-specific typed fields</option>
          <option value="preserve" data-i18n="spoolman.extraFieldModePreserve">Preserve source values unchanged under spoolman_extra</option>
          <option value="legacy" data-i18n="spoolman.extraFieldModeLegacy">Legacy import: keep values under spoolman_extra</option>
        </select>
        <p class="fm-field-hint" data-i18n="spoolman.extraFieldModeHint">Choose a default here, then optionally override individual fields in the preview.</p>
        </div>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 10px;">
        <button id="btn-import" class="fm-btn fm-btn-primary" data-i18n="spoolman.startImport">Start Import</button>
        <button id="btn-repair-transparency" class="fm-btn fm-btn-outline hidden">Fix transparency hex</button>
      </div>
      <div id="transparency-repair-note" class="hidden" style="margin-top: 12px; padding: 12px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--accent-2);">
        <strong id="transparency-repair-count" style="color: var(--accent);"></strong>
        <p style="margin: 4px 0 0; color: var(--text-muted); font-size: 0.85rem;" data-i18n="spoolman.repairTransparencyDesc">Repairs only existing filament color assignments linked by spoolman_id to the connected Spoolman data. No manufacturers, locations, filaments, spools, or unrelated fields are imported.</p>
      </div>
    </div>
    <div id="import-progress" style="display: none;">
      <div style="background: var(--bg-soft); border-radius: 999px; overflow: hidden; height: 8px;"><div id="import-bar" style="background: var(--accent); height: 100%; width: 0%; transition: width 0.5s;"></div></div>
      <p id="import-status" style="font-size: 0.85rem; color: var(--text-muted); margin-top: 6px; text-align: center;" data-i18n="spoolman.importing">Importing...</p>
    </div>
    <div id="import-result" style="display: none;"></div>
    </FormSection>
  </div>

  <div id="repair-imports">
    <FormSection titleKey="spoolman.repairTitle" title="Repair previous Spoolman imports">
    <p class="fm-field-hint" data-i18n="spoolman.repairDesc">Convert extra values from earlier imports into native typed fields. Existing values are never overwritten.</p>
    <div style="display:flex;gap:18px;flex-wrap:wrap;">
      <label style="display:flex;align-items:center;gap:7px;cursor:pointer;"><input type="radio" name="repair-mode" value="server" /><span data-i18n="spoolman.repairServerMode">Use running Spoolman server</span></label>
      <label style="display:flex;align-items:center;gap:7px;cursor:pointer;"><input type="radio" name="repair-mode" value="offline" checked /><span data-i18n="spoolman.repairOfflineMode">Recover from stored imported data</span></label>
    </div>
    <p id="repair-mode-hint" class="fm-field-hint" data-i18n="spoolman.repairOfflineHint">No source server is required. Suggested mappings must be reviewed and approved individually.</p>
    <button style="justify-self: start;" id="btn-repair-preview" class="fm-btn fm-btn-outline" data-i18n="spoolman.repairPreview">Scan existing imports</button>
    <div id="repair-preview-result" style="display:none;"></div>
    <div id="repair-actions" style="display:none;"><button id="btn-repair-execute" class="fm-btn fm-btn-primary" data-i18n="spoolman.repairApply">Apply approved repairs</button></div>
    <div id="repair-result" style="display:none;"></div>
    </FormSection>
  </div>

  </div>
  </div>

  <script>
    import { getAbortSignal } from '../../../lib/abort'
    import { initI18n, t } from '../../../lib/i18n'
    import { createSpoolmanApi } from '../../../lib/spoolman-api'
    import type { SpoolmanControllerDeps } from '../../../lib/spoolman-controller-types'
    import { initSpoolmanImportController } from '../../../lib/spoolman-import-controller'
    import { initSpoolmanRepairController } from '../../../lib/spoolman-repair-controller'

    await initI18n()

    const csrfToken = () => {
      const encoded = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)?.[1]
      return encoded ? decodeURIComponent(encoded) : ''
    }
    const modalWindow = window as unknown as {
      __fmConfirm: SpoolmanControllerDeps['confirm']
      __fmAlert: SpoolmanControllerDeps['alert']
    }
    const deps: SpoolmanControllerDeps = {
      api: createSpoolmanApi({ csrfToken }),
      t,
      signal: getAbortSignal,
      confirm: (message, options) => modalWindow.__fmConfirm(message, options),
      alert: message => modalWindow.__fmAlert(message),
    }

    initSpoolmanImportController(deps)
    initSpoolmanRepairController(deps)
  </script>
</Layout>
