---
import Layout from '../../../layouts/Layout.astro'
import AdminHeader from '../../../components/AdminHeader.astro'
import FormSection from '../../../components/FormSection.astro'
---

<Layout panel="filamentdb-import" title="FilaMan - FilamentDB Import">
  <div class="fm-admin-page">
  <a href="/admin/system" class="fm-admin-back">&larr; <span data-i18n="admin.backToSystem">Back to System</span></a>
  <AdminHeader titleKey="filamentdb.title" title="FilamentDB Import" back={false} />
  <p class="fm-admin-message" style="color: var(--text-muted);" data-i18n="filamentdb.subtitle">Import manufacturers, filaments and spool details from the FilamentDB community database.</p>
  <p class="fm-field-hint fm-db-hint"><span data-i18n="filamentdb.contributeHint">The data comes from the community database. Anyone can submit and correct filaments there:</span> <a href="https://db.filaman.app" target="_blank" rel="noopener noreferrer">db.filaman.app</a></p>

  <div class="fm-admin-stack">
  <!-- Abgleich aller verknuepften Filamente -->
  <div id="step-sync-linked">
    <FormSection titleKey="filamentdb.syncLinkedTitle" title="Sync local filaments">
    <p class="fm-field-hint" data-i18n="filamentdb.syncLinkedDesc">Checks all local filaments linked to the FilamentDB for updates. No new filaments or manufacturers are created.</p>
    <button style="justify-self: start;" id="btn-sync-linked" class="fm-btn fm-btn-outline" data-i18n="filamentdb.syncLinkedCheck">Check for updates</button>
    <div id="sync-linked-result" style="display: none;"></div>
    <div id="unlinked-area" style="display: none;"></div>
    </FormSection>
  </div>

  <!-- Step 1: Preview & Manufacturer Selection -->
  <div id="step-manufacturers">
    <FormSection titleKey="filamentdb.stepManufacturers" title="Manufacturers">
      <Fragment slot="actions"><span style="color: var(--text-muted); font-size: 0.85rem;" aria-hidden="true">1</span></Fragment>
    <p class="fm-field-hint" data-i18n="filamentdb.previewDesc">Load the data from FilamentDB and select which manufacturers to import.</p>
    <button style="justify-self: start;" id="btn-preview" class="fm-btn fm-btn-outline" data-i18n="filamentdb.loadPreview">Load Preview</button>
    <div id="preview-result" style="display: none;"></div>
    </FormSection>
  </div>

  <!-- Step 2: Filament Selection -->
  <div id="step-filaments" style="opacity: 0.5; pointer-events: none;">
    <FormSection titleKey="filamentdb.stepFilaments" title="Filaments">
      <Fragment slot="actions"><span style="color: var(--text-muted); font-size: 0.85rem;" aria-hidden="true">2</span></Fragment>
    <p class="fm-field-hint" data-i18n="filamentdb.selectFilamentsDesc">Fine-tune your selection — deselect individual filaments you don't need.</p>
    <div id="filament-list" style="display: none;"></div>
    <div id="no-mfr-hint" style="color: var(--text-muted); font-size: 0.9rem; font-style: italic;" data-i18n="filamentdb.noManufacturersSelected">Select at least one manufacturer in step 1.</div>
    </FormSection>
  </div>

  <!-- Step 3: Settings & Import -->
  <div id="step-import" style="opacity: 0.5; pointer-events: none;">
    <FormSection titleKey="filamentdb.stepImport" title="Settings &amp; Import">
      <Fragment slot="actions"><span style="color: var(--text-muted); font-size: 0.85rem;" aria-hidden="true">3</span></Fragment>

    <!-- Spool Detail Target -->
    <div class="fm-compact-form">
      <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0 0 6px;" data-i18n="filamentdb.spoolDetailTarget">Spool Detail Target</h3>
      <p style="color: var(--text-muted); margin-bottom: 12px; font-size: 0.85rem;" data-i18n="filamentdb.spoolDetailDesc">Choose where to apply spool profile data (empty weight, diameter, width, material).</p>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label style="display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-soft);">
          <input type="radio" name="spool-detail-target" value="filament" checked style="margin-top: 3px;" />
          <div>
            <div style="font-weight: 600; font-size: 0.9rem;" data-i18n="filamentdb.targetFilament">Filament only</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);" data-i18n="filamentdb.targetFilamentDesc">Apply spool profile data to each filament individually</div>
          </div>
        </label>
        <label style="display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-soft);">
          <input type="radio" name="spool-detail-target" value="manufacturer" style="margin-top: 3px;" />
          <div>
            <div style="font-weight: 600; font-size: 0.9rem;" data-i18n="filamentdb.targetManufacturer">Manufacturer only</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);" data-i18n="filamentdb.targetManufacturerDesc">Apply the most common spool profile per manufacturer</div>
          </div>
        </label>
        <label style="display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-soft);">
          <input type="radio" name="spool-detail-target" value="both" style="margin-top: 3px;" />
          <div>
            <div style="font-weight: 600; font-size: 0.9rem;" data-i18n="filamentdb.targetBoth">Both</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);" data-i18n="filamentdb.targetBothDesc">Apply to both filament and manufacturer level</div>
          </div>
        </label>
      </div>
    </div>

    <!-- Summary -->
    <div id="import-summary" style="padding: 12px 16px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--border);">
      <strong data-i18n="filamentdb.importSummary">Import Summary</strong>
      <div id="summary-text" style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px;"></div>
    </div>

    <p class="fm-field-hint" data-i18n="filamentdb.importDesc">Start the import. Existing data will not be overwritten.</p>

    <!-- Diff-Bereich fuer existierende Filamente -->
    <div id="diff-section" style="display: none;">
      <div id="diff-loading" style="padding: 16px; text-align: center; color: var(--text-muted); display: none;">
        <div style="margin-bottom: 8px;" data-i18n="filamentdb.loadingDiff">Checking for changes...</div>
        <div style="width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto;"></div>
      </div>
      <div id="diff-content"></div>
    </div>

    <button style="justify-self: start;" id="btn-import" class="fm-btn fm-btn-primary" data-i18n="filamentdb.checkImport">Check</button>
    <div id="import-progress" style="display: none;">
      <div style="background: var(--bg-soft); border-radius: 999px; overflow: hidden; height: 8px;">
        <div id="import-bar" style="background: var(--accent); height: 100%; width: 0%; transition: width 0.5s;"></div>
      </div>
      <p id="import-status" style="font-size: 0.85rem; color: var(--text-muted); margin-top: 6px; text-align: center;" data-i18n="filamentdb.importing">Importing...</p>
    </div>
    <div id="import-result" style="display: none;"></div>
    </FormSection>
  </div>

  </div>
  </div>

  <script>
    import { t, initI18n } from '../../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../../lib/abort'
    import { checkFilamentDbActive, FILAMENTDB_SITE_URL } from '../../../lib/filamentdb-lookup'
    import { toColorSwatchBackground } from '../../../lib/colors'
    import { mountPanel } from '../../../lib/panel-navigation'

    mountPanel('filamentdb-import', async (panelSignal) => {
    await initI18n()

    // Check if plugin is active — redirect to system page if disabled
    const pluginActive = await checkFilamentDbActive()
    if (panelSignal.aborted) return
    if (!pluginActive) {
      window.location.href = '/admin/system'
      return
    }

    interface CatalogManufacturer {
      id: number
      name?: string
      _exists?: boolean
      _material_types?: string[]
      _filament_count?: number
    }

    interface CatalogFilament {
      id: number
      manufacturer_id?: number | null
      manufacturer?: { id: number } | null
      designation?: string
      name?: string
      _exists?: boolean
      _material_key?: string
      _match_type?: 'exact' | 'fuzzy'
      _matched_name?: string
      _match_score?: number
      spool_profile?: unknown
      colors?: { hex_code?: string }[]
      hex_color?: string
    }

    interface ImportPreview {
      snapshot_id?: string | null
      summary: Record<'manufacturers' | 'filaments' | 'materials' | 'colors', number>
      manufacturers: CatalogManufacturer[]
      materials?: { key?: string; name?: string }[]
    }

    interface FilamentDiff {
      fdb_id: number
      designation: string
      manufacturer_name: string
      identical: boolean
      changes: { field: string; old: unknown; new: unknown }[]
    }

    interface LinkedChange { field: string; old: unknown; new: unknown }
    interface LinkedFilament { fdb_id: number; local_id: number; designation: string; changes: LinkedChange[] }
    interface LinkedManufacturer {
      fdb_manufacturer_id: number
      local_id?: number | null
      name: string
      changes: LinkedChange[]
      filaments: LinkedFilament[]
    }
    interface LinkedDiff {
      snapshot_id?: string | null
      linked_count: number
      unlinked_count: number
      identical_count: number
      missing_in_db: { fdb_id: number; designation: string; manufacturer_name: string }[]
      manufacturers: LinkedManufacturer[]
      warnings?: string[]
    }

    interface ImportResult {
      manufacturers_created: number
      manufacturers_skipped: number
      colors_created: number
      colors_skipped: number
      filaments_created: number
      filaments_skipped: number
      filaments_updated: number
      manufacturers_updated?: number
      logos_downloaded: number
      logos_failed: number
      errors?: string[] | null
      warnings?: string[] | null
    }

    // ---- State ----
    let previewData: ImportPreview | null = null
    /** Filament data loaded on-demand for selected manufacturers */
    let filamentData: { snapshot_id?: string | null; filaments: CatalogFilament[] } | null = null
    /** Set of selected FDB manufacturer IDs */
    const selectedMfrIds = new Set<number>()
    /** Set of selected FDB filament IDs */
    const selectedFilIds = new Set<number>()
    /** Set of FDB filament IDs where user rejected the fuzzy match */
    const rejectedFuzzyIds = new Set<number>()
    /** Active material filter (empty = all) */
    const activeMaterials = new Set<string>()
    /** Manufacturer search term */
    let mfrSearchTerm = ''
    /** Debounce timer for filament loading */
    let filamentDebounceTimer: ReturnType<typeof setTimeout> | null = null
    /** AbortController for filament fetch */
    let filamentAbortCtrl: AbortController | null = null
    panelSignal.addEventListener('abort', () => {
      clearTimeout(filamentDebounceTimer ?? undefined)
      filamentAbortCtrl?.abort()
    }, { once: true })
    /** Snapshot ID from server cache — reused across all steps to avoid redundant fetches */
    let currentSnapshotId: string | null = null

    // ---- Helpers ----
    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div')
      div.textContent = str
      return div.innerHTML
    }

    // Lesbarer Feldname; fehlt der Key, gibt t() den Key selbst zurueck -> roher Name
    function fieldLabel(field: string): string {
      const key = 'filamentdb.fieldLabels.' + field
      const label = t(key)
      return label === key ? field : label
    }

    function enableStep(id: string) {
      const el = document.getElementById(id)!
      el.style.opacity = '1'
      el.style.pointerEvents = 'auto'
    }

    function disableStep(id: string) {
      const el = document.getElementById(id)!
      el.style.opacity = '0.5'
      el.style.pointerEvents = 'none'
    }

    function getSelectedTarget(): string {
      const checked = document.querySelector('input[name="spool-detail-target"]:checked') as HTMLInputElement | null
      return checked?.value ?? 'filament'
    }

    /** Collect all unique material types from preview data */
    function getAllMaterials(): string[] {
      if (!previewData) return []
      const mats = new Set<string>()
      for (const m of previewData.materials ?? []) {
        const k = (m.key || m.name || '').toUpperCase()
        if (k) mats.add(k)
      }
      return [...mats].sort()
    }

    /** Get FDB manufacturer ID for a filament dict */
    function filMfrId(f: CatalogFilament): number | null {
      return f.manufacturer_id ?? f.manufacturer?.id ?? null
    }

    /** Check if a manufacturer passes the material filter */
    function mfrPassesMaterialFilter(mfr: CatalogManufacturer): boolean {
      if (activeMaterials.size === 0) return true
      const types: string[] = mfr._material_types ?? []
      return types.some(t => activeMaterials.has(t))
    }

    /** Check if a filament passes the material filter */
    function filPassesMaterialFilter(f: CatalogFilament): boolean {
      if (activeMaterials.size === 0) return true
      const k = (f._material_key || '').toUpperCase()
      return activeMaterials.has(k)
    }

    // ================================================================
    //  Step 1: Load Preview + Manufacturer Selection
    // ================================================================

    document.getElementById('btn-preview')?.addEventListener('click', async () => {
      const resultDiv = document.getElementById('preview-result')!
      const btn = document.getElementById('btn-preview') as HTMLButtonElement

      btn.disabled = true
      btn.textContent = t('filamentdb.loadingPreview')
      resultDiv.style.display = 'none'

      try {
        const response = await fetch('/api/v1/admin/system/filamentdb-import/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          signal: getAbortSignal(),
        })

        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('filamentdb.previewFailed'))
        }

        const preview: ImportPreview = await response.json()
        previewData = preview
        currentSnapshotId = preview.snapshot_id ?? null
        resultDiv.style.display = 'block'

        // Default: kein Hersteller ausgewählt
        selectedMfrIds.clear()

        renderStep1()
        updateSummary()
        // Step 2 + 3 bleiben disabled bis Filamente geladen
        disableStep('step-filaments')
        disableStep('step-import')

      } catch (err) {
        if (isAbortError(err)) return
        resultDiv.style.display = 'block'
        resultDiv.innerHTML = `<div style="padding: 10px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--error-text); color: var(--error-text);">${escapeHtml(err instanceof Error ? err.message : String(err))}</div>`
        disableStep('step-filaments')
        disableStep('step-import')
      } finally {
        btn.disabled = false
        btn.textContent = t('filamentdb.loadPreview')
      }
    })

    function renderStep1() {
      const resultDiv = document.getElementById('preview-result')!
      if (!previewData) return
      const s = previewData.summary
      const materials = getAllMaterials()

      // Summary table
      let html = `
        <div class="fm-card" style="padding: 0; margin-bottom: 16px;">
          <table class="fm-table">
            <thead style="background: var(--bg-soft);">
              <tr>
                <th>${escapeHtml(t('filamentdb.dataType'))}</th>
                <th style="text-align: right;">${escapeHtml(t('filamentdb.count'))}</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>${escapeHtml(t('filamentdb.previewManufacturers'))}</td><td style="text-align: right; font-weight: 600;">${s.manufacturers}</td></tr>
              <tr><td>${escapeHtml(t('filamentdb.previewFilaments'))}</td><td style="text-align: right; font-weight: 600;">${s.filaments}</td></tr>
              <tr><td>${escapeHtml(t('filamentdb.previewMaterials'))}</td><td style="text-align: right; font-weight: 600;">${s.materials}</td></tr>
              <tr><td>${escapeHtml(t('filamentdb.previewColors'))}</td><td style="text-align: right; font-weight: 600;">${s.colors}</td></tr>
            </tbody>
          </table>
        </div>
      `

      // Material filter
      if (materials.length > 1) {
        html += `
          <div style="margin-bottom: 16px;">
            <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0 0 6px;">${escapeHtml(t('filamentdb.materialFilter'))}</h3>
            <p style="color: var(--text-muted); margin-bottom: 8px; font-size: 0.85rem;">${escapeHtml(t('filamentdb.materialFilterDesc'))}</p>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;" id="material-filter">
              ${materials.map(m => `
                <label style="display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border: 1px solid var(--border); border-radius: 999px; font-size: 0.8rem; cursor: pointer; background: var(--bg-soft);">
                  <input type="checkbox" value="${escapeHtml(m)}" class="mat-filter-cb" ${activeMaterials.size === 0 || activeMaterials.has(m) ? '' : ''} />
                  ${escapeHtml(m)}
                </label>
              `).join('')}
            </div>
          </div>
        `
      }

      // Manufacturer selection
      html += `
        <div>
          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0 0 6px;">${escapeHtml(t('filamentdb.selectManufacturers'))}</h3>
          <p style="color: var(--text-muted); margin-bottom: 8px; font-size: 0.85rem;">${escapeHtml(t('filamentdb.selectManufacturersDesc'))}</p>
          <div style="margin-bottom: 10px;">
            <input type="search" id="mfr-search" placeholder="${escapeHtml(t('filamentdb.searchManufacturers'))}" value="${escapeHtml(mfrSearchTerm)}" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-soft); color: var(--text); font-size: 0.9rem; outline: none;" />
          </div>
          <div style="display: flex; gap: 8px; margin-bottom: 10px;">
            <button class="fm-btn fm-btn-outline" style="font-size: 0.8rem; padding: 4px 12px;" id="btn-sel-all">${escapeHtml(t('filamentdb.selectAll'))}</button>
            <button class="fm-btn fm-btn-outline" style="font-size: 0.8rem; padding: 4px 12px;" id="btn-sel-new">${escapeHtml(t('filamentdb.selectAllNew'))}</button>
            <button class="fm-btn fm-btn-outline" style="font-size: 0.8rem; padding: 4px 12px;" id="btn-sel-none">${escapeHtml(t('filamentdb.deselectAll'))}</button>
            <span style="font-size: 0.85rem; color: var(--text-muted); align-self: center; margin-left: auto;" id="mfr-count"></span>
          </div>
          <div id="mfr-list" style="border: 1px solid var(--border); border-radius: var(--radius-sm);"></div>
        </div>
      `

      resultDiv.innerHTML = html
      renderMfrList()
      updateMfrCount()

      // Wire events
      resultDiv.querySelectorAll('.mat-filter-cb').forEach(cb => {
        cb.addEventListener('change', onMaterialFilterChange)
      })
      document.getElementById('btn-sel-all')?.addEventListener('click', () => { selectMfrs('all'); })
      document.getElementById('btn-sel-new')?.addEventListener('click', () => { selectMfrs('new'); })
      document.getElementById('btn-sel-none')?.addEventListener('click', () => { selectMfrs('none'); })
      document.getElementById('mfr-search')?.addEventListener('input', (e) => {
        mfrSearchTerm = (e.target as HTMLInputElement).value
        renderMfrList()
      })
    }

    function renderMfrList() {
      const container = document.getElementById('mfr-list')
      if (!container || !previewData) return

      const manufacturers = previewData.manufacturers
      const searchLower = mfrSearchTerm.toLowerCase().trim()
      const sorted = [...manufacturers]
        .filter(m => {
          if (!mfrPassesMaterialFilter(m)) return false
          if (searchLower && !(m.name || '').toLowerCase().includes(searchLower)) return false
          return true
        })
        .sort((a, b) => (a.name || '').localeCompare(b.name || ''))

      let rows = ''
      for (const m of sorted) {
        const id = m.id
        const checked = selectedMfrIds.has(id) ? 'checked' : ''
        const existsBadge = m._exists
          ? `<span style="display: inline-block; font-size: 0.7rem; padding: 1px 7px; border-radius: 999px; background: var(--bg-soft); border: 1px solid var(--border); color: var(--text-muted); margin-left: 8px;">${escapeHtml(t('filamentdb.alreadyExists'))}</span>`
          : ''
        const matTags = (m._material_types || []).slice(0, 5).map((mt: string) =>
          `<span style="display: inline-block; font-size: 0.7rem; padding: 1px 6px; border-radius: 4px; background: var(--accent-bg, rgba(var(--accent-rgb, 100,100,255), 0.1)); color: var(--accent); margin-right: 3px;">${escapeHtml(mt)}</span>`
        ).join('')
        const filCount = t('filamentdb.filamentCount').replace('{count}', String(m._filament_count || 0))

        rows += `
          <label style="display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid var(--border); cursor: pointer;${m._exists ? ' opacity: 0.7;' : ''}">
            <input type="checkbox" class="mfr-cb" data-id="${id}" ${checked} style="flex-shrink: 0;" />
            <div style="flex: 1; min-width: 0;">
              <div style="font-weight: 500; font-size: 0.9rem;">
                ${escapeHtml(m.name || '-')}${existsBadge}
              </div>
              <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 2px;">
                <span>${escapeHtml(filCount)}</span>
                ${matTags}
              </div>
            </div>
          </label>
        `
      }

      container.innerHTML = rows || `<div style="padding: 16px; color: var(--text-muted); text-align: center;">No manufacturers match the filter.</div>`

      // Wire checkbox events
      container.querySelectorAll('.mfr-cb').forEach(cb => {
        cb.addEventListener('change', (e) => {
          const input = e.target as HTMLInputElement
          const id = Number(input.dataset.id)
          if (input.checked) selectedMfrIds.add(id)
          else selectedMfrIds.delete(id)
          updateMfrCount()
          scheduleFilamentLoad()
        })
      })
    }

    function updateMfrCount() {
      const el = document.getElementById('mfr-count')
      if (el) el.textContent = t('filamentdb.selectedCount').replace('{count}', String(selectedMfrIds.size))
    }

    function selectMfrs(mode: 'all' | 'new' | 'none') {
      selectedMfrIds.clear()
      if (mode !== 'none') {
        for (const m of previewData?.manufacturers ?? []) {
          if (!mfrPassesMaterialFilter(m)) continue
          if (mfrSearchTerm) {
            const searchLower = mfrSearchTerm.toLowerCase().trim()
            if (!(m.name || '').toLowerCase().includes(searchLower)) continue
          }
          if (mode === 'all' || (mode === 'new' && !m._exists)) {
            if (m.id) selectedMfrIds.add(m.id)
          }
        }
      }
      renderMfrList()
      updateMfrCount()
      scheduleFilamentLoad()
    }

    function onMaterialFilterChange() {
      activeMaterials.clear()
      document.querySelectorAll('.mat-filter-cb:checked').forEach(cb => {
        activeMaterials.add((cb as HTMLInputElement).value)
      })
      renderMfrList()
      updateMfrCount()
      // Filamente neu laden wenn welche selektiert sind
      if (selectedMfrIds.size > 0) scheduleFilamentLoad()
    }

    // ================================================================
    //  Step 2: Filament Loading (on-demand with debounce)
    // ================================================================

    function scheduleFilamentLoad() {
      // Debounce: warte 500ms nach der letzten Hersteller-Aenderung
      if (filamentDebounceTimer) clearTimeout(filamentDebounceTimer)
      filamentDebounceTimer = setTimeout(() => loadFilamentsForSelected(), 500)
    }

    async function loadFilamentsForSelected() {
      const container = document.getElementById('filament-list')!
      const hint = document.getElementById('no-mfr-hint')!

      if (selectedMfrIds.size === 0) {
        filamentData = null
        selectedFilIds.clear()
        rejectedFuzzyIds.clear()
        container.style.display = 'none'
        hint.style.display = 'block'
        disableStep('step-filaments')
        disableStep('step-import')
        updateSummary()
        return
      }

      // Vorherigen Request abbrechen
      if (filamentAbortCtrl) filamentAbortCtrl.abort()
      filamentAbortCtrl = new AbortController()

      // Loading-State anzeigen
      enableStep('step-filaments')
      container.style.display = 'block'
      hint.style.display = 'none'
      container.innerHTML = `<div style="padding: 24px; text-align: center; color: var(--text-muted);"><div style="margin-bottom: 8px;">${escapeHtml(t('filamentdb.loadingFilaments'))}</div><div style="width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto;"></div></div>`

      try {
        const response = await fetch('/api/v1/admin/system/filamentdb-import/filaments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ manufacturer_ids: [...selectedMfrIds], snapshot_id: currentSnapshotId }),
          signal: filamentAbortCtrl.signal,
        })

        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('filamentdb.previewFailed'))
        }

        const catalog: NonNullable<typeof filamentData> = await response.json()
        filamentData = catalog
        currentSnapshotId = catalog.snapshot_id ?? currentSnapshotId

        selectedFilIds.clear()
        rejectedFuzzyIds.clear()

        renderFilamentList()
        updateSummary()
        resetImportButton()
        enableStep('step-import')

      } catch (err) {
        if (isAbortError(err)) return
        container.innerHTML = `<div style="padding: 12px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--error-text); color: var(--error-text);">${escapeHtml(err instanceof Error ? err.message : String(err))}</div>`
        disableStep('step-import')
      }
    }

    function renderFilamentList() {
      const container = document.getElementById('filament-list')!
      if (!filamentData || !previewData) return

      const filaments = filamentData.filaments
      // Group by manufacturer
      const mfrMap = new Map<number, CatalogManufacturer>()
      for (const m of previewData.manufacturers) {
        if (m.id && selectedMfrIds.has(m.id)) mfrMap.set(m.id, m)
      }

      // Group filaments
      const grouped = new Map<number, CatalogFilament[]>()
      for (const f of filaments) {
        const mId = filMfrId(f)
        if (!mId || !selectedMfrIds.has(mId)) continue
        if (!filPassesMaterialFilter(f)) continue
        if (!grouped.has(mId)) grouped.set(mId, [])
        grouped.get(mId)!.push(f)
      }

      // Sort manufacturers by name
      const sortedMfrIds = [...grouped.keys()].sort((a, b) => {
        const na = mfrMap.get(a)?.name || ''
        const nb = mfrMap.get(b)?.name || ''
        return na.localeCompare(nb)
      })

      let html = ''

      // Hinweis zu Fuzzy-Matches anzeigen wenn welche vorhanden
      const hasFuzzyMatches = filaments.some(f => f._match_type === 'fuzzy' && !rejectedFuzzyIds.has(f.id))
      if (hasFuzzyMatches) {
        html += `<div style="padding: 10px 14px; margin-bottom: 12px; border-radius: var(--radius-sm); background: rgba(var(--warning-rgb, 200,150,0), 0.08); border: 1px solid rgba(var(--warning-rgb, 200,150,0), 0.25); font-size: 0.85rem; color: var(--text);">
          ${escapeHtml(t('filamentdb.fuzzyHintBox'))}
        </div>`
      }

      for (const mfrId of sortedMfrIds) {
        const mfr = mfrMap.get(mfrId)
        const fils = grouped.get(mfrId) || []
        if (fils.length === 0) continue

        const selectedInGroup = fils.filter(f => selectedFilIds.has(f.id)).length

        html += `
          <div style="margin-bottom: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm);">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: var(--bg-soft); border-bottom: 1px solid var(--border);">
              <strong style="font-size: 0.9rem;">${escapeHtml(mfr?.name || '?')}</strong>
              <div style="display: flex; gap: 6px; align-items: center;">
                <span style="font-size: 0.8rem; color: var(--text-muted);">${selectedInGroup}/${fils.length}</span>
                <button class="fm-btn fm-btn-outline fil-sel-all" data-mfr="${mfrId}" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.selectAll'))}</button>
                <button class="fm-btn fm-btn-outline fil-sel-none" data-mfr="${mfrId}" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.deselectAll'))}</button>
              </div>
            </div>
            <div>
        `

        for (const f of fils) {
          const checked = selectedFilIds.has(f.id) ? 'checked' : ''
          const isRejectedFuzzy = rejectedFuzzyIds.has(f.id)
          const effectiveExists = f._exists && !isRejectedFuzzy
          const isFuzzyMatch = f._match_type === 'fuzzy' && !isRejectedFuzzy
          let existsBadge = ''
          if (effectiveExists && isFuzzyMatch) {
            existsBadge = `<span style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; padding: 1px 7px; border-radius: 999px; background: rgba(var(--warning-rgb, 200,150,0), 0.1); border: 1px solid rgba(var(--warning-rgb, 200,150,0), 0.3); color: var(--warning, #c89600); margin-left: 8px;" title="${escapeHtml(t('filamentdb.fuzzyMatchHint').replace('{name}', f._matched_name || ''))}">${escapeHtml(t('filamentdb.fuzzyMatch'))}: ${escapeHtml(f._matched_name || '?')} <span style="opacity:0.7">(${Math.round((f._match_score || 0) * 100)}%)</span><button class="fuzzy-reject-btn" data-id="${f.id}" style="background: none; border: none; cursor: pointer; font-size: 0.85rem; padding: 0 2px; line-height: 1; color: var(--text-muted);" title="${escapeHtml(t('filamentdb.fuzzyReject'))}">✕</button></span>`
          } else if (effectiveExists) {
            existsBadge = `<span style="display: inline-block; font-size: 0.7rem; padding: 1px 7px; border-radius: 999px; background: var(--bg-soft); border: 1px solid var(--border); color: var(--text-muted); margin-left: 8px;">${escapeHtml(t('filamentdb.alreadyExists'))}</span>`
          }
          const noSpoolBadge = !f.spool_profile
            ? `<span style="display: inline-block; font-size: 0.7rem; padding: 1px 7px; border-radius: 999px; background: var(--bg-soft); border: 1px solid var(--border); color: var(--text-muted); margin-left: 4px;">${escapeHtml(t('filamentdb.noSpoolData'))}</span>`
            : ''
          const matKey = f._material_key || ''
          const designation = f.designation || f.name || '-'
          const colorSwatches = renderColorSwatches(f)

          html += `
            <label style="display: flex; align-items: center; gap: 10px; padding: 6px 12px; border-bottom: 1px solid var(--border); cursor: pointer;${effectiveExists ? ' opacity: 0.7;' : ''}">
              <input type="checkbox" class="fil-cb" data-id="${f.id}" data-mfr="${mfrId}" ${checked} style="flex-shrink: 0;" />
              <div style="flex: 1; min-width: 0;">
                <div style="font-size: 0.85rem;">
                   ${escapeHtml(designation)}${existsBadge}${noSpoolBadge}
                </div>
                <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; gap: 8px; align-items: center; margin-top: 1px;">
                  <span style="font-size: 0.7rem; padding: 1px 6px; border-radius: 4px; background: var(--accent-bg, rgba(var(--accent-rgb, 100,100,255), 0.1)); color: var(--accent);">${escapeHtml(matKey)}</span>
                  ${colorSwatches}
                </div>
              </div>
            </label>
          `
        }

        html += `</div></div>`
      }

      container.innerHTML = html || `<div style="padding: 16px; color: var(--text-muted); text-align: center;">No filaments for selected manufacturers.</div>`

      // Wire events
      container.querySelectorAll('.fil-cb').forEach(cb => {
        cb.addEventListener('change', (e) => {
          const input = e.target as HTMLInputElement
          const id = Number(input.dataset.id)
          if (input.checked) selectedFilIds.add(id)
          else selectedFilIds.delete(id)
          updateSummary()
          resetImportButton()
        })
      })

      // Fuzzy-Reject buttons
      container.querySelectorAll('.fuzzy-reject-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault()
          e.stopPropagation()
          const id = Number((e.currentTarget as HTMLElement).dataset.id)
          rejectedFuzzyIds.add(id)
          renderFilamentList()
          updateSummary()
          resetImportButton()
        })
      })

      container.querySelectorAll('.fil-sel-all').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault()
          const mfrId = Number((e.currentTarget as HTMLElement).dataset.mfr)
          for (const f of filaments) {
            if (filMfrId(f) === mfrId && filPassesMaterialFilter(f) && f.id) selectedFilIds.add(f.id)
          }
          renderFilamentList()
          updateSummary()
          resetImportButton()
        })
      })

      container.querySelectorAll('.fil-sel-none').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault()
          const mfrId = Number((e.currentTarget as HTMLElement).dataset.mfr)
          for (const f of filaments) {
            if (filMfrId(f) === mfrId && f.id) selectedFilIds.delete(f.id)
          }
          renderFilamentList()
          updateSummary()
          resetImportButton()
        })
      })
    }

    function renderColorSwatches(f: CatalogFilament): string {
      const cols: { hex: string }[] = []
      const filColors = f.colors || []
      if (filColors.length) {
        for (const c of filColors.slice(0, 5)) {
          if (c.hex_code) cols.push({ hex: c.hex_code })
        }
      } else if (f.hex_color) {
        cols.push({ hex: f.hex_color })
      }
      if (cols.length === 0) return ''
      return cols.map(c =>
        `<span style="display: inline-block; width: 14px; height: 14px; border-radius: 3px; background: ${toColorSwatchBackground(c.hex)}; border: 1px solid var(--border);"></span>`
      ).join('')
    }

    // ================================================================
    //  Summary
    // ================================================================

    function updateSummary() {
      const el = document.getElementById('summary-text')
      if (!el) return
      el.textContent = t('filamentdb.importSummaryText')
        .replace('{manufacturers}', String(selectedMfrIds.size))
        .replace('{filaments}', String(selectedFilIds.size))
    }

    // ================================================================
    //  Step 3: Import (with Diff support for existing filaments)
    // ================================================================

    const updateFilIds = new Set<number>()
    /** Tracks whether the pre-import check has been done */
    let importChecked = false

    /** Reset the import button back to "Check" phase */
    function resetImportButton() {
      importChecked = false
      const btn = document.getElementById('btn-import') as HTMLButtonElement | null
      if (btn) {
        btn.textContent = t('filamentdb.checkImport')
        btn.disabled = false
      }
      // Diff-Bereich verstecken
      const diffSection = document.getElementById('diff-section')
      if (diffSection) diffSection.style.display = 'none'
      updateFilIds.clear()
    }

    async function checkForExistingFilaments(): Promise<boolean> {
      if (!filamentData) return false

      // Existierende Filamente in der Auswahl finden
      const existingFdbIds: number[] = []
      for (const f of filamentData.filaments) {
        if (f._exists && f.id && selectedFilIds.has(f.id) && !rejectedFuzzyIds.has(f.id)) {
          existingFdbIds.push(f.id)
        }
      }

      if (existingFdbIds.length === 0) {
        // Kein Diff noetig, Diff-Bereich verstecken
        const section = document.getElementById('diff-section')!
        section.style.display = 'none'
        updateFilIds.clear()
        return true
      }

      // Diff laden
      const section = document.getElementById('diff-section')!
      const loading = document.getElementById('diff-loading')!
      const content = document.getElementById('diff-content')!
      section.style.display = 'block'
      loading.style.display = 'block'
      content.innerHTML = ''

      try {
        const response = await fetch('/api/v1/admin/system/filamentdb-import/diff', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ filament_ids: existingFdbIds, snapshot_id: currentSnapshotId }),
          signal: getAbortSignal(),
        })

        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || 'Diff failed')
        }

        const diffData: { snapshot_id?: string | null; results?: (FilamentDiff | { not_found: true })[] } = await response.json()
        currentSnapshotId = diffData.snapshot_id ?? currentSnapshotId
        loading.style.display = 'none'

        if (!diffData.results || diffData.results.length === 0) {
          content.innerHTML = `<div style="padding: 12px; color: var(--text-muted); font-size: 0.9rem;">${escapeHtml(t('filamentdb.noChanges'))}</div>`
          return true
        }

        renderDiffSection(diffData.results, content)
        return true

      } catch (err) {
        if (isAbortError(err)) return false
        loading.style.display = 'none'
        content.innerHTML = `<div style="padding: 12px; color: var(--error-text); font-size: 0.9rem;">${escapeHtml(err instanceof Error ? err.message : String(err))}</div>`
        return true
      }
    }

    function renderDiffSection(results: (FilamentDiff | { not_found: true })[], container: HTMLElement) {
      updateFilIds.clear()

      const found = results.filter((r): r is FilamentDiff => !('not_found' in r))
      const withChanges = found.filter(r => !r.identical)
      const identical = found.filter(r => r.identical)

      let html = `
        <div style="border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden;">
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: var(--bg-soft); border-bottom: 1px solid var(--border);">
            <strong style="font-size: 0.95rem;">${escapeHtml(t('filamentdb.updateExisting'))}
              <span style="font-size: 0.8rem; font-weight: 400; color: var(--text-muted); margin-left: 6px;">(${withChanges.length} ${escapeHtml(t('filamentdb.differences'))}, ${identical.length} ${escapeHtml(t('filamentdb.identical'))})</span>
            </strong>
            <div style="display: flex; gap: 6px;">
              <button class="fm-btn fm-btn-outline" id="diff-sel-all" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.selectAll'))}</button>
              <button class="fm-btn fm-btn-outline" id="diff-sel-none" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.deselectAll'))}</button>
            </div>
          </div>
          <div>
      `

      // Filamente mit Aenderungen
      for (const r of withChanges) {
        html += renderDiffItem(r, true)
      }

      // Identische Filamente
      if (identical.length > 0) {
        html += `
          <details style="border-top: 1px solid var(--border);">
            <summary style="padding: 8px 14px; cursor: pointer; font-size: 0.85rem; color: var(--text-muted); background: var(--bg-soft);">
              ${identical.length} ${escapeHtml(t('filamentdb.identical'))}
            </summary>
        `
        for (const r of identical) {
          html += renderDiffItem(r, false)
        }
        html += '</details>'
      }

      html += '</div></div>'

      if (withChanges.length === 0) {
        html = `<div style="padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-muted); font-size: 0.9rem;">
          ${escapeHtml(t('filamentdb.noChanges'))} (${identical.length} ${escapeHtml(t('filamentdb.identical'))})
        </div>`
      }

      container.innerHTML = html

      // Events
      container.querySelectorAll('.diff-cb').forEach(cb => {
        cb.addEventListener('change', (e) => {
          const input = e.target as HTMLInputElement
          const id = Number(input.dataset.fdbId)
          if (input.checked) updateFilIds.add(id)
          else updateFilIds.delete(id)
        })
      })

      document.getElementById('diff-sel-all')?.addEventListener('click', () => {
        container.querySelectorAll('.diff-cb').forEach(cb => {
          const input = cb as HTMLInputElement
          input.checked = true
          updateFilIds.add(Number(input.dataset.fdbId))
        })
      })

      document.getElementById('diff-sel-none')?.addEventListener('click', () => {
        container.querySelectorAll('.diff-cb').forEach(cb => {
          (cb as HTMLInputElement).checked = false
        })
        updateFilIds.clear()
      })
    }

    function renderDiffItem(r: FilamentDiff, hasChanges: boolean): string {
      let html = `
        <div style="padding: 8px 14px; border-bottom: 1px solid var(--border);">
          <div style="display: flex; align-items: center; gap: 10px;">
      `

      if (hasChanges) {
        html += `<input type="checkbox" class="diff-cb" data-fdb-id="${r.fdb_id}" style="flex-shrink: 0;" />`
      }

      html += `
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 0.85rem; font-weight: 500;">
                ${escapeHtml(r.designation)}
                <span style="font-size: 0.75rem; color: var(--text-muted); margin-left: 6px;">${escapeHtml(r.manufacturer_name)}</span>
              </div>
            </div>
      `

      if (!hasChanges) {
        html += `<span style="font-size: 0.7rem; padding: 1px 7px; border-radius: 999px; background: var(--bg-soft); border: 1px solid var(--border); color: var(--text-muted);">${escapeHtml(t('filamentdb.identical'))}</span>`
      } else {
        html += `<span style="font-size: 0.7rem; padding: 1px 7px; border-radius: 999px; background: rgba(var(--accent-rgb, 100,100,255), 0.1); border: 1px solid var(--accent); color: var(--accent);">${r.changes.length} ${escapeHtml(t('filamentdb.differences'))}</span>`
      }

      html += '</div>'

      if (hasChanges && r.changes.length > 0) {
        html += `
          <details style="margin-top: 6px; margin-left: 28px;">
            <summary style="cursor: pointer; font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(t('filamentdb.showChanges'))}</summary>
            <table style="width: 100%; font-size: 0.8rem; margin-top: 6px; border-collapse: collapse;">
              <thead>
                <tr style="color: var(--text-muted);">
                  <th style="text-align: left; padding: 3px 8px; font-weight: 500;">${escapeHtml(t('filamentdb.fieldName'))}</th>
                  <th style="text-align: left; padding: 3px 8px; font-weight: 500;">${escapeHtml(t('filamentdb.currentValue'))}</th>
                  <th style="text-align: left; padding: 3px 8px; font-weight: 500;">${escapeHtml(t('filamentdb.newValue'))}</th>
                </tr>
              </thead>
              <tbody>
                ${r.changes.map(c => `
                  <tr style="border-top: 1px solid var(--border);">
                    <td style="padding: 3px 8px; color: var(--text-muted);">${escapeHtml(fieldLabel(c.field))}</td>
                    <td style="padding: 3px 8px; color: var(--error-text);">${c.old != null ? escapeHtml(String(c.old)) : '<em style="opacity: 0.5;">-</em>'}</td>
                    <td style="padding: 3px 8px; color: var(--accent-2, green);">${c.new != null ? escapeHtml(String(c.new)) : '<em style="opacity: 0.5;">-</em>'}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </details>
        `
      }

      html += '</div>'
      return html
    }


    // ---- Abgleich aller verknuepften Filamente ----
    let linkedSnapshotId: string | null = null

    function linkedMsg(text: string, error = false): string {
      return `<div style="padding: 12px; font-size: 0.9rem; color: ${error ? 'var(--error-text)' : 'var(--text-muted)'};">${escapeHtml(text)}</div>`
    }

    function formatLinkedValue(v: unknown): string {
      if (v === null || v === undefined || v === '') return '<em style="opacity: 0.5;">-</em>'
      return escapeHtml(typeof v === 'object' ? (Array.isArray(v) ? v.join(', ') : JSON.stringify(v)) : String(v))
    }

    const IMG_STYLE = 'max-height: 48px; max-width: 96px; vertical-align: middle; border: 1px solid var(--border); border-radius: 4px; background: #fff;'

    function thumb(src: string, label: string): string {
      return `<img src="${escapeHtml(src)}" alt="${escapeHtml(label)}" title="${escapeHtml(label)}" loading="lazy" style="${IMG_STYLE}" onerror="this.replaceWith(document.createTextNode('-'))" />`
    }

    function spoolImageSrc(v: unknown): string {
      if (typeof v !== 'string' || v.length > 500 || v.includes('..') || !/^[A-Za-z0-9][A-Za-z0-9_.-]*$/.test(v)) return ''
      return `/api/v1/filamentdb/spool-profile-image?image_file=${encodeURIComponent(v)}`
    }

    // Bild-Felder als Vorschau; null = normale Textanzeige
    function formatImageValue(c: LinkedChange, side: 'old' | 'new', mfrLocalId?: number | null): string | null {
      const v = side === 'old' ? c.old : c.new
      if (v === null || v === undefined || v === '') return null
      if (c.field === 'filamentdb_spool_image_file') {
        const src = spoolImageSrc(v)
        return src ? thumb(src, String(v)) : null
      }
      if (c.field === 'image_url') {
        return typeof v === 'string' && /^https?:\/\//i.test(v) ? thumb(v, v) : null
      }
      if (c.field === 'logo' || c.field === 'label_logo') {
        if (side === 'new') return escapeHtml(t('filamentdb.newLogoVersion'))
        if (!mfrLocalId) return escapeHtml(String(v))
        return thumb(`/api/v1/manufacturers/${mfrLocalId}/${c.field === 'logo' ? 'logo' : 'label-logo'}`, fieldLabel(c.field))
      }
      return null
    }

    function renderLinkedChange(c: LinkedChange, attrs: string, mfrLocalId?: number | null): string {
      const oldHtml = formatImageValue(c, 'old', mfrLocalId) ?? formatLinkedValue(c.old)
      const newHtml = formatImageValue(c, 'new', mfrLocalId) ?? formatLinkedValue(c.new)
      return `<label style="display: flex; align-items: baseline; gap: 8px; padding: 2px 0; font-size: 0.8rem;">
        <input type="checkbox" class="chg-cb" ${attrs} data-field="${escapeHtml(c.field)}" checked />
        <span style="min-width: 160px; color: var(--text-muted);">${escapeHtml(fieldLabel(c.field))}</span>
        <span style="color: var(--error-text);">${oldHtml}</span>
        <span aria-hidden="true">&rarr;</span>
        <span style="color: var(--accent-2, green);">${newHtml}</span>
      </label>`
    }

    function renderLinkedGroups(groups: LinkedManufacturer[]): string {
      return groups.map(g => {
        const mid = g.fdb_manufacturer_id
        const total = g.changes.length + g.filaments.reduce((n, f) => n + f.changes.length, 0)
        let html = `<details class="linked-group" data-mfr-id="${mid}" style="border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 8px;">
          <summary style="padding: 8px 14px; cursor: pointer; background: var(--bg-soft); display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" class="mfr-cb" data-mfr-id="${mid}" checked />
            <strong style="font-size: 0.9rem;">${escapeHtml(g.name)}</strong>
            <span style="font-size: 0.75rem; color: var(--text-muted);">(${total} ${escapeHtml(t('filamentdb.differences'))})</span>
          </summary><div style="padding: 8px 14px;">`
        if (g.changes.length) {
          html += `<div style="margin-bottom: 8px;"><div style="font-size: 0.85rem; font-weight: 500;">${escapeHtml(t('filamentdb.syncLinkedMfrData'))}</div>`
          html += g.changes.map(c => renderLinkedChange(c, `data-scope="mfr" data-mfr-id="${mid}"`, g.local_id)).join('')
          html += '</div>'
        }
        for (const f of g.filaments) {
          html += `<div class="linked-fil" style="margin-bottom: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 500;">
              <input type="checkbox" class="fil-cb" data-mfr-id="${mid}" data-fdb-id="${f.fdb_id}" checked />
              ${escapeHtml(f.designation)}
            </label><div style="margin-left: 24px;">`
          html += f.changes.map(c => renderLinkedChange(c, `data-scope="fil" data-mfr-id="${mid}" data-fdb-id="${f.fdb_id}"`)).join('')
          html += '</div></div>'
        }
        return html + '</div></details>'
      }).join('')
    }

    function setTri(cb: HTMLInputElement, boxes: HTMLInputElement[]) {
      const on = boxes.filter(b => b.checked).length
      cb.checked = on === boxes.length && boxes.length > 0
      cb.indeterminate = on > 0 && on < boxes.length
    }

    function wireLinkedTree(root: HTMLElement) {
      const changeBoxes = (sel: string) => [...root.querySelectorAll<HTMLInputElement>(sel)]
      const refresh = () => {
        root.querySelectorAll<HTMLInputElement>('.fil-cb').forEach(cb => {
          setTri(cb, changeBoxes(`.chg-cb[data-scope="fil"][data-fdb-id="${cb.dataset.fdbId}"]`))
        })
        root.querySelectorAll<HTMLInputElement>('.mfr-cb').forEach(cb => {
          setTri(cb, changeBoxes(`.chg-cb[data-mfr-id="${cb.dataset.mfrId}"]`))
        })
      }
      root.querySelectorAll<HTMLInputElement>('.chg-cb').forEach(cb => cb.addEventListener('change', refresh))
      root.querySelectorAll<HTMLInputElement>('.fil-cb').forEach(cb => cb.addEventListener('change', () => {
        changeBoxes(`.chg-cb[data-scope="fil"][data-fdb-id="${cb.dataset.fdbId}"]`).forEach(b => { b.checked = cb.checked })
        refresh()
      }))
      root.querySelectorAll<HTMLInputElement>('.mfr-cb').forEach(cb => cb.addEventListener('change', () => {
        changeBoxes(`.chg-cb[data-mfr-id="${cb.dataset.mfrId}"]`).forEach(b => { b.checked = cb.checked })
        refresh()
      }))
      const setAll = (v: boolean) => {
        root.querySelectorAll<HTMLInputElement>('.chg-cb').forEach(b => { b.checked = v })
        refresh()
      }
      document.getElementById('linked-sel-all')?.addEventListener('click', () => setAll(true))
      document.getElementById('linked-sel-none')?.addEventListener('click', () => setAll(false))
      refresh()
    }

    /** Gewaehlte Aenderungen aus dem DOM sammeln (nur Feldnamen, Werte bestimmt der Server). */
    function collectLinkedSelection(root: HTMLElement) {
      const filaments = new Map<number, string[]>()
      const manufacturers = new Map<number, string[]>()
      root.querySelectorAll<HTMLInputElement>('.chg-cb:checked').forEach(cb => {
        const field = cb.dataset.field!
        if (cb.dataset.scope === 'mfr') {
          const id = Number(cb.dataset.mfrId)
          manufacturers.set(id, [...(manufacturers.get(id) ?? []), field])
        } else {
          const id = Number(cb.dataset.fdbId)
          filaments.set(id, [...(filaments.get(id) ?? []), field])
        }
      })
      return {
        filaments: [...filaments].map(([fdb_id, fields]) => ({ fdb_id, fields })),
        manufacturers: [...manufacturers].map(([fdb_manufacturer_id, fields]) => ({ fdb_manufacturer_id, fields })),
      }
    }

    document.getElementById('btn-sync-linked')?.addEventListener('click', async () => {
      const btn = document.getElementById('btn-sync-linked') as HTMLButtonElement
      const out = document.getElementById('sync-linked-result')!
      btn.disabled = true
      out.style.display = 'block'
      out.innerHTML = linkedMsg(t('filamentdb.syncLinkedLoading'))
      try {
        const response = await fetch('/api/v1/admin/system/filamentdb-import/diff-linked', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ snapshot_id: null }),
          signal: getAbortSignal(),
        })
        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('filamentdb.syncLinkedFailed'))
        }
        const data: LinkedDiff = await response.json()
        linkedSnapshotId = data.snapshot_id ?? null
        const changed = data.manufacturers.reduce((n, g) => n + g.filaments.length, 0)

        let html = `<div style="padding: 8px 0; font-size: 0.9rem;">${escapeHtml(
          t('filamentdb.syncLinkedSummary', {
            linked: data.linked_count, changed, identical: data.identical_count, unlinked: data.unlinked_count,
          }),
        )}</div>`
        if (data.warnings?.length) {
          html += `<ul style="padding-left: 20px; font-size: 0.85rem; color: var(--text-muted);">${data.warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul>`
        }
        if (data.unlinked_count > 0) {
          html += `<div style="padding-bottom: 8px; font-size: 0.85rem; color: var(--text-muted);">${escapeHtml(t('filamentdb.syncLinkedUnlinkedHint'))}
            <button id="btn-unlinked-check" class="fm-btn fm-btn-outline" style="font-size: 0.75rem; padding: 2px 8px; margin-left: 6px;">${escapeHtml(t('filamentdb.unlinkedCheck'))}</button></div>`
        }
        if (data.manufacturers.length === 0) {
          html += linkedMsg(t('filamentdb.syncLinkedUpToDate'))
        } else {
          html += `<div style="display: flex; gap: 6px; margin-bottom: 8px;">
            <button class="fm-btn fm-btn-outline" id="linked-sel-all" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.selectAll'))}</button>
            <button class="fm-btn fm-btn-outline" id="linked-sel-none" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.deselectAll'))}</button>
          </div><div id="sync-linked-tree">${renderLinkedGroups(data.manufacturers)}</div>
          <button id="btn-sync-linked-apply" class="fm-btn fm-btn-primary" style="margin-top: 12px;">${escapeHtml(t('filamentdb.syncLinkedUpdateSelected'))}</button>
          <div id="sync-linked-done" style="margin-top: 12px;"></div>`
        }
        if (data.missing_in_db.length > 0) {
          html += `<details style="margin-top: 12px;"><summary style="cursor: pointer; font-size: 0.85rem; color: var(--text-muted);">${escapeHtml(t('filamentdb.syncLinkedMissing'))} (${data.missing_in_db.length})</summary>
            <ul style="padding-left: 20px; font-size: 0.85rem; color: var(--text-muted);">
              ${data.missing_in_db.map(m => `<li>${escapeHtml(m.designation)} <span style="opacity: 0.7;">${escapeHtml(m.manufacturer_name)} (#${m.fdb_id})</span></li>`).join('')}
            </ul></details>`
        }
        out.innerHTML = html
        document.getElementById('btn-unlinked-check')?.addEventListener('click', () => loadUnlinked())
        const tree = document.getElementById('sync-linked-tree')
        if (tree) {
          wireLinkedTree(tree)
          document.getElementById('btn-sync-linked-apply')?.addEventListener('click', () => applyLinkedUpdates(tree))
        }
      } catch (err) {
        if (isAbortError(err)) return
        out.innerHTML = linkedMsg(err instanceof Error ? err.message : String(err), true)
      } finally {
        btn.disabled = false
      }
    })

    // ---- Nicht verknuepfte Filamente pruefen und verknuepfen ----
    interface UnlinkedSuggestion {
      fdb_id: number; designation: string; manufacturer_name: string; material_type: string
      colors: string[]; score: number; exact: boolean; already_linked_to: number | null
    }
    interface UnlinkedItem {
      local_id: number; designation: string; manufacturer_name: string; material_type: string
      colors: string[]; suggestion: UnlinkedSuggestion | null
    }

    function safeHexDots(colors: string[]): string {
      return (colors || []).filter(c => /^#?[0-9a-f]{6,8}$/i.test(c)).map(c => {
        const hex = c.startsWith('#') ? c : '#' + c
        return `<span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); background: ${hex}; vertical-align: middle; margin-right: 2px;"></span>`
      }).join('')
    }

    function renderUnlinkedItem(it: UnlinkedItem): string {
      const s = it.suggestion
      const local = `<a href="/filaments/${it.local_id}" style="font-weight: 500;">${escapeHtml(it.designation)}</a>
        <span style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(it.material_type)}</span> ${safeHexDots(it.colors)}`
      if (!s) {
        return `<div style="padding: 6px 0; border-top: 1px solid var(--border); font-size: 0.85rem; margin-left: 24px;">${local}
          <div style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(t('filamentdb.unlinkedNoMatch'))}
            · <a href="/filaments/${it.local_id}/edit">${escapeHtml(t('filamentdb.unlinkedEdit'))}</a>
            · <a href="${FILAMENTDB_SITE_URL}" target="_blank" rel="noopener noreferrer">${escapeHtml(t('filamentdb.unlinkedSubmit'))}</a></div></div>`
      }
      const checked = s.exact && s.already_linked_to == null ? 'checked' : ''
      const taken = s.already_linked_to != null
        ? `<div style="font-size: 0.8rem; color: var(--warning-text, var(--text-muted));"><a href="/filaments/${Number(s.already_linked_to)}">${escapeHtml(t('filamentdb.unlinkedAlreadyLinked', { id: s.already_linked_to }))}</a></div>`
        : ''
      return `<div style="padding: 6px 0; border-top: 1px solid var(--border);">
        <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.85rem;">
          <input type="checkbox" class="unl-cb" data-local-id="${it.local_id}" data-fdb-id="${s.fdb_id}" ${checked} style="margin-top: 3px;" />
          <span>${local}<br />
            <span style="color: var(--text-muted);">&rarr;</span> ${escapeHtml(s.designation)}
            <span style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(s.material_type)}</span> ${safeHexDots(s.colors)}
            <span style="font-size: 0.75rem; color: var(--text-muted);">${Math.round(s.score * 100)}% ${escapeHtml(t('filamentdb.unlinkedMatch'))}</span>
            ${taken}</span>
        </label></div>`
    }

    async function loadUnlinked(note = '') {
      const area = document.getElementById('unlinked-area')!
      area.style.display = 'block'
      area.innerHTML = linkedMsg(t('filamentdb.unlinkedLoading'))
      try {
        const response = await fetch('/api/v1/admin/system/filamentdb-import/unlinked-suggestions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ snapshot_id: linkedSnapshotId }),
          signal: getAbortSignal(),
        })
        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('filamentdb.unlinkedFailed'))
        }
        const data: { snapshot_id: string | null; items: UnlinkedItem[] } = await response.json()
        linkedSnapshotId = data.snapshot_id ?? linkedSnapshotId
        let html = note
        if (data.items.length === 0) {
          area.innerHTML = html + linkedMsg(t('filamentdb.unlinkedNone'))
          return
        }
        const byMfr = new Map<string, UnlinkedItem[]>()
        for (const it of data.items) {
          byMfr.set(it.manufacturer_name, [...(byMfr.get(it.manufacturer_name) ?? []), it])
        }
        html += `<div style="display: flex; gap: 6px; margin: 8px 0;">
          <button class="fm-btn fm-btn-outline" id="unl-sel-all" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.selectAll'))}</button>
          <button class="fm-btn fm-btn-outline" id="unl-sel-none" style="font-size: 0.7rem; padding: 2px 8px;">${escapeHtml(t('filamentdb.deselectAll'))}</button>
        </div><div id="unlinked-tree">`
        for (const [name, items] of byMfr) {
          html += `<details style="border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 8px;">
            <summary style="padding: 8px 14px; cursor: pointer; background: var(--bg-soft);"><strong style="font-size: 0.9rem;">${escapeHtml(name)}</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">(${items.length})</span></summary>
            <div style="padding: 4px 14px;">${items.map(renderUnlinkedItem).join('')}</div></details>`
        }
        html += `</div><button id="btn-unlinked-apply" class="fm-btn fm-btn-primary" style="margin-top: 8px;">${escapeHtml(t('filamentdb.unlinkedLinkSelected'))}</button>
          <div id="unlinked-done" style="margin-top: 12px;"></div>`
        area.innerHTML = html
        const boxes = () => [...area.querySelectorAll<HTMLInputElement>('.unl-cb')]
        document.getElementById('unl-sel-all')?.addEventListener('click', () => boxes().forEach(b => { b.checked = true }))
        document.getElementById('unl-sel-none')?.addEventListener('click', () => boxes().forEach(b => { b.checked = false }))
        document.getElementById('btn-unlinked-apply')?.addEventListener('click', async () => {
          const selected = boxes().filter(b => b.checked).map(b => ({
            local_id: Number(b.dataset.localId), fdb_id: Number(b.dataset.fdbId),
          }))
          const done = document.getElementById('unlinked-done')!
          if (selected.length === 0) { done.innerHTML = linkedMsg(t('filamentdb.unlinkedNothingSelected')); return }
          const applyBtn = document.getElementById('btn-unlinked-apply') as HTMLButtonElement
          applyBtn.disabled = true
          try {
            const res = await fetch('/api/v1/admin/system/filamentdb-import/link', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              body: JSON.stringify({ snapshot_id: linkedSnapshotId, items: selected }),
              signal: getAbortSignal(),
            })
            if (!res.ok) {
              const d = await res.json().catch(() => ({}))
              throw new Error(d.detail?.message || t('filamentdb.unlinkedLinkFailed'))
            }
            const r: { linked: number; warnings: string[] } = await res.json()
            let msg = `<div style="padding: 8px 0; font-size: 0.9rem;">${escapeHtml(t('filamentdb.unlinkedLinked', { count: r.linked }))}</div>`
            if (r.warnings?.length) {
              msg += `<ul style="padding-left: 20px; font-size: 0.85rem; color: var(--text-muted);">${r.warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul>`
            }
            area.innerHTML = msg
            document.getElementById('btn-sync-linked')?.click()
          } catch (err) {
            if (isAbortError(err)) return
            done.innerHTML = linkedMsg(err instanceof Error ? err.message : String(err), true)
            applyBtn.disabled = false
          }
        })
      } catch (err) {
        if (isAbortError(err)) return
        area.innerHTML = linkedMsg(err instanceof Error ? err.message : String(err), true)
      }
    }

    async function applyLinkedUpdates(tree: HTMLElement) {
      const btn = document.getElementById('btn-sync-linked-apply') as HTMLButtonElement
      const done = document.getElementById('sync-linked-done')!
      const selection = collectLinkedSelection(tree)
      if (selection.filaments.length === 0 && selection.manufacturers.length === 0) return
      btn.disabled = true
      btn.textContent = t('filamentdb.syncLinkedUpdating')
      try {
        const response = await fetch('/api/v1/admin/system/filamentdb-import/update-linked', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ snapshot_id: linkedSnapshotId, ...selection }),
          signal: getAbortSignal(),
        })
        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('filamentdb.syncLinkedFailed'))
        }
        const result: ImportResult = await response.json()
        const errors = result.errors ?? []
        const warnings = result.warnings ?? []
        let html = `<div style="font-size: 0.9rem; color: ${errors.length ? 'var(--error-text)' : 'var(--accent-2)'};">${escapeHtml(t('filamentdb.syncLinkedDone', { count: result.filaments_updated }))}</div>`
        if (warnings.length) {
          html += `<ul style="padding-left: 20px; font-size: 0.85rem; color: var(--text-muted);">${warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul>`
        }
        if (errors.length) {
          html += `<ul style="padding-left: 20px; font-size: 0.85rem; color: var(--error-text);">${errors.map(e => `<li>${escapeHtml(e)}</li>`).join('')}</ul>`
        }
        done.innerHTML = html
      } catch (err) {
        if (isAbortError(err)) return
        done.innerHTML = linkedMsg(err instanceof Error ? err.message : String(err), true)
      } finally {
        btn.disabled = false
        btn.textContent = t('filamentdb.syncLinkedUpdateSelected')
      }
    }

    document.getElementById('btn-import')?.addEventListener('click', async () => {
      const resultDiv = document.getElementById('import-result')!
      const progressDiv = document.getElementById('import-progress')!
      const progressBar = document.getElementById('import-bar') as HTMLElement
      const statusText = document.getElementById('import-status')!
      const btn = document.getElementById('btn-import') as HTMLButtonElement

      if (selectedMfrIds.size === 0 || selectedFilIds.size === 0) return

      // Phase 1: Pruefen
      if (!importChecked) {
        btn.disabled = true
        btn.textContent = t('filamentdb.loadingDiff')

        const diffOk = await checkForExistingFilaments()
        if (!diffOk) {
          btn.disabled = false
          btn.textContent = t('filamentdb.checkImport')
          return
        }

        importChecked = true
        btn.disabled = false
        btn.textContent = t('filamentdb.startImport')
        return
      }

      // Phase 2: Import ausfuehren

      btn.disabled = true
      btn.textContent = t('filamentdb.importing')
      progressDiv.style.display = 'block'
      progressBar.style.width = '20%'
      resultDiv.style.display = 'none'

      try {
        progressBar.style.width = '50%'
        statusText.textContent = t('filamentdb.importing')

        const requestBody = {
          spool_detail_target: getSelectedTarget(),
          manufacturer_ids: [...selectedMfrIds],
          filament_ids: [...selectedFilIds],
          snapshot_id: currentSnapshotId,
          update_filament_ids: updateFilIds.size ? [...updateFilIds] : undefined,
          skip_fuzzy_ids: rejectedFuzzyIds.size ? [...rejectedFuzzyIds] : undefined,
        }

        const response = await fetch('/api/v1/admin/system/filamentdb-import/execute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify(requestBody),
          signal: getAbortSignal(),
        })

        progressBar.style.width = '90%'

        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('filamentdb.importFailed'))
        }

        const result = await response.json()
        progressBar.style.width = '100%'
        statusText.textContent = t('filamentdb.importComplete')

        resultDiv.style.display = 'block'
        resultDiv.innerHTML = renderImportResult(result)

      } catch (err) {
        if (isAbortError(err)) return
        progressDiv.style.display = 'none'
        resultDiv.style.display = 'block'
        resultDiv.innerHTML = `
          <div style="padding: 12px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--error-text); color: var(--error-text);">
            <strong>${escapeHtml(t('filamentdb.importFailed'))}</strong><br>
            ${escapeHtml(err instanceof Error ? err.message : String(err))}
          </div>
        `
      } finally {
        btn.disabled = false
        btn.textContent = t('filamentdb.startImport')
      }
    })

    function renderImportResult(r: ImportResult): string {
      const errors = r.errors ?? []
      const warnings = r.warnings ?? []

      let html = `
        <div style="padding: 16px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid ${errors.length ? 'var(--error-text)' : 'var(--accent-2)'};">
          <h3 style="font-size: 1rem; font-weight: 600; margin: 0 0 12px;">${escapeHtml(t('filamentdb.importResults'))}</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px;">
            ${resultCard(t('filamentdb.manufacturers'), r.manufacturers_created, r.manufacturers_skipped)}
            ${resultCard(t('filamentdb.colors'), r.colors_created, r.colors_skipped)}
            ${resultCard(t('filamentdb.filaments'), r.filaments_created, r.filaments_skipped, r.filaments_updated)}
            ${logoCard(r.logos_downloaded, r.logos_failed)}
          </div>
      `

      if (warnings.length) {
        html += `
          <details style="margin-top: 16px;">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--text-muted);">${escapeHtml(t('filamentdb.warnings'))} (${warnings.length})</summary>
            <ul style="margin-top: 8px; padding-left: 20px; font-size: 0.85rem; color: var(--text-muted);">
              ${warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}
            </ul>
          </details>
        `
      }

      if (errors.length) {
        html += `
          <details style="margin-top: 12px;" open>
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--error-text);">${escapeHtml(t('filamentdb.errors'))} (${errors.length})</summary>
            <ul style="margin-top: 8px; padding-left: 20px; font-size: 0.85rem; color: var(--error-text);">
              ${errors.map(e => `<li>${escapeHtml(e)}</li>`).join('')}
            </ul>
          </details>
        `
      }

      html += '</div>'
      return html
    }

    function resultCard(label: string, created: number, skipped: number, updated?: number): string {
      return `
        <div style="background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; text-align: center;">
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">${escapeHtml(label)}</div>
          <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent);">${created}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(t('filamentdb.created'))}</div>
          ${updated && updated > 0 ? `<div style="font-size: 0.75rem; color: var(--accent-2, green); margin-top: 4px;">${updated} ${escapeHtml(t('filamentdb.updated'))}</div>` : ''}
          ${skipped > 0 ? `<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">${skipped} ${escapeHtml(t('filamentdb.skipped'))}</div>` : ''}
        </div>
      `
    }

    function logoCard(downloaded: number, failed: number): string {
      return `
        <div style="background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; text-align: center;">
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">${escapeHtml(t('filamentdb.logos'))}</div>
          <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent);">${downloaded}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(t('filamentdb.downloaded'))}</div>
          ${failed > 0 ? `<div style="font-size: 0.75rem; color: var(--error-text); margin-top: 4px;">${failed} ${escapeHtml(t('filamentdb.failed'))}</div>` : ''}
        </div>
      `
    }
    })
  </script>
  <style>
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</Layout>
