---
import Layout from '../../layouts/Layout.astro'
import AdminHeader from '../../components/AdminHeader.astro'
import FormSection from '../../components/FormSection.astro'
---

<Layout title="FilaMan - OIDC">
  <style>
    #oidc-form > div:has(> .fm-label) { align-items: start; }
    #oidc-form > div > .fm-label { padding-top: 8px; }
    .oidc-control { min-width: 0; display: grid; gap: 4px; }
    .oidc-callback { display: flex; gap: 8px; align-items: center; }
    .oidc-callback input { flex: 1; width: 0; cursor: default; }
    .oidc-callback button { padding: 8px 14px; white-space: nowrap; }
    @media (max-width: 640px) { #oidc-form > div > .fm-label { padding-top: 0; } }
  </style>

  <div class="fm-admin-page fm-admin-page-compact">
  <AdminHeader titleKey="admin.oidcTitle" title="OIDC Configuration">
    <button type="submit" form="oidc-form" id="save-btn" disabled class="fm-btn fm-btn-primary" data-i18n="admin.oidcSave">Save</button>
  </AdminHeader>
  <p class="fm-field-hint" data-i18n="admin.oidcSubtitle">Configure OpenID Connect for Single Sign-On</p>
  <FormSection titleKey="admin.oidc" title="OIDC / SSO">
    <form id="oidc-form" class="fm-compact-form">
      <!-- Enabled toggle -->
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <label for="oidc-enabled" data-i18n="admin.oidcEnabled" style="font-weight: 500;">Enabled</label>
        <label class="fm-toggle" for="oidc-enabled">
          <input type="checkbox" id="oidc-enabled" />
          <span class="fm-toggle-slider" aria-hidden="true"></span>
        </label>
      </div>

      <!-- Issuer URL -->
      <div>
        <label for="issuer-url" class="fm-label" data-i18n="admin.oidcIssuerUrl">Issuer URL</label>
        <div class="oidc-control">
          <input type="url" id="issuer-url" class="fm-input" placeholder="https://auth.example.com" aria-describedby="issuer-url-hint" />
          <p id="issuer-url-hint" class="fm-field-hint" data-i18n="admin.oidcIssuerUrlHint">Must start with https://</p>
        </div>
      </div>

      <!-- Client ID -->
      <div>
        <label for="client-id" class="fm-label" data-i18n="admin.oidcClientId">Client ID</label>
        <input type="text" id="client-id" class="fm-input" />
      </div>

      <!-- Client Secret -->
      <div>
        <label for="client-secret" class="fm-label" data-i18n="admin.oidcClientSecret">Client Secret</label>
        <div class="oidc-control">
          <input type="password" id="client-secret" class="fm-input" placeholder="" aria-describedby="client-secret-hint secret-status" />
          <p id="client-secret-hint" class="fm-field-hint" data-i18n="admin.oidcClientSecretHint">Leave empty to keep current secret</p>
          <p id="secret-status" class="fm-field-hint"></p>
        </div>
      </div>

      <!-- Scopes -->
      <div>
        <label for="scopes" class="fm-label" data-i18n="admin.oidcScopes">Scopes</label>
        <div class="oidc-control">
          <input type="text" id="scopes" class="fm-input" value="openid email profile" aria-describedby="scopes-hint" />
          <p id="scopes-hint" class="fm-field-hint" data-i18n="admin.oidcScopesHint">Space-separated list of scopes</p>
        </div>
      </div>

      <!-- Button Text -->
      <div>
        <label for="button-text" class="fm-label" data-i18n="admin.oidcButtonText">Button Text</label>
        <div class="oidc-control">
          <input type="text" id="button-text" class="fm-input" value="Login with SSO" aria-describedby="button-text-hint" />
          <p id="button-text-hint" class="fm-field-hint" data-i18n="admin.oidcButtonTextHint">Shown on the login page</p>
        </div>
      </div>

      <!-- Callback URL (read-only) -->
      <div>
        <label for="callback-url" class="fm-label" data-i18n="admin.oidcCallbackUrl">Callback URL</label>
        <div class="oidc-control">
          <div class="oidc-callback">
            <input type="text" id="callback-url" class="fm-input" readonly aria-describedby="callback-url-hint" />
            <button type="button" id="copy-callback" class="fm-btn" data-i18n="admin.oidcCopy">Copy</button>
          </div>
          <p id="callback-url-hint" class="fm-field-hint" data-i18n="admin.oidcCallbackUrlHint">Register this URL in your OIDC provider</p>
        </div>
      </div>

      <div id="form-message" class="hidden" style="padding: 10px 14px; border-radius: 8px; font-size: 0.85rem;"></div>

    </form>
  </FormSection>
  </div>

  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { getAbortSignal } from '../../lib/abort'
    import { copyText } from '../../lib/clipboard'
    import { bindFormState } from '../../lib/form-state'

    async function init() {
      await initI18n()

      function getCsrfToken(): string {
        const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
        return match ? decodeURIComponent(match[1]) : ''
      }

      const form = document.getElementById('oidc-form') as HTMLFormElement
      const enabledInput = document.getElementById('oidc-enabled') as HTMLInputElement
      const issuerInput = document.getElementById('issuer-url') as HTMLInputElement
      const clientIdInput = document.getElementById('client-id') as HTMLInputElement
      const clientSecretInput = document.getElementById('client-secret') as HTMLInputElement
      const scopesInput = document.getElementById('scopes') as HTMLInputElement
      const buttonTextInput = document.getElementById('button-text') as HTMLInputElement
      const secretStatus = document.getElementById('secret-status')!
      const formMessage = document.getElementById('form-message')!
      const saveBtn = document.getElementById('save-btn') as HTMLButtonElement
      const formState = bindFormState(form, saveBtn)

      const callbackUrlInput = document.getElementById('callback-url') as HTMLInputElement
      const copyBtn = document.getElementById('copy-callback') as HTMLButtonElement

      // Set callback URL based on current origin
      callbackUrlInput.value = `${window.location.origin}/auth/oidc/callback`

      // Over plain HTTP navigator.clipboard is undefined, so this threw before
      // the then() could run and the button never moved. copyText() falls back
      // to a hidden textarea; a failure selects the field to copy by hand.
      copyBtn.addEventListener('click', async () => {
        const originalText = copyBtn.textContent
        if (await copyText(callbackUrlInput.value)) {
          copyBtn.textContent = '✓'
        } else {
          copyBtn.textContent = '✕'
          callbackUrlInput.select()
        }
        setTimeout(() => { copyBtn.textContent = originalText }, 2000)
      })

      function showMessage(text: string, isError: boolean) {
        formMessage.textContent = text
        formMessage.className = isError ? 'fm-alert-error' : 'fm-alert-success'
        formMessage.classList.remove('hidden')
        setTimeout(() => formMessage.classList.add('hidden'), 5000)
      }

      // Load settings
      try {
        const resp = await fetch('/api/v1/admin/oidc-settings/', { credentials: 'include', signal: getAbortSignal() })
        if (resp.ok) {
          const data = await resp.json()
          enabledInput.checked = data.enabled
          issuerInput.value = data.issuer_url || ''
          clientIdInput.value = data.client_id || ''
          scopesInput.value = data.scopes || 'openid email profile'
          buttonTextInput.value = data.button_text || 'Login with SSO'
          formState.reset()
          if (data.has_client_secret) {
            secretStatus.textContent = t('admin.oidcClientSecretSet')
            secretStatus.style.color = 'var(--success-text)'
          } else {
            secretStatus.textContent = t('admin.oidcClientSecretNotSet')
            secretStatus.style.color = 'var(--error-text)'
          }
        } else {
          showMessage(t('admin.oidcLoadFailed'), true)
        }
      } catch {
        showMessage(t('admin.oidcLoadFailed'), true)
      }

      // Save settings
      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        if (formState.busy || saveBtn.disabled) return

        const issuerUrl = issuerInput.value.trim()
        if (issuerUrl && !issuerUrl.startsWith('https://')) {
          showMessage(t('admin.oidcIssuerUrlInvalid'), true)
          return
        }

        formState.setBusy(true)
        saveBtn.textContent = t('admin.oidcSaving')

        const payload: Record<string, unknown> = {
          enabled: enabledInput.checked,
          issuer_url: issuerUrl || null,
          client_id: clientIdInput.value.trim() || null,
          scopes: scopesInput.value.trim() || 'openid email profile',
          button_text: buttonTextInput.value.trim() || 'Login with SSO',
        }
        const secret = clientSecretInput.value
        if (secret) {
          payload.client_secret = secret
        }

        try {
          const resp = await fetch('/api/v1/admin/oidc-settings/', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': getCsrfToken(),
            },
            credentials: 'include',
            body: JSON.stringify(payload),
            signal: getAbortSignal(),
          })

          if (resp.ok) {
            const data = await resp.json()
            clientSecretInput.value = ''
            if (data.has_client_secret) {
              secretStatus.textContent = t('admin.oidcClientSecretSet')
              secretStatus.style.color = 'var(--success-text)'
            } else {
              secretStatus.textContent = t('admin.oidcClientSecretNotSet')
              secretStatus.style.color = 'var(--error-text)'
            }
            formState.reset()
            showMessage(t('admin.oidcSaveSuccess'), false)
          } else {
            const err = await resp.json().catch(() => ({}))
            // Handle all backend error formats:
            // HTTPException: {detail: {message: '...'}} or {detail: '...'}
            // CSRF middleware: {message: '...'}
            // Pydantic: {detail: [{msg: '...'}]}
            const msg =
              err.detail?.message ||
              err.message ||
              (typeof err.detail === 'string' ? err.detail : null) ||
              (Array.isArray(err.detail) ? err.detail[0]?.msg : null) ||
              t('admin.oidcSaveFailed')
            showMessage(msg, true)
          }
        } catch {
          showMessage(t('admin.oidcSaveFailed'), true)
        } finally {
          formState.setBusy(false)
          saveBtn.textContent = t('admin.oidcSave')
        }
      })
    }

    init()
  </script>
</Layout>
