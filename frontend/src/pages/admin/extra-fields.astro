      if (formulaFields.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted);">No formula fields defined yet.</td></tr>`
        return
      }

      tbody.innerHTML = formulaFields.map(f => {
        const formulaPreview = JSON.stringify(f.formula)
        const truncated = formulaPreview.length > 60 ? formulaPreview.slice(0, 60) + '…' : formulaPreview
        return `
        <tr>
          <td><span class="fm-pill" style="text-transform: capitalize;">${escapeHtml(f.target_type)}</span></td>
          <td style="font-family: monospace; color: var(--accent-2);">ƒ ${escapeHtml(f.key)}</td>
          <td>${escapeHtml(f.label)}</td>
          <td style="font-family: monospace; font-size: 0.78rem; color: var(--text-muted);" title="${escapeHtml(formulaPreview)}">${escapeHtml(truncated)}</td>
          <td style="white-space: nowrap;">${surfaceBadges(f)}</td>
          <td style="text-align: right;">
            <button data-id="${f.id}" class="btn-edit-formula" style="color: var(--accent); background: none; border: none; cursor: pointer; margin-right: 8px;">${t('common.edit')}</button>
            <button data-id="${f.id}" class="btn-delete-formula" style="color: var(--error-text); background: none; border: none; cursor: pointer;">${t('common.delete')}</button>
          </td>
        </tr>`
      }).join('')

      document.querySelectorAll('.btn-edit-formula').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = parseInt((e.currentTarget as HTMLButtonElement).dataset.id!)
          const field = fields.find(f => f.id === id)
          if (field) openFormulaModal(field)
        })
      })

      document.querySelectorAll('.btn-delete-formula').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = parseInt((e.currentTarget as HTMLButtonElement).dataset.id!)
          if (!(await (window as any).__fmConfirm("Delete this formula field?"))) return
          try {
            const response = await fetch(`/api/v1/system-extra-fields/${id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              signal: getAbortSignal(),
            })
            if (!response.ok) {
              const data = await response.json()
              throw new Error(apiErrorMessage(data, 'Failed to delete'))
            }
            loadData()
          } catch (err: any) {
            if (isAbortError(err)) return
            await (window as any).__fmAlert(err.message || "Failed to delete formula field")
          }
        })
      })
    }

