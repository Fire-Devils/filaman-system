---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="FilaMan - System Extra Fields">
  <div style="margin-bottom: 24px;">
    <a href="/admin" style="color: var(--accent); text-decoration: none;">&larr; <span data-i18n="admin.backToAdmin">Back to Admin</span></a>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="font-size: 1.8rem; font-weight: 700; margin: 0; font-family: var(--font-serif);" data-i18n="admin.extraFieldsTitle">System Extra Fields</h1>
    <button
      id="btn-new"
      class="fm-btn fm-btn-primary"
      data-i18n="admin.addField"
    >
      Add Field
    </button>
  </div>

  <p style="color: var(--text-muted); margin-bottom: 24px;" data-i18n="admin.extraFieldsHint">
    These fields will be automatically added to all filaments or spools.
  </p>

  <div class="fm-card" style="padding: 0;">
    <table class="fm-table">
      <thead style="background: var(--bg-soft);">
        <tr>
          <th data-i18n="admin.targetType">Target Type</th>
          <th data-i18n="admin.keyJson">Key (JSON)</th>
          <th data-i18n="admin.displayLabel">Label</th>
          <th data-i18n="admin.fieldType">Type</th>
          <th data-i18n="admin.defaultValue">Default Value</th>
          <th data-i18n="admin.source">Source</th>
          <th data-i18n="admin.referencedIn">Referenced In</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="fields-table">
        <tr>
          <td colspan="8" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Formula Fields Section -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 40px; margin-bottom: 16px;">
    <div>
      <h2 style="font-size: 1.3rem; font-weight: 600; margin: 0;">Formula Fields</h2>
      <p style="color: var(--text-muted); margin: 4px 0 0 0; font-size: 0.875rem;">
        Computed values derived from entity data via <a href="https://jsonlogic.com/" target="_blank" rel="noopener noreferrer" style="color: var(--accent);">JSON Logic</a> expressions. Never stored — evaluated at read time.
      </p>
    </div>
    <button id="btn-new-formula" class="fm-btn fm-btn-primary">Add Formula</button>
  </div>

  <div class="fm-card" style="padding: 0;">
    <table class="fm-table">
      <thead style="background: var(--bg-soft);">
        <tr>
          <th data-i18n="admin.targetType">Target Type</th>
          <th data-i18n="admin.keyJson">Key</th>
          <th data-i18n="admin.displayLabel">Label</th>
          <th>Formula</th>
          <th>Surfaces</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="formula-fields-table">
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <style>
    /* Compact overrides scoped to the formula modal */
    #formula-modal-form input.fm-input,
    #formula-modal-form select.fm-select {
      height: 34px;
      padding: 5px 10px;
      font-size: 0.85rem;
    }
    #formula-modal-form select.fm-select {
      padding-right: 36px;
    }
    #formula-modal-form .fm-label {
      font-size: 0.78rem;
      margin-bottom: 3px;
    }
    /* Prevent flex from shrinking form children — ensures overflow-y:auto scrolls */
    #formula-modal-form > * {
      flex-shrink: 0;
    }
  </style>

  <!-- Formula field modal (V2: wide two-panel layout with CodeMirror) -->
  <div id="formula-modal-container" class="fm-modal-overlay">
    <div class="fm-card" style="width:90vw; max-width:900px; margin:0 1rem; padding:0; max-height:90vh; overflow:hidden; display:flex; flex-direction:column;">

      <!-- Header -->
      <div style="padding:10px 16px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-shrink:0;">
        <h3 id="formula-modal-title" style="font-size:1.1rem; font-weight:600; margin:0;">Add Formula Field</h3>
        <button id="formula-modal-close" type="button" style="background:none; border:none; cursor:pointer; color:var(--text-muted); font-size:1.1rem; line-height:1; padding:2px 6px;">✕</button>
      </div>

      <!-- Two-panel body -->
      <div style="display:flex; flex:1; min-height:0;">

        <!-- Left: form -->
        <form id="formula-modal-form" style="flex:1; min-height:0; overflow-y:auto; padding:12px 16px; display:flex; flex-direction:column; gap:8px; min-width:0;">
          <input type="hidden" id="formula-field-id" />

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div>
              <label for="formula-field-target" class="fm-label">Target Type *</label>
              <select id="formula-field-target" required class="fm-select">
                <option value="spool">Spool</option>
                <option value="filament">Filament</option>
              </select>
            </div>
            <div>
              <label for="formula-field-key" class="fm-label">Key *</label>
              <input type="text" id="formula-field-key" required class="fm-input" placeholder="e.g. weight_per_meter" pattern="[a-zA-Z0-9_]+" title="Only letters, numbers, and underscores" />
            </div>
          </div>

          <div>
            <label for="formula-field-label" class="fm-label">Display Label *</label>
            <input type="text" id="formula-field-label" required class="fm-input" placeholder="e.g. Weight per Meter (g/m)" />
          </div>

          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <label class="fm-label" style="margin:0;">JSON Logic Expression *</label>
              <button type="button" id="btn-format-json" class="fm-btn fm-btn-outline" style="padding:2px 8px; font-size:0.78rem;">Format JSON</button>
            </div>
            <div id="formula-json-editor" style="border:1px solid var(--border); border-radius:6px; overflow:hidden; min-height:120px;"></div>
            <small style="color:var(--text-muted); font-size:0.75rem; margin-top:3px; display:block;">
              Valid <a href="https://jsonlogic.com/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">JSON Logic</a> expression. Click a chip below or in the operators panel to copy a snippet.
            </small>
          </div>

          <!-- Field References (collapsible) -->
          <div style="border:1px solid var(--border); border-radius:5px; overflow:hidden;">
            <div id="btn-toggle-field-refs" role="button" tabindex="0" style="display:flex; justify-content:space-between; align-items:center; padding:5px 8px; background:var(--bg-soft); border-bottom:1px solid var(--border); cursor:pointer; user-select:none;">
              <span style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Field References</span>
              <span id="field-refs-chevron" style="font-size:0.65rem; color:var(--text-muted);">&#9660;</span>
            </div>
            <div id="field-refs-body" style="padding:6px 8px 4px;">
              <input type="text" id="ref-search" class="fm-input" placeholder="Search fields…" style="height:28px; padding:3px 8px; font-size:0.78rem; margin-bottom:5px;" />
              <div id="field-reference-list"></div>
            </div>
          </div>

          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <label class="fm-label" style="margin:0;">Preview</label>
              <div style="display:flex; align-items:center; gap:6px;">
                <label style="display:flex; align-items:center; gap:4px; font-size:0.75rem; color:var(--text-muted); cursor:pointer;">
                  <input type="checkbox" id="formula-auto-scaffold" checked style="width:13px; height:13px;" />
                  Auto-fill context
                </label>
                <button type="button" id="btn-preview" class="fm-btn fm-btn-outline" style="padding:2px 8px; font-size:0.78rem;">Run Preview</button>
              </div>
            </div>
            <textarea id="formula-preview-context" class="fm-input" rows="5" placeholder='{"remaining_weight_g": 800, "filament": {"raw_material_weight_g": 1000}}' style="resize:none; font-family:monospace; font-size:0.72rem; min-height:80px; padding:5px 8px; overflow:hidden;"></textarea>
            <div id="formula-preview-result" style="margin-top:4px; padding:5px 10px; background:var(--bg-soft); border-radius:4px; font-family:monospace; font-size:0.75rem; display:none;"></div>
          </div>

          <div>
            <label class="fm-label">Display Surfaces</label>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:4px 8px;">
              <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                <input type="checkbox" id="formula-show-detail" checked style="width:13px; height:13px; flex-shrink:0;" />
                <span style="font-size:0.82rem;">Show in detail view</span>
              </label>
              <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                <input type="checkbox" id="formula-show-template" style="width:13px; height:13px; flex-shrink:0;" />
                <span style="font-size:0.82rem;">Show in label template</span>
              </label>
              <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                <input type="checkbox" id="formula-include-api" style="width:13px; height:13px; flex-shrink:0;" />
                <span style="font-size:0.82rem;">Include in API response</span>
              </label>
            </div>
          </div>

          <div id="formula-modal-error" class="fm-alert-error hidden"></div>
          <div style="display:flex; gap:8px; padding-top:2px;">
            <button type="submit" id="formula-modal-submit" class="fm-btn fm-btn-primary">Save</button>
            <button type="button" id="formula-modal-cancel" class="fm-btn fm-btn-outline">Cancel</button>
          </div>
        </form>

        <!-- Vertical divider (always fills full panel height) -->
        <div style="width:1px; background:var(--border); flex-shrink:0; align-self:stretch;"></div>

        <!-- Right: reference panel -->
        <div id="formula-ref-panel" style="width:290px; flex-shrink:0; min-height:0; display:flex; flex-direction:column; transition:width 0.15s ease; overflow:hidden;">
          <div style="padding:8px 12px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-shrink:0; background:var(--bg-soft);">
            <span id="ref-panel-title" style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); white-space:nowrap; overflow:hidden;">Reference Aids</span>
            <button id="btn-collapse-ref" type="button" style="background:none; border:none; cursor:pointer; color:var(--text-muted); padding:2px 5px; font-size:0.78rem; flex-shrink:0; margin-left:6px;" title="Collapse panel">◀</button>
          </div>
          <div id="ref-panel-body" style="flex:1; min-height:0; padding:8px 10px; display:flex; flex-direction:column; overflow-y:auto;">
            <div style="margin-bottom:10px;">
              <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:6px; padding-bottom:3px; border-bottom:1px solid var(--border);">Operators &amp; Helpers</div>
              <div id="operator-categories" style="display:flex; flex-direction:column; gap:6px;"></div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Copy toast notification -->
  <div id="copy-toast" style="position:fixed; bottom:20px; right:20px; background:var(--bg-card, #1e2030); border:1px solid var(--border); border-radius:6px; padding:8px 16px; font-size:0.8rem; color:var(--text); box-shadow:0 4px 12px rgba(0,0,0,.3); opacity:0; transition:opacity 0.2s ease; pointer-events:none; z-index:9999;">Copied to clipboard</div>

  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import {
      createExtraFieldDefinitionDialog,
      type ExtraFieldDefinitionDialogDraft,
      type ExtraFieldDefinitionDialogResult,
    } from '../../lib/extra-field-definition-dialog'
    import {
      escapeHtml,
      formatExtraFieldDefaultValue,
    } from '../../lib/extra-fields'
    import { scaffoldFormulaPreviewContext } from '../../lib/formula-preview-context'
    import { EditorView, basicSetup } from 'codemirror'
    import { json as jsonLang } from '@codemirror/lang-json'
    await initI18n()

    interface SystemExtraFieldRecord {
      id: number
      target_type: 'filament' | 'spool'
      key: string
      label: string
      default_value: string | null
      field_type: string
      options: string[] | null
      config: {
        unit?: string
        decimal_places?: number | null
        min_bound?: number | null
        max_bound?: number | null
        max_length?: number | null
      } | null
      source: string | null
      formula?: Record<string, unknown> | null
      show_in_detail?: boolean
      show_in_template?: boolean
      include_in_api?: boolean
    }

    let fields: SystemExtraFieldRecord[] = []
    const editableRichFieldTypes = new Set([
      'text',
      'number',
      'range',
      'dropdown',
      'multiselect',
      'checkbox',
      'date',
      'datetime',
      'url',
      'textarea',
    ])
    const fieldDialog = createExtraFieldDefinitionDialog({ mode: 'system' })

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function draftFromField(
      field?: SystemExtraFieldRecord,
    ): ExtraFieldDefinitionDialogDraft {
      const config = field?.config ?? {}
      return {
        targetType: field?.target_type ?? 'filament',
        key: field?.key ?? '',
        label: field?.label ?? '',
        fieldType: field?.field_type ?? 'text',
        options: field?.options ? [...field.options] : [],
        unit: config.unit ?? '',
        decimalPlaces: config.decimal_places == null ? '' : String(config.decimal_places),
        minBound: config.min_bound == null ? '' : String(config.min_bound),
        maxBound: config.max_bound == null ? '' : String(config.max_bound),
        maxLength: config.max_length == null ? '' : String(config.max_length),
        defaultValue: field?.default_value ?? null,
      }
    }

    function configFromResult(
      result: ExtraFieldDefinitionDialogResult,
    ): Record<string, unknown> | null {
      const config: Record<string, unknown> = {}
      if (['number', 'range'].includes(result.fieldType)) {
        if (result.unit.trim()) config.unit = result.unit.trim()
        if (result.decimalPlaces !== '') config.decimal_places = Number(result.decimalPlaces)
        if (result.minBound !== '') config.min_bound = Number(result.minBound)
        if (result.maxBound !== '') config.max_bound = Number(result.maxBound)
      } else if (result.fieldType === 'textarea' && result.maxLength !== '') {
        config.max_length = Number(result.maxLength)
      }
      return Object.keys(config).length ? config : null
    }

    async function saveField(
      result: ExtraFieldDefinitionDialogResult,
      existing?: SystemExtraFieldRecord,
    ): Promise<void> {
      const body: Record<string, unknown> = {
        label: result.label.trim(),
        default_value: result.defaultValue,
      }
      if (!existing) {
        body.target_type = result.targetType
        body.key = result.key.trim()
        body.field_type = result.fieldType
        body.options = ['dropdown', 'multiselect'].includes(result.fieldType)
          ? result.options
          : null
        body.config = configFromResult(result)
      } else if (editableRichFieldTypes.has(existing.field_type)) {
        body.options = ['dropdown', 'multiselect'].includes(existing.field_type)
          ? result.options
          : null
        body.config = configFromResult({
          ...result,
          fieldType: existing.field_type,
        })
      }
      const response = await fetch(
        existing
          ? `/api/v1/system-extra-fields/${existing.id}`
          : '/api/v1/system-extra-fields',
        {
          method: existing ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify(body),
          signal: getAbortSignal(),
        },
      )
      if (!response.ok) {
        const data = await response.json()
        if (data.detail?.code === 'incompatible_existing_values') {
          throw new Error(t('admin.incompatibleExistingValues', {
            count: data.detail.incompatible_count,
            target: data.detail.target_type,
            type: fieldTypeLabel(data.detail.field_type),
          }))
        }
        throw new Error(apiErrorMessage(
          data,
          existing ? 'Failed to update field' : 'Failed to create field',
        ))
      }
      await loadData()
    }

    function openCreateDialog(): void {
      fieldDialog.open({
        title: t('admin.addField'),
        draft: draftFromField(),
        onSubmit: result => saveField(result),
      })
    }

    function openEditDialog(field: SystemExtraFieldRecord): void {
      fieldDialog.open({
        title: t('admin.editField'),
        draft: draftFromField(field),
        lockIdentity: true,
        lockType: true,
        onSubmit: result => saveField(result, field),
      })
    }

    async function loadData() {
      try {
        const res = await fetch('/api/v1/system-extra-fields', { credentials: 'include', signal: getAbortSignal() })
        if (!res.ok) throw new Error('Failed to fetch fields')
        fields = await res.json()
        renderFields()
        renderFormulaFields()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load data:', error)
      }
    }

    function apiErrorMessage(data: unknown, fallback: string): string {
      if (!data || typeof data !== 'object') return fallback
      const payload = data as { detail?: unknown; message?: unknown }
      if (typeof payload.detail === 'string') return payload.detail
      if (Array.isArray(payload.detail)) {
        const messages = payload.detail
          .map(item => item && typeof item === 'object' && 'msg' in item ? String(item.msg) : '')
          .filter(Boolean)
        if (messages.length > 0) return messages.join('; ')
      }
      if (payload.detail && typeof payload.detail === 'object' && 'message' in payload.detail) {
        return String((payload.detail as { message: unknown }).message)
      }
      return typeof payload.message === 'string' ? payload.message : fallback
    }

    function fieldTypeLabel(fieldType: string): string {
      const normalized = fieldType === 'float' ? 'number' : fieldType
      const translated = t(`admin.fieldType_${normalized}`)
      return translated === `admin.fieldType_${normalized}`
        ? normalized || t('admin.fieldType_text')
        : translated
    }

    function renderFields() {
      const tbody = document.getElementById('fields-table')!
      const regularFields = fields.filter(f => !f.formula)
      const formulaFields = fields.filter(f => !!f.formula)

      // Build reference count map: key → count of formula fields referencing it
      const refCounts: Record<string, number> = {}
      formulaFields.forEach(ff => {
        const formulaStr = JSON.stringify(ff.formula)
        regularFields.forEach(rf => {
          if (formulaStr.includes(`"${rf.key}"`)) {
            refCounts[rf.key] = (refCounts[rf.key] || 0) + 1
          }
        })
      })

      if (regularFields.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted);">${t('admin.noFieldsDefined')}</td></tr>`
        return
      }

      tbody.innerHTML = regularFields.map(f => {
        const isPluginManaged = !!f.source
        const refCount = refCounts[f.key] || 0
        const deleteDisabled = refCount > 0
        let actionsCell: string
        if (isPluginManaged) {
          actionsCell = `<span title="${t('admin.pluginManagedField') || 'Managed by plugin'}: ${escapeHtml(f.source)}" style="color: var(--text-muted); cursor: help;">🔒</span>`
        } else if (deleteDisabled) {
          actionsCell = `<button data-id="${f.id}" class="btn-edit" style="color: var(--accent); background: none; border: none; cursor: pointer; margin-right: 8px;">${t('common.edit')}</button><button disabled title="Referenced by formula fields — remove those first" style="color: var(--text-muted); background: none; border: none; cursor: not-allowed; opacity: 0.5;">${t('common.delete')}</button>`
        } else {
          actionsCell = `<button data-id="${f.id}" class="btn-edit" style="color: var(--accent); background: none; border: none; cursor: pointer; margin-right: 8px;">${t('common.edit')}</button><button data-id="${f.id}" class="btn-delete" style="color: var(--error-text); background: none; border: none; cursor: pointer;">${t('common.delete')}</button>`
        }

        const optionsInfo = (f.field_type === 'dropdown' || f.field_type === 'multiselect') && f.options
          ? ` <span title="${escapeHtml(f.options.join('\n'))}" style="color: var(--text-muted); cursor: help; font-size: 0.8rem;">(${f.options.length})</span>`
          : ''

        const rowStyle = isPluginManaged ? 'background: var(--bg-soft); opacity: 0.85;' : ''
        const refCell = refCount > 0
          ? `<span title="${refCount} formula field(s) reference this key" style="color: var(--accent); font-size: 0.8rem;">ƒ×${refCount}</span>`
          : '<span style="color: var(--text-muted);">—</span>'

        return `
        <tr style="${rowStyle}">
          <td><span class="fm-pill" style="text-transform: capitalize;">${escapeHtml(f.target_type)}</span></td>
          <td style="font-family: monospace; color: var(--accent-2);">${escapeHtml(f.key)}</td>
          <td>${escapeHtml(f.label)}</td>
          <td><span class="fm-pill">${fieldTypeLabel(f.field_type)}</span>${optionsInfo}</td>
          <td style="color: var(--text-muted);">${escapeHtml(formatExtraFieldDefaultValue(f))}</td>
          <td style="color: var(--text-muted);">${f.source ? escapeHtml(f.source) : '-'}</td>
          <td style="text-align: center;">${refCell}</td>
          <td style="text-align: right;">${actionsCell}</td>
        </tr>`
      }).join('')

      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = parseInt((e.currentTarget as HTMLButtonElement).dataset.id!)
          const field = fields.find(f => f.id === id)
          if (field) openEditDialog(field)
        })
      })

      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = parseInt((e.currentTarget as HTMLButtonElement).dataset.id!)
          if (!(await (window as any).__fmConfirm(t('admin.deleteFieldConfirm') || "Delete field?"))) return

          try {
            const response = await fetch(`/api/v1/system-extra-fields/${id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              signal: getAbortSignal(),
            })

            if (!response.ok) {
              const data = await response.json()
              throw new Error(apiErrorMessage(data, 'Failed to delete field'))
            }
            loadData()
          } catch (err: any) {
            if (isAbortError(err)) return
            await (window as any).__fmAlert(err.message || t('admin.failedDeleteField') || "Failed to delete field")
          }
        })
      })
    }

    function surfaceBadges(f: any): string {
      const badges: string[] = []
      if (f.show_in_detail) badges.push('<span style="font-size: 0.7rem; padding: 1px 5px; border-radius: 3px; background: var(--bg-soft); border: 1px solid var(--border);">Detail</span>')
      if (f.show_in_template) badges.push('<span style="font-size: 0.7rem; padding: 1px 5px; border-radius: 3px; background: var(--bg-soft); border: 1px solid var(--border);">Template</span>')
      if (f.include_in_api) badges.push('<span style="font-size: 0.7rem; padding: 1px 5px; border-radius: 3px; background: var(--bg-soft); border: 1px solid var(--border);">API</span>')
      return badges.join(' ') || '<span style="color: var(--text-muted); font-size: 0.8rem;">none</span>'
    }

    function renderFormulaFields() {
      const tbody = document.getElementById('formula-fields-table')!
