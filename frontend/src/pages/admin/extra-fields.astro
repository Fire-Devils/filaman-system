        ;(document.getElementById('formula-include-api') as HTMLInputElement).checked = false
        ;(document.getElementById('formula-modal-title') as HTMLElement).textContent = 'Add Formula Field'
      }

      // Auto-collapse ref panel on narrow screens
      if (window.innerWidth < 680) {
        applyRefPanelState(true)
      }

      container.classList.add('open')

      // Initialize CodeMirror on first open (must be visible for layout)
      ensureFormulaEditor()
      setFormulaJson(field ? JSON.stringify(field.formula, null, 2) : '')

      const target = (document.getElementById('formula-field-target') as HTMLSelectElement).value
      renderOperatorCategories()
      renderFieldReferences(target)
