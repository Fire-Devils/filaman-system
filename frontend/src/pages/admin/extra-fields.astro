        ;(document.getElementById('formula-show-template') as HTMLInputElement).checked = field.show_in_template ?? false
        ;(document.getElementById('formula-include-api') as HTMLInputElement).checked = field.include_in_api ?? false
        ;(document.getElementById('formula-modal-title') as HTMLElement).textContent = 'Edit Formula Field'
      } else {
        ;(document.getElementById('formula-field-id') as HTMLInputElement).value = ''
        ;(document.getElementById('formula-field-target') as HTMLSelectElement).disabled = false
        ;(document.getElementById('formula-field-target') as HTMLSelectElement).value = 'spool'
