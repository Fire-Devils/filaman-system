    function renderFieldReferences(targetType: string, query: string = '') {
      const container = document.getElementById('field-reference-list')!
      const baseRefs = targetType === 'spool' ? SPOOL_REFS : FILAMENT_REFS
      const q = query.toLowerCase().trim()
      const extraFields = fields.filter(f => f.target_type === targetType && !f.formula)
      const extraItems = extraFields.map(f => ({ key: `custom_fields.${f.key}`, label: f.key }))
      const allGroups = [
        ...baseRefs,
        ...(extraItems.length > 0 ? [{ group: 'Extra Fields', items: extraItems }] : []),
      ]
      const html = allGroups.map(group => {
        const items = q ? group.items.filter(item => item.key.toLowerCase().includes(q)) : group.items
        if (items.length === 0) return ''
        const chips = items.map(item => {
          const varSnippet = `{"var":"${item.key}"}`
          const escSnippet = varSnippet.replace(/&/g, '&amp;').replace(/"/g, '&quot;')
          return `<button type="button" class="ref-chip" data-var="${escSnippet}" style="font-size:0.76rem; padding:1px 6px; border:1px solid var(--border); border-radius:3px; background:var(--bg-soft); cursor:pointer; font-family:monospace; color:var(--accent); white-space:nowrap;" title="Copy ${escapeHtml(varSnippet)}">${escapeHtml(item.key)}</button>`
        }).join('')
        return `<div style="margin-bottom:5px;"><div style="font-size:0.64rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-bottom:3px;">${escapeHtml(group.group)}</div><div style="display:flex; flex-wrap:wrap; gap:3px;">${chips}</div></div>`
      }).join('')
      container.innerHTML = html
      container.querySelectorAll<HTMLButtonElement>('.ref-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          const raw = btn.getAttribute('data-var')!
          copySnippet(raw.replace(/&quot;/g, '"').replace(/&amp;/g, '&'))
        })
      })
    }

