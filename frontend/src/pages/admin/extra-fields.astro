    function extractVarPaths(expr: unknown): string[] {
      if (!expr || typeof expr !== 'object') return []
      const paths: string[] = []
      const obj = expr as Record<string, unknown>
      if ('var' in obj) {
        const p = obj.var
        if (typeof p === 'string' && p) paths.push(p)
        return paths
      }
      for (const val of Object.values(obj)) {
        if (Array.isArray(val)) {
          for (const item of val) paths.push(...extractVarPaths(item))
        } else {
          paths.push(...extractVarPaths(val))
        }
      }
      return paths
    }

    function scheduleAutoScaffold() {
      if (autoScaffoldTimer) clearTimeout(autoScaffoldTimer)
      autoScaffoldTimer = setTimeout(applyAutoScaffold, 400)
    }

    function applyAutoScaffold() {
      const autoEl = document.getElementById('formula-auto-scaffold') as HTMLInputElement
      if (!autoEl?.checked) return
      const raw = getFormulaJson()
      if (!raw) return
      let parsed: unknown
      try { parsed = JSON.parse(raw) } catch { return }
      const paths = [...new Set(extractVarPaths(parsed))]
      if (paths.length === 0) return
      const contextEl = document.getElementById('formula-preview-context') as HTMLTextAreaElement
      let context: Record<string, unknown> = {}
      if (contextEl.value.trim()) {
        try { context = JSON.parse(contextEl.value) } catch { /* keep empty */ }
      }
      const changed = scaffoldFormulaPreviewContext(context, paths, SCAFFOLD_PLACEHOLDERS)
      if (changed) {
        contextEl.value = JSON.stringify(context, null, 2)
        autoResizePreviewContext()
      }
    }

