---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="FilaMan - System Extra Fields">
  <div style="margin-bottom: 24px;">
    <a href="/admin" style="color: var(--accent); text-decoration: none;">&larr; <span data-i18n="admin.backToAdmin">Back to Admin</span></a>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="font-size: 1.8rem; font-weight: 700; margin: 0; font-family: var(--font-serif);" data-i18n="admin.extraFieldsTitle">System Extra Fields</h1>
    <button id="btn-new" class="fm-btn fm-btn-primary" data-i18n="admin.addField">Add Field</button>
  </div>

  <p style="color: var(--text-muted); margin-bottom: 24px;" data-i18n="admin.extraFieldsHint">
    These fields will be automatically added to all filaments or spools.
  </p>

  <div class="fm-card" style="padding: 0;">
    <table class="fm-table">
      <thead style="background: var(--bg-soft);">
        <tr>
          <th data-i18n="admin.targetType">Target Type</th>
          <th data-i18n="admin.keyJson">Key (JSON)</th>
          <th data-i18n="admin.displayLabel">Label</th>
          <th data-i18n="admin.fieldType">Type</th>
          <th data-i18n="admin.defaultValue">Default Value</th>
          <th data-i18n="admin.source">Source</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="fields-table">
        <tr>
          <td colspan="7" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <script>
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import {
      createExtraFieldDefinitionDialog,
      type ExtraFieldDefinitionDialogDraft,
      type ExtraFieldDefinitionDialogResult,
    } from '../../lib/extra-field-definition-dialog'
    import {
      escapeHtml,
      formatExtraFieldDefaultValue,
    } from '../../lib/extra-fields'
    import { initI18n, t } from '../../lib/i18n'

    await initI18n()

    interface SystemExtraFieldRecord {
      id: number
      target_type: 'filament' | 'spool'
      key: string
      label: string
      default_value: string | null
      field_type: string
      options: string[] | null
      config: {
        unit?: string
        decimal_places?: number | null
        min_bound?: number | null
        max_bound?: number | null
        max_length?: number | null
      } | null
      source: string | null
    }

    type ExtraFieldAdminWindow = Window & {
      __fmAlert: (message: string) => Promise<boolean>
      __fmConfirm: (message: string) => Promise<boolean>
    }

    let fields: SystemExtraFieldRecord[] = []

    const fieldDialog = createExtraFieldDefinitionDialog({ mode: 'system' })

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function fieldTypeLabel(fieldType: string): string {
      const normalized = fieldType === 'float' ? 'number' : fieldType
      const translated = t(`admin.fieldType_${normalized}`)
      return translated === `admin.fieldType_${normalized}`
        ? normalized || t('admin.fieldType_text')
        : translated
    }

    function draftFromField(
      field?: SystemExtraFieldRecord,
    ): ExtraFieldDefinitionDialogDraft {
      const config = field?.config ?? {}
      return {
        targetType: field?.target_type ?? 'filament',
        key: field?.key ?? '',
        label: field?.label ?? '',
        fieldType: field?.field_type ?? 'text',
        options: field?.options ? [...field.options] : [],
        unit: config.unit ?? '',
        decimalPlaces: config.decimal_places == null ? '' : String(config.decimal_places),
        minBound: config.min_bound == null ? '' : String(config.min_bound),
        maxBound: config.max_bound == null ? '' : String(config.max_bound),
        maxLength: config.max_length == null ? '' : String(config.max_length),
        defaultValue: field?.default_value ?? null,
      }
    }

    function configFromResult(result: ExtraFieldDefinitionDialogResult): Record<string, unknown> | null {
      const config: Record<string, unknown> = {}
      if (['number', 'range'].includes(result.fieldType)) {
        if (result.unit.trim()) config.unit = result.unit.trim()
        if (result.decimalPlaces !== '') config.decimal_places = Number(result.decimalPlaces)
        if (result.minBound !== '') config.min_bound = Number(result.minBound)
        if (result.maxBound !== '') config.max_bound = Number(result.maxBound)
      } else if (result.fieldType === 'textarea' && result.maxLength !== '') {
        config.max_length = Number(result.maxLength)
      }
      return Object.keys(config).length ? config : null
    }

    async function saveField(
      result: ExtraFieldDefinitionDialogResult,
      existing?: SystemExtraFieldRecord,
    ): Promise<void> {
      const isEdit = Boolean(existing)
      const body = {
        ...(isEdit
          ? {}
          : {
              target_type: result.targetType,
              key: result.key.trim(),
            }),
        label: result.label.trim(),
        default_value: result.defaultValue,
        field_type: result.fieldType,
        options: ['dropdown', 'multiselect'].includes(result.fieldType)
          ? result.options
          : null,
        config: configFromResult(result),
      }
      const response = await fetch(
        existing
          ? `/api/v1/system-extra-fields/${existing.id}`
          : '/api/v1/system-extra-fields',
        {
          method: isEdit ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify(body),
          signal: getAbortSignal(),
        },
      )
      if (!response.ok) {
        const data = await response.json()
        throw new Error(
          data.detail?.message
          || data.detail
          || data.message
          || (isEdit ? 'Failed to update field' : 'Failed to create field'),
        )
      }
      await loadData()
    }

    function openCreateDialog(): void {
      fieldDialog.open({
        title: t('admin.addField'),
        draft: draftFromField(),
        onSubmit: result => saveField(result),
      })
    }

    function openEditDialog(field: SystemExtraFieldRecord): void {
      fieldDialog.open({
        title: t('admin.editField'),
        draft: draftFromField(field),
        lockIdentity: true,
        lockType: true,
        onSubmit: result => saveField(result, field),
      })
    }

    function renderFields(): void {
      const tbody = document.getElementById('fields-table')!
      if (fields.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text-muted)">${escapeHtml(t('admin.noFieldsDefined'))}</td></tr>`
        return
      }

      tbody.innerHTML = fields
        .map(field => {
          const isPluginManaged = Boolean(field.source)
          const actions = isPluginManaged
            ? `<span title="${escapeHtml(t('admin.pluginManagedField'))}: ${escapeHtml(field.source)}" style="color:var(--text-muted);cursor:help">🔒</span>`
            : `<button data-id="${field.id}" class="btn-edit" style="color:var(--accent);background:none;border:none;cursor:pointer;margin-right:8px">${escapeHtml(t('common.edit'))}</button><button data-id="${field.id}" class="btn-delete" style="color:var(--error-text);background:none;border:none;cursor:pointer">${escapeHtml(t('common.delete'))}</button>`
          const optionsInfo =
            ['dropdown', 'multiselect'].includes(field.field_type) && field.options
              ? ` <span title="${escapeHtml(field.options.join('\n'))}" style="color:var(--text-muted);cursor:help;font-size:0.8rem">(${field.options.length})</span>`
              : ''
          return `
            <tr style="${isPluginManaged ? 'background:var(--bg-soft);opacity:0.85' : ''}">
              <td><span class="fm-pill" style="text-transform:capitalize">${escapeHtml(field.target_type)}</span></td>
              <td style="font-family:monospace;color:var(--accent-2)">${escapeHtml(field.key)}</td>
              <td>${escapeHtml(field.label)}</td>
              <td><span class="fm-pill">${escapeHtml(fieldTypeLabel(field.field_type))}</span>${optionsInfo}</td>
              <td style="color:var(--text-muted)">${escapeHtml(formatExtraFieldDefaultValue(field))}</td>
              <td style="color:var(--text-muted)">${field.source ? escapeHtml(field.source) : '—'}</td>
              <td style="text-align:right">${actions}</td>
            </tr>`
        })
        .join('')

      tbody.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach(button => {
        button.addEventListener('click', () => {
          const field = fields.find(item => item.id === Number(button.dataset.id))
          if (field) openEditDialog(field)
        })
      })
      tbody.querySelectorAll<HTMLButtonElement>('.btn-delete').forEach(button => {
        button.addEventListener('click', async () => {
          const dialogWindow = window as unknown as ExtraFieldAdminWindow
          if (!(await dialogWindow.__fmConfirm(t('admin.deleteFieldConfirm')))) return
          const response = await fetch(`/api/v1/system-extra-fields/${button.dataset.id}`, {
            method: 'DELETE',
            headers: { 'X-CSRF-Token': getCsrfToken() },
            credentials: 'include',
            signal: getAbortSignal(),
          })
          if (!response.ok) {
            const data = await response.json()
            void dialogWindow.__fmAlert(
              data.detail || t('admin.failedDeleteField'),
            )
            return
          }
          await loadData()
        })
      })
    }

    async function loadData(): Promise<void> {
      try {
        const response = await fetch('/api/v1/system-extra-fields', {
          credentials: 'include',
          signal: getAbortSignal(),
        })
        if (!response.ok) throw new Error('Failed to fetch fields')
        fields = await response.json()
        renderFields()
      } catch (error) {
        if (!isAbortError(error)) console.error('Failed to load data:', error)
      }
    }

    document.getElementById('btn-new')?.addEventListener('click', openCreateDialog)
    await loadData()
  </script>
</Layout>
