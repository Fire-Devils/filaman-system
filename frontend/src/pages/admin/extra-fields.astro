    document.getElementById('ref-search')?.addEventListener('input', (e) => {
      const target = (document.getElementById('formula-field-target') as HTMLSelectElement).value
      renderFieldReferences(target, (e.target as HTMLInputElement).value)
    })

    // Field references collapse toggle
    const FIELD_REFS_KEY = 'filaman_formula_field_refs_collapsed'
    function applyFieldRefsState(collapsed: boolean) {
      const body = document.getElementById('field-refs-body')!
      const chevron = document.getElementById('field-refs-chevron')!
      body.style.display = collapsed ? 'none' : ''
      chevron.innerHTML = collapsed ? '&#9654;' : '&#9660;'
    }
    document.getElementById('btn-toggle-field-refs')?.addEventListener('click', () => {
      const next = localStorage.getItem(FIELD_REFS_KEY) !== 'true'
      localStorage.setItem(FIELD_REFS_KEY, String(next))
      applyFieldRefsState(next)
    })
    applyFieldRefsState(localStorage.getItem(FIELD_REFS_KEY) === 'true')

    // Format JSON
    document.getElementById('btn-format-json')?.addEventListener('click', () => {
      const raw = getFormulaJson()
      try {
        setFormulaJson(JSON.stringify(JSON.parse(raw), null, 2))
      } catch { /* leave as-is on invalid JSON */ }
    })

    // Preview
    document.getElementById('btn-preview')?.addEventListener('click', async () => {
      const formulaRaw = getFormulaJson()
      const contextRaw = (document.getElementById('formula-preview-context') as HTMLTextAreaElement).value.trim()
      const previewDiv = document.getElementById('formula-preview-result')!

      let formula: any
      let context: any = {}
      try {
        formula = JSON.parse(formulaRaw)
      } catch {
        previewDiv.textContent = '✗ Invalid JSON in formula'
        previewDiv.style.color = 'var(--error-text)'
        previewDiv.style.display = 'block'
        return
      }
      if (contextRaw) {
        try { context = JSON.parse(contextRaw) } catch {
          previewDiv.textContent = '✗ Invalid JSON in sample context'
          previewDiv.style.color = 'var(--error-text)'
          previewDiv.style.display = 'block'
          return
        }
      }

      try {
        const res = await fetch('/api/v1/system-extra-fields/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ formula, context }),
          signal: getAbortSignal(),
        })
        const data = await res.json()
        if (data.error) {
          previewDiv.textContent = `✗ Error: ${data.error}`
          previewDiv.style.color = 'var(--error-text)'
        } else {
          previewDiv.textContent = `✓ Result: ${JSON.stringify(data.result)}`
          previewDiv.style.color = 'var(--success-text, var(--accent))'
        }
        previewDiv.style.display = 'block'
      } catch (err: any) {
        if (isAbortError(err)) return
        previewDiv.textContent = `✗ Request failed: ${err.message}`
        previewDiv.style.color = 'var(--error-text)'
        previewDiv.style.display = 'block'
      }
    })

    // Form submit
    document.getElementById('formula-modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()

      const editId = (document.getElementById('formula-field-id') as HTMLInputElement).value
      const isEdit = !!editId

      let formula: any
      try {
        formula = JSON.parse(getFormulaJson())
      } catch {
        const error = document.getElementById('formula-modal-error') as HTMLDivElement
        error.textContent = 'Formula is not valid JSON'
        error.classList.remove('hidden')
        return
      }

      const body: Record<string, any> = {
        formula,
        field_type: 'formula',
        label: (document.getElementById('formula-field-label') as HTMLInputElement).value,
        show_in_detail: (document.getElementById('formula-show-detail') as HTMLInputElement).checked,
        show_in_template: (document.getElementById('formula-show-template') as HTMLInputElement).checked,
        include_in_api: (document.getElementById('formula-include-api') as HTMLInputElement).checked,
      }
      if (!isEdit) {
        body.target_type = (document.getElementById('formula-field-target') as HTMLSelectElement).value
        body.key = (document.getElementById('formula-field-key') as HTMLInputElement).value
      }

      const error = document.getElementById('formula-modal-error') as HTMLDivElement
      const submitBtn = document.getElementById('formula-modal-submit') as HTMLButtonElement
      error.classList.add('hidden')
      submitBtn.disabled = true
      submitBtn.textContent = t('common.saving')

      try {
        const url = isEdit
          ? `/api/v1/system-extra-fields/${editId}`
          : '/api/v1/system-extra-fields'
        const response = await fetch(url, {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify(body),
          signal: getAbortSignal(),
        })
        if (!response.ok) {
          const data = await response.json()
          throw new Error(apiErrorMessage(data, 'Failed to save formula field'))
        }
        closeFormulaModal()
        loadData()
      } catch (err: any) {
        if (isAbortError(err)) return
        error.textContent = err.message
        error.classList.remove('hidden')
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = t('common.save')
      }
    })

    document.getElementById('btn-new')?.addEventListener('click', openCreateDialog)
    loadData()
  </script>
</Layout>
