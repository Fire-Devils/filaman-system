---
import Layout from '../../layouts/Layout.astro'
import AdminHeader from '../../components/AdminHeader.astro'
import FormSection from '../../components/FormSection.astro'
---

<Layout title="FilaMan - System Extra Fields">
  <div class="fm-admin-page fm-admin-page-wide">
  <AdminHeader titleKey="admin.extraFieldsTitle" title="System Extra Fields">
    <button id="btn-new" class="fm-btn fm-btn-primary" data-i18n="admin.addField">Add Field</button>
  </AdminHeader>
  <div class="fm-list-toolbar">
    <input id="fields-search" type="search" class="fm-input" data-i18n-placeholder="admin.extraFieldsSearch" data-i18n-aria-label="admin.extraFieldsSearch" aria-label="Search fields" placeholder="Search fields" style="max-width:24rem" />
    <button id="fields-clear" type="button" class="fm-btn fm-btn-outline" data-i18n="common.clearColumnFilters">Clear column filters</button>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 24px;" data-i18n="admin.extraFieldsHint">
    These fields will be automatically added to all filaments or spools.
  </p>

  <div class="fm-card fm-table-scroll" style="padding: 0;">
    <table id="fields-list" class="fm-table fm-admin-table">
      <thead>
        <tr>
          <th data-i18n="admin.targetType" data-sort="target_type" class="col-target_type">Target Type</th>
          <th data-i18n="admin.keyJson" data-sort="key" class="col-key">Key (JSON)</th>
          <th data-i18n="admin.displayLabel" data-sort="label" class="col-label">Label</th>
          <th data-i18n="admin.fieldType" data-sort="field_type" class="col-field_type">Type</th>
          <th data-i18n="admin.defaultValue" data-sort="default_value" class="col-default_value">Default Value</th>
          <th data-i18n="admin.source" data-sort="source" class="col-source">Source</th>
          <th data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="fields-table">
        <tr>
          <td colspan="7" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div style="margin-top:16px">
    <FormSection titleKey="admin.pluginManagedFields" title="Plugin-managed fields">
      <p class="fm-field-hint" data-i18n="admin.pluginManagedFieldsHint">These definitions belong to plugins. Manage them through the owning plugin; their values remain available on linked records.</p>
    <div class="fm-table-scroll"><table id="managed-fields-list" class="fm-table fm-admin-table">
      <thead>
        <tr>
          <th data-i18n="admin.targetType" data-sort="target_type" class="col-target_type">Target Type</th>
          <th data-i18n="admin.keyJson" data-sort="key" class="col-key">Key (JSON)</th>
          <th data-i18n="admin.displayLabel" data-sort="label" class="col-label">Label</th>
          <th data-i18n="admin.fieldType" data-sort="field_type" class="col-field_type">Type</th>
          <th data-i18n="admin.defaultValue" data-sort="default_value" class="col-default_value">Default Value</th>
          <th data-i18n="admin.source" data-sort="source" class="col-source">Source</th>
          <th data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="managed-fields-table">
        <tr>
          <td colspan="7" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table></div>
    </FormSection>
  </div>
  </div>
  <script>
    import { tableAction } from '../../lib/table-actions'
    import { initHeaderColumnFilters, matchesColumnFilter, syncHeaderSortButtons, type ColumnFilterValue, type HeaderFilterController } from '../../lib/table-column-filters'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import {
      createExtraFieldDefinitionDialog,
      type ExtraFieldDefinitionDialogDraft,
      type ExtraFieldDefinitionDialogResult,
    } from '../../lib/extra-field-definition-dialog'
    import {
      escapeHtml,
      formatExtraFieldDefaultValue,
    } from '../../lib/extra-fields'
    import { initI18n, t } from '../../lib/i18n'

    await initI18n()

    interface SystemExtraFieldRecord {
      id: number
      target_type: 'filament' | 'spool'
      key: string
      label: string
      default_value: string | null
      field_type: string
      options: string[] | null
      config: {
        unit?: string
        decimal_places?: number | null
        min_bound?: number | null
        max_bound?: number | null
        max_length?: number | null
      } | null
      source: string | null
    }

    type ExtraFieldAdminWindow = Window & {
      __fmAlert: (message: string) => Promise<boolean>
      __fmConfirm: (message: string) => Promise<boolean>
    }

    let fields: SystemExtraFieldRecord[] = []
    const editableRichFieldTypes = new Set([
      'text',
      'number',
      'range',
      'dropdown',
      'multiselect',
      'checkbox',
      'date',
      'datetime',
      'url',
      'textarea',
    ])

    const fieldDialog = createExtraFieldDefinitionDialog({ mode: 'system' })

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function fieldTypeLabel(fieldType: string): string {
      const normalized = fieldType === 'float' ? 'number' : fieldType
      const translated = t(`admin.fieldType_${normalized}`)
      return translated === `admin.fieldType_${normalized}`
        ? normalized || t('admin.fieldType_text')
        : translated
    }

    function targetTypeLabel(targetType: SystemExtraFieldRecord['target_type']): string {
      return t(`admin.targetType_${targetType}`)
    }

    function draftFromField(
      field?: SystemExtraFieldRecord,
    ): ExtraFieldDefinitionDialogDraft {
      const config = field?.config ?? {}
      return {
        targetType: field?.target_type ?? 'filament',
        key: field?.key ?? '',
        label: field?.label ?? '',
        fieldType: field?.field_type ?? 'text',
        options: field?.options ? [...field.options] : [],
        unit: config.unit ?? '',
        decimalPlaces: config.decimal_places == null ? '' : String(config.decimal_places),
        minBound: config.min_bound == null ? '' : String(config.min_bound),
        maxBound: config.max_bound == null ? '' : String(config.max_bound),
        maxLength: config.max_length == null ? '' : String(config.max_length),
        defaultValue: field?.default_value ?? null,
      }
    }

    function configFromResult(result: ExtraFieldDefinitionDialogResult): Record<string, unknown> | null {
      const config: Record<string, unknown> = {}
      if (['number', 'range'].includes(result.fieldType)) {
        if (result.unit.trim()) config.unit = result.unit.trim()
        if (result.decimalPlaces !== '') config.decimal_places = Number(result.decimalPlaces)
        if (result.minBound !== '') config.min_bound = Number(result.minBound)
        if (result.maxBound !== '') config.max_bound = Number(result.maxBound)
      } else if (result.fieldType === 'textarea' && result.maxLength !== '') {
        config.max_length = Number(result.maxLength)
      }
      return Object.keys(config).length ? config : null
    }

    async function saveField(
      result: ExtraFieldDefinitionDialogResult,
      existing?: SystemExtraFieldRecord,
    ): Promise<void> {
      const isEdit = Boolean(existing)
      const body: Record<string, unknown> = {
        label: result.label.trim(),
        default_value: result.defaultValue,
      }
      if (!existing) {
        body.target_type = result.targetType
        body.key = result.key.trim()
        body.field_type = result.fieldType
        body.options = ['dropdown', 'multiselect'].includes(result.fieldType)
          ? result.options
          : null
        body.config = configFromResult(result)
      } else if (editableRichFieldTypes.has(existing.field_type)) {
        body.options = ['dropdown', 'multiselect'].includes(existing.field_type)
          ? result.options
          : null
        body.config = configFromResult({
          ...result,
          fieldType: existing.field_type,
        })
      }
      const response = await fetch(
        existing
          ? `/api/v1/system-extra-fields/${existing.id}`
          : '/api/v1/system-extra-fields',
        {
          method: isEdit ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify(body),
          signal: getAbortSignal(),
        },
      )
      if (!response.ok) {
        const data = await response.json()
        if (data.detail?.code === 'incompatible_existing_values') {
          throw new Error(t('admin.incompatibleExistingValues', {
            count: data.detail.incompatible_count,
            target: data.detail.target_type,
            type: fieldTypeLabel(data.detail.field_type),
          }))
        }
        throw new Error(
          data.detail?.message
          || data.detail
          || data.message
          || (isEdit ? 'Failed to update field' : 'Failed to create field'),
        )
      }
      await loadData()
    }

    function openCreateDialog(): void {
      fieldDialog.open({
        title: t('admin.addField'),
        draft: draftFromField(),
        onSubmit: result => saveField(result),
      })
    }

    function openEditDialog(field: SystemExtraFieldRecord): void {
      fieldDialog.open({
        title: t('admin.editField'),
        draft: draftFromField(field),
        lockIdentity: true,
        lockType: true,
        onSubmit: result => saveField(result, field),
      })
    }

    const tables = ['fields-list', 'managed-fields-list'].map(id => document.getElementById(id) as HTMLTableElement)
    const filterKeys = ['target_type', 'key', 'label', 'field_type', 'default_value', 'source'] as const
    let sortKey: typeof filterKeys[number] = 'label'
    let sortDirection: 'asc' | 'desc' = 'asc'
    let filters: Record<string, ColumnFilterValue> = {}
    const controllers: HeaderFilterController[] = []
    function fieldValue(field: SystemExtraFieldRecord, key: string): string {
      if (key === 'target_type') return targetTypeLabel(field.target_type)
      if (key === 'field_type') return fieldTypeLabel(field.field_type)
      if (key === 'default_value') return field.default_value ? formatExtraFieldDefaultValue(field) : ''
      return String(field[key as keyof SystemExtraFieldRecord] ?? '')
    }
    function renderFields(): void {
      const search = (document.getElementById('fields-search') as HTMLInputElement).value.toLocaleLowerCase().trim()
      const visible = fields.filter(field => filterKeys.some(key => fieldValue(field, key).toLocaleLowerCase().includes(search))
        && Object.entries(filters).every(([key, value]) => matchesColumnFilter(fieldValue(field, key), value)))
        .sort((a, b) => (sortDirection === 'asc' ? 1 : -1) * fieldValue(a, sortKey).localeCompare(fieldValue(b, sortKey), undefined, { numeric: true }))
      for (const [index, table] of tables.entries()) {
        syncHeaderSortButtons(table, sortKey, sortDirection)
        const tbody = table.tBodies[0]
        const rows = visible.filter(field => Boolean(field.source) === Boolean(index))
        tbody.innerHTML = rows.length ? rows
        .map(field => {
          const isPluginManaged = Boolean(field.source)
          const actions = isPluginManaged
            ? `<a class="fm-admin-back" href="/admin/system" title="${escapeHtml(t('admin.pluginManagedField'))}">${escapeHtml(t('admin.pluginManagedField'))}</a>`
            : `<span class="fm-row-actions">${tableAction('edit', { id: field.id })}${tableAction('delete', { id: field.id })}</span>`
          const optionsInfo =
            ['dropdown', 'multiselect'].includes(field.field_type) && field.options
              ? ` <span title="${escapeHtml(field.options.join('\n'))}" style="color:var(--text-muted);cursor:help;font-size:0.8rem">(${field.options.length})</span>`
              : ''
          return `
            <tr>
              <td><span class="fm-pill">${escapeHtml(targetTypeLabel(field.target_type))}</span></td>
              <td style="font-family:monospace;color:var(--accent-2)">${escapeHtml(field.key)}</td>
              <td>${escapeHtml(field.label)}</td>
              <td><span class="fm-pill">${escapeHtml(fieldTypeLabel(field.field_type))}</span>${optionsInfo}</td>
              <td style="color:var(--text-muted)">${escapeHtml(formatExtraFieldDefaultValue(field))}</td>
              <td style="color:var(--text-muted)">${field.source ? `<a href="/admin/system" style="color:var(--accent)">${escapeHtml(field.source)}</a>` : '—'}</td>
              <td>${actions}</td>
            </tr>`
        })
        .join('') : `<tr><td colspan="7">${escapeHtml(t('admin.noFieldsDefined'))}</td></tr>`
      }
      const tbody = document.getElementById('fields-table')!
      tbody.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach(button => {
        button.addEventListener('click', () => {
          const field = fields.find(item => item.id === Number(button.dataset.id))
          if (field) openEditDialog(field)
        })
      })
      tbody.querySelectorAll<HTMLButtonElement>('.btn-delete').forEach(button => {
        button.addEventListener('click', async () => {
          const dialogWindow = window as unknown as ExtraFieldAdminWindow
          if (!(await dialogWindow.__fmConfirm(t('admin.deleteFieldConfirm')))) return
          try {
            const response = await fetch(`/api/v1/system-extra-fields/${button.dataset.id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              signal: getAbortSignal(),
            })
            if (!response.ok) {
              const data = await response.json()
              void dialogWindow.__fmAlert(
                data.detail || t('admin.failedDeleteField'),
              )
              return
            }
            await loadData()
          } catch (error) {
            if (!isAbortError(error)) {
              void dialogWindow.__fmAlert(t('common.networkError'))
            }
          }
        })
      })
    }

    async function loadData(): Promise<void> {
      try {
        const response = await fetch('/api/v1/system-extra-fields', {
          credentials: 'include',
          signal: getAbortSignal(),
        })
        if (!response.ok) throw new Error('Failed to fetch fields')
        fields = await response.json()
        renderFields()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load data:', error)
        const tbody = document.getElementById('fields-table')!
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center;color:var(--error-text)">
              ${escapeHtml(t('admin.failedLoadFields'))}
              <button type="button" class="fm-btn" id="retry-fields" style="margin-left:8px">${escapeHtml(t('common.retry'))}</button>
            </td>
          </tr>`
        document.getElementById('retry-fields')?.addEventListener('click', () => {
          void loadData()
        })
      }
    }

    for (const table of tables) {
      controllers.push(initHeaderColumnFilters(table, filterKeys.map(key => ({
        key, label: table.querySelector<HTMLElement>(`.col-${key}`)!.textContent || key,
        columnSelector: `.col-${key}`, type: 'text' as const,
        onApply(value: ColumnFilterValue) {
          filters[key] = value
          for (const controller of controllers) controller.setValue(key, value)
          renderFields()
        },
      }))))
      table.tHead!.addEventListener('click', event => {
        const header = (event.target as HTMLElement).closest<HTMLElement>('th[data-sort]')
        if (!header) return
        const key = header.dataset.sort as typeof sortKey
        sortDirection = key === sortKey && sortDirection === 'asc' ? 'desc' : 'asc'
        sortKey = key
        renderFields()
      })
    }
    document.getElementById('fields-search')!.addEventListener('input', renderFields)
    document.getElementById('fields-clear')!.addEventListener('click', () => {
      filters = {}
      controllers.forEach(controller => controller.resetAll())
      ;(document.getElementById('fields-search') as HTMLInputElement).value = ''
      renderFields()
    })
    document.getElementById('btn-new')?.addEventListener('click', openCreateDialog)
    await loadData()
  </script>
</Layout>
