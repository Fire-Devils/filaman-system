    // Load SystemExtraFields for filaments and add as dynamic column group
    async function loadFilamentExtraFieldColumns() {
      try {
        const res = await fetch('/api/v1/system-extra-fields?target_type=filament', { credentials: 'include', signal: getAbortSignal() })
        if (!res.ok) return
        const definitions: SystemExtraFieldDef[] = await res.json()
        const fields = definitions.filter(field => !isIntegrationExtraFieldPath(field.key))
        if (isMissingExtraFieldSort(sortKey, fields)) {
          sortKey = null
          sortDirection = null
          localStorage.removeItem(sortStorageKey)
        }
        if (fields.length === 0) return
        filamentExtraFields = fields
        const extraGroup: ColumnGroup = {
          heading: t('common.columnsExtraFields'),
          columns: fields.map(f => ({ key: `cf_${f.key}`, label: f.label })),
        }
        filPicker.updateGroups([...filColumnGroups, extraGroup])
        // Add dynamic <th> headers for extra fields
        const headerRow = document.querySelector('.fm-table thead tr')
        if (headerRow) {
          fields.forEach(f => {
            headerRow.appendChild(createSortableColumnHeader(`cf_${f.key}`, f.label))
          })
        }
        // Refresh column reorder to include new extra field columns
        filReorder.refreshColumns()
        filResize.refreshColumns()
      } catch (e) {
        if (isAbortError(e)) return
        console.error('Failed to load filament extra field columns:', e)
      }
    }
    // ── End Column Visibility ──────────────────────────────────────────

    setupSortableHeaders()
    // Restore group checkbox from saved state
    if (savedFilterState?.group) {
      (document.getElementById('filter-group') as HTMLInputElement).checked = true
      updateFilterResets()
    }
    Promise.all([initCurrency(), loadFilamentExtraFieldColumns()])
      .then(() => {
        setupHeaderFilters()
        return Promise.all([populateFilterDropdowns(), populateSpoolStatusDropdown()])
      })
      .then(() => loadFilaments())

    window.addEventListener('pageshow', event => {
      if (event.persisted) void loadFilaments()
    })
    // Live-Update via SSE: Filamente automatisch neu laden
    let _filamentsReloadTimer: ReturnType<typeof setTimeout> | null = null
    window.addEventListener('filaman:data-changed', (e: Event) => {
      const { event } = (e as CustomEvent).detail ?? {}
      if (event === 'filaments_changed' || event === 'spools_changed' || event === 'manufacturers_changed' || event === 'colors_changed') {
        invalidateCache(CACHE_KEYS.FILAMENT_FILTER_OPTIONS)
        if (compactPicker && (event === 'filaments_changed' || event === 'manufacturers_changed')) {
          invalidatePickerRows()
          void refreshPickerSelection()
        }
        if (_filamentsReloadTimer) clearTimeout(_filamentsReloadTimer)
        _filamentsReloadTimer = setTimeout(async () => {
          await populateFilterDropdowns()
          await loadFilaments()
        }, 300)
      }
    })

    // ── Bulk Selection & Actions ──────────────────────────────
    const hooks = document.querySelector<HTMLElement>('[data-filament-plugin-hooks]')
    if (!compactPicker && !selectForSpool && hooks) mountFilamentPluginHooks(hooks, {
      mode: 'selection', selectedIds: selectedFilamentIds, expectedFilaments: selectedPickerFilaments,
    })

    const selectionLimit = compactPicker ? 50 : Infinity
    function setFilamentSelected(id: number, checked: boolean): boolean {
      if (checked && selectedFilamentIds.size < selectionLimit && !selectedFilamentIds.has(id)) {
        if (!selectForSpool) {
          const filament = filamentList.get(id)
          if (!filament) return false
          const { manufacturer_id, designation, material_type, record_token } = filament
          selectedPickerFilaments.set(id, { id, manufacturer_id, designation, material_type, record_token })
        }
        selectedFilamentIds.add(id)
      } else if (!checked) {
        selectedFilamentIds.delete(id)
        selectedPickerFilaments.delete(id)
      }
      return selectedFilamentIds.has(id)
    }

    function updateBulkBar() {
      if (selectForSpool) return
      const bar = document.getElementById('bulk-action-bar')!
      const countEl = document.getElementById('bulk-count')!
      const selectAllCb = document.getElementById('bulk-select-all') as HTMLInputElement
      countEl.textContent = t('filaments.bulkSelected', { count: selectedFilamentIds.size })
      bar.classList.toggle('visible', !compactPicker && selectedFilamentIds.size > 0)
      // Update select-all checkbox state
      const visibleCheckboxes = document.querySelectorAll<HTMLInputElement>('#filaments-table tr:not([hidden]) input.bulk-checkbox[data-filament-id]')
      const visibleIds = Array.from(visibleCheckboxes, cb => Number(cb.dataset.filamentId))
      const allChecked = visibleIds.length > 0 && visibleIds.every(id => selectedFilamentIds.has(id))
      const someChecked = visibleIds.some(id => selectedFilamentIds.has(id))
      const atLimit = selectedFilamentIds.size >= selectionLimit
      selectAllCb.disabled = visibleIds.length === 0 || (atLimit && !someChecked)
      selectAllCb.checked = allChecked
      selectAllCb.indeterminate = someChecked && !allChecked
      const label = allChecked || (atLimit && someChecked) ? 'filaments.deselectLoaded' : 'filaments.selectLoaded'
      selectAllCb.dataset.i18nAriaLabel = label
      selectAllCb.setAttribute('aria-label', t(label))
      if (compactPicker) {
        document.getElementById('picker-selection-count')!.textContent =
          t('filaments.pickerSelected', { count: selectedFilamentIds.size, limit: selectionLimit })
        visibleCheckboxes.forEach(cb => { cb.disabled = atLimit && !cb.checked })
      }
    }

    function toggleFilamentSelection(id: number, checked: boolean) {
      if (selectForSpool) return
      const checkbox = document.querySelector<HTMLInputElement>(`#filaments-table input.bulk-checkbox[data-filament-id="${id}"]`)
      const selected = setFilamentSelected(id, checked)
      if (checkbox) checkbox.checked = selected
      checkbox?.closest('tr')?.classList.toggle('bulk-selected', selected)
      publishSelection()
    }

    ;(window as typeof window & { __toggleFilamentSelection: typeof toggleFilamentSelection }).__toggleFilamentSelection = toggleFilamentSelection

    function publishSelection(inventoryChanged = false) {
      updateBulkBar()
      if (compactPicker && window.parent !== window) {
        window.parent.postMessage({
          type: 'filaman:filament-picker-selection',
          filament_ids: [...selectedFilamentIds],
          expected_filaments: [...selectedPickerFilaments.values()],
          inventory_changed: inventoryChanged,
        }, location.origin)
      }
    }

    function reconcilePickerSelection(items: Filament[], checkedSelection?: typeof selectedPickerFilaments) {
      const current = new Map(items.map(filament => [filament.id, filament]))
      let changed = false
      for (const expected of (checkedSelection ?? selectedPickerFilaments).values()) {
        if (selectedPickerFilaments.get(expected.id) !== expected) continue
        const filament = current.get(expected.id)
        if (!filament && !checkedSelection) continue
        if (filament && filament.record_token === expected.record_token &&
            filament.manufacturer_id === expected.manufacturer_id &&
            filament.designation === expected.designation && filament.material_type === expected.material_type) continue
        setFilamentSelected(expected.id, false)
        const checkbox = document.querySelector<HTMLInputElement>(`#filaments-table input[data-filament-id="${expected.id}"]`)
        if (checkbox) checkbox.checked = false
        checkbox?.closest('tr')?.classList.remove('bulk-selected')
        changed = true
      }
      if (changed) publishSelection(true)
    }

    async function refreshPickerSelection() {
      if (!selectedPickerFilaments.size) return
      const selected = new Map(selectedPickerFilaments)
      const params = new URLSearchParams({ include_record_token: 'true', page_size: String(selectionLimit) })
      for (const id of selected.keys()) params.append('filament_id', String(id))
      try {
        const response = await fetch(`/api/v1/filaments?${params}`, { credentials: 'include', signal: getAbortSignal() })
        if (!response.ok) return
        const { items }: { items: Filament[] } = await response.json()
        reconcilePickerSelection(items, selected)
      } catch (error) {
        if (!isAbortError(error)) console.error('Failed to refresh picker selection:', error)
      }
    }

    function clearPickerSelection() {
      selectedFilamentIds.clear()
      selectedPickerFilaments.clear()
      for (const checkbox of document.querySelectorAll<HTMLInputElement>('#filaments-table input.bulk-checkbox:checked')) {
        checkbox.checked = false
        checkbox.closest('tr')?.classList.remove('bulk-selected')
      }
      publishSelection()
    }

    function invalidatePickerRows() {
      filamentList.pause()
      document.getElementById('filaments-table')!.innerHTML =
        `<tr><td colspan="34" style="text-align: center;">${t('common.loading')}</td></tr>`
      updateBulkBar()
    }

    if (compactPicker && window.parent !== window) {
      window.addEventListener('message', event => {
        if (event.source !== window.parent || event.origin !== location.origin ||
            event.data?.type !== 'filaman:filament-picker-clear-selection') return
        if (event.data.refresh === true) invalidatePickerRows()
        clearPickerSelection()
        if (event.data.refresh === true) void loadFilaments()
      })
    }

    // Select all checkbox
    document.getElementById('bulk-select-all')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked && selectedFilamentIds.size < selectionLimit
      const visibleCheckboxes = document.querySelectorAll<HTMLInputElement>('#filaments-table tr:not([hidden]) input.bulk-checkbox[data-filament-id]')
      visibleCheckboxes.forEach(cb => {
        const id = Number(cb.dataset.filamentId)
        cb.checked = setFilamentSelected(id, checked)
        cb.closest('tr')?.classList.toggle('bulk-selected', cb.checked)
      })
      publishSelection()
    })

    // Generic bulk prompt modal
    function openBulkPrompt(title: string, contentHtml: string): Promise<string | null> {
      const modal = document.getElementById('bulk-prompt-modal')!
      const titleEl = document.getElementById('bulk-prompt-title')!
      const contentEl = document.getElementById('bulk-prompt-content')!
      titleEl.textContent = title
      contentEl.innerHTML = contentHtml
      modal.classList.add('open')
      translatePage()
      return new Promise((resolve) => {
        function cleanup() {
          modal.classList.remove('open')
          okBtn.removeEventListener('click', onOk)
          cancelBtn.removeEventListener('click', onCancel)
          modal.removeEventListener('click', onOverlay)
        }
        function onOk() {
          const input = contentEl.querySelector('select, input') as HTMLInputElement | HTMLSelectElement | null
          cleanup()
          resolve(input ? input.value : '')
        }
        function onCancel() {
          cleanup()
          resolve(null)
        }
        function onOverlay(e: Event) {
          if (e.target === modal) { cleanup(); resolve(null) }
        }
        const okBtn = document.getElementById('bulk-prompt-ok')!
        const cancelBtn = document.getElementById('bulk-prompt-cancel')!
        okBtn.addEventListener('click', onOk)
        cancelBtn.addEventListener('click', onCancel)
        modal.addEventListener('click', onOverlay)
      })
    }

    async function bulkPatch(body: Record<string, unknown>) {
      const count = selectedFilamentIds.size
      try {
        const res = await fetch('/api/v1/filaments/bulk', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ filament_ids: [...selectedFilamentIds], ...body }),
          signal: getAbortSignal(),
        })
        if (!res.ok) throw new Error('API error')
        await dialogWindow.__fmSuccess(t('filaments.bulkSuccess', { count }))
        selectedFilamentIds.clear()
        selectedPickerFilaments.clear()
        updateBulkBar()
        loadFilaments()
      } catch {
        dialogWindow.__fmAlert(t('filaments.bulkError'))
      }
    }

    // Print Labels
    document.getElementById('bulk-btn-print')?.addEventListener('click', () => {
      if (selectedFilamentIds.size === 0) return
      const ids = [...selectedFilamentIds].join(',')
      window.location.href = `/filaments/print?ids=${ids}`
    })

    // Delete
    document.getElementById('bulk-btn-delete')?.addEventListener('click', async () => {
      const count = selectedFilamentIds.size
      if (count === 0) return
      const result = await dialogWindow.__fmConfirm(
        t('filaments.bulkConfirmDelete', { count }),
        {
          title: t('filaments.bulkDelete'),
          okLabel: t('filaments.bulkDelete'),
          isDanger: true,
          checkbox: { label: t('filaments.bulkConfirmDeleteForce', { count }), checked: false }
        }
      )
      if (!result.confirmed) return
      try {
        const res = await fetch('/api/v1/filaments/bulk', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ filament_ids: [...selectedFilamentIds], force: result.checked }),
          signal: getAbortSignal(),
        })
        if (!res.ok) throw new Error('API error')
        await dialogWindow.__fmSuccess(t('filaments.bulkDeleteSuccess', { count }))
        selectedFilamentIds.clear()
        selectedPickerFilaments.clear()
        updateBulkBar()
        loadFilaments()
      } catch {
        dialogWindow.__fmAlert(t('filaments.bulkError'))
      }
    })

    // Set Price
    document.getElementById('bulk-btn-price')?.addEventListener('click', async () => {
      if (selectedFilamentIds.size === 0) return
      const value = await openBulkPrompt(
        t('filaments.bulkSetPrice'),
        `<input type="number" class="fm-input" style="width: 100%;" min="0" step="0.01" value="0" />`
      )
      if (value === null) return
      await bulkPatch({ price: Number(value) })
    })

    // Set Diameter
    document.getElementById('bulk-btn-diameter')?.addEventListener('click', async () => {
      if (selectedFilamentIds.size === 0) return
      const value = await openBulkPrompt(
        t('filaments.bulkSetDiameter'),
        `<input type="number" class="fm-input" style="width: 100%;" min="0" step="0.01" value="1.75" />`
      )
      if (value === null) return
      await bulkPatch({ diameter_mm: Number(value) })
    })

    // Set Spool Weight
    document.getElementById('bulk-btn-spool-weight')?.addEventListener('click', async () => {
      if (selectedFilamentIds.size === 0) return
      const value = await openBulkPrompt(
        t('filaments.bulkSetSpoolWeight'),
        `<input type="number" class="fm-input" style="width: 100%;" min="0" step="0.1" value="0" />`
      )
      if (value === null) return
      await bulkPatch({ default_spool_weight_g: Number(value) })
    })

    // Set Density
    document.getElementById('bulk-btn-density')?.addEventListener('click', async () => {
      if (selectedFilamentIds.size === 0) return
      const value = await openBulkPrompt(
        t('filaments.bulkSetDensity'),
        `<input type="number" class="fm-input" style="width: 100%;" min="0" step="0.01" value="1.24" />`
      )
      if (value === null) return
      await bulkPatch({ density_g_cm3: Number(value) })
    })
  </script>
</Layout>
