    function applyColumnFilter(key: string, value: ColumnFilterValue, urlParam?: string) {
      if (isColumnFilterActive(value)) columnFilters[key] = value
      else delete columnFilters[key]
      if (urlParam) removeFilterUrlParams(urlParam)
      if (filterRenderQueued) return
      filterRenderQueued = true
      queueMicrotask(() => {
        filterRenderQueued = false
        applyFiltersAndRender()
      })
    }

    function removeFilterUrlParams(...keys: string[]) {
      const url = new URL(window.location.href)
      let changed = false
      keys.forEach((key) => {
        if (url.searchParams.has(key)) {
          url.searchParams.delete(key)
          changed = true
        }
      })
      if (changed) window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`)
    }

