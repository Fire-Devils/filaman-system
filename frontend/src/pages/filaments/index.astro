---
import Layout from '../../layouts/Layout.astro'
import InventoryLoadMore from '../../components/InventoryLoadMore.astro'
import InventoryFilterReset from '../../components/InventoryFilterReset.astro'
import FilamentPluginHooks from '../../components/FilamentPluginHooks.astro'

interface Props { compactPicker?: boolean }
const { compactPicker = false } = Astro.props
---

<Layout title="FilaMan - Filaments" embedded={compactPicker}>
  <style>
    :global(#fm-page:has([data-filament-picker])) { grid-template-columns: minmax(0, 1fr); }
    :global(#fm-page:has([data-filament-picker]) > .fm-main) { padding: 0; }
    :global(#fm-page:has([data-filament-picker]) :is(.fm-sidebar, .fm-sidebar-backdrop, .fm-list-toolbar, #bulk-action-bar)) { display: none !important; }
    :global([data-filament-picker]:not([data-manufacturer-hidden]) .fm-picker-manufacturer) { display: none; }
    :global(.fm-picker-manufacturer) { color: var(--text-muted); font-size: 0.85rem; }
    #picker-selection-count { color: var(--text-muted); font-size: 0.85rem; margin-block: 0 8px; }
    .spool-selection-only[hidden] { display: none; }
    :global(.filament-spool-select) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      color: var(--text-muted);
      vertical-align: middle;
    }
    :global(.filament-spool-select:hover) { color: var(--text); }
    :global(.filament-spool-select:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
    :global(.filament-spool-select:active) { color: var(--success-text); background: var(--success-bg); }
  </style>
  <a id="spool-selection-back" href="/spools" class="fm-admin-back spool-selection-only" hidden>&larr; <span data-i18n="spools.backToSpools">Back to Spools</span></a>
  <div class="fm-list-toolbar">
    <h1 data-i18n="filaments.title">Filaments</h1>
    <div class="fm-list-controls">
      <a href="/filaments/colors" class="fm-btn fm-btn-outline" data-i18n="filaments.manageColors">
        Manage Colors
      </a>
      <a id="spool-selection-import" href="/spools/new?from_tag=1" class="fm-btn fm-btn-outline spool-selection-only" hidden data-i18n="spools.importFromTag">Import from Tag</a>
      <a id="add-filament" href="/filaments/new" class="fm-btn fm-btn-primary" data-i18n="filaments.addFilament">
        Add Filament
      </a>
      {!compactPicker && <InventoryFilterReset scope="all" />}
    </div>
  </div>
  
  <div class="filter-bar">
    <div class="fm-filter-search-wrap">
      <input
        type="text"
        id="filter-search"
        class="fm-input fm-input-search"
        data-i18n-placeholder={compactPicker ? 'filaments.searchPicker' : 'filaments.searchPlaceholder'}
        data-i18n-aria-label={compactPicker ? 'filaments.searchPicker' : undefined}
        placeholder="Search designation, color, manufacturer..."
      />
      <button id="filter-search-clear" class="fm-filter-search-clear" type="button" aria-label="Clear search" title="Clear search" data-i18n-aria-label="common.clearSearch" data-i18n-title="common.clearSearch">&times;</button>
    </div>
    {compactPicker && <InventoryFilterReset scope="all" />}
    <label id="filter-group-control" class="fm-column-group-control" hidden>
      <input type="checkbox" id="filter-group" class="fm-checkbox" />
      <span data-i18n="filaments.groupByManufacturer">Group by Manufacturer</span>
    </label>
  </div>

  {compactPicker && <p id="picker-selection-count" role="status"></p>}
  <div class="fm-inventory-toolbar">
    <div data-inventory-count></div>
    <InventoryFilterReset scope="columns" />
    <div class="col-picker-wrap">
      <button id="btn-columns" class="fm-btn fm-btn-outline" style="padding: 5px 10px; font-size: 0.8rem; display: flex; align-items: center; gap: 5px; white-space: nowrap;">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
        <span data-i18n="common.columns">Spalten</span>
      </button>
      <div id="columns-dropdown" class="col-picker-dropdown"></div>
    </div>
  </div>

  <div class="fm-card fm-inventory-table fm-filaments-table" data-compact={compactPicker ? "" : undefined} data-filament-picker={compactPicker ? "1" : undefined}>
    <table class="fm-table">
      <thead>
        <tr style="background: var(--bg-soft);">
          <th data-column-selection style="width: 40px; text-align: center;"><input type="checkbox" id="bulk-select-all" class="fm-checkbox bulk-checkbox" aria-label="Select loaded filaments" data-i18n-aria-label="filaments.selectLoaded" disabled /></th>
          <th data-i18n="filaments.manufacturer" data-sort="manufacturer" class="sortable col-manufacturer">Manufacturer</th>
          <th data-i18n="manufacturers.logo" class="col-logo" style="min-width: 114px;">Logo</th>
          <th data-i18n="filaments.type" data-sort="type" class="sortable col-type">Type</th>
          <th data-i18n="filaments.designation" data-i18n-compact="filaments.designationCompact" data-sort="designation" class="sortable col-designation">Designation</th>
          <th data-i18n="filaments.colors" data-sort="colors" class="sortable col-colors">Colors</th>
          <th data-i18n="filaments.diameter" data-sort="diameter_mm" class="sortable col-diameter">Diameter</th>
          <th style="text-align: right;" data-i18n="filaments.spools" data-sort="spool_count" class="sortable col-spools fm-header-filter-align-end">Spools</th>
          <th data-i18n="filaments.colPrice" data-sort="price" class="sortable col-price">Price</th>
          <th data-i18n="filaments.colMfrColor" data-sort="manufacturer_color_name" class="sortable col-mfr_color">Mfr. Color</th>
          <th data-i18n="filaments.colFinish" data-sort="finish_type" class="sortable col-finish">Finish</th>
          <th data-i18n="filaments.colSubgroup" data-sort="material_subgroup" class="sortable col-subgroup">Subgroup</th>
          <th data-i18n="filaments.colWeight" data-sort="raw_material_weight_g" class="sortable col-weight">Material Weight</th>
          <th data-i18n="filaments.colDensity" data-sort="density_g_cm3" class="sortable col-density">Density</th>
          <th data-i18n="filaments.manufacturerSku" class="col-sku">Manufacturer SKU</th>
          <th data-i18n="filaments.extruderTemperature" class="col-extruder_temp">Extruder temperature</th>
          <th data-i18n="filaments.bedTemperature" class="col-bed_temp">Bed temperature</th>
          <th data-i18n="filaments.datasheetUrl" class="col-datasheet">Datasheet</th>
          <th data-i18n="filaments.imageUrl" class="col-image">Image</th>
          <th data-i18n="filaments.discontinued" class="col-discontinued">Discontinued</th>
          <th data-i18n="filaments.dryingTemperature" class="col-drying_temp">Drying temperature</th>
          <th data-i18n="filaments.dryingTime" class="col-drying_time">Drying time</th>
          <th data-i18n="filaments.softeningTemperature" class="col-softening_temp">Softening temperature</th>
          <th data-i18n="filaments.coolingFan" class="col-cooling_fan">Cooling fan</th>
          <th data-i18n="filaments.chamberTemperature" class="col-chamber_temp">Chamber temperature</th>
          <th data-i18n="filaments.maxVolumetricSpeed" class="col-max_vol_speed">Max volumetric speed</th>
          <th data-i18n="filaments.flowRatio" class="col-flow_ratio">Flow ratio</th>
          <th data-i18n="filaments.pressureAdvance" class="col-pressure_advance">Pressure advance</th>
          <th data-i18n="filaments.amsCompatibility" class="col-ams">AMS compatibility</th>
          <th data-i18n="filaments.buildPlateCompatibility" class="col-build_plates">Build plate compatibility</th>
          <th data-i18n="filaments.priceCurrency" class="col-currency">Price currency</th>
          <th data-i18n="spools.spoolOuterDiameter" class="col-spool_outer">Spool outer diameter</th>
          <th data-i18n="spools.spoolWidth" class="col-spool_width">Spool width</th>
          <th data-i18n="spools.spoolMaterial" class="col-spool_material">Spool material</th>
        </tr>
      </thead>
      <tbody id="filaments-table">
        <tr>
          <td colspan="34" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <InventoryLoadMore />

  <!-- Bulk Action Bar -->
  <div id="bulk-action-bar" class="bulk-action-bar">
    <span class="bulk-count" id="bulk-count"></span>
    <FilamentPluginHooks mode="selection" />
    <button class="fm-btn fm-btn-outline" id="bulk-btn-price" data-i18n="filaments.bulkSetPrice">Set Price</button>
    <button class="fm-btn fm-btn-outline" id="bulk-btn-diameter" data-i18n="filaments.bulkSetDiameter">Set Diameter</button>
    <button class="fm-btn fm-btn-outline" id="bulk-btn-spool-weight" data-i18n="filaments.bulkSetSpoolWeight">Set Spool Weight</button>
    <button class="fm-btn fm-btn-outline" id="bulk-btn-density" data-i18n="filaments.bulkSetDensity">Set Density</button>
    <button class="fm-btn fm-btn-outline" id="bulk-btn-print" data-i18n="filaments.bulkLabel">Print Labels</button>
    <button class="fm-btn fm-btn-danger" id="bulk-btn-delete" data-i18n="filaments.bulkDelete">Delete</button>
  </div>

  <!-- Bulk Prompt Modal -->
  <div id="bulk-prompt-modal" class="fm-modal-overlay">
    <div class="fm-card" style="width: 100%; max-width: 24rem; margin: 0 1rem; padding: 24px;">
      <h3 id="bulk-prompt-title" style="font-size: 1.15rem; font-weight: 600; margin-bottom: 16px;"></h3>
      <div id="bulk-prompt-content" style="margin-bottom: 16px;"></div>
      <div style="display: flex; gap: 12px;">
        <button id="bulk-prompt-ok" class="fm-btn fm-btn-primary" data-i18n="common.confirm">Confirm</button>
        <button id="bulk-prompt-cancel" class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </div>
    </div>
  </div>
  
  <script>
    import { t, initI18n, translatePage } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { initInventoryScroll, inventoryApiPages, inventoryLocalPages } from '../../lib/inventory-scroll'
    import { colorFilterParams, fetchAllPages } from '../../lib/api'
    import { cachedFetch, CACHE_KEYS, invalidateCache } from '../../lib/cache'
    import { initColumnPicker, type ColumnGroup } from '../../lib/column-picker'
    import { columnClassName, createSortableColumnHeader } from '../../lib/column-key'
    import { initColumnReorder } from '../../lib/column-reorder'
    import { initColumnResize } from '../../lib/column-resize'
    import { escapeHtml, extraFieldColumnSortValue, formatNumericRange, getExtraFieldColumnValue, isIntegrationExtraFieldPath, renderExtraFieldColumn, type SystemExtraFieldDef } from '../../lib/extra-fields'
    import {
      bindTableFilterControls,
      initHeaderColumnFilters,
      isMissingExtraFieldSort,
      isColumnFilterActive,
      matchesColumnFilter,
      matchesExtraFieldColumnFilter,
      multiColumnFilter,
      sanitizeColumnFilters,
      syncHeaderSortButtons,
      systemExtraFieldHeaderFilter,
      type ColumnFilterValue,
      type HeaderFilterController,
      type HeaderFilterDefinition,
      type HeaderFilterOption,
    } from '../../lib/table-column-filters'
    import { formatPrice, getCurrency, initCurrency } from '../../lib/format'
    import { filamentColorValues, inventoryColorMatcher, toColorSwatchBackground } from '../../lib/colors'
    import { mountFilamentPluginHooks } from '../../lib/filament-plugin-hooks'
    import type { AppDialogs } from '../../lib/form-dialog'
    const dialogWindow = window as unknown as AppDialogs
    await initI18n()

    const pickerCard = document.querySelector('[data-filament-picker]')
    const compactPicker = pickerCard !== null
    if (compactPicker) {
      window.addEventListener('storage', event => {
        if (event.key === 'theme') document.documentElement.dataset.theme = event.newValue || 'brand'
      })
    }
    const storageScope = compactPicker ? 'filament-picker' : 'filaments'
    type FilamentColor = { display_name_override?: string | null; color_id?: number; color?: { name: string; hex_code: string } | null }
    type Filament = {
      id: number
      manufacturer_id: number
      manufacturer?: { name: string; logo_url?: string | null } | null
      designation: string
      record_token?: string
      material_type: string
      material_subgroup: string | null
      manufacturer_color_name: string | null
      finish_type: string | null
      diameter_mm: number
      price: number | null
      price_currency?: string | null
      spool_count: number
      spool_status_ids: number[]
      colors: FilamentColor[]
      manufacturer_sku?: string | null
      ams_compatibility?: string[] | null
      build_plate_compatibility?: string[] | null
      spool_material?: string | null
      custom_fields: Record<string, unknown> | null
      [key: string]: unknown
    }
    const filamentList = initInventoryScroll<Filament>(
      document.getElementById('filaments-table')!, 'filaments.filamentCount', renderFilaments, updateBulkBar,
    )
    let filamentExtraFields: SystemExtraFieldDef[] = []
    let sortKey: string | null = null
    let sortDirection: 'asc' | 'desc' | null = null
    const sortStorageKey = `filaman-sort-${storageScope}`
    const selectedFilamentIds = new Set<number>()
    const selectedPickerFilaments = new Map<number, Pick<Filament, 'id' | 'manufacturer_id' | 'designation' | 'material_type' | 'record_token'>>()

    // Map frontend sort keys to backend sort_by values; empty string = client-side only (not server-sortable)
    const sortKeyMap: Record<string, string> = {
      'type': 'material_type',
      'colors': '', // aggregated (count) — client-side only
    }
    // Only fetch all rows for an extra-field sort when its definition is available.
    function isClientOnlySort(key: string | null): boolean {
      if (!key) return false
      if (key.startsWith('cf_')) return !isMissingExtraFieldSort(key, filamentExtraFields)
      return sortKeyMap[key] === ''
    }

    // Restore sort state from localStorage
    try {
      const savedSort = localStorage.getItem(sortStorageKey)
      if (savedSort) {
        const { key, direction } = JSON.parse(savedSort)
        if (typeof key === 'string' && key && (direction === 'asc' || direction === 'desc')) {
          sortKey = key
          sortDirection = direction
        }
      }
    } catch { /* ignore invalid data */ }
    // Restore filter state from localStorage
    let savedFilterState: {
      manufacturer?: string | string[]
      type?: string | string[]
      color?: string | string[]
      columns?: Record<string, ColumnFilterValue>
      group?: boolean
    } | null = null
    try {
      const sf = localStorage.getItem(`filaman-filters-${storageScope}`)
      if (sf) savedFilterState = JSON.parse(sf)
    } catch { /* ignore invalid data */ }
    let colorFilterPaged = true
    let filterRenderQueued = false
    let columnFilters: Record<string, ColumnFilterValue> = { ...(savedFilterState?.columns || {}) }
    let filHeaderFilters: HeaderFilterController | null = null
    let allSpoolStatusIds: string[] = []

    const urlParams = new URLSearchParams(window.location.search)
    if (urlParams.get('clear_filters') === '1') {
      savedFilterState = null
      columnFilters = {}
      removeFilterUrlParams('clear_filters')
    }
    const filterManufacturerId = urlParams.get('manufacturer_id')
    const selectForSpool = !compactPicker && urlParams.get('select_for_spool') === '1'
    const createFilamentHref = selectForSpool ? '/filaments/new?create_spool=1' : '/filaments/new'
    if (selectForSpool) {
      const title = document.querySelector('h1')!
      title.dataset.i18n = 'spools.selectFilament'
      title.textContent = t('spools.selectFilament')
      document.title = `FilaMan - ${t('spools.selectFilament')}`
      document.querySelectorAll<HTMLElement>('.spool-selection-only').forEach(element => { element.hidden = false })
      document.getElementById('spool-selection-back')!.addEventListener('click', () => sessionStorage.removeItem('filaman_spool_create_draft'))
      document.getElementById('add-filament')!.setAttribute('href', createFilamentHref)
      const selectionHeader = document.getElementById('bulk-select-all')!.closest('th')!
      selectionHeader.textContent = ''
      selectionHeader.setAttribute('aria-label', t('common.select'))
      document.getElementById('bulk-action-bar')!.style.display = 'none'
    }
    const normalizeSavedValues = (value: unknown): string[] => {
      if (Array.isArray(value)) return value.filter((item): item is string => typeof item === 'string' && item.length > 0)
      return typeof value === 'string' && value.length > 0 ? [value] : []
    }
    if (!columnFilters.manufacturer) columnFilters.manufacturer = multiColumnFilter(normalizeSavedValues(savedFilterState?.manufacturer))
    if (!columnFilters.type) columnFilters.type = multiColumnFilter(normalizeSavedValues(savedFilterState?.type))
    if (!columnFilters.colors) columnFilters.colors = multiColumnFilter(normalizeSavedValues(savedFilterState?.color))
    if (filterManufacturerId) columnFilters.manufacturer = multiColumnFilter([filterManufacturerId])
    // Debounce timer for search input

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function setupSortableHeaders() {
      const thead = document.querySelector('.fm-table thead')
      if (!thead) return
      thead.addEventListener('click', (e) => {
        const th = (e.target as HTMLElement).closest('th[data-sort]') as HTMLElement | null
        if (!th) return
        const key = th.dataset.sort!
        if (sortKey === key) {
          if (sortDirection === 'asc') sortDirection = 'desc'
          else if (sortDirection === 'desc') { sortKey = null; sortDirection = null }
          else sortDirection = 'asc'
        } else {
          sortKey = key
          sortDirection = 'asc'
        }
        updateSortIndicators()
        void loadFilaments(true)
        // Save sort state to localStorage
        if (sortKey && sortDirection) {
          localStorage.setItem(sortStorageKey, JSON.stringify({ key: sortKey, direction: sortDirection }))
        } else {
          localStorage.removeItem(sortStorageKey)
        }
      })
    }

    function updateSortIndicators() {
      document.querySelectorAll('th[data-sort]').forEach(th => {
        const key = (th as HTMLElement).dataset.sort!
        th.classList.remove('sort-asc', 'sort-desc')
        if (sortKey === key && sortDirection) {
          th.classList.add(sortDirection === 'asc' ? 'sort-asc' : 'sort-desc')
        }
      })
      const table = document.querySelector('.fm-table') as HTMLTableElement | null
      if (table) syncHeaderSortButtons(table, sortKey, sortDirection)
    }

    function getSortValue(item: Filament, key: string): unknown {
      if (key === 'manufacturer') return item.manufacturer?.name || ''
      if (key === 'type') return item.material_type || ''
      if (key === 'colors') {
        const first = item.colors?.[0]
        return (first?.display_name_override || first?.color?.name || '').toLowerCase()
      }
      return item[key]
    }

    function sortFilaments(filaments: Filament[]): Filament[] {
      if (!sortKey || !sortDirection) return filaments
      if (sortKey === 'spool_count') return filaments  // server-only sort: skip client re-sort
      const sortBy = sortKey
      const field = filamentExtraFields.find((candidate) => `cf_${candidate.key}` === sortBy)
      const sortValue = field
        ? (item: Filament) => extraFieldColumnSortValue(field, getExtraFieldColumnValue(item.custom_fields, field.key))
        : (item: Filament) => getSortValue(item, sortBy)
      return [...filaments].sort((a, b) => {
        const aVal = sortValue(a)
        const bVal = sortValue(b)
        let cmp = 0
        if (aVal == null && bVal == null) cmp = 0
        else if (aVal == null) cmp = 1
        else if (bVal == null) cmp = -1
        else if (typeof aVal === 'string') cmp = aVal.localeCompare(String(bVal))
        else cmp = Number(aVal) - Number(bVal)
        return sortDirection === 'asc' ? cmp : -cmp
      })
    }

    function getFilterValues() {
      const search = (document.getElementById('filter-search') as HTMLInputElement).value.toLowerCase().trim()
      const manufacturerIds = getMultiFilterValues('manufacturer')
      const types = getMultiFilterValues('type')
      const groupBy = (document.getElementById('filter-group') as HTMLInputElement).checked
      return { search, manufacturerIds, types, groupBy }
    }

    function getMultiFilterValues(key: string): string[] {
      const filter = columnFilters[key]
      return filter?.type === 'multi' ? [...filter.values] : []
    }

    function hasLocalColumnFilters(): boolean {
      return Object.entries(columnFilters).some(([key, value]) =>
        isEffectiveColumnFilterActive(key, value) && key !== 'manufacturer' && key !== 'type'
        && !(key === 'colors' && colorFilterPaged && colorFilterParams(value) !== null))
    }

    // Selecting every status is equivalent to no status filter.
    function isEffectiveColumnFilterActive(key: string, value: ColumnFilterValue | undefined): boolean {
      if (!isColumnFilterActive(value)) return false
      if (key === 'spoolStatus' && value?.type === 'multi' && allSpoolStatusIds.length > 0) {
        return value.values.length < allSpoolStatusIds.length
      }
      return true
    }

    function getFilamentFilterValue(filament: Filament, key: string): unknown {
      if (key === 'manufacturer') return String(filament.manufacturer_id)
      if (key === 'type') return filament.material_type
      if (key === 'designation') return filament.designation
      if (key === 'colors') return filamentColorValues(filament, 'name')
      if (key === 'diameter') return filament.diameter_mm
      if (key === 'spools') return filament.spool_count
      if (key === 'spoolStatus') return (filament.spool_status_ids || []).map(String)
      if (key === 'price') return filament.price
      if (key === 'mfr_color') return filament.manufacturer_color_name
      if (key === 'finish') return filament.finish_type
      if (key === 'subgroup') return filament.material_subgroup
      if (key === 'weight') return filament.raw_material_weight_g
      if (key === 'density') return filament.density_g_cm3
      return null
    }

    function filterFilaments(filaments: Filament[]): Filament[] {
      const colorFilter = columnFilters.colors
      const matchesColors = colorFilter?.type === 'multi' ? inventoryColorMatcher(colorFilter) : null
      const activeFilters = Object.entries(columnFilters).filter(([key, value]) => isEffectiveColumnFilterActive(key, value))
      return filaments.filter((filament) => activeFilters.every(([key, filter]) => {
        if (key === 'colors' && matchesColors) return matchesColors(filament)
        if (key.startsWith('cf_')) return matchesExtraFieldColumnFilter(filamentExtraFields, key, filament.custom_fields, filter)
        return matchesColumnFilter(getFilamentFilterValue(filament, key), filter)
      }))
    }

    function applyFiltersAndRender() {
      void loadFilaments(true)
    }

    async function populateFilterDropdowns() {
      try {
        const signal = getAbortSignal()
        const options = await cachedFetch<{
          manufacturers: HeaderFilterOption[]
          types: string[]
          designations: string[]
          diameters: number[]
          finishes: string[]
          subgroups: string[]
          spool_counts: number[]
          colors: Array<{ value: string; label: string; color_hexes: string[]; color_stops?: { id: number; hex: string }[] }>
          has_empty_colors: boolean
        }>(CACHE_KEYS.FILAMENT_FILTER_OPTIONS, async () => {
          const response = await fetch('/api/v1/filaments/filter-options', { credentials: 'include', signal })
          if (!response.ok) throw new Error(`Failed to load filament filter options (${response.status})`)
          return response.json()
        })

        filHeaderFilters?.setOptions('manufacturer', options.manufacturers)
        filHeaderFilters?.setOptions('type', options.types.map(type => ({ value: type, label: type })))
        filHeaderFilters?.setOptions('designation', options.designations.map(value => ({ value, label: value })))
        filHeaderFilters?.setOptions('diameter', options.diameters.map(value => ({ value: String(value), label: `${value} mm` })))
        filHeaderFilters?.setOptions('finish', options.finishes.map(value => ({ value, label: value })))
        filHeaderFilters?.setOptions('subgroup', options.subgroups.map(value => ({ value, label: value })))
        filHeaderFilters?.setOptions('spools', options.spool_counts.map(value => ({ value: String(value), label: String(value) })))
        const colorOptions: HeaderFilterOption[] = options.colors.map(color => ({
          value: color.value,
          label: color.label,
          colorHexes: color.color_hexes,
          colorStops: color.color_stops,
        }))
        if (options.has_empty_colors) colorOptions.unshift({ value: '', label: t('common.empty') })
        filHeaderFilters?.setOptions('colors', colorOptions)

      } catch (e) {
        if (isAbortError(e)) return
        filHeaderFilters?.setOptions('colors', [])
        console.error('Failed to populate filter dropdowns:', e)
      }
    }

    async function populateSpoolStatusDropdown() {
      try {
        const response = await fetch('/api/v1/spools/statuses', { credentials: 'include', signal: getAbortSignal() })
        if (!response.ok) throw new Error(`Failed to load spool statuses (${response.status})`)
        const statuses: Array<{ id: number; key: string; label: string }> = await response.json()
        filHeaderFilters?.setOptions('spoolStatus', statuses.map((status) => {
          const i18nKey = `spools.status${status.key.charAt(0).toUpperCase() + status.key.slice(1)}`
          return { value: String(status.id), label: t(i18nKey) || status.label }
        }))
        allSpoolStatusIds = statuses.map((status) => String(status.id))
        if (!columnFilters.spoolStatus) {
          const defaultFilter = multiColumnFilter(allSpoolStatusIds)
          columnFilters.spoolStatus = defaultFilter
          filHeaderFilters?.setValue('spoolStatus', defaultFilter)
        }
      } catch (e) {
        if (isAbortError(e)) return
        console.error('Failed to populate spool status dropdown:', e)
      }
    }
    
    async function loadFilaments(reset = false) {
      if (!filHeaderFilters) return
      updateFilterResets()
      const { search, manufacturerIds, types, groupBy } = getFilterValues()

      // Build query params for backend
      const params = new URLSearchParams()
      if (!selectForSpool) params.set('include_record_token', 'true')
      manufacturerIds.forEach((id) => params.append('manufacturer_id', id))
      types.forEach((item) => params.append('type', item))
      if (search) params.set('search', search)
      // sortKeyMap lives at module scope; '' means client-side only
      if (sortKey && sortDirection && !sortKey.startsWith('cf_') && !isClientOnlySort(sortKey)) {
        const backendSortKey = sortKeyMap[sortKey] ?? sortKey
        if (backendSortKey) {
          params.set('sort_by', backendSortKey)
          params.set('sort_order', sortDirection)
        }
      }

      const colors = colorFilterParams(columnFilters.colors, params, '/api/v1/filaments')
      colorFilterPaged = colors !== null
      colors?.forEach((value, key) => params.append(key, value))

      try {
        const source = hasLocalColumnFilters() || groupBy || isClientOnlySort(sortKey)
          ? inventoryLocalPages(async () => {
              const { items } = await fetchAllPages<Filament>(`/api/v1/filaments?${params}`)
              return sortFilaments(hasLocalColumnFilters() ? filterFilaments(items) : items)
            }, groupBy)
          : inventoryApiPages<Filament>('/api/v1/filaments', params)
        if (!await filamentList.load(source, reset, (items, append) => {
          if (compactPicker) reconcilePickerSelection(items)
          if (groupBy) renderGroupedFilaments(items)
          else renderFilaments(items, append)
        })) return
        localStorage.setItem(`filaman-filters-${storageScope}`, JSON.stringify({ columns: columnFilters, group: groupBy }))
      } catch (error) {
        console.error('Failed to load filaments:', error)
        document.getElementById('filaments-table')!.innerHTML = `
          <tr>
            <td colspan="34" style="text-align: center; color: var(--error-text);">${t('filaments.failedLoad')}</td>
          </tr>
        `
        updateBulkBar()
      }
    }
    
    function renderColorDots(colors: FilamentColor[]): string {
      if (!colors || colors.length === 0) return '-'
      return colors.map(fc => {
        const c = fc.color
        if (!c) return ''
        return `<span title="${escapeHtml(fc.display_name_override || c.name)}" style="display: inline-block; width: 18px; height: 18px; border-radius: 50%; background: ${toColorSwatchBackground(c.hex_code)}; border: 2px solid var(--border); vertical-align: middle; margin-right: 2px;"></span>`
      }).join('')
    }

