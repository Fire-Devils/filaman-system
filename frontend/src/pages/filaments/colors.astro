---
import ColorEditorFields from '../../components/ColorEditorFields.astro'
import FormDialog from '../../components/FormDialog.astro'
import Layout from '../../layouts/Layout.astro'
---

<Layout title="FilaMan - Manage Colors">
  <div class="fm-list-toolbar">
    <div style="display: flex; align-items: center; gap: 16px;">
      <a href="/filaments" class="fm-btn fm-btn-outline" style="padding: 8px;" data-i18n-title="common.back">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <h1 style="font-weight: 700; margin: 0; font-family: var(--font-serif);" data-i18n="colors.title">Manage Colors</h1>
    </div>
    <div class="fm-list-controls">
      <button id="filter-clear-columns" class="fm-btn fm-btn-outline" type="button" data-i18n="common.clearColumnFilters">Clear column filters</button>
      <button id="btn-new" class="fm-btn fm-btn-primary" data-i18n="colors.addColor">Add Color</button>
    </div>
  </div>
  
  <div class="fm-card" style="padding: 0;">
    <table class="fm-table" id="colors-list-table">
      <thead>
        <tr style="background: var(--bg-soft);">
          <th data-i18n="colors.name" data-sort="name" class="sortable col-name">Name</th>
          <th data-i18n="colors.hexCode" data-sort="hex_code" class="sortable col-hex">Hex Code</th>
          <th data-i18n="colors.usage" data-sort="usage_count" class="sortable col-usage">Usage</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="colors-table">
        <tr>
          <td colspan="4" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <FormDialog id="modal-container" titleId="modal-title" titleKey="colors.addColor" title="Add Color" wide>
    <Fragment slot="actions">
      <button type="submit" form="modal-form" id="modal-submit" disabled class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
      <button type="button" id="modal-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
    <form id="modal-form" class="fm-compact-form">
        <input type="hidden" id="color-id" />
        <ColorEditorFields idPrefix="color" />
        <div id="modal-error" class="fm-alert-error hidden" role="alert"></div>
    </form>
  </FormDialog>

  <script>
    import { t, initI18n, translatePage } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { fetchAllPages } from '../../lib/api'
    import { bindAlphaColorControls, normalizeHexCode, toColorSwatchBackground } from '../../lib/colors'
    import { escapeHtml } from '../../lib/extra-fields'
    import {
      bindTableFilterControls,
      initHeaderColumnFilters,
      isColumnFilterActive,
      matchesColumnFilter,
      syncHeaderSortButtons,
      type ColumnFilterValue,
      type HeaderFilterController,
    } from '../../lib/table-column-filters'
    import { tableAction } from '../../lib/table-actions'
    import { bindFormDialog } from '../../lib/form-dialog'
    import { bindFormState } from '../../lib/form-state'
    await initI18n()

    const modalForm = document.getElementById('modal-form') as HTMLFormElement
    const formState = bindFormState(modalForm, document.getElementById('modal-submit') as HTMLButtonElement)
    const formDialog = bindFormDialog(document.getElementById('modal-container') as HTMLDialogElement, { canClose: () => !formState.busy })

    let colors: any[] = []
    let sortKey: string | null = 'name'
    let sortDirection: 'asc' | 'desc' | null = 'asc'
    let columnFilters: Record<string, ColumnFilterValue> = {}
    let colorHeaderFilters: HeaderFilterController | null = null
    const colorSortKeys = new Set(['name', 'hex_code', 'usage_count'])

    try {
      const saved = JSON.parse(localStorage.getItem('filaman-sort-colors') || 'null')
      if (colorSortKeys.has(saved?.key) && (saved.direction === 'asc' || saved.direction === 'desc')) {
        sortKey = saved.key
        sortDirection = saved.direction
      }
    } catch { /* ignore invalid data */ }
    
    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }
    
    async function loadColors() {
      try {
        const data = await fetchAllPages('/api/v1/colors')
        colors = data.items
        colorHeaderFilters?.setOptions('name', colors.map(color => ({
          value: String(color.id),
          label: color.name,
          colorHexes: [color.hex_code],
        })))
        colorHeaderFilters?.setOptions('usage_count', [...new Set<number>(colors.map(color => color.usage_count))]
          .sort((left, right) => left - right)
          .map(value => ({ value: String(value), label: String(value) })))
        renderColors()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load colors:', error)
        document.getElementById('colors-table')!.innerHTML = `
          <tr>
            <td colspan="4" style="text-align: center; color: var(--error-text);">${t('colors.failedLoad')}</td>
          </tr>
        `
      }
    }
    
    function renderColors() {
      const tbody = document.getElementById('colors-table')!
      let visibleColors = colors.filter(color => Object.entries(columnFilters).every(([key, filter]) => {
        const value = key === 'name' ? String(color.id) : color[key]
        return matchesColumnFilter(value, filter)
      }))
      if (sortKey && sortDirection) {
        const direction = sortDirection
        visibleColors = [...visibleColors].sort((a, b) => {
          const left = a[sortKey!] ?? ''
          const right = b[sortKey!] ?? ''
          const comparison = typeof left === 'number'
            ? left - right
            : String(left).localeCompare(String(right), undefined, { sensitivity: 'base' })
          return direction === 'asc' ? comparison : -comparison
        })
      }
      
      if (visibleColors.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="4" style="text-align: center; color: var(--text-muted);">
              ${t('colors.noColors')}
            </td>
          </tr>
        `
        return
      }
      
      tbody.innerHTML = visibleColors.map(c => `
        <tr>
          <td style="padding: 12px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="display: inline-block; width: 24px; height: 24px; border-radius: 50%; background: ${toColorSwatchBackground(c.hex_code)}; border: 1px solid var(--border);"></span>
              <span style="font-weight: 500;">${escapeHtml(c.name)}</span>
            </div>
          </td>
          <td style="padding: 12px; font-family: monospace; color: var(--text-muted);">${escapeHtml(String(c.hex_code).toUpperCase())}</td>
          <td style="padding: 12px; color: var(--text-muted); font-size: 0.85rem;">
            ${t('colors.usedIn', { count: c.usage_count })}
          </td>
          <td style="padding: 12px; text-align: right;">
            <div class="fm-row-actions">${tableAction('edit', { id: c.id })}${tableAction('delete', { id: c.id, usage: c.usage_count }, { disabled: c.usage_count > 0, title: c.usage_count > 0 ? t('colors.inUseWarning') : undefined })}</div>
          </td>
        </tr>
      `).join('')
      
      translatePage()

      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const color = colors.find(color => color.id === Number(target.dataset.id))
          if (color) openModal(color.id, color.name, color.hex_code)
        })
      })
      
      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const id = parseInt(target.dataset.id!)
          const usage = parseInt(target.dataset.usage!)
          
          if (usage > 0) return
          
          if (!(await (window as any).__fmConfirm(t('colors.confirmDelete')))) return
          
          try {
            const response = await fetch(`/api/v1/colors/${id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              signal: getAbortSignal(),
            })
            
            if (!response.ok) {
              const data = await response.json()
              await (window as any).__fmAlert(data.message || t('colors.failedDelete'))
              return
            }
            
            loadColors()
          } catch {
            await (window as any).__fmAlert(t('colors.failedDelete'))
          }
        })
      })
    }

    function applyColumnFilter(key: string, value: ColumnFilterValue) {
      if (isColumnFilterActive(value)) columnFilters[key] = value
      else delete columnFilters[key]
      renderColors()
    }

    function setupTableControls() {
      const table = document.getElementById('colors-list-table') as HTMLTableElement
      colorHeaderFilters = initHeaderColumnFilters(table, [
        {
          key: 'name',
          label: t('colors.name'),
          columnSelector: 'th.col-name',
          type: 'multi',
          multiDisplay: 'colors',
          options: [],
          onApply: value => applyColumnFilter('name', value),
        },
        {
          key: 'hex_code',
          label: t('colors.hexCode'),
          columnSelector: 'th.col-hex',
          type: 'text',
          onApply: value => applyColumnFilter('hex_code', value),
        },
        {
          key: 'usage_count',
          label: t('colors.usage'),
          columnSelector: 'th.col-usage',
          type: 'number',
          autocomplete: true,
          onApply: value => applyColumnFilter('usage_count', value),
        },
      ])
      syncHeaderSortButtons(table, sortKey, sortDirection)
      if (sortKey && sortDirection) {
        table.querySelector(`th[data-sort="${sortKey}"]`)?.classList.add(sortDirection === 'asc' ? 'sort-asc' : 'sort-desc')
      }

      table.tHead?.addEventListener('click', event => {
        const header = (event.target as HTMLElement).closest<HTMLElement>('th[data-sort]')
        if (!header) return
        const key = header.dataset.sort!
        if (sortKey !== key) {
          sortKey = key
          sortDirection = 'asc'
        } else if (sortDirection === 'asc') sortDirection = 'desc'
        else if (sortDirection === 'desc') {
          sortKey = null
          sortDirection = null
        } else sortDirection = 'asc'
        table.querySelectorAll('th[data-sort]').forEach(cell => cell.classList.remove('sort-asc', 'sort-desc'))
        if (sortKey && sortDirection) {
          header.classList.add(sortDirection === 'asc' ? 'sort-asc' : 'sort-desc')
          localStorage.setItem('filaman-sort-colors', JSON.stringify({ key: sortKey, direction: sortDirection }))
        } else localStorage.removeItem('filaman-sort-colors')
        syncHeaderSortButtons(table, sortKey, sortDirection)
        renderColors()
      })

      bindTableFilterControls({
        onApply: renderColors,
        onClearColumns: () => {
          columnFilters = {}
          colorHeaderFilters?.resetAll()
          renderColors()
        },
        onClearAll: () => {},
      })
    }
    
    function openModal(id: number | null = null, name: string = '', hex: string = '#000000') {
      const title = document.getElementById('modal-title')!
      const idInput = document.getElementById('color-id') as HTMLInputElement
      const nameInput = document.getElementById('color-name') as HTMLInputElement
      const error = document.getElementById('modal-error')!
      
      title.textContent = id ? t('colors.editColor') : t('colors.addColor')
      idInput.value = id ? String(id) : ''
      nameInput.value = name
      colorControls.reset(normalizeHexCode(hex) || '#000000')
      error.classList.add('hidden')
      
      formState.reset()
      formDialog.open()
      nameInput.focus()
    }
    
    function closeModal() {
      formDialog.close()
    }
    
    document.getElementById('btn-new')?.addEventListener('click', () => openModal())
    
    // Sync picker, opacity slider, and hex input
    const hexInput = document.getElementById('color-hex') as HTMLInputElement
    const picker = document.getElementById('color-picker') as HTMLInputElement
    const alphaEnabled = document.getElementById('color-alpha-enabled') as HTMLInputElement
    const alphaOptions = document.getElementById('color-alpha-options') as HTMLDivElement
    const alphaPreview = document.getElementById('color-alpha-preview') as HTMLSpanElement
    const alphaInput = document.getElementById('color-alpha') as HTMLInputElement
    const alphaValue = document.getElementById('color-alpha-value') as HTMLInputElement
    const alphaHex = document.getElementById('color-alpha-hex') as HTMLInputElement
    const colorControls = bindAlphaColorControls({
      picker,
      hexInput,
      alphaEnabled,
      alphaOptions,
      alphaPreview,
      alphaInput,
      alphaValueInput: alphaValue,
      alphaHexInput: alphaHex,
    })
    
    document.getElementById('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const id = (document.getElementById('color-id') as HTMLInputElement).value
      const name = (document.getElementById('color-name') as HTMLInputElement).value
      const hex_code = normalizeHexCode((document.getElementById('color-hex') as HTMLInputElement).value)
      const error = document.getElementById('modal-error') as HTMLDivElement
      const submitBtn = document.getElementById('modal-submit') as HTMLButtonElement
      
      error.classList.add('hidden')
      if (formState.busy || !modalForm.reportValidity()) return
      formState.setBusy(true)
      submitBtn.textContent = t('common.saving')
      
      try {
        const url = id ? `/api/v1/colors/${id}` : '/api/v1/colors'
        const method = id ? 'PATCH' : 'POST'
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify({ name, hex_code }),
          signal: getAbortSignal(),
        })
        
        if (!response.ok) {
          const errorData = await response.json()
          throw new Error(errorData.message || t('colors.failedSave'))
        }
        
        formState.setBusy(false)
        closeModal()
        loadColors()
      } catch (err: any) {
        if (isAbortError(err)) return
        error.textContent = err.message
        error.classList.remove('hidden')
      } finally {
        formState.setBusy(false)
        submitBtn.textContent = t('common.save')
      }
    })
    
    setupTableControls()
    loadColors()

    // Live-Update via SSE: Farben automatisch neu laden
    let _colorsReloadTimer: ReturnType<typeof setTimeout> | null = null
    window.addEventListener('filaman:data-changed', (e: Event) => {
      const { event } = (e as CustomEvent).detail ?? {}
      if (event === 'colors_changed') {
        if (_colorsReloadTimer) clearTimeout(_colorsReloadTimer)
        _colorsReloadTimer = setTimeout(() => loadColors(), 300)
      }
    })
  </script>
</Layout>
