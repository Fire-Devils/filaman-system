---
import ColorPluginHooks from '../../components/ColorPluginHooks.astro'
import PluginUiLaunchers from '../../components/PluginUiLaunchers.astro'
import ColorEditorFields from '../../components/ColorEditorFields.astro'
import FormDialog from '../../components/FormDialog.astro'
import InventoryLoadMore from '../../components/InventoryLoadMore.astro'
import InventoryFilterReset from '../../components/InventoryFilterReset.astro'
import Layout from '../../layouts/Layout.astro'
---

<Layout panel="colors" title="FilaMan - Color Library">
  <div class="fm-colors-library">
  <div class="fm-list-toolbar">
    <h1 data-i18n="colors.title">Color Library</h1>
    <div class="fm-list-controls" data-help-slot>
      <PluginUiLaunchers surface="colors.library" />
      <span data-inventory-count></span>
      <InventoryFilterReset scope="columns" />
      <button id="btn-review-colors" class="fm-btn fm-btn-outline"><svg width="18" height="18" aria-hidden="true"><use href="/icons.svg?v=4#icon-broom" /></svg><span data-i18n="colors.cleanup.review">Duplicates</span></button>
      <button id="btn-new" class="fm-btn fm-btn-primary" data-i18n="colors.addColor">Add Color</button>
    </div>
  </div>
  
  <div class="fm-inventory-toolbar" id="color-bulk-controls">
    <span id="color-selection-count" role="status"></span>
    <button type="button" id="color-select-matching" class="fm-btn fm-btn-outline" data-i18n="colors.cleanup.selectAll">Select all</button>
    <button type="button" id="color-merge-selected" class="fm-btn fm-btn-outline" hidden disabled><svg width="18" height="18" aria-hidden="true"><use href="/icons.svg?v=4#icon-merge" /></svg><span data-i18n="colors.cleanup.mergeAction">Merge</span></button>
    <button type="button" id="color-clear-selection" class="fm-btn fm-btn-outline" hidden><svg width="18" height="18" aria-hidden="true"><use href="/icons.svg?v=4#icon-close" /></svg><span data-i18n="colors.cleanup.clearSelection">Clear selection</span></button>
    <button type="button" id="color-delete-selected" class="fm-btn fm-btn-danger" hidden disabled><svg width="18" height="18" aria-hidden="true"><use href="/icons.svg?v=4#icon-trash" /></svg><span data-i18n="colors.cleanup.deleteSelected">Delete selected</span></button>
    <PluginUiLaunchers surface="colors.selection" />
  </div>
  <div class="fm-card fm-inventory-table fm-colors-table" data-compact>
    <table class="fm-table fm-admin-table" id="colors-list-table">
      <thead>
        <tr>
          <th data-column-selection><input id="color-select-loaded" type="checkbox" class="fm-checkbox" aria-label="Select loaded colors" data-i18n-aria-label="colors.cleanup.selectLoaded" disabled /></th>
          <th data-i18n="colors.name" data-sort="name" class="sortable col-name">Name</th>
          <th data-i18n="colors.hexCode" data-sort="hex_code" class="sortable col-hex">Hex Code</th>
          <th data-i18n="colors.usage" data-sort="usage_count" class="sortable col-usage">Usage</th>
          <th data-column-actions style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="colors-table">
        <tr>
          <td colspan="5" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <InventoryLoadMore />
  </div>

  <FormDialog id="color-cleanup-dialog" handbook="colorCleanup" titleId="color-cleanup-title" titleKey="colors.cleanup.title" title="Color cleanup" wide>
    <button slot="actions" type="button" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.close">Close</button>
    <div id="color-cleanup-content"></div>
    <form data-cleanup-merge-form class="fm-compact-form" hidden>
      <label class="fm-label" for="cleanup-survivor" data-i18n="colors.cleanup.survivor">Keep this color</label>
      <select class="fm-input" id="cleanup-survivor"></select>
      <ColorEditorFields idPrefix="cleanup" wheel />
      <p class="fm-alert-error" data-cleanup-warning role="note"></p>
      <div class="fm-admin-actions">
        <button type="button" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
        <button type="submit" data-cleanup-merge class="fm-btn fm-btn-primary"><svg width="18" height="18" aria-hidden="true"><use href="/icons.svg?v=4#icon-merge" /></svg><span data-i18n="colors.cleanup.merge">Merge selected colors</span></button>
      </div>
    </form>
  </FormDialog>

  <FormDialog id="modal-container" handbook="colorAdd" titleId="modal-title" titleKey="colors.addColor" title="Add Color" wide>
    <Fragment slot="actions">
      <ColorPluginHooks />
      <button type="submit" form="modal-form" id="modal-submit" disabled class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
      <button type="button" id="modal-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
    <form id="modal-form" class="fm-compact-form">
        <input type="hidden" id="color-id" />
        <ColorEditorFields idPrefix="color" wheel />
        <div id="modal-error" class="fm-alert-error hidden" role="alert"></div>
    </form>
  </FormDialog>

  <script>
    import { bindColorPickerPopup } from '../../lib/color-picker-wheel'
    import { getMe, hasPermission, type User } from '../../lib/auth'
    import { bindColorCleanup } from '../../lib/color-library-cleanup'
    import { t, initI18n, translatePage } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { initInventoryScroll, inventoryLocalPages } from '../../lib/inventory-scroll'
    import { api, fetchAllPages } from '../../lib/api'
    import { colorUsageHtml } from '../../lib/color-library-links'
    import { bindAlphaColorControls, normalizeHexCode, toColorSwatchBackground } from '../../lib/colors'
    import { escapeHtml } from '../../lib/extra-fields'
    import {
      bindTableFilterControls,
      initHeaderColumnFilters,
      isColumnFilterActive,
      matchesColumnFilter,
      syncHeaderSortButtons,
      type ColumnFilterValue,
      type HeaderFilterController,
    } from '../../lib/table-column-filters'
    import { tableAction } from '../../lib/table-actions'
    import { initColumnLocks } from '../../lib/column-locks'
    import { bindFormDialog, type AppDialogs } from '../../lib/form-dialog'
    import { mountColorPluginHooks } from '../../lib/color-plugin-hooks'
    import { mountPluginUiLaunchers } from '../../lib/plugin-ui-launchers'
    import { bindFormState } from '../../lib/form-state'
    import { mountPanel } from '../../lib/panel-navigation'

    mountPanel('colors', async panelSignal => {
    await initI18n()
    const user = await getMe()
    if (panelSignal.aborted) return

    const modalForm = document.getElementById('modal-form') as HTMLFormElement
    const formState = bindFormState(modalForm, document.getElementById('modal-submit') as HTMLButtonElement)
    const formDialog = bindFormDialog(document.getElementById('modal-container') as HTMLDialogElement, { canClose: () => !formState.busy, onClose: () => colorHooks.close() })

    interface ColorRecord { id: number; name: string; hex_code: string; usage_count: number }
    type ColorSortKey = 'name' | 'hex_code' | 'usage_count'
    const dialogs = window as unknown as AppDialogs
    const isSortKey = (key: unknown): key is ColorSortKey => key === 'name' || key === 'hex_code' || key === 'usage_count'
    let colors: ColorRecord[] = []
    let editorUsage = 0
    let sortKey: ColorSortKey | null = 'name'
    let sortDirection: 'asc' | 'desc' | null = 'asc'
    let columnFilters: Record<string, ColumnFilterValue> = {}
    let colorHeaderFilters: HeaderFilterController | null = null
    let visibleColors: ColorRecord[] = []

    try {
      const saved: unknown = JSON.parse(localStorage.getItem('filaman-sort-colors') || 'null')
      if (saved && typeof saved === 'object' && 'key' in saved && isSortKey(saved.key) && 'direction' in saved && (saved.direction === 'asc' || saved.direction === 'desc')) {
        sortKey = saved.key
        sortDirection = saved.direction
      }
    } catch { /* ignore invalid data */ }
    
    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }
    
    let colorRequestId = 0
    async function loadColors(reset = true) {
      const requestId = ++colorRequestId
      try {
        const data = await fetchAllPages<ColorRecord>('/api/v1/colors')
        if (panelSignal.aborted || requestId !== colorRequestId) return
        colors = data.items
        colorHeaderFilters?.setOptions('name', colors.map(color => ({
          value: String(color.id),
          label: color.name,
          colorHexes: [color.hex_code],
        })))
        colorHeaderFilters?.setOptions('usage_count', [...new Set<number>(colors.map(color => color.usage_count))]
          .sort((left, right) => left - right)
          .map(value => ({ value: String(value), label: String(value) })))
        renderColors(reset)
      } catch (error) {
        if (panelSignal.aborted || requestId !== colorRequestId || isAbortError(error)) return
        colorList.pause()
        console.error('Failed to load colors:', error)
        document.getElementById('colors-table')!.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; color: var(--error-text);">${t('colors.failedLoad')}</td>
          </tr>
        `
        visibleColors = []
        cleanup.syncSelection()
      }
    }
    
    const colorList = initInventoryScroll<ColorRecord>(
      document.getElementById('colors-table')!, 'colors.colorCount', renderColorRows, () => cleanup.syncSelection(), panelSignal,
      () => ({ columns: columnFilters, sort: { key: sortKey, direction: sortDirection } }),
    )
    if (colorList.view) {
      columnFilters = colorList.view.columns
      const { key, direction } = colorList.view.sort
      sortKey = isSortKey(key) ? key : null
      sortDirection = direction
    }

    function renderColors(reset = true) {
      updateFilterReset()
      const filtered = Object.values(columnFilters).some(isColumnFilterActive)
      const selectAll = document.getElementById('color-select-matching')!
      selectAll.dataset.i18n = filtered ? 'colors.cleanup.selectMatching' : 'colors.cleanup.selectAll'
      selectAll.textContent = t(selectAll.dataset.i18n)
      visibleColors = colors.filter(color => Object.entries(columnFilters).every(([key, filter]) => {
        const value = key === 'name' ? String(color.id) : isSortKey(key) ? color[key] : undefined
        return matchesColumnFilter(value, filter)
      }))
      if (sortKey && sortDirection) {
        const direction = sortDirection
        const key = sortKey
        visibleColors.sort((a, b) => {
          const comparison = key === 'usage_count'
            ? a.usage_count - b.usage_count
            : a[key].localeCompare(b[key], undefined, { sensitivity: 'base' })
          return direction === 'asc' ? comparison : -comparison
        })
      }
      
      void colorList.load(inventoryLocalPages(() => visibleColors, false, filtered ? () => colors.length : undefined), reset)
    }

    function renderColorRows(items: ColorRecord[], append: boolean) {
      const tbody = document.getElementById('colors-table')!
      if (!items.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; color: var(--text-muted);">
              ${t('colors.noColors')}
            </td>
          </tr>
        `
        return
      }
      
      const rows = items.map(c => `
        <tr>
          <td><input type="checkbox" class="fm-checkbox" data-color-select="${c.id}" aria-label="${escapeHtml(t('colors.cleanup.selectColor', { name: c.name }))}" /></td>
          <td style="padding: 12px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="display: inline-block; width: 24px; height: 24px; border-radius: 50%; background: ${toColorSwatchBackground(c.hex_code)}; border: 1px solid var(--border);"></span>
              <span class="fm-color-name" title="${escapeHtml(c.name)}" style="font-weight: 500;">${escapeHtml(c.name)}</span>
            </div>
          </td>
          <td style="padding: 12px; font-family: monospace; color: var(--text-muted);">${escapeHtml(String(c.hex_code).toUpperCase())}</td>
          <td style="padding: 12px; color: var(--text-muted); font-size: 0.85rem;">
            ${colorUsageHtml(c.id, c.usage_count, t)}
          </td>
          <td style="padding: 12px; text-align: right;">
            <div class="fm-row-actions">${tableAction('edit', { id: c.id })}${tableAction('delete', { id: c.id, usage: c.usage_count }, { disabled: c.usage_count > 0, title: c.usage_count > 0 ? t('colors.inUseWarning') : undefined })}</div>
          </td>
        </tr>
      `).join('')
      if (append) tbody.insertAdjacentHTML('beforeend', rows)
      else tbody.innerHTML = rows
      tbody.closest('table')?.dispatchEvent(new Event('filaman:columns-changed'))
      
      translatePage()
    }

    document.getElementById('colors-table')!.addEventListener('click', async event => {
      const target = event.target
      if (!(target instanceof Element)) return
      const action = target.closest<HTMLButtonElement>('button.btn-edit, button.btn-delete')
      if (!action || action.disabled) return
      const id = Number(action.dataset.id)
      if (action.classList.contains('btn-edit')) {
        const color = colorList.get(id)
        if (color) openModal(color.id, color.name, color.hex_code)
        return
      }

      if ((colorList.get(id)?.usage_count ?? 0) > 0) {
        await dialogs.__fmAlert(t('colors.inUseWarning'))
        return
      }

      if (!(await dialogs.__fmConfirm(t('colors.confirmDelete')))) return

      try {
        const response = await fetch(`/api/v1/colors/${id}`, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          signal: getAbortSignal(),
        })

        if (!response.ok) {
          const data = await response.json()
          if (panelSignal.aborted) return
          await dialogs.__fmAlert(data.message || t('colors.failedDelete'))
          return
        }

        if (!panelSignal.aborted) loadColors()
      } catch {
        if (!panelSignal.aborted) await dialogs.__fmAlert(t('colors.failedDelete'))
      }
    })

    function applyColumnFilter(key: string, value: ColumnFilterValue) {
      if (isColumnFilterActive(value)) columnFilters[key] = value
      else delete columnFilters[key]
      renderColors()
    }

    const table = document.getElementById('colors-list-table') as HTMLTableElement
    const updateFilterReset = bindTableFilterControls({
      signal: panelSignal,
      hasColumnFilters: () => Object.values(columnFilters).some(isColumnFilterActive),
      onApply: renderColors,
      onClearColumns: () => {
        columnFilters = {}
        colorHeaderFilters?.resetAll()
        renderColors()
      },
    })

    function setupTableControls() {
      initColumnLocks(table, 'filaman-columns-colors', undefined, panelSignal)
      colorHeaderFilters = initHeaderColumnFilters(table, [
        {
          key: 'name',
          label: t('colors.name'),
          columnSelector: 'th.col-name',
          type: 'multi',
          multiDisplay: 'colors',
          options: [],
          initialValue: columnFilters.name,
          onApply: value => applyColumnFilter('name', value),
        },
        {
          key: 'hex_code',
          label: t('colors.hexCode'),
          columnSelector: 'th.col-hex',
          type: 'text',
          initialValue: columnFilters.hex_code,
          onApply: value => applyColumnFilter('hex_code', value),
        },
        {
          key: 'usage_count',
          label: t('colors.usage'),
          columnSelector: 'th.col-usage',
          type: 'number',
          autocomplete: true,
          initialValue: columnFilters.usage_count,
          presets: [
            { label: t('colors.cleanup.used'), value: { type: 'number', operator: 'gt', value: '0', valueTo: '' } },
            { label: t('colors.cleanup.unused'), value: { type: 'number', operator: 'eq', value: '0', valueTo: '' } },
          ],
          onApply: value => applyColumnFilter('usage_count', value),
        },
      ], panelSignal)
      syncHeaderSortButtons(table, sortKey, sortDirection)
      if (sortKey && sortDirection) {
        table.querySelector(`th[data-sort="${sortKey}"]`)?.classList.add(sortDirection === 'asc' ? 'sort-asc' : 'sort-desc')
      }

      table.tHead?.addEventListener('click', event => {
        const header = (event.target as HTMLElement).closest<HTMLElement>('th[data-sort]')
        if (!header) return
        const key = header.dataset.sort
        if (!isSortKey(key)) return
        if (sortKey !== key) {
          sortKey = key
          sortDirection = 'asc'
        } else if (sortDirection === 'asc') sortDirection = 'desc'
        else if (sortDirection === 'desc') {
          sortKey = null
          sortDirection = null
        } else sortDirection = 'asc'
        table.querySelectorAll('th[data-sort]').forEach(cell => cell.classList.remove('sort-asc', 'sort-desc'))
        if (sortKey && sortDirection) {
          header.classList.add(sortDirection === 'asc' ? 'sort-asc' : 'sort-desc')
          localStorage.setItem('filaman-sort-colors', JSON.stringify({ key: sortKey, direction: sortDirection }))
        } else localStorage.removeItem('filaman-sort-colors')
        syncHeaderSortButtons(table, sortKey, sortDirection)
        renderColors()
      })

    }
    
    let openRequest = 0
    async function openModal(id: number | null = null, name: string = '', hex: string = '#000000', usageCount?: number) {
      const request = ++openRequest
      if (id && usageCount === undefined) {
        try {
          const current = await api.get<ColorRecord>(`/colors/${id}`, {signal: panelSignal})
          if (request !== openRequest || panelSignal.aborted || formState.busy) return
          name = current.name; hex = current.hex_code; usageCount = current.usage_count
        } catch (error) {
          if (request === openRequest && !panelSignal.aborted && !isAbortError(error)) dialogs.__fmAlert(t('common.errorLoadingData'))
          return
        }
      }
      const title = document.getElementById('modal-title')!
      const idInput = document.getElementById('color-id') as HTMLInputElement
      const nameInput = document.getElementById('color-name') as HTMLInputElement
      const error = document.getElementById('modal-error')!
      
      title.textContent = id ? t('colors.editColor') : t('colors.addColor')
      editorUsage = usageCount || 0
      idInput.value = id ? String(id) : ''
      nameInput.value = name
      colorControls.reset(normalizeHexCode(hex) || '#000000')
      pickerWheel.reset()
      error.classList.add('hidden')
      
      formState.reset()
      formDialog.open()
      void colorHooks.refresh()
      nameInput.focus()
    }
    
    
    document.getElementById('btn-new')?.addEventListener('click', () => openModal())
    
    // Sync picker, opacity slider, and hex input
    const hexInput = document.getElementById('color-hex') as HTMLInputElement
    const picker = document.getElementById('color-picker') as HTMLInputElement
    const alphaEnabled = document.getElementById('color-alpha-enabled') as HTMLInputElement
    const alphaOptions = document.getElementById('color-alpha-options') as HTMLDivElement
    const alphaPreview = document.getElementById('color-alpha-preview') as HTMLSpanElement
    const alphaInput = document.getElementById('color-alpha') as HTMLInputElement
    const alphaValue = document.getElementById('color-alpha-value') as HTMLInputElement
    const alphaHex = document.getElementById('color-alpha-hex') as HTMLInputElement
    const colorControls = bindAlphaColorControls({
      picker,
      hexInput,
      alphaEnabled,
      alphaOptions,
      alphaPreview,
      alphaInput,
      alphaValueInput: alphaValue,
      alphaHexInput: alphaHex,
    })
    const colorHooks = mountColorPluginHooks(
      document.querySelector<HTMLElement>('[data-color-plugin-hooks]')!,
      document.getElementById('modal-container') as HTMLDialogElement,
      {
        read() {
          const id = Number((document.getElementById('color-id') as HTMLInputElement).value) || null
          return {mode: id ? 'edit' : 'create', color_id: id,
            usage_count: editorUsage,
            fields: {name: (document.getElementById('color-name') as HTMLInputElement).value,
              hex_code: normalizeHexCode(hexInput.value) || ''}}
        },
        busy: () => formState.busy,
        stage(value) {
          (document.getElementById('color-name') as HTMLInputElement).value = value.name
          colorControls.reset(value.hex_code)
          pickerWheel.reset()
          formState.update()
        },
        async openExisting(id, isCurrent, revalidate) {
          if (formState.busy || !isCurrent()) return false
          const signature = () => JSON.stringify(['color-id', 'color-name', 'color-hex'].map(key => (document.getElementById(key) as HTMLInputElement).value))
          const expected = signature()
          try {
            const account = await api.get<User>('/auth/me', {signal: panelSignal})
            if (!isCurrent() || formState.busy || !hasPermission(account, 'colors:update')) return false
            const existing = await api.get<ColorRecord>(`/colors/${id}`, {signal: panelSignal})
            if (!isCurrent() || formState.busy) return false
            if (modalForm.dataset.dirty === 'true' && !await dialogs.__fmConfirm(
              t('colors.confirmOpenExisting', {name: existing.name}), {okLabel: t('pluginLaunchers.openColor'), isDanger: false},
            )) return false
            const [currentUser, current, authorized] = await Promise.all([
              api.get<User>('/auth/me', {signal: panelSignal}), api.get<ColorRecord>(`/colors/${id}`, {signal: panelSignal}), revalidate(),
            ])
            if (!authorized || !isCurrent() || formState.busy || !hasPermission(currentUser, 'colors:update')
              || current.id !== id || expected !== signature()) return false
            openModal(current.id, current.name, current.hex_code, current.usage_count)
            return true
          } catch { return false }

        },
      }, panelSignal,
    )
    const pickerWheel = bindColorPickerPopup(document.getElementById('color-picker-popup')!, hexInput, panelSignal, formState.update)
    // Revert hidden alpha values too, so an opaque color can return to a clean state.
    alphaEnabled.addEventListener('change', () => {
      if (!alphaEnabled.checked) colorControls.syncFromHex()
    })
    
    document.getElementById('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const id = (document.getElementById('color-id') as HTMLInputElement).value
      const name = (document.getElementById('color-name') as HTMLInputElement).value
      const hex_code = normalizeHexCode((document.getElementById('color-hex') as HTMLInputElement).value)
      const error = document.getElementById('modal-error') as HTMLDivElement
      const submitBtn = document.getElementById('modal-submit') as HTMLButtonElement
      
      error.classList.add('hidden')
      if (formState.busy || !modalForm.reportValidity()) return
      formState.setBusy(true)
      colorHooks.updateEligibility()
      submitBtn.textContent = t('common.saving')
      
      try {
        const url = id ? `/api/v1/colors/${id}` : '/api/v1/colors'
        const method = id ? 'PATCH' : 'POST'
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify({ name, hex_code }),
          signal: getAbortSignal(),
        })
        
        if (!response.ok) {
          const errorData = await response.json()
          throw new Error(errorData.message || t('colors.failedSave'))
        }
        
        formState.setBusy(false)
        formDialog.close()
        loadColors()
      } catch (err) {
        if (isAbortError(err)) return
        error.textContent = err instanceof Error ? err.message : t('colors.failedSave')
        error.classList.remove('hidden')
      } finally {
        formState.setBusy(false)
        colorHooks.updateEligibility()
        submitBtn.textContent = t('common.save')
      }
    })
    
    const workspace = document.querySelector<HTMLElement>('.fm-main') || document.body
    const libraryHost = document.querySelector<HTMLElement>('[data-plugin-ui-launchers="colors.library"]')!
    void mountPluginUiLaunchers(libraryHost, {
      surface: 'colors.library', workspace, isEligible: () => ({enabled: true}), context: () => ({entity: 'colors'}),
    }, panelSignal).refresh()
    let selectionTools: ReturnType<typeof mountPluginUiLaunchers> | undefined = undefined
    const cleanup = bindColorCleanup({
      scope: document.body, getColors: () => colors, getVisible: () => visibleColors,
      reload: () => loadColors(), signal: panelSignal,
      canDelete: !!user && hasPermission(user, 'colors:delete'),
      canSelect: !!user && hasPermission(user, 'colors:update'),
      onSelectionChange: () => selectionTools?.updateEligibility(),
      canMerge: !!user && ['colors:update', 'colors:delete', 'filaments:update'].every(permission => hasPermission(user, permission)),
    })
    selectionTools = mountPluginUiLaunchers(
      document.querySelector<HTMLElement>('[data-plugin-ui-launchers="colors.selection"]')!, {
        surface: 'colors.selection', workspace,
        isEligible: () => ({enabled: cleanup.getSelectedIds().length > 0, reason: t('pluginLaunchers.selectRecords')}),
        context: () => ({color_ids: cleanup.getSelectedIds()}),
      }, panelSignal,
    )
    void selectionTools.refresh()
    setupTableControls()
    loadColors(false)

    // Live-Update via SSE: Farben automatisch neu laden
    let _colorsReloadTimer: ReturnType<typeof setTimeout> | null = null
    panelSignal.addEventListener('abort', () => clearTimeout(_colorsReloadTimer ?? undefined), { once: true })
    window.addEventListener('filaman:data-changed', (e: Event) => {
      const { event } = (e as CustomEvent).detail ?? {}
      if (event === 'resync' || event === 'colors_changed' || event === 'filaments_changed') {
        ++colorRequestId
        if (_colorsReloadTimer) clearTimeout(_colorsReloadTimer)
        _colorsReloadTimer = setTimeout(() => loadColors(), 300)
      }
    }, { signal: panelSignal })
    })
  </script>
</Layout>
