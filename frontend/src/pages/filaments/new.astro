---
import FilamentForm from '../../components/FilamentForm.astro'
import Layout from '../../layouts/Layout.astro'
---

<Layout title="FilaMan - New Filament">
  <div style="margin-bottom: 24px;">
    <a href="/filaments" style="color: var(--accent); text-decoration: none;">&larr; <span data-i18n="filaments.backToFilaments">Back to Filaments</span></a>
  </div>

  <FilamentForm mode="create" cancelHref="/filaments" />

  <script>
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { CACHE_KEYS, invalidateCachePrefix } from '../../lib/cache'
    import { createFilamentFormController } from '../../lib/filament-form'
    import { initI18n, t } from '../../lib/i18n'

    await initI18n()

    const form = document.getElementById('filament-form') as HTMLFormElement
    const csrfToken = () => {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }
    const controller = createFilamentFormController({
      form,
      mode: 'create',
      async onSubmit({ scalar, colors }) {
        const response = await fetch('/api/v1/filaments', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify({ ...scalar, colors }),
          signal: getAbortSignal(),
        })
        if (!response.ok) {
          const error = await response.json()
          throw new Error(error.detail?.message || error.message || t('filaments.failedCreate'))
        }
        invalidateCachePrefix(CACHE_KEYS.FILAMENTS)
        const filament = await response.json()
        window.location.href = `/filaments/${filament.id}`
      },
    })

    try {
      await controller.loadReferenceData()
      const duplicate = sessionStorage.getItem('filaman_duplicate_filament')
      if (duplicate) {
        sessionStorage.removeItem('filaman_duplicate_filament')
        controller.applyInitialData(JSON.parse(duplicate), 'duplicate')
      }
    } catch (error) {
      if (!isAbortError(error)) {
        console.error('Failed to initialize filament form:', error)
        controller.showError(error instanceof Error ? error.message : t('common.systemFieldsUnavailable'))
        controller.setSubmitting(true)
      }
    }
  </script>
</Layout>
