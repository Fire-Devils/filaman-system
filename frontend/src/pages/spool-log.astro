---
import Layout from '../layouts/Layout.astro'
---

<Layout title="FilaMan - Spool Log">
  <style>
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 16px;
      align-items: center;
    }
  </style>
  <style is:global>
    .pagination-container { display: flex; justify-content: space-between; align-items: center; }
    .pagination-pages { display: flex; gap: 4px; align-items: center; font-size: 0.8rem; }
    .pagination-pages :is(a, button) { color: var(--accent); cursor: pointer; padding: 2px 6px; text-decoration: none; border-radius: 3px; }
    .pagination-pages :is(a, button):hover { text-decoration: underline; background: color-mix(in srgb, var(--accent) 10%, transparent); }
    .pagination-pages .page-current { font-weight: 700; color: var(--accent); padding: 2px 8px; background: color-mix(in srgb, var(--accent) 15%, transparent); border-radius: 3px; }
    .pagination-pages .page-ellipsis { color: var(--text-muted); padding: 0 2px; }
    .fm-table .col-spool-id { width: 8rem; white-space: nowrap; }
    #spool-log-table th { white-space: nowrap; }
    #spool-log-table .fm-header-filter-wrap { display: inline-flex; float: none; vertical-align: middle; }
    .pagination-pages button { border: 0; background: none; font: inherit; cursor: pointer; }
  </style>
  <div class="fm-list-toolbar">
    <h1 data-i18n="spoolLog.title">Spool Log</h1>
  </div>

  <div class="filter-bar">
    <div class="fm-filter-search-wrap">
      <input type="search" id="filter-search" class="fm-input fm-input-search" data-i18n-placeholder="spoolLog.searchPlaceholder" data-i18n-aria-label="spoolLog.searchPlaceholder" aria-label="Search spool log" placeholder="Search spool, material, manufacturer or note…" maxlength="200" />
      <button id="filter-search-clear" class="fm-filter-search-clear" type="button" aria-label="Clear search" title="Clear search" data-i18n-aria-label="common.clearSearch" data-i18n-title="common.clearSearch">&times;</button>
    </div>
    <button id="filter-clear-columns" class="fm-btn fm-btn-outline" type="button" data-i18n="common.clearColumnFilters">Clear column filters</button>
    <button id="filter-clear" class="fm-btn fm-btn-outline" type="button" data-i18n="common.clearAllFilters">Clear all filters</button>
  </div>
  <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
    <div class="pagination-container" id="pagination-top" style="flex: 1;"></div>
  </div>

  <div class="fm-card fm-table-scroll" style="padding: 0;">
    <table id="spool-log-table" class="fm-table fm-admin-table">
      <thead>
        <tr>
          <th class="sortable col-spool-id" data-sort="spool" data-i18n="spoolLog.spool">Spool</th>
          <th class="sortable col-mfr-color" data-sort="mfr_color" data-i18n="spools.colMfrColor">Mfr. Color</th>
          <th class="sortable col-manufacturer" data-sort="manufacturer" data-i18n="spools.manufacturer">Manufacturer</th>
          <th class="sortable col-material" data-sort="material" data-i18n="spools.material">Material</th>
          <th class="sortable col-event-type" data-sort="event_type" data-i18n="spoolLog.eventType">Type</th>
          <th class="sortable col-event-at" data-sort="event_at" data-i18n="spoolLog.eventDate">Date</th>
          <th class="sortable col-weight" data-sort="weight" data-i18n="spoolLog.eventWeight">Weight</th>
          <th class="sortable col-note" data-sort="note" data-i18n="spoolLog.eventNote">Note</th>
        </tr>
      </thead>
      <tbody id="events-table">
        <tr>
          <td colspan="8" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="pagination-container" id="pagination" style="margin-top: 16px;"></div>

  <script>
    import { t, initI18n, translatePage } from '../lib/i18n'
    import { getAbortSignal, isAbortError } from '../lib/abort'
    import { toColorSwatchBackground } from '../lib/colors'
    import { escapeHtml } from '../lib/extra-fields'
    import { bindTableFilterControls, initHeaderColumnFilters, isColumnFilterActive, syncHeaderSortButtons, type ColumnFilterValue, type HeaderFilterDefinition } from '../lib/table-column-filters'

    await initI18n()

    interface EventColor { name: string; hex_code: string }
    interface LogEvent {
      id: number; spool_id: number; event_type: string; event_at: string
      manufacturer_name: string | null; manufacturer_color_name: string | null
      material_type: string | null; colors: EventColor[]
      measured_weight_g: number | null; delta_weight_g: number | null; note: string | null
    }

    let currentPage = 1
    let requestSequence = 0
    let sortKey = 'event_at'
    let sortDirection: 'asc' | 'desc' = 'desc'
    let columnFilters: Record<string, ColumnFilterValue> = {}
    const allowedPageSizes = [25, 50, 100, 150, 200]
    let pageSize = parseInt(localStorage.getItem('filaman-pagesize-spool-log') || '50', 10)
    if (!allowedPageSizes.includes(pageSize)) pageSize = 50

    async function loadEvents() {
      const sequence = ++requestSequence
      const params = new URLSearchParams({ page: String(currentPage), page_size: String(pageSize), sort_by: sortKey, sort_order: sortDirection })
      const search = (document.getElementById('filter-search') as HTMLInputElement).value.trim()
      if (search) params.set('search', search)
      if (Object.keys(columnFilters).length) {
        params.set('filters', JSON.stringify(columnFilters))
        params.set('timezone_name', Intl.DateTimeFormat().resolvedOptions().timeZone)
      }
      try {
        const response = await fetch(`/api/v1/spools/all-events?${params}`, {
          credentials: 'include',
          signal: getAbortSignal(),
        })

        if (!response.ok) throw new Error('Failed to fetch events')

        const data = await response.json()
        if (sequence !== requestSequence) return
        renderEvents(data.items)
        renderPagination(data.total, data.page)
      } catch (error) {
        if (isAbortError(error) || sequence !== requestSequence) return
        console.error('Failed to load events:', error)
        const tbody = document.getElementById('events-table')!
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--error-text);">${t('spoolLog.failedLoad')}</td></tr>`
      }
    }

    function renderEvents(events: LogEvent[]) {
      const tbody = document.getElementById('events-table')!

      if (events.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="text-align: center; color: var(--text-muted);">${t('spoolLog.noEvents')}</td>
          </tr>
        `
        return
      }

      tbody.innerHTML = events.map(e => `
        <tr>
          <td class="col-spool-id">
            <a href="/spools/${e.spool_id}" style="color: var(--accent); text-decoration: none; font-weight: 500;">#${e.spool_id}</a>
          </td>
          <td style="padding: 12px; font-size: 0.85rem; color: var(--text); white-space: nowrap;">
            <span style="display: inline-flex; align-items: center; gap: 6px;">${renderMfrColorCell(e.colors, e.manufacturer_color_name)}</span>
          </td>
          <td style="padding: 12px; font-size: 0.85rem; color: var(--text-muted);">${escapeHtml(e.manufacturer_name) || '-'}</td>
          <td style="padding: 12px; font-size: 0.85rem; color: var(--text-muted);">${escapeHtml(e.material_type) || '-'}</td>
          <td style="padding: 12px;">
            <span class="fm-pill" style="${getEventTypeStyle(e.event_type)}">${escapeHtml(e.event_type)}</span>
          </td>
          <td style="padding: 12px; font-size: 0.85rem; color: var(--text-muted);">
            ${new Date(e.event_at).toLocaleString()}
          </td>
          <td style="padding: 12px; font-family: monospace; font-size: 0.85rem;">
            ${e.measured_weight_g !== null ? e.measured_weight_g + ' g' : ''}
            ${e.delta_weight_g !== null ? (e.delta_weight_g > 0 ? '+' : '') + e.delta_weight_g + ' g' : ''}
          </td>
          <td style="padding: 12px; font-size: 0.85rem; color: var(--text-muted);">${escapeHtml(e.note) || '-'}</td>
        </tr>
      `).join('')
    }

    function normalizeHexColor(hex: string | null | undefined): string {
      const value = (hex || '').trim()
      if (!value) return ''
      return value.startsWith('#') ? value : `#${value}`
    }

    function renderColorDots(colors: EventColor[] | null | undefined): string {
      if (!colors || colors.length === 0) return ''
      return colors.map(c => {
        if (!c) return ''
        const hex = normalizeHexColor(c.hex_code)
        if (!hex) return ''
        const title = escapeHtml(c.name || '')
        return `<span title="${title}" style="display: inline-block; width: 18px; height: 18px; border-radius: 50%; background: ${toColorSwatchBackground(hex)}; border: 2px solid var(--border); vertical-align: middle; margin-right: 6px;"></span>`
      }).join('')
    }

    function renderMfrColorCell(
      colors: EventColor[] | null | undefined,
      manufacturerColorName: string | null | undefined
    ): string {
      const dots = renderColorDots(colors)
      const label = escapeHtml(manufacturerColorName)
      if (!dots && !label) return '<span style="color: var(--text-muted);">-</span>'
      if (!label) return dots
      if (!dots) return label
      return `${dots}<span>${label}</span>`
    }

    function getEventTypeStyle(type: string): string {
      const styles: Record<string, string> = {
        measurement: 'border-color: var(--accent-2); color: var(--accent-2);',
        adjustment: 'border-color: var(--accent); color: var(--accent);',
        consumption: 'border-color: var(--accent-3); color: var(--accent-3);',
        status_change: 'border-color: var(--accent-3); color: var(--accent-3);',
        move_location: 'border-color: var(--accent); color: var(--accent);',
      }
      return styles[type] || ''
    }

    function getPageNumbers(page: number, totalPages: number): (number | string)[] {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1)
      const pages = new Set([1, totalPages])
      for (let i = Math.max(2, page - 1); i <= Math.min(totalPages - 1, page + 1); i++) pages.add(i)
      const sorted = [...pages].sort((a, b) => (a as number) - (b as number))
      const result: (number | string)[] = []
      sorted.forEach((p, i) => {
        if (i > 0 && (p as number) - (sorted[i - 1] as number) > 1) result.push('\u2026')
        result.push(p)
      })
      return result
    }

    function buildPaginationHtml(total: number, page: number): string {
      const totalPages = Math.ceil(total / pageSize)
      if (totalPages <= 1 && total <= allowedPageSizes[0]) {
        return `<div style="font-size: 0.8rem; color: var(--text-muted);">${total} ${t('spoolLog.title')}</div>`
      }
      if (totalPages <= 1) {
        const pageSizeItems = allowedPageSizes.map(s => s === pageSize ? `<span class="page-current">${s}</span>` : `<button type="button" class="page-link page-size-link" data-size="${s}">${s}</button>`).join('')
        return `
          <div style="font-size: 0.8rem; color: var(--text-muted);">${total} ${t('spoolLog.title')}</div>
          <div></div>
          <div class="pagination-pages">
            <span style="color: var(--text-muted);">${t('common.perPage')}:</span>
            ${pageSizeItems}
          </div>
        `
      }
      const pageNumbers = getPageNumbers(page, totalPages)
      const pageItems = pageNumbers.map(p => {
        if (p === '\u2026') return `<span class="page-ellipsis">\u2026</span>`
        if (p === page) return `<span class="page-current">${p}</span>`
        return `<button type="button" class="page-link" data-page="${p}">${p}</button>`
      }).join('')
      const pageSizeItems = allowedPageSizes.map(s => s === pageSize ? `<span class="page-current">${s}</span>` : `<button type="button" class="page-link page-size-link" data-size="${s}">${s}</button>`).join('')
      return `
        <div style="font-size: 0.8rem; color: var(--text-muted);">
          ${t('common.showing')} ${((page - 1) * pageSize) + 1}-${Math.min(page * pageSize, total)} ${t('common.of')} ${total}
        </div>
        <div class="pagination-pages">
          <span style="color: var(--text-muted);">${t('common.page')}:</span>
          ${page > 1 ? `<button type="button" class="page-link page-prev" aria-label="${escapeHtml(t('common.previous'))}">\u2039</button>` : ''}
          ${pageItems}
          ${page < totalPages ? `<button type="button" class="page-link page-next" aria-label="${escapeHtml(t('common.next'))}">\u203A</button>` : ''}
        </div>
        <div class="pagination-pages">
          <span style="color: var(--text-muted);">${t('common.perPage')}:</span>
          ${pageSizeItems}
        </div>
      `
    }

    function renderPagination(total: number, page: number) {
      const totalPages = Math.ceil(total / pageSize)
      const html = buildPaginationHtml(total, page)
      document.getElementById('pagination-top')!.innerHTML = html
      document.getElementById('pagination')!.innerHTML = html

      document.querySelectorAll('.pagination-container').forEach(container => {
        container.querySelectorAll('.page-link[data-page]').forEach(link => {
          link.addEventListener('click', () => {
            currentPage = parseInt((link as HTMLElement).dataset.page!, 10)
            loadEvents()
            window.scrollTo({ top: 0, behavior: 'smooth' })
          })
        })
        container.querySelector('.page-prev')?.addEventListener('click', () => {
          if (page > 1) {
            currentPage = page - 1
            loadEvents()
            window.scrollTo({ top: 0, behavior: 'smooth' })
          }
        })
        container.querySelector('.page-next')?.addEventListener('click', () => {
          if (page < totalPages) {
            currentPage = page + 1
            loadEvents()
            window.scrollTo({ top: 0, behavior: 'smooth' })
          }
        })
        container.querySelectorAll('.page-size-link').forEach(link => {
          link.addEventListener('click', () => {
            pageSize = parseInt((link as HTMLElement).dataset.size!, 10)
            localStorage.setItem('filaman-pagesize-spool-log', String(pageSize))
            currentPage = 1
            loadEvents()
          })
        })
      })
    }

    const table = document.getElementById('spool-log-table') as HTMLTableElement
    function applyFilters() { currentPage = 1; void loadEvents() }
    const definitions: HeaderFilterDefinition[] = [
      ['spool', 'spoolLog.spool', 'col-spool-id', 'number'],
      ['mfr_color', 'spools.colMfrColor', 'col-mfr-color', 'text'],
      ['manufacturer', 'spools.manufacturer', 'col-manufacturer', 'text'],
      ['material', 'spools.material', 'col-material', 'text'],
      ['event_type', 'spoolLog.eventType', 'col-event-type', 'text'],
      ['event_at', 'spoolLog.eventDate', 'col-event-at', 'date'],
      ['weight', 'spoolLog.eventWeight', 'col-weight', 'number'],
      ['note', 'spoolLog.eventNote', 'col-note', 'text'],
    ].map(([key, label, column, type]) => ({
      key, label: t(label), columnSelector: `th.${column}`, type: type as 'text' | 'number' | 'date',
      onApply(value: ColumnFilterValue) {
        if (isColumnFilterActive(value)) columnFilters[key] = value
        else delete columnFilters[key]
        applyFilters()
      },
    }))
    const headerFilters = initHeaderColumnFilters(table, definitions)
    function syncSort() {
      table.querySelectorAll('th[data-sort]').forEach(cell => {
        cell.classList.toggle('sort-asc', cell.getAttribute('data-sort') === sortKey && sortDirection === 'asc')
        cell.classList.toggle('sort-desc', cell.getAttribute('data-sort') === sortKey && sortDirection === 'desc')
      })
      syncHeaderSortButtons(table, sortKey, sortDirection)
    }
    table.tHead?.addEventListener('click', event => {
      const header = (event.target as HTMLElement).closest<HTMLElement>('th[data-sort]')
      if (!header) return
      const key = header.dataset.sort!
      sortDirection = sortKey === key && sortDirection === 'asc' ? 'desc' : 'asc'
      sortKey = key
      syncSort()
      applyFilters()
    })
    function clearColumns() { columnFilters = {}; headerFilters.resetAll(); applyFilters() }
    bindTableFilterControls({ onApply: applyFilters, onClearColumns: clearColumns, onClearAll: clearColumns })
    syncSort()
    translatePage()
    loadEvents()
  </script>
</Layout>
