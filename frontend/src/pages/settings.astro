---
import Layout from '../layouts/Layout.astro'
import FormSection from '../components/FormSection.astro'
import ColorModePicker from '../components/ColorModePicker.astro'
---
<Layout title="FilaMan - Settings">
<div class="fm-settings-page fm-settings-profile">
  <div class="fm-list-toolbar"><h1 data-i18n="settings.title">Settings</h1></div>
  <div class="fm-settings-stack">
    <FormSection titleKey="settings.profile" title="Profile">
      <Fragment slot="actions"><button
          type="submit" form="profile-form"
          id="profile-btn" disabled
          class="fm-btn fm-btn-primary"

          data-i18n="settings.saveProfile"
        >
          Save Profile
        </button></Fragment>
      <form id="profile-form" class="fm-compact-form">
        <div>
          <label for="email" class="fm-label" data-i18n="settings.email">Email</label>
          <input
            type="email"
            id="email"
            disabled
            class="fm-input"
          />
        </div>

        <div>
          <label for="display_name" class="fm-label" data-i18n="settings.displayName">Display Name</label>
          <input
            type="text"
            id="display_name"
            name="display_name"
            class="fm-input"
          />
        </div>

        <div>
          <label for="language" class="fm-label" data-i18n="settings.language">Language</label>
          <select
            id="language"
            name="language"
            class="fm-select"
          >
            <option value="en" data-i18n="settings.langEn">English</option>
            <option value="de" data-i18n="settings.langDe">Deutsch</option>
            <!-- French (fr) locale — contributed by Nanostra (Frédéric Dubus) -->
            <option value="fr" data-i18n="settings.langFr">Français</option>
          </select>
        </div>

        <div id="profile-error" class="fm-alert-error hidden" role="alert"></div>
        <div id="profile-success" class="fm-alert-success hidden"></div>


      </form>
    </FormSection>
    <section class="fm-card fm-section settings-appearance" aria-labelledby="settings-appearance-title">
      <header class="fm-section-header"><h2 id="settings-appearance-title" data-i18n="settings.appearance">Appearance</h2></header>
      <div class="fm-section-body"><ColorModePicker /></div>
    </section>
    <a href="/settings/sidebar" class="fm-settings-link fm-card fm-section">
      <header class="fm-section-header"><h2 data-i18n="settings.sidebarTitle">Sidebar settings</h2><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></header>
      <div class="fm-section-body"><p class="fm-field-hint" data-i18n="settings.sidebarDescription">Choose which shortcuts appear and how they’re arranged.</p></div>
    </a>
    <a href="/settings/api-keys" class="fm-settings-link fm-card fm-section">
      <header class="fm-section-header"><h2 data-i18n="settings.apiKeys">API Keys</h2><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></header>
      <div class="fm-section-body"><p class="fm-field-hint" data-i18n="settings.apiKeysDesc">Manage API keys for external integrations like Bambuddy</p></div>
    </a>
    <FormSection titleKey="settings.tagScanner" title="Tag scanner">
      <p class="fm-field-hint" data-i18n="settings.browserOnly">Applies to this browser only.</p>
      <div class="fm-settings-row">
        <label for="scanner-auto-open" data-i18n="settings.scannerAutoOpen">Open the spool that was scanned</label>
        <label class="fm-toggle"><input type="checkbox" id="scanner-auto-open" /><span class="fm-toggle-slider"></span></label>
        <p class="fm-field-hint" data-i18n="settings.scannerAutoOpenHint">Put a spool on the scale and this browser follows to it.</p>
      </div>
      <div class="fm-settings-row"><label for="scanner-device" data-i18n="settings.scannerDevice">Reader</label>
        <select id="scanner-device" class="fm-select"><option value="" data-i18n="settings.scannerDeviceAny">Whichever scanned last</option></select>
        <p class="fm-field-hint" data-i18n="settings.scannerDeviceHint">Pick one if several scales are in use and this screen should follow only one of them.</p>
      </div>
    </FormSection>
    <FormSection titleKey="settings.changePassword" title="Change Password">
      <Fragment slot="actions"><button
          type="submit" form="password-form"
          id="password-btn" disabled
          class="fm-btn fm-btn-primary"

          data-i18n="settings.changePassword"
        >
          Change Password
        </button></Fragment>
      <form id="password-form" class="fm-compact-form">
        <div>
          <label for="current_password" class="fm-label" data-i18n="settings.currentPassword">Current Password</label>
          <input
            type="password"
            id="current_password"
            name="current_password"
            required
            autocomplete="current-password"
            class="fm-input"
          />
        </div>

        <div>
          <label for="new_password" class="fm-label" data-i18n="settings.newPassword">New Password</label>
          <input
            type="password"
            id="new_password"
            name="new_password"
            required
            autocomplete="new-password"
            minlength="8"
            class="fm-input"
          />
        </div>

        <div>
          <label for="confirm_password" class="fm-label" data-i18n="settings.confirmPassword">Confirm New Password</label>
          <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            required
            autocomplete="new-password"
            minlength="8"
            class="fm-input"
          />
        </div>

        <div id="password-error" class="fm-alert-error hidden" role="alert"></div>
        <div id="password-success" class="fm-alert-success hidden"></div>


      </form>
    </FormSection>
  </div>
</div>
  <script>
    import { t, initI18n } from '../lib/i18n'
    import { bindFormState } from '../lib/form-state'
    import { getAbortSignal, isAbortError } from '../lib/abort'
    import {
      getBoundReaderId,
      isAutoOpenEnabled,
      setAutoOpenEnabled,
      setBoundReaderId,
    } from '../lib/tag-scanner'
    await initI18n()

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    async function loadProfile() {
      try {
        const response = await fetch('/api/v1/me', { credentials: 'include', signal: getAbortSignal() })
        if (!response.ok) throw new Error('Failed to load profile')

        const user = await response.json()
        ;(document.getElementById('email') as HTMLInputElement).value = user.email
        ;(document.getElementById('display_name') as HTMLInputElement).value = user.display_name || ''
        ;(document.getElementById('language') as HTMLSelectElement).value = user.language
        profileState.reset()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load profile:', error)
      }
    }

    const profileForm = document.getElementById('profile-form') as HTMLFormElement
    const profileError = document.getElementById('profile-error') as HTMLDivElement
    const profileSuccess = document.getElementById('profile-success') as HTMLDivElement
    const profileBtn = document.getElementById('profile-btn') as HTMLButtonElement
    const profileState = bindFormState(profileForm, profileBtn)

    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault()

      if (profileState.busy || profileBtn.disabled || !profileForm.reportValidity()) return
      const formData = new FormData(profileForm)
      const data = {
        display_name: formData.get('display_name') || null,
        language: formData.get('language'),
      }

      profileError.classList.add('hidden')
      profileSuccess.classList.add('hidden')
      profileState.setBusy(true)
      profileBtn.textContent = t('common.saving')

      try {
        const response = await fetch('/api/v1/me', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          signal: getAbortSignal(),
          body: JSON.stringify(data),
        })

        if (!response.ok) {
          const errorData = await response.json().catch(() => null)
          const msg = errorData?.message || errorData?.detail || t('settings.profileFailed')
          throw new Error(typeof msg === 'string' ? msg : t('settings.profileFailed'))
        }

        profileState.reset()
        // If language changed, store and reload so the entire UI updates
        const selectedLang = formData.get('language') as string
        if (selectedLang !== localStorage.getItem('lang')) {
          localStorage.setItem('lang', selectedLang)
          window.location.reload()
          return
        }

        profileSuccess.textContent = t('settings.profileSaved')
        profileSuccess.classList.remove('hidden')
      } catch (error) {
        if (isAbortError(error)) return
        profileError.textContent = error instanceof Error ? error.message : t('settings.profileFailed')
        profileError.classList.remove('hidden')
      } finally {
        profileState.setBusy(false)
        profileBtn.textContent = t('settings.saveProfile')
      }
    })

    const passwordForm = document.getElementById('password-form') as HTMLFormElement
    const passwordError = document.getElementById('password-error') as HTMLDivElement
    const passwordSuccess = document.getElementById('password-success') as HTMLDivElement
    const passwordBtn = document.getElementById('password-btn') as HTMLButtonElement
    const passwordState = bindFormState(passwordForm, passwordBtn)
    passwordState.reset()

    passwordForm.addEventListener('submit', async (e) => {
      e.preventDefault()

      if (passwordState.busy || passwordBtn.disabled || !passwordForm.reportValidity()) return
      const formData = new FormData(passwordForm)
      const newPassword = formData.get('new_password') as string
      const confirmPassword = formData.get('confirm_password') as string

      passwordError.classList.add('hidden')
      passwordSuccess.classList.add('hidden')

      if (newPassword !== confirmPassword) {
        passwordError.textContent = t('settings.passwordsNoMatch')
        passwordError.classList.remove('hidden')
        return
      }

      if (newPassword.length < 8) {
        passwordError.textContent = t('settings.passwordTooShort')
        passwordError.classList.remove('hidden')
        return
      }

      const data = {
        current_password: formData.get('current_password'),
        new_password: newPassword,
      }

      passwordState.setBusy(true)
      passwordBtn.textContent = t('settings.changingPassword')

      try {
        const response = await fetch('/api/v1/me/change-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          signal: getAbortSignal(),
          body: JSON.stringify(data),
        })

        if (!response.ok) {
          const errorData = await response.json().catch(() => null)
          const msg = errorData?.message || errorData?.detail || t('settings.passwordFailed')
          throw new Error(typeof msg === 'string' ? msg : t('settings.passwordFailed'))
        }

        passwordSuccess.textContent = t('settings.passwordChanged')
        passwordSuccess.classList.remove('hidden')
        passwordForm.reset()
        passwordState.reset()
      } catch (error) {
        if (isAbortError(error)) return
        passwordError.textContent = error instanceof Error ? error.message : t('settings.passwordFailed')
        passwordError.classList.remove('hidden')
      } finally {
        passwordState.setBusy(false)
        passwordBtn.textContent = t('settings.changePassword')
      }
    })

    // ── Tag scanner ────────────────────────────────────────────────────
    // Stored in this browser, not on the account: the kiosk on the wall and the
    // laptop in the workshop want opposite things from the same login.
    const autoOpenInput = document.getElementById('scanner-auto-open') as HTMLInputElement
    const deviceSelect = document.getElementById('scanner-device') as HTMLSelectElement

    autoOpenInput.checked = isAutoOpenEnabled()
    autoOpenInput.addEventListener('change', () => {
      setAutoOpenEnabled(autoOpenInput.checked)
    })

    deviceSelect.addEventListener('change', () => {
      setBoundReaderId(deviceSelect.value || null)
    })

    async function loadScannerReaders() {
      const bound = getBoundReaderId()
      try {
        // Readers, not devices: a reader may be a scale, an app on an API key
        // or anything else that reports a scan, and only the scale has a row
        // in the device registry.
        const response = await fetch('/api/v1/tag/readers', {
          credentials: 'include',
          signal: getAbortSignal(),
        })
        if (!response.ok) return
        const readers = await response.json()
        for (const reader of Array.isArray(readers) ? readers : []) {
          const option = document.createElement('option')
          option.value = reader.reader_id
          option.textContent = reader.name || reader.reader_id
          deviceSelect.appendChild(option)
        }
      } catch (error) {
        // A reader list that cannot be loaded still leaves "whichever scanned
        // last" selectable, which is the useful default anyway.
        if (!isAbortError(error)) console.error(error)
      }
      // After the options exist, so a stored choice actually takes. A reader
      // only appears once it has scanned, so one that has not reported since
      // the last restart gets an entry of its own rather than silently reading
      // as "whichever scanned last".
      if (bound && !deviceSelect.querySelector(`option[value="${CSS.escape(bound)}"]`)) {
        const option = document.createElement('option')
        option.value = bound
        option.textContent = t('settings.scannerDeviceOffline', { id: bound })
        deviceSelect.appendChild(option)
      }
      deviceSelect.value = bound || ''
    }

    loadProfile()
    loadScannerReaders()
  </script>
</Layout>
