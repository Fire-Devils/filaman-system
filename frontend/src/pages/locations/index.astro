---
import FormDialog from '../../components/FormDialog.astro'
import Layout from '../../layouts/Layout.astro'
---

<Layout panel="locations" title="FilaMan - Locations">
  <div class="fm-list-toolbar">
    <h1 style="font-weight: 700; margin: 0; font-family: var(--font-serif);" data-i18n="locations.title">Locations</h1>
    <button
      id="btn-new"
      class="fm-btn fm-btn-primary"
      data-i18n="locations.addLocation"
    >
      Add Location
    </button>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;">
    <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem;">
      <span data-i18n="locations.filterType">Type</span>
      <select id="type-filter" class="fm-select" style="width: auto; min-width: 160px;"></select>
    </label>
    <div class="col-picker-wrap">
      <button id="btn-columns" class="fm-btn fm-btn-outline" style="padding: 5px 10px; font-size: 0.8rem; display: flex; align-items: center; gap: 5px; white-space: nowrap;">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
        <span data-i18n="common.columns">Spalten</span>
      </button>
      <div id="columns-dropdown" class="col-picker-dropdown"></div>
    </div>
  </div>

  <div class="fm-card" style="padding: 0;">
    <style>
      .spinner {
        display: inline-block;
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid var(--border);
        border-radius: 50%;
        border-top-color: var(--accent);
        animation: spin 1s linear infinite;
        vertical-align: middle;
        margin-right: 8px;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
    <style is:global>
      /* Write-in box sits under the Type select, in the control column. */
      .fm-compact-form .location-type-custom { grid-column: -2; }
    </style>
    <table class="fm-table fm-admin-table">
      <thead>
        <tr>
          <th style="width: 40px; text-align: center;"><input type="checkbox" id="bulk-select-all" class="fm-checkbox bulk-checkbox" aria-label="Select shown locations" data-i18n-aria-label="locations.selectShown" /></th>
          <th class="col-name" data-i18n="locations.name">Name</th>
          <th class="col-type" data-i18n="locations.type">Type</th>
          <th class="col-identifier" data-i18n="locations.identifier">Identifier</th>
          <th class="col-spools" style="text-align: right;" data-i18n="locations.spools">Spools</th>
          <th style="text-align: right;" data-i18n="common.actions">Actions</th>
          <th style="width: 40px;"></th>
        </tr>
      </thead>
      <tbody id="locations-table">
        <tr>
          <td colspan="7" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <FormDialog id="modal-container" titleId="modal-title" titleKey="locations.addLocation" title="Add Location" >
    <Fragment slot="actions">
      <button type="submit" form="modal-form" id="modal-submit" disabled class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
      <button type="button" id="modal-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
    <form id="modal-form" class="fm-compact-form">
        <input type="hidden" id="location-id" />
        <div>
          <label for="location-name" class="fm-label">
            <span data-i18n="locations.name">Name</span> *
          </label>
          <input
            type="text"
            id="location-name"
            required
            class="fm-input"
          />
        </div>
        <div>
          <label for="location-type" class="fm-label" data-i18n="locations.type">Type</label>
          <select id="location-type" class="fm-select"></select>
          <input
            type="text"
            id="location-type-custom"
            class="fm-input hidden location-type-custom"
            maxlength="50"
            pattern=".*\S.*"
            data-i18n-placeholder="locations.typeWriteInPlaceholder"
            placeholder="New type name"
          />
          <p id="location-type-hint" class="hidden" style="margin: 6px 0 0; color: var(--text-muted); font-size: 0.8rem;"></p>
        </div>
        <div>
          <label for="location-identifier" class="fm-label" data-i18n="locations.identifier">
            Identifier
          </label>
          <input
            type="text"
            id="location-identifier"
            class="fm-input"
          />
          <p id="location-identifier-hint" class="hidden" style="margin: 6px 0 0; color: var(--text-muted); font-size: 0.8rem;"></p>
        </div>
        <div id="modal-error" class="fm-alert-error hidden" role="alert"></div>
    </form>
  </FormDialog>

  <FormDialog id="bulk-type-modal" titleId="bulk-type-title" titleKey="locations.bulkChangeType" title="Change Type">
    <Fragment slot="actions">
      <button type="submit" form="bulk-type-form" id="bulk-type-submit" class="fm-btn fm-btn-primary" data-i18n="common.save">Save</button>
      <button type="button" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
    <form id="bulk-type-form" class="fm-compact-form">
      <p id="bulk-type-text" style="margin: 0;"></p>
      <p id="bulk-type-hint" class="hidden" style="margin: 0; color: var(--text-muted); font-size: 0.85rem;"></p>
        <div>
          <label for="bulk-type" class="fm-label" data-i18n="locations.type">Type</label>
          <select id="bulk-type" class="fm-select"></select>
          <input
            type="text"
            id="bulk-type-custom"
            class="fm-input hidden location-type-custom"
            maxlength="50"
            pattern=".*\S.*"
            data-i18n-placeholder="locations.typeWriteInPlaceholder"
            placeholder="New type name"
          />
        </div>
    </form>
  </FormDialog>

  <div id="bulk-action-bar" class="bulk-action-bar">
    <span class="bulk-count" id="bulk-count"></span>
    <button class="fm-btn fm-btn-outline" id="bulk-btn-type" data-i18n="locations.bulkChangeType">Change Type</button>
    <button class="fm-btn fm-btn-danger" id="bulk-btn-delete" data-i18n="locations.bulkDelete">Delete</button>
    <button class="fm-btn fm-btn-outline" id="bulk-btn-clear" data-i18n="locations.bulkClear">Clear Selection</button>
  </div>

  <FormDialog id="rfid-modal" titleId="rfid-title" titleKey="rfid.writeTag" title="Write RFID Tag">
    <Fragment slot="actions">
      <button type="button" id="rfid-confirm" class="fm-btn fm-btn-primary" data-i18n="common.confirm">Confirm</button>
      <button type="button" id="rfid-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
    </Fragment>
      <div id="rfid-content">
        <p style="margin-bottom: 16px;" id="rfid-text"></p>
        <div id="rfid-device-select-container" class="hidden">
          <label for="rfid-device-select" class="fm-label" data-i18n="rfid.selectDevice">Select Device</label>
          <select id="rfid-device-select" class="fm-select" style="margin-bottom: 16px;"></select>
        </div>
        <div id="rfid-warning" class="fm-alert fm-alert-warning hidden" style="margin-bottom: 16px;" data-i18n="rfid.tagAlreadyExistsWarning"></div>
      </div>
      <div id="rfid-status" class="fm-alert hidden" style="margin-bottom: 16px;"></div>
  </FormDialog>

  <script>
    import { t, initI18n, translatePage } from '../../lib/i18n'
    import { cachedFetchAllPages, invalidateCachePrefix, CACHE_KEYS } from '../../lib/cache'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { initColumnPicker, type ColumnGroup } from '../../lib/column-picker'
    import { initColumnResize } from '../../lib/column-resize'
    import { escapeHtml } from '../../lib/extra-fields'
    import { tableAction } from '../../lib/table-actions'
    import { bindFormDialog } from '../../lib/form-dialog'
    import { bindFormState } from '../../lib/form-state'
    import { mountPanel } from '../../lib/panel-navigation'
    import { isDriverManagedLocation } from '../../lib/driver-managed-locations'
    import {
      TYPE_FILTER_ALL,
      TYPE_FILTER_NONE,
      TYPE_WRITE_IN,
      decodeTypeOption,
      encodeTypeOption,
      locationTypeOptions,
      matchesTypeFilter,
      resolveKnownType,
    } from '../../lib/location-types'

    mountPanel('locations', async (panelSignal) => {
    await initI18n()

    const modalForm = document.getElementById('modal-form') as HTMLFormElement
    const formState = bindFormState(modalForm, document.getElementById('modal-submit') as HTMLButtonElement)
    const formDialog = bindFormDialog(document.getElementById('modal-container') as HTMLDialogElement, { canClose: () => !formState.busy })

    interface LocationRecord { id: number; name: string; identifier: string | null; location_type: string | null; custom_fields?: Record<string, unknown> | null; spool_count: number }
    interface ActiveDevice { id: number; name: string; ip_address: string | null }
    interface BulkResult { updated: number[]; deleted: number[]; skipped: number[]; not_found: number[] }
    const dialogs = window as unknown as {
      __fmConfirm: (message: string, options?: { title?: string; okLabel?: string; isDanger?: boolean }) => Promise<boolean>
      __fmAlert: (message: string) => Promise<boolean>
      __fmSuccess: (message: string) => Promise<boolean>
    }
    let locations: LocationRecord[] = []
    let activeDevices: ActiveDevice[] = []
    const selectedIds = new Set<number>()

    const FILTER_KEY = 'filaman-locations-type-filter'
    const typeFilter = document.getElementById('type-filter') as HTMLSelectElement
    let currentFilter = TYPE_FILTER_ALL
    try { currentFilter = localStorage.getItem(FILTER_KEY) ?? TYPE_FILTER_ALL } catch { /* storage blocked */ }

    function knownTypes(): string[] {
      return locationTypeOptions(locations.map(loc => loc.location_type))
    }

    function visibleLocations(): LocationRecord[] {
      return locations.filter(loc => matchesTypeFilter(loc.location_type, currentFilter))
    }

    function renderTypeFilter() {
      const types = knownTypes()
      // A saved filter whose type no longer exists would hide every row.
      if (currentFilter !== TYPE_FILTER_ALL && currentFilter !== TYPE_FILTER_NONE) {
        const raw = decodeTypeOption(currentFilter) ?? currentFilter
        const resolved = resolveKnownType(types, raw)
        currentFilter = resolved ? encodeTypeOption(resolved) : TYPE_FILTER_ALL
      }
      typeFilter.innerHTML = [
        `<option value="${TYPE_FILTER_ALL}">${escapeHtml(t('locations.filterAll'))}</option>`,
        ...types.map(type => `<option value="${escapeHtml(encodeTypeOption(type))}">${escapeHtml(type)}</option>`),
        `<option value="${TYPE_FILTER_NONE}">${escapeHtml(t('locations.typeNone'))}</option>`,
      ].join('')
      typeFilter.value = currentFilter
    }

    typeFilter.addEventListener('change', () => {
      currentFilter = typeFilter.value
      try { localStorage.setItem(FILTER_KEY, currentFilter) } catch { /* storage blocked */ }
      // Bulk actions only ever apply to rows you can see.
      const shown = new Set(visibleLocations().map(loc => loc.id))
      for (const id of selectedIds) if (!shown.has(id)) selectedIds.delete(id)
      renderLocations()
    }, { signal: panelSignal })

    let bulkTypeBusy = false

    function fillTypePicker(prefix: string, current: string | null, allowNone = true) {
      const select = document.getElementById(`${prefix}-type`) as HTMLSelectElement
      const custom = document.getElementById(`${prefix}-type-custom`) as HTMLInputElement
      const types = knownTypes()
      const resolved = resolveKnownType(types, current)
      const needsPlaceholder = !allowNone && !resolved && !current?.trim()
      select.dataset.allowNone = String(allowNone)
      select.required = !allowNone
      select.innerHTML = [
        ...(allowNone ? [`<option value="">${escapeHtml(t('locations.typeNone'))}</option>`] : []),
        ...(needsPlaceholder ? [`<option value="" disabled>${escapeHtml(t('locations.selectTypePlaceholder'))}</option>`] : []),
        ...types.map(type => `<option value="${escapeHtml(encodeTypeOption(type))}">${escapeHtml(type)}</option>`),
        `<option value="${TYPE_WRITE_IN}">${escapeHtml(t('locations.typeWriteIn'))}</option>`,
      ].join('')
      if (resolved) {
        select.value = encodeTypeOption(resolved)
        custom.value = ''
      } else if (current?.trim()) {
        select.value = TYPE_WRITE_IN
        custom.value = current.trim()
      } else {
        select.value = ''
        custom.value = ''
      }
      syncTypePicker(prefix, false)
    }

    function syncTypePicker(prefix: string, focusCustom = true) {
      const select = document.getElementById(`${prefix}-type`) as HTMLSelectElement
      const custom = document.getElementById(`${prefix}-type-custom`) as HTMLInputElement
      const writeIn = select.value === TYPE_WRITE_IN
      custom.classList.toggle('hidden', !writeIn)
      custom.required = writeIn
      if (prefix === 'bulk') {
        const submit = document.getElementById('bulk-type-submit') as HTMLButtonElement | null
        const unchosen = select.dataset.allowNone === 'false' && select.value === ''
        if (submit) submit.disabled = bulkTypeBusy || unchosen
      }
      if (writeIn && focusCustom) custom.focus()
    }

    function normalizeWriteIn(prefix: string) {
      const select = document.getElementById(`${prefix}-type`) as HTMLSelectElement
      const custom = document.getElementById(`${prefix}-type-custom`) as HTMLInputElement
      if (select.value === TYPE_WRITE_IN) custom.value = custom.value.trim()
    }

    function readTypePicker(prefix: string): string | null {
      const select = document.getElementById(`${prefix}-type`) as HTMLSelectElement
      const custom = document.getElementById(`${prefix}-type-custom`) as HTMLInputElement
      const value = select.value === TYPE_WRITE_IN
        ? custom.value
        : decodeTypeOption(select.value) ?? select.value
      return value.trim() || null
    }

    for (const prefix of ['location', 'bulk']) {
      document.getElementById(`${prefix}-type`)?.addEventListener('change', () => syncTypePicker(prefix), { signal: panelSignal })
    }
    
    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function extractApiError(data: Record<string, unknown>, fallback: string): string {
      const detail = data.detail
      if (typeof detail === 'string' && detail) return detail
      if (Array.isArray(detail) && typeof detail[0]?.msg === 'string') return detail[0].msg
      if (detail && typeof detail === 'object' && 'message' in detail && typeof detail.message === 'string' && detail.message) {
        return detail.message
      }
      return typeof data.message === 'string' && data.message ? data.message : fallback
    }
    
    async function loadActiveDevices() {
      try {
        const res = await fetch('/api/v1/devices/active', { credentials: 'include', signal: getAbortSignal() })
        if (res.ok) {
          activeDevices = await res.json()
        }
      } catch (e) {
        if (isAbortError(e)) return
        console.error('Failed to load active devices:', e)
      }
    }

    async function loadLocations() {
      try {
        const data = await cachedFetchAllPages<LocationRecord>(CACHE_KEYS.LOCATIONS, '/api/v1/locations')
        locations = data.items
        renderTypeFilter()
        // A live reload can delete a selected location or move it out of the
        // current filter; bulk actions must only ever cover rows on screen.
        const shown = new Set(visibleLocations().map(loc => loc.id))
        for (const id of selectedIds) if (!shown.has(id)) selectedIds.delete(id)
        renderLocations()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load locations:', error)
        document.getElementById('locations-table')!.innerHTML = `
          <tr>
            <td colspan="7" style="text-align: center; color: var(--error-text);">${t('locations.failedLoad')}</td>
          </tr>
        `
      }
    }
    
    function renderLocations() {
      const tbody = document.getElementById('locations-table')!
      
      const shown = visibleLocations()
      if (shown.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align: center; color: var(--text-muted);">
              ${t(locations.length === 0 ? 'locations.noLocations' : 'locations.noMatches')}
            </td>
          </tr>
        `
        updateBulkBar()
        return
      }
      
      tbody.innerHTML = shown.map(loc => {
        const managed = isDriverManagedLocation(loc)
        // A driver slot's identifier is the AMS address, not a location tag.
        const hasTag = !!loc.identifier && !managed
        const isOnline = activeDevices.length > 0
        const canWrite = isOnline && !managed
        const iconColor = hasTag ? 'color: #10b981;' : 'color: var(--text-muted);'
        const tooltip = managed
          ? t('rfid.driverManagedTooltip')
          : isOnline ? t('rfid.writeTag') : t('rfid.noDeviceOnlineTooltip')
        
        const rfidIcon = `
          <td style="padding: 12px; text-align: center;" onclick="event.stopPropagation()">
            <button type="button" class="fm-btn" data-rfid-location="${loc.id}"
                    style="border: none !important; background: transparent; padding: 4px; line-height: 0; ${iconColor} ${!canWrite ? 'cursor: not-allowed; opacity: 0.6;' : ''}" 
                    title="${tooltip}"
                    ${!canWrite ? 'disabled' : ''}>
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 135.18028 115.18283" fill="currentColor" style="vertical-align: middle;"><g transform="translate(-37.583451,-63.372624)"><path d="m 70.222963,178.33313 c -2.040926,-0.39862 -7.168348,-4.13124 -11.835405,-8.61585 -11.236022,-10.7968 -18.197641,-24.54085 -20.318866,-40.11476 -0.914987,-6.71777 -0.506732,-16.35742 0.977968,-23.09161 2.31059,-10.480198 7.418829,-20.910018 14.204507,-29.002258 4.136212,-4.93262 11.33237,-11.25913 15.203175,-13.36589 3.228084,-1.75694 6.735163,-0.32453 7.658584,3.12804 0.247595,0.92573 0.239278,1.4288 -0.04012,2.4267 -0.455391,1.6265 -1.235816,2.52818 -3.546301,4.0973 -2.718612,1.84629 -6.655458,5.21243 -8.886438,7.5982 -8.337084,8.91553 -13.388674,19.334498 -15.242672,31.438188 -0.606927,3.96229 -0.606927,12.1773 0,16.13959 2.48356,16.21374 10.951629,29.82811 24.433921,39.28314 2.570726,1.80283 3.338858,2.98296 3.338858,5.12972 0,1.75821 -0.610733,3.02689 -1.972927,4.0984 -0.557741,0.43872 -2.492716,1.15289 -2.888792,1.06621 -0.07276,-0.0159 -0.561233,-0.11273 -1.085496,-0.21512 z m 67.475117,-0.10858 c -2.76471,-1.00625 -4.15566,-3.49487 -3.42065,-6.12008 0.4554,-1.6265 1.23582,-2.52818 3.54631,-4.0973 2.71861,-1.84629 6.65545,-5.21242 8.88643,-7.5982 8.33709,-8.91553 13.38868,-19.3345 15.24267,-31.43819 0.60693,-3.96229 0.60693,-12.1773 0,-16.13959 -2.48355,-16.213738 -10.95162,-29.828108 -24.43392,-39.283138 -2.57072,-1.80283 -3.33885,-2.98296 -3.33885,-5.12972 0,-1.31289 0.13178,-1.83293 0.66238,-2.61377 1.79517,-2.64183 4.51786,-3.15763 7.48598,-1.4182 3.97325,2.32848 10.82063,8.41172 14.77065,13.12229 6.78568,8.09224 11.89391,18.52206 14.2045,29.002258 1.94688,8.83047 1.94688,19.94969 0,28.78015 -2.31059,10.4802 -7.41882,20.91002 -14.2045,29.00226 -4.09611,4.8848 -11.38152,11.30257 -15.09913,13.30093 -1.58248,0.85065 -3.08971,1.07148 -4.30187,0.6303 z M 82.288667,161.67534 c -3.491247,-1.68198 -8.945231,-6.03926 -12.155513,-9.71126 -15.69411,-