            </button>
          </td>
        `;


        return `
        <tr class="${selectedIds.has(loc.id) ? 'bulk-selected' : ''}" style="cursor: pointer;" onclick="window.location='/spools?location_id=${loc.id}'">
          <td style="padding: 12px; text-align: center;" onclick="event.stopPropagation()">
            <input type="checkbox" class="fm-checkbox bulk-checkbox" data-location-id="${loc.id}" aria-label="${escapeHtml(t('locations.selectLocation', { name: loc.name }))}" ${selectedIds.has(loc.id) ? 'checked' : ''} />
          </td>
          <td class="col-name" style="padding: 12px; font-weight: 500;">${escapeHtml(loc.name)}</td>
          <td class="col-type" style="padding: 12px; color: var(--text-muted);">${escapeHtml(loc.location_type || '-')}</td>
          <td class="col-identifier" style="padding: 12px; color: var(--text-muted); font-family: monospace; font-size: 0.85rem;">${escapeHtml(loc.identifier || '-')}</td>
          <td class="col-spools" style="padding: 12px; text-align: right; color: var(--text-muted);">${loc.spool_count || 0}</td>
          <td style="padding: 12px; text-align: right;" onclick="event.stopPropagation()">
            <div class="fm-row-actions">${tableAction('edit', { id: loc.id })}${tableAction('delete', { id: loc.id })}</div>
          </td>
          ${rfidIcon}
        </tr>
      `}).join('')
      
      translatePage()
      updateBulkBar()

      tbody.querySelectorAll<HTMLInputElement>('input[data-location-id]').forEach(cb => {
        cb.addEventListener('change', () => {
          const id = Number(cb.dataset.locationId)
          if (cb.checked) selectedIds.add(id)
          else selectedIds.delete(id)
          cb.closest('tr')?.classList.toggle('bulk-selected', cb.checked)
          updateBulkBar()
        })
      })

      tbody.querySelectorAll<HTMLButtonElement>('button[data-rfid-location]').forEach(button => {
        button.addEventListener('click', () => openRfidModal(Number(button.dataset.rfidLocation)))
      })

      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const location = locations.find(location => location.id === Number(target.dataset.id))
          if (location) openModal(location)
        })
      })
      
      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement
          const id = parseInt(target.dataset.id!)
          
          const location = locations.find(loc => loc.id === id)
          if (!(await dialogs.__fmConfirm(t('locations.confirmDelete', { name: location?.name ?? `#${id}` }), {
            title: t('locations.bulkDelete'),
            okLabel: t('locations.bulkDelete'),
            isDanger: true,
          }))) return
          
          try {
            const response = await fetch(`/api/v1/locations/${id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': getCsrfToken() },
              credentials: 'include',
              signal: getAbortSignal(),
            })
            
            if (!response.ok) {
              const data = await response.json().catch(() => ({}))
              if (panelSignal.aborted) return
              await dialogs.__fmAlert(extractApiError(data, t('locations.failedDelete')))
              return
            }
            
            // Invalidate cache after successful delete
            invalidateCachePrefix(CACHE_KEYS.LOCATIONS)
            if (!panelSignal.aborted) loadLocations()
          } catch {
            if (!panelSignal.aborted) await dialogs.__fmAlert(t('locations.failedDelete'))
          }
        })
      })
    }
    
    function openModal(location?: LocationRecord) {
      const title = document.getElementById('modal-title')!
      const idInput = document.getElementById('location-id') as HTMLInputElement
      const nameInput = document.getElementById('location-name') as HTMLInputElement
      const identifierInput = document.getElementById('location-identifier') as HTMLInputElement
      const error = document.getElementById('modal-error')!
      
      title.textContent = location ? t('locations.editLocation') : t('locations.addLocation')
      idInput.value = location ? String(location.id) : ''
      nameInput.value = location?.name ?? ''
      identifierInput.value = location?.identifier ?? ''
      // New locations start out as whatever the list is filtered to.
      const filterRaw = currentFilter === TYPE_FILTER_ALL || currentFilter === TYPE_FILTER_NONE
        ? null
        : decodeTypeOption(currentFilter) ?? currentFilter
      const filterType = resolveKnownType(knownTypes(), filterRaw)
      const managed = Boolean(location && isDriverManagedLocation(location))
      const allowNone = !managed
      fillTypePicker('location', location ? location.location_type : filterType, allowNone)
      const typeHint = document.getElementById('location-type-hint')!
      typeHint.textContent = managed ? t('locations.typeManagedHint') : ''
      typeHint.classList.toggle('hidden', !managed)
      identifierInput.readOnly = managed
      const identifierHint = document.getElementById('location-identifier-hint')!
      identifierHint.textContent = managed ? t('locations.identifierManaged') : ''
      identifierHint.classList.toggle('hidden', !managed)
      error.classList.add('hidden')
      
      formState.reset()
      formDialog.open()
      nameInput.focus()
    }
    
    
    document.getElementById('btn-new')?.addEventListener('click', () => openModal())
    
    document.getElementById('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const id = (document.getElementById('location-id') as HTMLInputElement).value
      const name = (document.getElementById('location-name') as HTMLInputElement).value
      const identifier = (document.getElementById('location-identifier') as HTMLInputElement).value || null
      const error = document.getElementById('modal-error') as HTMLDivElement
      const submitBtn = document.getElementById('modal-submit') as HTMLButtonElement
      
      error.classList.add('hidden')
      if (formState.busy) return
      normalizeWriteIn('location')
      if (!modalForm.reportValidity()) return

      const data = { name, identifier, location_type: readTypePicker('location') }
      formState.setBusy(true)
      submitBtn.textContent = t('common.saving')
      
      try {
        const url = id ? `/api/v1/locations/${id}` : '/api/v1/locations'
        const method = id ? 'PATCH' : 'POST'
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          signal: getAbortSignal(),
          body: JSON.stringify(data),
        })
        
        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}))
          throw new Error(extractApiError(errorData, t('locations.failedSave')))
        }
        
        // Invalidate cache after successful save
        invalidateCachePrefix(CACHE_KEYS.LOCATIONS)
        formState.setBusy(false)
        formDialog.close()
        loadLocations()
      } catch (err) {
        if (isAbortError(err)) return
        error.textContent = err instanceof Error ? err.message : t('locations.failedSave')
        error.classList.remove('hidden')
      } finally {
        formState.setBusy(false)
        submitBtn.textContent = t('common.save')
      }
    })
    
    // RFID Modal Logic
    let currentRfidLocationId: number | null = null
    let rfidAbort: AbortController | null = null
    let rfidTimer: ReturnType<typeof setTimeout> | undefined
    const rfidDialog = bindFormDialog(document.getElementById('rfid-modal') as HTMLDialogElement, {
      onClose() {
        // Stop observing; the device may already have accepted the write command.
        rfidAbort?.abort()
        clearTimeout(rfidTimer)
        currentRfidLocationId = null
        ;(document.getElementById('rfid-confirm') as HTMLButtonElement).disabled = false
      },
    })
    
    function openRfidModal(locationId: number) {
      const location = locations.find(l => l.id === locationId)
      if (location && isDriverManagedLocation(location)) return
      currentRfidLocationId = locationId
      rfidAbort?.abort()
      rfidAbort = new AbortController()
      const text = document.getElementById('rfid-text')!
      const deviceSelectContainer = document.getElementById('rfid-device-select-container')!
      const deviceSelect = document.getElementById('rfid-device-select') as HTMLSelectElement
      const status = document.getElementById('rfid-status')!
      const warning = document.getElementById('rfid-warning')!
      
      status.classList.add('hidden')

      if (location && location.identifier) {
        warning.classList.remove('hidden')
      } else {
        warning.classList.add('hidden')
      }

      if (activeDevices.length === 1) {
        text.textContent = t('rfid.confirmWrite', { device: activeDevices[0].name })
        deviceSelectContainer.classList.add('hidden')
      } else {
        text.textContent = t('rfid.selectDeviceToWrite')
        deviceSelectContainer.classList.remove('hidden')
        deviceSelect.innerHTML = activeDevices.map(d => `<option value="${d.id}">${d.name} (${d.ip_address})</option>`).join('')
      }
      
      rfidDialog.open()
    }
    
    
    document.getElementById('rfid-confirm')?.addEventListener('click', async () => {
      if (!currentRfidLocationId || !rfidAbort || (document.getElementById('rfid-confirm') as HTMLButtonElement).disabled) return
      const signal = AbortSignal.any([getAbortSignal(), rfidAbort.signal])
      
      const deviceId = activeDevices.length === 1 
        ? activeDevices[0].id 
        : (document.getElementById('rfid-device-select') as HTMLSelectElement).value
      
      const device = activeDevices.find(d => String(d.id) === String(deviceId))
      if (!device) return
      
      const confirmBtn = document.getElementById('rfid-confirm') as HTMLButtonElement
      const status = document.getElementById('rfid-status')!
      
      confirmBtn.disabled = true
      
      const maxWaitSeconds = 120
      status.className = 'fm-alert fm-alert-info rfid-write-progress'
      status.classList.remove('hidden')
      status.innerHTML = `
        <div class="message-row">
          <span class="spinner"></span>
          <span>${t('rfid.writeStarted')}</span>
        </div>
        <div class="countdown-bar">
          <div class="countdown-fill green" id="countdown-fill" style="width: 100%"></div>
        </div>
        <span class="countdown-text" id="countdown-text">${maxWaitSeconds}s</span>
      `
      
      try {
        const response = await fetch(`/api/v1/devices/${deviceId}/write-tag`, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken()
          },
          credentials: 'include',
          signal,
          body: JSON.stringify({ location_id: currentRfidLocationId }),
        })
        
        const result = await response.json()
        if (signal.aborted) return
        
        if (response.ok && result.success) {
          // Polling: Check periodically for the write status
          const maxAttempts = 60 // 60 attempts * 2 seconds = 120 seconds max wait
          let attempts = 0
          
          const pollForResult = async () => {
            if (signal.aborted) return
            
            attempts++
            
            const elapsedSeconds = attempts * 2
            const remainingSeconds = 120 - elapsedSeconds
            const percentage = Math.max(0, (remainingSeconds / 120) * 100)
            
            const fill = document.getElementById('countdown-fill')
            const text = document.getElementById('countdown-text')
            
            if (fill && text) {
              fill.style.width = percentage + '%'
              text.textContent = Math.max(0, remainingSeconds) + 's'
              
              fill.className = 'countdown-fill'
              if (percentage > 66) {
                fill.classList.add('green')
              } else if (percentage > 33) {
                fill.classList.add('yellow')
              } else {
                fill.classList.add('orange')
              }
            }
            
            try {
              const statusRes = await fetch(`/api/v1/devices/${deviceId}/write-status`, { credentials: 'include', signal })
              if (statusRes.ok) {
                const statusData = await statusRes.json()
                if (signal.aborted) return
                
                if (statusData.status === 'success') {
                  
                  if (statusData.removed_from) {
                    status.textContent = t('rfid.writeSuccessWithCleanup', { source: statusData.removed_from })
                  } else {
                    status.textContent = t('rfid.writeSuccess')
                  }
                  
                  status.className = 'fm-alert fm-alert-success'
                  
                  // Reload data
                  loadLocations()
                  
                  rfidTimer = setTimeout(() => rfidDialog.close(), 3000)
                  return
                } else if (statusData.status === 'error') {
                  status.textContent = statusData.error_message || t('rfid.writeError')
                  status.className = 'fm-alert fm-alert-error'
                  confirmBtn.disabled = false
                  return
                }
              }
            } catch (e) {
              if (signal.aborted || isAbortError(e)) return
              console.error('Polling error:', e)
            }
            
            if (attempts >= maxAttempts) {
              status.textContent = t('rfid.deviceTimeout')
              status.className = 'fm-alert fm-alert-error'
              confirmBtn.disabled = false
            } else {
              if (!signal.aborted) rfidTimer = setTimeout(pollForResult, 2000)
            }
          }
          
          rfidTimer = setTimeout(pollForResult, 2000)
        } else {
          const msg = result.detail?.message || result.message || t('rfid.writeError')
          status.textContent = msg
          status.className = 'fm-alert fm-alert-error'
          confirmBtn.disabled = false
        }
      } catch (err) {
        if (signal.aborted || isAbortError(err)) return
        status.textContent = t('rfid.writeError')
        status.className = 'fm-alert fm-alert-error'
        confirmBtn.disabled = false
      }
    })
    
    // ── Bulk actions ──────────────────────────────────────────────────
    const selectAll = document.getElementById('bulk-select-all') as HTMLInputElement

    function updateBulkBar() {
      document.getElementById('bulk-count')!.textContent = t('locations.bulkSelected', { count: selectedIds.size })
      document.getElementById('bulk-action-bar')!.classList.toggle('visible', selectedIds.size > 0)
      const shownIds = visibleLocations().map(loc => loc.id)
      const all = shownIds.length > 0 && shownIds.every(id => selectedIds.has(id))
      const some = shownIds.some(id => selectedIds.has(id))
      selectAll.disabled = shownIds.length === 0
      selectAll.checked = all
      selectAll.indeterminate = some && !all
    }

    selectAll.addEventListener('change', () => {
      // Selection is always a subset of the rows on screen.
      for (const loc of visibleLocations()) {
        if (selectAll.checked) selectedIds.add(loc.id)
        else selectedIds.delete(loc.id)
      }
      renderLocations()
    }, { signal: panelSignal })

    document.getElementById('bulk-btn-clear')?.addEventListener('click', () => {
      selectedIds.clear()
      renderLocations()
    }, { signal: panelSignal })

    async function sendBulk(method: 'PATCH' | 'DELETE', ids: number[], body: Record<string, unknown>): Promise<BulkResult> {
      const res = await fetch('/api/v1/locations/bulk', {
        method,
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
        credentials: 'include',
        signal: getAbortSignal(),
        body: JSON.stringify({ location_ids: ids, ...body }),
      })
      if (!res.ok) {
        const data = await res.json().catch(() => ({}))
        throw new Error(extractApiError(data, t('locations.bulkError')))
      }
      return res.json()
    }

    function namesOf(ids: number[], lookup: Map<number, string>): string {
      return ids.map(id => lookup.get(id) ?? locations.find(loc => loc.id === id)?.name ?? `#${id}`).join(', ')
    }

    const BULK_LIMIT = 1000

    function rejectIfTooMany(count: number): boolean {
      if (count <= BULK_LIMIT) return false
      void dialogs.__fmAlert(t('locations.bulkTooMany', { max: BULK_LIMIT, count }))
      return true
    }

    let bulkTypeTargetIds: number[] = []
    const bulkTypeForm = document.getElementById('bulk-type-form') as HTMLFormElement
    const bulkTypeDialog = bindFormDialog(document.getElementById('bulk-type-modal') as HTMLDialogElement, {
      canClose: () => !bulkTypeBusy,
    })

    document.getElementById('bulk-btn-type')?.addEventListener('click', () => {
      if (selectedIds.size === 0 || rejectIfTooMany(selectedIds.size)) return
      bulkTypeTargetIds = [...selectedIds]
      document.getElementById('bulk-type-text')!.textContent = t('locations.bulkChangeTypeText', { count: bulkTypeTargetIds.length })
      const targetSet = new Set(bulkTypeTargetIds)
      const selected = locations.filter(loc => targetSet.has(loc.id))
      const driverSlots = selected.filter(loc => isDriverManagedLocation(loc)).length
      const hint = document.getElementById('bulk-type-hint')!
      hint.textContent = driverSlots ? t('locations.bulkTypeDriverHint', { count: driverSlots }) : ''
      hint.classList.toggle('hidden', driverSlots === 0)
      const allowNone = driverSlots === 0
      const known = knownTypes()
      const types = new Set(
        selected.map(loc => resolveKnownType(known, loc.location_type) ?? loc.location_type?.trim() ?? null),
      )
      fillTypePicker('bulk', types.size === 1 ? [...types][0] : null, allowNone)
      bulkTypeDialog.open()
    }, { signal: panelSignal })

    bulkTypeForm.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (bulkTypeBusy || bulkTypeTargetIds.length === 0) return
      normalizeWriteIn('bulk')
      if (!bulkTypeForm.reportValidity()) return
      const targetIds = [...bulkTypeTargetIds]
      const submit = document.getElementById('bulk-type-submit') as HTMLButtonElement
      bulkTypeBusy = true
      submit.disabled = true
      try {
        const result = await sendBulk('PATCH', targetIds, { location_type: readTypePicker('bulk') })
        if (panelSignal.aborted) return
        bulkTypeBusy = false
        bulkTypeDialog.close()
        for (const id of targetIds) selectedIds.delete(id)
        invalidateCachePrefix(CACHE_KEYS.LOCATIONS)
        await loadLocations()
        if (result.updated.length) await dialogs.__fmSuccess(t('locations.bulkChangeTypeSuccess', { count: result.updated.length }))
        if (result.not_found.length) await dialogs.__fmAlert(t('locations.bulkNotFound', { count: result.not_found.length }))
      } catch (err) {
        if (isAbortError(err) || panelSignal.aborted) return
        await dialogs.__fmAlert(err instanceof Error ? err.message : t('locations.bulkError'))
      } finally {
        bulkTypeBusy = false
        syncTypePicker('bulk', false)
      }
    }, { signal: panelSignal })

    document.getElementById('bulk-btn-delete')?.addEventListener('click', async () => {
      const targetIds = [...selectedIds]
      const count = targetIds.length
      if (count === 0 || rejectIfTooMany(count)) return
      const targetSet = new Set(targetIds)
      const selected = locations.filter(loc => targetSet.has(loc.id))
      const nameSnapshot = new Map(selected.map(loc => [loc.id, loc.name]))
      const driverSlots = selected.filter(loc => isDriverManagedLocation(loc)).length
      const listed = selected.slice(0, 10).map(loc => loc.name).join(', ')
      const more = selected.length > 10 ? ` ${t('locations.bulkMore', { count: selected.length - 10 })}` : ''
      // The confirm dialog collapses newlines, so keep this on one line.
      let message = `${t('locations.bulkConfirmDelete', { count })} (${listed}${more})`
      if (driverSlots) message += ` ${t('locations.bulkDeleteDriverWarning', { count: driverSlots })}`
      const confirmed = await dialogs.__fmConfirm(message, {
        title: t('locations.bulkDelete'),
        okLabel: t('locations.bulkDelete'),
        isDanger: true,
      })
      if (!confirmed || panelSignal.aborted) return
      try {
        const result = await sendBulk('DELETE', targetIds, {})
        if (panelSignal.aborted) return
        for (const id of targetIds) selectedIds.delete(id)
        invalidateCachePrefix(CACHE_KEYS.LOCATIONS)
        const skippedNames = namesOf(result.skipped, nameSnapshot)
        await loadLocations()
        if (result.skipped.length) {
          await dialogs.__fmAlert(t('locations.bulkDeleteSkipped', {
            deleted: result.deleted.length,
            skipped: result.skipped.length,
            names: skippedNames,
          }))
        } else if (result.deleted.length === 0 && result.not_found.length > 0) {
          await dialogs.__fmAlert(t('locations.bulkNotFound', { count: result.not_found.length }))
        } else {
          await dialogs.__fmSuccess(t('locations.bulkDeleteSuccess', { count: result.deleted.length }))
        }
      } catch (err) {
        if (isAbortError(err) || panelSignal.aborted) return
        await dialogs.__fmAlert(err instanceof Error ? err.message : t('locations.bulkError'))
      }
    }, { signal: panelSignal })

    // ── Column Picker & Resize ─────────────────────────────────────────
    const locColumnGroups: ColumnGroup[] = [
      {
        heading: t('common.columnsStandard'),
        columns: [
          { key: 'name', label: t('locations.name') },
          { key: 'type', label: t('locations.type') },
          { key: 'identifier', label: t('locations.identifier') },
          { key: 'spools', label: t('locations.spools') },
        ],
      },
    ]
    initColumnPicker({
      signal: panelSignal,
      // New key so the Type column shows up for people with saved column prefs.
      storageKey: 'filaman-columns-locations-v2',
      defaultVisible: ['name', 'type', 'identifier', 'spools'],
      groups: locColumnGroups,
      btnId: 'btn-columns',
      dropdownId: 'columns-dropdown',
      widthsStorageKey: 'filaman-column-widths-locations',
      resetLabel: t('common.columnsReset'),
      onResetWidths: () => locResize.resetWidths(),
    })
    const locResize = initColumnResize({
      tableSelector: '.fm-table',
      storageKey: 'filaman-column-widths-locations',
    })
    // ── End Column Picker & Resize ────────────────────────────────────

    loadActiveDevices().then(() => { if (!panelSignal.aborted) return loadLocations() })

    // Live-Update via SSE: Standorte automatisch neu laden
    let _locationsReloadTimer: ReturnType<typeof setTimeout> | null = null
    panelSignal.addEventListener('abort', () => {
      clearTimeout(_locationsReloadTimer ?? undefined)
      locResize.destroy()
      rfidAbort?.abort()
      clearTimeout(rfidTimer)
    }, { once: true })
    window.addEventListener('filaman:data-changed', (e: Event) => {
      const { event } = (e as CustomEvent).detail ?? {}
      if (event === 'locations_changed' || event === 'spools_changed') {
        if (_locationsReloadTimer) clearTimeout(_locationsReloadTimer)
        _locationsReloadTimer = setTimeout(() => loadLocations(), 300)
      }
    }, { signal: panelSignal })
    })
  </script>
</Layout>
